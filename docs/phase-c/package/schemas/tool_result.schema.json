{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_result_id",
    "tool_call_id",
    "tool_id",
    "caller_role_id",
    "status",
    "started_at"
  ],
  "properties": {
    "tool_result_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_call_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "caller_role_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "permission_result": {
      "type": "string",
      "minLength": 1
    },
    "request_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "empty",
        "refused",
        "timeout",
        "provider_error",
        "invalid_result",
        "cancelled"
      ]
    },
    "result_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "latency_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
