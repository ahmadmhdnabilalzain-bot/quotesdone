{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Workflow Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_run_id",
    "workflow_id",
    "business_object_id",
    "business_object_version",
    "accountable_role_id",
    "state",
    "created_at"
  ],
  "properties": {
    "workflow_run_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "business_object_id": {
      "type": "string",
      "minLength": 1
    },
    "business_object_version": {
      "type": "integer",
      "minimum": 1
    },
    "command_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "accountable_role_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "start_event_id": {
      "type": "string",
      "minLength": 1
    },
    "current_step_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "blocker_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
