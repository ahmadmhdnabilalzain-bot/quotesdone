{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approval Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_request_id",
    "action_class",
    "requester_role_id",
    "approver_identity_type",
    "status",
    "created_at"
  ],
  "properties": {
    "approval_request_id": {
      "type": "string",
      "minLength": 1
    },
    "action_class": {
      "type": "string",
      "minLength": 1
    },
    "requester_role_id": {
      "type": "string",
      "minLength": 1
    },
    "approver_identity_type": {
      "type": "string",
      "enum": [
        "founder",
        "canonical_role"
      ]
    },
    "approver_role_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "founder_identity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "business_object_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "recommendation": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired",
        "cancelled",
        "superseded"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_trace_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
