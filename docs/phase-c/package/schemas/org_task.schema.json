{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Organization Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "source_type",
    "accountable_role_id",
    "manager_role_id",
    "objective",
    "status",
    "priority",
    "acceptance_criteria",
    "closure_criteria",
    "idempotency_key",
    "created_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": [
        "founder_command",
        "workflow",
        "event",
        "manager",
        "incident",
        "remediation"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "step_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "accountable_role_id": {
      "type": "string",
      "minLength": 1
    },
    "manager_role_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "requested_output": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "assigned",
        "accepted",
        "in_progress",
        "blocked",
        "review_required",
        "revision_required",
        "completed",
        "cancelled",
        "failed",
        "superseded"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "closure_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reviewer_role_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "due_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
