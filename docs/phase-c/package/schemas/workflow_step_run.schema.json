{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Workflow Step Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_run_id",
    "workflow_run_id",
    "step_id",
    "accountable_role_id",
    "state",
    "attempt_no",
    "idempotency_key",
    "created_at"
  ],
  "properties": {
    "step_run_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_run_id": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "accountable_role_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_role_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1
    },
    "parent_attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
