{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Action Execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "component_id",
    "system_actor_id",
    "accountable_role_id",
    "action_class",
    "status",
    "started_at"
  ],
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "component_id": {
      "type": "string",
      "minLength": 1
    },
    "system_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "accountable_role_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "step_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_class": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1
    },
    "parent_attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
