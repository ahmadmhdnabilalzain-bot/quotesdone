{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Handoff Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_run_id",
    "handoff_id",
    "workflow_run_id",
    "from_step_run_id",
    "sender_role_id",
    "receiver_role_id",
    "status",
    "packet_hash",
    "created_at"
  ],
  "properties": {
    "handoff_run_id": {
      "type": "string",
      "minLength": 1
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_run_id": {
      "type": "string",
      "minLength": 1
    },
    "from_step_run_id": {
      "type": "string",
      "minLength": 1
    },
    "to_step_id": {
      "type": "string",
      "minLength": 1
    },
    "sender_role_id": {
      "type": "string",
      "minLength": 1
    },
    "receiver_role_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_hash": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "returned",
        "overdue",
        "cancelled",
        "completed"
      ]
    },
    "rejection_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "return_owner_role_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "due_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
