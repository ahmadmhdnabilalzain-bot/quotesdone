{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Founder Command Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "command_id",
    "version",
    "status",
    "child_tasks",
    "created_at"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "accepted",
        "superseded",
        "refused"
      ]
    },
    "workflow_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "primary_owner_role_id": {
      "type": "string",
      "minLength": 1
    },
    "child_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_key",
          "accountable_role_id",
          "objective"
        ],
        "properties": {
          "task_key": {
            "type": "string",
            "minLength": 1
          },
          "workflow_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "step_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "accountable_role_id": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "closure_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "clarification_required": {
      "type": "boolean"
    },
    "clarification_question": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
