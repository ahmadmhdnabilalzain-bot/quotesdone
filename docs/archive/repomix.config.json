{
  "output": {
    "filePath": "repomix-src.xml",
    "style": "xml",
    "removeComments": false,
    "showLineNumbers": false,
    "topFilesLength": 5
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "s.key",
      "qd-src.zip",
      "**/*.key",
      "**/*.pem",
      ".env*",
      "repomix-*.xml",
      "repomix.log",
      "holdout_v2_eval/**",
      "tsconfig.tsbuildinfo",
      "graphify-out/**",
      "ai-organization/**",
      "knowledge/**",
      "knowledge-import/**",
      "messages/**",
      "public/**",
      "_archive/**",
      "supabase/schema/**",
      "supabase/migrations-superseded-consolidated/**",
      "supabase/seeds/**",
      "*.skill",
      "package-lock.json"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
