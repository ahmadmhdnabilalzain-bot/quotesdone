{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuotesDone Decision Trace",
  "type": "object",
  "required": [
    "trace_id",
    "task_id",
    "agent_id",
    "role_id",
    "department_id",
    "task_class",
    "started_at",
    "knowledge_ids",
    "tool_calls",
    "evidence",
    "authority",
    "model",
    "output_status",
    "expected_outcome",
    "review_at"
  ],
  "properties": {
    "trace_id": {
      "type": "string"
    },
    "parent_trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "workflow_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_id": {
      "type": "string"
    },
    "role_id": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "manager_role_id": {
      "type": "string"
    },
    "task_class": {
      "type": "string"
    },
    "company_objective_context": {
      "type": "object"
    },
    "department_objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "role_kpi": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "knowledge_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knowledge_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool_call_id",
          "tool_id",
          "status"
        ],
        "properties": {
          "tool_call_id": {
            "type": "string"
          },
          "tool_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "result_hash": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "kind",
          "claim"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "options_considered": {
      "type": "array"
    },
    "authority": {
      "type": "object",
      "required": [
        "classification",
        "allowed",
        "reason"
      ],
      "properties": {
        "classification": {
          "type": "string"
        },
        "allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "escalation": {
      "type": "object"
    },
    "model": {
      "type": "object",
      "required": [
        "model_id",
        "provider",
        "reasoning_effort",
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "properties": {
        "model_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "reasoning_effort": {
          "type": "string"
        },
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "reasoning_tokens": {
          "type": "integer"
        },
        "cached_tokens": {
          "type": "integer"
        },
        "cost_usd": {
          "type": "number"
        }
      }
    },
    "decision": {
      "type": [
        "object",
        "string",
        "null"
      ]
    },
    "expected_outcome": {
      "type": "object"
    },
    "review_at": {
      "type": "string",
      "format": "date-time"
    },
    "output_status": {
      "enum": [
        "complete",
        "clarification_required",
        "escalated",
        "refused",
        "blocked",
        "truncated",
        "schema_invalid",
        "infrastructure_error"
      ]
    },
    "actual_outcome": {
      "type": [
        "object",
        "null"
      ]
    },
    "lesson_proposal_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
