{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuotesDone Tool Result",
  "type": "object",
  "required": [
    "tool_call_id",
    "tool_id",
    "status",
    "data_hash",
    "source_timestamp",
    "freshness",
    "latency_ms",
    "cost_usd",
    "retryable",
    "trace_id"
  ],
  "properties": {
    "tool_call_id": {
      "type": "string"
    },
    "tool_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "empty",
        "error",
        "timeout",
        "unauthorized",
        "stale",
        "blocked"
      ]
    },
    "data": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "data_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "freshness": {
      "type": "string"
    },
    "latency_ms": {
      "type": "integer"
    },
    "cost_usd": {
      "type": "number"
    },
    "retryable": {
      "type": "boolean"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
