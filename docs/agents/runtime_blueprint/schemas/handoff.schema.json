{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuotesDone Cross-Department Handoff",
  "type": "object",
  "required": [
    "handoff_id",
    "origin_department",
    "origin_role",
    "accountable_owner_role",
    "receiving_department",
    "receiving_role",
    "purpose",
    "evidence",
    "requested_action",
    "acceptance_criteria",
    "closure_criteria",
    "deadline",
    "status",
    "trace_id"
  ],
  "properties": {
    "handoff_id": {
      "type": "string"
    },
    "origin_department": {
      "type": "string"
    },
    "origin_role": {
      "type": "string"
    },
    "accountable_owner_role": {
      "type": "string"
    },
    "receiving_department": {
      "type": "string"
    },
    "receiving_role": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "evidence": {
      "type": "array"
    },
    "requested_action": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array"
    },
    "closure_criteria": {
      "type": "array"
    },
    "deadline": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "submitted",
        "accepted",
        "rejected_incomplete",
        "in_progress",
        "blocked",
        "returned",
        "completed",
        "escalated"
      ]
    },
    "return_payload": {
      "type": [
        "object",
        "null"
      ]
    },
    "trace_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
