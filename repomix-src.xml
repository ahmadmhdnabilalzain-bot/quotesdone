<file path="scripts/audit-screenshots.mjs">
// Capture every major QuotesDone route at desktop and mobile size.
//
// Written during the Phase 0 audit because the audit environment (a cloud sandbox with an egress
// allowlist) could not reach quotesdone.com - every navigation returned ERR_CONNECTION_RESET. The
// requirement asks for a screenshot set covering responsive and mobile behaviour, so rather than
// claim coverage that was never captured, the capture is committed as one command.
//
//   npx playwright install chromium
//   node scripts/audit-screenshots.mjs                       # against production
//   BASE=http://localhost:3000 node scripts/audit-screenshots.mjs   # against a local dev server
//
// Writes docs/audit/screenshots/{desktop,mobile}__<route>.png and docs/audit/route_probe.json.
import { chromium } from 'playwright';
import { mkdirSync, writeFileSync } from 'node:fs';

const BASE = process.env.BASE || 'https://quotesdone.com';
const OUT = 'docs/audit/screenshots';

// Application routes first - they are the ones the upgrade touches.
const ROUTES = [
  ['os', '/os'], ['portal', '/portal'], ['me', '/me'],
  ['me-ar', '/ar/me'], ['portal-ar', '/ar/portal'], ['os-ar', '/ar/os'],
  ['home', '/'], ['home-ar', '/ar'],
  ['services', '/services'], ['service-detail', '/services/waterproofing-suppliers'],
  ['about', '/about'], ['faq', '/faq'], ['contact', '/contact'], ['blog', '/blog'],
  ['terms', '/terms'], ['privacy', '/privacy'], ['supplier-agreement', '/supplier-agreement'],
];

const VIEWPORTS = [
  ['desktop', 1440, 900, undefined],
  ['mobile', 390, 844,
   'Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1'],
];

mkdirSync(OUT, { recursive: true });
const browser = await chromium.launch();
const probe = [];

for (const [vp, width, height, userAgent] of VIEWPORTS) {
  const ctx = await browser.newContext({ viewport: { width, height }, userAgent, isMobile: vp === 'mobile' });
  for (const [name, path] of ROUTES) {
    const page = await ctx.newPage();
    const consoleErrors = [];
    page.on('console', m => { if (m.type() === 'error') consoleErrors.push(m.text().slice(0, 160)); });
    let status = null, title = '', error = '';
    try {
      const res = await page.goto(BASE + path, { waitUntil: 'domcontentloaded', timeout: 45000 });
      status = res?.status() ?? null;
      await page.waitForTimeout(3000);           // let client components mount and fetch
      title = await page.title();
      await page.screenshot({ path: `${OUT}/${vp}__${name}.png`, fullPage: true });
    } catch (e) { error = String(e.message).slice(0, 160); }
    probe.push({ viewport: vp, name, path, status, title, error, consoleErrors });
    console.log(`${vp.padEnd(7)} ${path.padEnd(38)} ${status ?? 'ERR'} ${error}`);
    await page.close();
  }
  await ctx.close();
}

await browser.close();
writeFileSync('docs/audit/route_probe.json', JSON.stringify(probe, null, 1));
const bad = probe.filter(p => p.status !== 200);
console.log(`\n${probe.length} captures, ${bad.length} non-200.`);
if (bad.length) console.log(bad.map(b => `  ${b.viewport} ${b.path} -> ${b.status ?? b.error}`).join('\n'));
</file>

<file path="scripts/b6_touchpoints.mjs">
// Which functions do the Stage B.6 migrations create or replace, and which of
// those already existed before B.6? The second set is what a B.6 rollback must
// restore, not drop.
import { readFileSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
const MIG = join(process.cwd(), 'supabase', 'migrations');
const b6 = readdirSync(MIG).filter(f => /^2026080222\d{2}_/.test(f)).sort();
const pre = readdirSync(MIG).filter(f => /^2026080223\d{2}_/.test(f)).sort();

const fns = src => {
  const s = new Set();
  for (const f of src) {
    const sql = readFileSync(join(MIG, f), 'utf8');
    for (const m of sql.matchAll(/create\s+(?:or\s+replace\s+)?function\s+(?:public\.)?([a-z0-9_]+)/gi)) s.add(m[1]);
  }
  return s;
};
const B6 = fns(b6), PRE = fns(pre);
const created = [...B6].filter(x => !PRE.has(x)).sort();
const replaced = [...B6].filter(x => PRE.has(x)).sort();

// what the current rollback actually touches
const rb = readFileSync(join(MIG, '202608022212_p2_c1_stage_b6_operator_rollback.sql'), 'utf8');
const dropped = new Set([...rb.matchAll(/drop\s+function\s+if\s+exists\s+public\.([a-z0-9_]+)/gi)].map(m => m[1]));
const restored = new Set([...rb.matchAll(/create\s+or\s+replace\s+function\s+public\.([a-z0-9_]+)/gi)].map(m => m[1]));
restored.delete('fn_p2c1_rollback_stage_b6');

console.log('B.6 CREATES (rollback must DROP):');
for (const f of created) console.log(`  ${dropped.has(f) ? 'ok   ' : 'MISS '} ${f}`);
console.log('\nB.6 REPLACES a prior-stage function (rollback must RESTORE):');
for (const f of replaced) console.log(`  ${restored.has(f) ? 'ok   ' : 'MISS '} ${f}`);

const b6tables = new Set(), b6views = new Set();
for (const f of b6) {
  const sql = readFileSync(join(MIG, f), 'utf8');
  for (const m of sql.matchAll(/create\s+table\s+(?:if\s+not\s+exists\s+)?(?:public\.)?([a-z0-9_]+)/gi)) b6tables.add(m[1]);
  for (const m of sql.matchAll(/create\s+(?:or\s+replace\s+)?view\s+(?:public\.)?([a-z0-9_]+)/gi)) b6views.add(m[1]);
}
const rbTables = new Set([...rb.matchAll(/drop\s+table\s+if\s+exists\s+public\.([a-z0-9_]+)/gi)].map(m => m[1]));
const rbViews = new Set([...rb.matchAll(/drop\s+view\s+if\s+exists\s+public\.([a-z0-9_]+)/gi)].map(m => m[1]));
console.log('\nB.6 TABLES:');
for (const t of [...b6tables].sort()) console.log(`  ${rbTables.has(t) ? 'ok   ' : 'MISS '} ${t}`);
console.log('\nB.6 VIEWS:');
for (const v of [...b6views].sort()) console.log(`  ${rbViews.has(v) ? 'ok   ' : 'MISS '} ${v}`);
</file>

