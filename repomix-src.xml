      // 21 Jul 2026: three dry_run calls produced a quote sitting in 'submitted'.
      const { data: priorQ } = await admin.from('quotes').select('status').eq('inquiry_id', body.inquiry_id).eq('supplier_id', sup.id).maybeSingle();
