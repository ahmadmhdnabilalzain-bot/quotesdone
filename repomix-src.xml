-- Production already has org_authority (33 rows, re-tiered 29 Jul) keyed on (dept_key,
-- action_class, max_tier, threshold_aed). The corpus adds 10 hard gates keyed on action_class with
-- a default tier and an approval role. They must agree, and where they disagree the STRICTER answer
-- has to win - a corpus that could widen production authority merely by being imported would be an
-- authority-escalation vector, which the security rules name explicitly.
-- So: strictest wins. A hard gate can only ever tighten.
create or replace function public.fn_ops_authority_check(
  p_dept_key text, p_action_class text, p_amount_aed numeric default null, p_risk text default null)
returns jsonb language plpgsql stable as $$
declare v_prod text; v_thresh numeric; v_gate record; v_tier text; v_reason text;
begin
  select max_tier, threshold_aed into v_prod, v_thresh
  from public.org_authority where dept_key = p_dept_key and action_class = p_action_class;

  select * into v_gate from ops_kb_stage.hard_gates
  where raw->>'action_class' = p_action_class limit 1;

  v_tier := coalesce(v_prod, 'gated');
  v_reason := case when v_prod is null
                   then 'no org_authority row for this department and action class - defaulting to gated'
                   else 'org_authority.max_tier' end;

  if v_gate.record_id is not null then
    if coalesce(v_gate.raw->>'default_tier','gated') = 'gated' and v_tier <> 'gated' then
      v_tier := 'gated';
      v_reason := 'hard gate "' || v_gate.title || '" overrides org_authority (a hard gate may only tighten, never widen)';
    end if;
  end if;

  if v_thresh is not null and p_amount_aed is not null and p_amount_aed > v_thresh then
    v_tier := 'gated';
    v_reason := format('amount %s AED exceeds the department threshold of %s AED', p_amount_aed, v_thresh);
  end if;

  if p_risk = 'critical' and v_tier = 'autonomous' then
    v_tier := 'gated';
    v_reason := 'risk_level=critical is never executed autonomously';
  end if;

  return jsonb_build_object(
    'department', p_dept_key, 'action_class', p_action_class,
    'effective_tier', v_tier,
    'may_act_autonomously', (v_tier = 'autonomous'),
    'requires_approval', (v_tier = 'gated'),
    'hard_gate', case when v_gate.record_id is null then null else jsonb_build_object(
        'title', v_gate.title, 'approval_role', v_gate.raw->>'approval_role',
        'threshold', v_gate.raw->>'threshold', 'rollback', v_gate.raw->>'rollback') end,
    'production_tier', v_prod, 'threshold_aed', v_thresh, 'reason', v_reason,
    'source', 'org_authority + ops_kb_stage.hard_gates (deterministic, no model call)');
end $$;

comment on function public.fn_ops_authority_check(text,text,numeric,text) is
  'Deterministic authority decision for one department and action class. Combines live org_authority with the corpus hard gates under a strictest-wins rule, so importing the corpus can never widen what an agent may do.';

-- ---------------------------------------------------------------------------------------------
-- 2. AGENT CONTEXT ASSEMBLY. Company core + department knowledge + live bindings + authoritative
-- sources + hard gates + recent institutional memory. The point is that it returns a HANDFUL of
-- records rather than a department master: agent_brain currently spends 14,600-22,000 input tokens
-- per call, which is the single largest AI cost in the company.
create or replace function public.fn_ops_department_context(
  p_dept_key text, p_topic text default null, p_limit int default 6)
returns jsonb language sql stable as $$
with q as (
  select to_tsquery('simple', nullif(array_to_string(
      array(select w || ':*' from unnest(regexp_split_to_array(lower(coalesce(p_topic,'')), '[^a-z0-9]+')) w
            where length(w) >= 3), ' | '), '')) tsq
)
select jsonb_build_object(
  'department', p_dept_key,
  'company_core', (
    select coalesce(jsonb_agg(jsonb_build_object('title', c.title, 'content', c.body)), '[]'::jsonb)
    from (select r.title, left(r.content,1200) body from ops_kb_stage.records r
          where r.scope_type = 'company' and r.module in ('identity','principles','governance','privacy','language')
            and r.validation_status in ('reviewed','source_verified','approved')
          order by r.record_type limit 8) c),
  'department_knowledge', (
    select coalesce(jsonb_agg(s.x), '[]'::jsonb) from (
      select jsonb_build_object('record_id', r.record_id, 'title', r.title,
                                'content', left(r.content, 1500), 'module', r.module,
                                'implementation_status', r.implementation_status,
                                'authority_tier', r.authority_tier, 'risk_level', r.risk_level,
                                'source_ids', r.source_ids) x
      from ops_kb_stage.records r, q
      where r.scope_type = 'department' and r.scope_key = p_dept_key
        and r.validation_status in ('reviewed','source_verified','approved')
        and (q.tsq is null or to_tsvector('simple', r.title || ' ' || left(r.content,4000)) @@ q.tsq)
      order by ts_rank(to_tsvector('simple', r.title || ' ' || left(r.content,4000)), q.tsq) desc,
               r.implementation_status, r.record_id
      limit greatest(p_limit,1)) s),
  'live_data', (
    select coalesce(jsonb_agg(jsonb_build_object('object', b.object_name, 'kind', b.db_object_kind,
                                                 'purpose', b.read_purpose, 'write_policy', b.write_policy)), '[]'::jsonb)
    from ops_kb_stage.live_bindings b
    where b.department_key = p_dept_key and b.mapping_status = 'mapped'),
  'authoritative_sources', (
    select coalesce(jsonb_agg(jsonb_build_object('source_id', s2.source_id, 'title', s2.title,
                                                 'publisher', s2.publisher, 'url', s2.url_or_path)), '[]'::jsonb)
    from ops_kb_stage.sources s2
    where exists (select 1 from ops_kb_stage.records r
                  where r.scope_key = p_dept_key and s2.source_id = any(r.source_ids))),
  'hard_gates', (
    select coalesce(jsonb_agg(jsonb_build_object('action_class', g.raw->>'action_class',
                                                 'approval_role', g.raw->>'approval_role')), '[]'::jsonb)
    from ops_kb_stage.hard_gates g),
  'institutional_memory', (
    select coalesce(jsonb_agg(jsonb_build_object('headline', m.headline, 'outcome', m.outcome)), '[]'::jsonb)
    from (select headline, outcome from public.institutional_memory order by created_at desc limit 3) m),
  'note', 'staging corpus: nothing here is enabled or approved; implementation_status must be checked before acting'
);
$$;

-- ---------------------------------------------------------------------------------------------
-- 3. SUPPLIER-CORPUS LINK. The pack is explicit that the 86-route supplier corpus stays the source
-- for category expertise and that this corpus links to it by stable key rather than copying it.
-- Four target departments own that boundary.
create or replace view public.v_ops_supplier_corpus_link as
select d.department_key,
       d.name as department_name,
       r.catalog_num,
       c.slug  as live_catalog_slug,
       c.name  as live_catalog_name,
       (select count(*) from public.kb_operational_route_map m where m.catalog_num = r.catalog_num) as mapped_subcategories
from ops_kb_stage.departments d
cross join public.kb_operational_route r
join public.catalog_supplier_categories c on c.num = r.catalog_num
where d.department_key in ('rfq_intelligence','marketplace_operations','supplier_knowledge','document_intelligence');

comment on view public.v_ops_supplier_corpus_link is
  'The join between the company-operations corpus and the 86-route supplier corpus. Linked by catalog_num, never copied: category expertise has exactly one owner.';

grant execute on function public.fn_ops_authority_check(text,text,numeric,text) to service_role;
grant execute on function public.fn_ops_department_context(text,text,int) to service_role;

create index if not exists ops_kb_stage_records_fts_idx
  on ops_kb_stage.records using gin (to_tsvector('simple', title || ' ' || left(content, 4000)));
</file>

<file path="supabase/migrations/20260802133532_ops_scenario_harness_and_gate_gap_view.sql">
-- PHASE 4 TEST HARNESS.
-- Honest scoping first: the 282 scenarios describe BEHAVIOUR ("a supplier submits a quote after the
-- deadline; the system should ..."). Executing them properly needs a runner that can drive the real
-- flows, which does not exist and is not in this session's scope. What CAN be executed
-- deterministically today is whether each scenario is even RUNNABLE - whether the department it
-- names exists, has knowledge, has resolved live data, has an authority position and has stated
-- pass criteria. A scenario that fails this cannot pass a behavioural run either, so it is a real
-- filter rather than a box-tick, and it is labelled 'structural' everywhere so nobody mistakes it
-- for behavioural proof.
create or replace function public.fn_ops_run_scenarios()
returns table (scenario_id text, kind text, scope_key text, verdict text, failures text[])
language sql volatile as $$
with checked as (
  select s.record_id, s.kind, s.scope_key,
    array_remove(array[
      case when not exists (select 1 from ops_kb_stage.departments d where d.department_key = s.scope_key)
            and s.kind = 'department' then 'department not in the corpus department index' end,
      case when s.kind = 'workflow'
            and not exists (select 1 from ops_kb_stage.workflows w where w.workflow_key = s.scope_key)
           then 'workflow_key does not resolve to an imported workflow' end,
      case when coalesce(btrim(s.expected_behaviour), '') = '' then 'no expected behaviour stated' end,
      case when jsonb_array_length(coalesce(s.pass_criteria, '[]'::jsonb)) = 0 then 'no pass criteria' end,
      case when s.kind = 'department'
            and not exists (select 1 from ops_kb_stage.records r
                            where r.scope_type='department' and r.scope_key = s.scope_key
                              and r.module = 'professional_knowledge')
           then 'department has no professional knowledge to reason from' end,
      case when s.kind = 'department'
            and not exists (select 1 from ops_kb_stage.live_bindings b
                            where b.department_key = s.scope_key and b.mapping_status='mapped')
           then 'department has no resolved live-data binding' end,
      case when s.kind = 'department'
            and not exists (select 1 from ops_kb_stage.decision_rules dr where dr.department_key = s.scope_key)
           then 'department has no decision rules' end
    ], null) as failures
  from ops_kb_stage.scenarios s
)
select c.record_id, c.kind, c.scope_key,
       case when cardinality(c.failures) = 0 then 'RUNNABLE' else 'BLOCKED' end,
       c.failures
from checked c;
$$;

comment on function public.fn_ops_run_scenarios() is
  'STRUCTURAL scenario check, not behavioural. Answers "could this scenario be run at all" - department exists, has knowledge, has resolved live data, has rules, states pass criteria. A BLOCKED scenario cannot pass a behavioural run either. Behavioural execution needs a flow runner that does not exist yet.';

-- Persist the outcome so the counts are queryable rather than transient.
update ops_kb_stage.scenarios s
set last_result = r.verdict,
    last_run = now(),
    raw = s.raw || jsonb_build_object('structural_failures', to_jsonb(r.failures))
from public.fn_ops_run_scenarios() r
where r.scenario_id = s.record_id;

-- GOVERNANCE GAP VIEW. 8 of the 10 corpus hard gates have no org_authority row at ALL. They are
-- safe inside fn_ops_authority_check because it fails closed, but any other code path that reads
-- org_authority directly finds nothing and has to invent a default. Stating the gap is the point;
-- filling it would be an authority change, which is itself hard-gated and is the founder's call.
create or replace view public.v_ops_hard_gate_coverage as
select g.raw->>'action_class'   as action_class,
       g.title                  as gate_title,
       g.raw->>'default_tier'   as corpus_default_tier,
       g.raw->>'approval_role'  as approval_role,
       (select count(*) from public.org_authority a where a.action_class = g.raw->>'action_class') as org_authority_rows,
       (select string_agg(a.dept_key || '=' || a.max_tier, ', ' order by a.dept_key)
          from public.org_authority a where a.action_class = g.raw->>'action_class') as existing_authority,
       case when (select count(*) from public.org_authority a where a.action_class = g.raw->>'action_class') = 0
            then 'NO AUTHORITY ROW - relies on fail-closed default'
            else 'covered' end as status
from ops_kb_stage.hard_gates g;

comment on view public.v_ops_hard_gate_coverage is
  'Which of the 10 corpus hard gates are actually represented in public.org_authority. Eight are not. They are gated today only because fn_ops_authority_check defaults to gated when no row exists; filling them in is an authority change and therefore the founder''s decision, not the importer''s.';
</file>

<file path="supabase/migrations/20260802142957_p1_02_supplier_fee_currency_locked.sql">
-- PHASE 1.2 - the supplier subscription is AED 1,000/year, stated once and enforced.
-- The founder confirmed AED on 2 Aug after the external reviewer flagged that pricing_config held
-- the number 1000 with NO currency column at all, while the written spec said EUR 1,000 and
-- everything built said AED. A 4x pricing error that depends on which document you happen to read
-- is not a documentation problem, so the currency is now a column with a CHECK, not a convention.
alter table public.pricing_config
  alter column supplier_reg_currency set default 'AED',
  alter column reveal_currency set default 'AED';

update public.pricing_config
set supplier_reg_fee = 1000,
    supplier_reg_period = 'yearly',
    supplier_reg_currency = 'AED',
    reveal_currency = 'AED',
    updated_at = now()
where id = 1;

-- Stripe charges in aed (supplier_pay line_items[0][price_data][currency] = 'aed') and every
-- customer-facing surface says AED. Anything else silently mis-bills, so make it un-typo-able.
alter table public.pricing_config
  drop constraint if exists pricing_config_currency_ck,
  add constraint pricing_config_currency_ck
  check (supplier_reg_currency = 'AED' and reveal_currency = 'AED');

alter table public.pricing_config
  drop constraint if exists pricing_config_period_ck,
  add constraint pricing_config_period_ck
  check (supplier_reg_period in ('yearly','monthly'));

comment on column public.pricing_config.supplier_reg_currency is
  'AED, confirmed by the founder 2 Aug 2026. CHECK-constrained because Stripe charges in aed and every published surface says AED; a change here without changing all of them mis-bills silently. To move currency: change supplier_pay, the Supplier Agreement (app_secrets.supplier_terms_html), the public supplier page and the accounting entries in the same migration, then relax the constraint.';

-- One place any surface can read the fee from, so no function ever hardcodes it again.
create or replace view public.v_supplier_pricing as
select p.supplier_reg_fee as annual_fee,
       p.supplier_reg_currency as currency,
       p.supplier_reg_period as period,
       p.supplier_free_count as free_registrations,
       (select count(*) from public.leads where approval_status = 'approved') as approved_suppliers,
       greatest(0, p.supplier_free_count - (select count(*) from public.leads where approval_status = 'approved')) as free_slots_remaining,
       date '2027-08-01' as charging_starts,
       p.standard_reveal_rate as reveal_rate,
       p.reveal_currency,
       'Free until 31 July 2027. From 1 August 2027: ' || p.supplier_reg_currency || ' ' ||
         trim(to_char(p.supplier_reg_fee, '999G999')) || '/year. The first ' ||
         p.supplier_free_count || ' registered suppliers are permanently exempt. No commission, ever.'
         as published_statement
from public.pricing_config p where p.id = 1;

comment on view public.v_supplier_pricing is
  'The single readable statement of supplier pricing. Every surface that quotes a fee should read this rather than restating the number.';
</file>

<file path="supabase/migrations/20260802143106_p1_03_supplier_exception_window_and_queue.sql">
-- PHASE 1.3 - supplier exception handling with a real deadline.
--
-- Context. On 2 Aug the founder chose fully automatic supplier approval: no human queue. A supplier
-- whose licence cannot be read goes to approval_status='action_required' with licence_gate_reason
-- naming the problem, and self-serves by re-uploading. That closed the "queue nobody works" problem
-- but opened a quieter one: an account can sit in action_required forever. It is neither approved
-- nor refused, it occupies a company name and an email, and nobody - supplier or founder - can tell
-- whether it is alive. A state with no exit is not automation; it is a queue with the label removed.
--
-- So: a 14-day window, reminders inside it, automatic rejection at the end, and the depth of the
-- window visible. Re-uploading a readable licence at any point re-runs the existing gate in
-- supplier_api and clears everything below. Nothing here approves anybody.

alter table public.leads
  add column if not exists exception_opened_at   timestamptz,
  add column if not exists exception_due_at      timestamptz,
  add column if not exists exception_reminders   integer not null default 0,
  add column if not exists exception_last_reminder_at timestamptz,
  add column if not exists exception_closed_at   timestamptz,
  add column if not exists exception_outcome     text;

comment on column public.leads.exception_due_at is
  'When an action_required registration is automatically rejected if the supplier has not supplied a readable, in-date trade licence. 14 days from the moment the exception opened. Re-uploading a valid licence clears this by way of the normal approval path in supplier_api.';

create index if not exists leads_exception_due_idx
  on public.leads (exception_due_at) where exception_closed_at is null;

-- How long the supplier gets. In app_secrets so it can be changed without a deploy, and read
-- through this function so nothing hardcodes 14 in two places.
insert into app_secrets (key, value) values ('supplier_exception_days','14')
on conflict (key) do update set value = excluded.value;

create or replace function public.fn_supplier_exception_days()
returns integer language sql stable as $$
  select greatest(1, coalesce((select nullif(btrim(value),'')::int from app_secrets where key='supplier_exception_days'), 14));
$$;

-- OPEN. Called when supplier_api sets action_required. Idempotent: re-opening an already-open
-- exception does not restart the clock, because that would let a supplier extend their own deadline
-- indefinitely by re-saving a still-unreadable licence.
create or replace function public.fn_supplier_exception_open(p_lead_id bigint, p_reason text)
returns jsonb language plpgsql security definer set search_path = public as $$
declare v_days int := public.fn_supplier_exception_days(); r public.leads;
begin
  select * into r from public.leads where id = p_lead_id;
  if not found then return jsonb_build_object('ok', false, 'error', 'lead_not_found'); end if;

  if r.exception_opened_at is not null and r.exception_closed_at is null then
    return jsonb_build_object('ok', true, 'reopened', false, 'due_at', r.exception_due_at,
                              'note', 'already open - the clock does not restart on a repeat failure');
  end if;

  update public.leads
     set exception_opened_at = now(),
         exception_due_at = now() + make_interval(days => v_days),
         exception_reminders = 0, exception_last_reminder_at = null,
         exception_closed_at = null, exception_outcome = null,
         licence_gate_reason = coalesce(p_reason, licence_gate_reason)
   where id = p_lead_id;

  return jsonb_build_object('ok', true, 'reopened', true,
                            'due_at', now() + make_interval(days => v_days), 'days', v_days);
end $$;

-- CLOSE. Called on approval, or by the expiry sweep, or if the supplier withdraws.
create or replace function public.fn_supplier_exception_close(p_lead_id bigint, p_outcome text)
returns void language sql security definer set search_path = public as $$
  update public.leads
     set exception_closed_at = now(),
         exception_outcome = p_outcome,
         licence_gate_reason = case when p_outcome = 'resolved' then null else licence_gate_reason end
   where id = p_lead_id and exception_closed_at is null;
$$;

-- THE SWEEP. Reminders at day 3, 7 and 12; automatic rejection the moment the window closes.
-- Deliberately does NOT delete anything: the row becomes approval_status='rejected' with a reason
-- and a closed exception, so the supplier can still be found, appealed and re-opened by a human if
-- one ever looks. Automatic rejection is a decision, not an erasure.
create or replace function public.fn_supplier_exception_sweep()
returns jsonb language plpgsql security definer set search_path = public as $$
declare v_reminded int := 0; v_rejected int := 0; r record; v_days int := public.fn_supplier_exception_days();
begin
  -- reminders
  for r in
    select l.id, l.company_name, l.claimed_by, l.exception_due_at, l.exception_reminders, l.licence_gate_reason
    from public.leads l
    where l.approval_status = 'action_required'
      and l.exception_closed_at is null
      and l.exception_due_at is not null
      and l.exception_due_at > now()
      and l.claimed_by is not null
      and (l.exception_last_reminder_at is null or l.exception_last_reminder_at < now() - interval '48 hours')
      and (
        (l.exception_reminders = 0 and now() >= l.exception_opened_at + interval '3 days') or
        (l.exception_reminders = 1 and now() >= l.exception_opened_at + interval '7 days') or
        (l.exception_reminders = 2 and now() >= l.exception_opened_at + interval '12 days')
      )
  loop
    insert into public.notifications (type, to_email, to_role, lead_id, subject, body, channel, status)
    values ('supplier_exception_reminder', r.claimed_by, 'supplier', r.id,
            'Action needed to activate your QuotesDone account',
            'Your registration for ' || coalesce(r.company_name,'your company') ||
            ' is not active yet: ' || coalesce(r.licence_gate_reason, 'we could not read a valid, in-date trade licence') ||
            E'.\n\nUpload a clear copy of your current trade licence in your supplier portal and your account activates automatically - there is no approval queue.' ||
            E'\n\nIf we do not receive one by ' || to_char(r.exception_due_at, 'DD Mon YYYY') ||
            ', this registration will be closed automatically. You can register again at any time.',
            'email', 'queued');
    update public.leads
       set exception_reminders = exception_reminders + 1, exception_last_reminder_at = now()
     where id = r.id;
    v_reminded := v_reminded + 1;
  end loop;

  -- expiry -> automatic rejection
  for r in
    select l.id, l.company_name, l.claimed_by, l.licence_gate_reason
    from public.leads l
    where l.approval_status = 'action_required'
      and l.exception_closed_at is null
      and l.exception_due_at is not null
      and l.exception_due_at <= now()
  loop
    update public.leads
       set approval_status = 'rejected',
           rejection_reason = 'Automatically closed after ' || v_days ||
                              ' days without a readable, in-date trade licence (' ||
                              coalesce(r.licence_gate_reason,'licence unreadable') || ')',
           exception_closed_at = now(), exception_outcome = 'expired_auto_rejected'
     where id = r.id;

    if r.claimed_by is not null then
      insert into public.notifications (type, to_email, to_role, lead_id, subject, body, channel, status)
      values ('supplier_exception_expired', r.claimed_by, 'supplier', r.id,
              'Your QuotesDone registration has been closed',
              'We could not activate ' || coalesce(r.company_name,'your registration') || ' because ' ||
              coalesce(r.licence_gate_reason,'we could not read a valid, in-date trade licence') ||
              ', and ' || v_days || ' days have passed.' ||
              E'\n\nNothing is lost - you can register again whenever you have a clear copy of your current trade licence, and activation is immediate once we can read it.' ||
              E'\n\nIf you believe this is a mistake, reply to this email.',
              'email', 'queued');
    end if;

    -- telemetry, not a ticket. The auto-rejection rate is the cost of the fully-automatic policy
    -- and the founder asked for it to stay measurable.
    insert into public.agent_actions (agent, kind, status, risk, title, recommendation, detail, target_table, target_id)
    values ('onboarding', 'supplier_exception_expired', 'logged', 'medium',
            'Registration auto-closed after ' || v_days || ' days - ' || coalesce(r.company_name, 'supplier #' || r.id),
            'No action required. Recorded so the auto-rejection rate stays visible; if genuine businesses appear here, the fully-automatic policy needs revisiting.',
            jsonb_build_object('lead_id', r.id, 'reason', r.licence_gate_reason, 'days', v_days),
            'leads', r.id::text);
    v_rejected := v_rejected + 1;
  end loop;

  return jsonb_build_object('reminded', v_reminded, 'auto_rejected', v_rejected, 'window_days', v_days);
end $$;

-- QUEUE DEPTH, visible. Not a work queue - nobody is meant to action these - but the depth and the
-- age distribution are the honest measure of how well fully-automatic onboarding is working.
create or replace view public.v_supplier_exception_queue as
select l.id, l.company_name, l.claimed_by as supplier_email, l.emirate,
       l.licence_gate_reason as reason,
       l.exception_opened_at, l.exception_due_at,
       greatest(0, extract(day from (l.exception_due_at - now()))::int) as days_remaining,
       l.exception_reminders as reminders_sent,
       case when l.exception_due_at <= now() then 'overdue'
            when l.exception_due_at <= now() + interval '3 days' then 'closing_soon'
            else 'open' end as urgency
from public.leads l
where l.approval_status = 'action_required' and l.exception_closed_at is null
order by l.exception_due_at nulls first;

create or replace view public.v_supplier_exception_health as
select (select count(*) from public.v_supplier_exception_queue) as open_now,
       (select count(*) from public.v_supplier_exception_queue where urgency='overdue') as overdue,
       (select count(*) from public.v_supplier_exception_queue where urgency='closing_soon') as closing_within_3_days,
