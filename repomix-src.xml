<file path="supabase/migrations/20260729140842_rfq_category_required_field_gate.sql">
-- WHY: The founder's goal is zero back-and-forth — a supplier must be able to quote
-- from the RFQ alone. Until now the ONLY gate before broadcast was fn_rfq_score, which
-- scores 6 GENERIC fields and dispatches at >= 70. An inquiry with no quantity and no
-- timeline could therefore reach 70 and be broadcast, guaranteeing back-and-forth.
-- Meanwhile category_specs.fields already declares the per-trade REQUIRED fields, and
-- inquiry_intake computes readiness/missing against them — but purely advisorily.
-- This migration makes those per-category required fields a REAL gate: rfq_ready is now
-- true only when the generic score passes AND no category-required field is missing.
-- The generic score is kept intact; the requirement is added on top.
--
-- DEADLOCK SAFETY: the intake brief does NOT use category_specs field keys (a brief has
-- quantity/location/timeline/details{...}, the spec asks for quantity_size/location_floor/
-- item_type). A naive key-equality check would mark a 100%-complete brief as missing and
-- freeze it forever. The resolver below therefore accepts an answer found by (a) exact key,
-- (b) synonym/concept or shared-token key match anywhere in the flattened brief and the
-- inquiry columns, or (c) the free text naming one of the field's enumerated options.
-- A category with no category_specs row is NOT gated (falls back to generic behaviour).

-- Is a stored answer actually an answer?
create or replace function public._rfq_answered(v text)
returns boolean language sql immutable
set search_path to 'public','pg_temp'
as $ans$
  select v is not null
     and btrim(v) <> ''
     and btrim(v) not in ('[]','{}','-','?')
     and lower(btrim(v)) not in ('null','not sure','unknown','tbd','n/a','na');
$ans$;

-- Map a field key onto a coarse concept so brief keys and spec keys can meet.
-- NOTE: 'category' is deliberately NOT an 'item' synonym — category is always present,
-- so treating it as an answer would make item-type fields trivially satisfied.
create or replace function public._rfq_concept(k text)
returns text language sql immutable
set search_path to 'public','pg_temp'
as $con$
  select case
    when k ~ '(quantity|qty|size|sizes|dimension|dimensions|area|volume|units|linear|count)' then 'qty'
    when k ~ '(location|emirate|address|site|floor|region)'                                  then 'loc'
    when k ~ '(scope|supply_install|install)'                                                then 'scope'
    when k ~ '(timeline|schedule|duration|deadline|when)'                                    then 'time'
    when k ~ '(budget|price|cost)'                                                           then 'budget'
    when k ~ '(finish|material|fabric|fibre|colou?r)'                                        then 'material'
    when k ~ '(item|product|element|service)'                                                then 'item'
    else null end;
$con$;

-- THE GATE. For one inquiry: which of its category's REQUIRED fields are answered?
create or replace function public.fn_rfq_required_check(i public.inquiries)
returns jsonb language plpgsql stable security definer
set search_path to 'public','pg_temp'
as $chk$
declare
  spec_fields jsonb; f jsonb; bag jsonb := '{}'::jsonb; blob text;
  k text; v text; bk text; opt text; tok text;
  reqn int := 0; have text[] := '{}'; miss jsonb := '[]'::jsonb; found boolean;
begin
  select cs.fields into spec_fields
    from public.category_specs cs
   where lower(cs.category) = lower(coalesce(i.category,''))
   limit 1;

  -- No spec for this category -> do NOT gate it (unmapped categories stay dispatchable).
  if spec_fields is null or jsonb_typeof(spec_fields) <> 'array' then
    return jsonb_build_object('applicable', false, 'reason', 'no category_specs row',
      'category', i.category, 'required_ok', true,
      'required_total', 0, 'present', '[]'::jsonb, 'missing', '[]'::jsonb, 'checked_at', now());
  end if;

  -- (1) Flatten the intake brief / spec: top level plus one nested object level (brief.details).
  if i.spec is not null and jsonb_typeof(i.spec) = 'object' then
    for k, v in
      select e.key, case when jsonb_typeof(e.value) in ('object','array')
                         then e.value::text else coalesce(e.value #>> '{}','') end
        from jsonb_each(i.spec) e
    loop
      bag := bag || jsonb_build_object(lower(k), v);
    end loop;

    for k, v in
      select e2.key, case when jsonb_typeof(e2.value) in ('object','array')
                          then e2.value::text else coalesce(e2.value #>> '{}','') end
        from jsonb_each(i.spec) e1
        join lateral jsonb_each(case when jsonb_typeof(e1.value)='object'
                                     then e1.value else '{}'::jsonb end) e2 on true
    loop
      if not public._rfq_answered(bag->>lower(k)) then
        bag := bag || jsonb_build_object(lower(k), v);
      end if;
    end loop;
  end if;

  -- (2) Structured inquiry columns count as answers too.
  bag := bag
    || case when coalesce(i.emirate,'') <> '' then
            jsonb_build_object('emirate', i.emirate,
              'location', coalesce(nullif(bag->>'location',''), i.emirate)) else '{}'::jsonb end
    || case when coalesce(i.scope_type,'') <> '' then
            jsonb_build_object('scope', coalesce(nullif(bag->>'scope',''), i.scope_type)) else '{}'::jsonb end
    || case when coalesce(i.budget,'') <> '' then jsonb_build_object('budget', i.budget) else '{}'::jsonb end
    || case when coalesce(array_length(i.trades,1),0) > 0 then
            jsonb_build_object('trades', array_to_string(i.trades,', ')) else '{}'::jsonb end
    || case when coalesce(i.drawing_file_path,'') <> '' or i.boq is not null then
            jsonb_build_object('drawing','provided') else '{}'::jsonb end;

  -- (3) Free-text haystack, with the category's own words stripped out so that a field
  --     whose options happen to echo the category name is not trivially satisfied.
  blob := lower(concat_ws(' ', i.summary, i.raw_input, i.spec::text));
  foreach tok in array regexp_split_to_array(lower(coalesce(i.category,'')), '[^a-z0-9]+') loop
    if length(tok) >= 4 then blob := replace(blob, tok, ' '); end if;
  end loop;

  for f in select value from jsonb_array_elements(spec_fields)
            where coalesce((value->>'required')::boolean, false)
  loop
    k := lower(f->>'key'); reqn := reqn + 1; found := false;

    -- (a) exact key
    if public._rfq_answered(bag->>k) then found := true; end if;

    -- (b) concept synonym or shared significant token
    if not found then
      for bk in select key from jsonb_each_text(bag) loop
        if public._rfq_answered(bag->>bk) then
          if public._rfq_concept(k) is not null
             and public._rfq_concept(k) = public._rfq_concept(bk) then
            found := true;
          else
            foreach tok in array string_to_array(k,'_') loop
              if length(tok) >= 4 and (bk = tok or bk like '%'||tok||'%' or tok like '%'||bk||'%') then
                found := true;
              end if;
            end loop;
          end if;
        end if;
        exit when found;
      end loop;
    end if;

    -- (c) the free text names one of this field's enumerated options
    if not found and jsonb_typeof(f->'options') = 'array' then
      for opt in select lower(o) from jsonb_array_elements_text(f->'options') o loop
        foreach tok in array regexp_split_to_array(regexp_replace(opt,'[^a-z0-9 ]',' ','g'), '\s+') loop
          if length(tok) >= 4 and blob like '%'||tok||'%' then found := true; end if;
        end loop;
        exit when found;
      end loop;
    end if;

    if found then
      have := array_append(have, k);
    else
      miss := miss || jsonb_build_object('key', k, 'question', f->>'question', 'type', f->>'type');
    end if;
  end loop;

  return jsonb_build_object(
    'applicable', true, 'category', i.category,
    'required_total', reqn,
    'required_ok', (jsonb_array_length(miss) = 0),
    'present', to_jsonb(have),
    'missing', miss,
    'checked_at', now());
end $chk$;

-- Extend the score: generic scoring is UNCHANGED; the category requirement is added on top.
create or replace function public.fn_rfq_score(i public.inquiries)
returns jsonb language plpgsql stable
set search_path to 'public','pg_temp'
as $sc$
declare pts int:=0; miss text[]:='{}'; have text[]:='{}'; spectxt text;
        catchk jsonb; catmiss text[]:='{}'; m jsonb; gready boolean; catok boolean;
begin
  spectxt := coalesce(i.spec::text,'');
  if coalesce(i.category,'')<>'' then pts:=pts+20; have:=array_append(have,'category'); else miss:=array_append(miss,'category'); end if;
  if coalesce(i.emirate,'')<>'' then pts:=pts+10; have:=array_append(have,'emirate'); else miss:=array_append(miss,'emirate'); end if;
  if length(regexp_replace(spectxt,'[^a-zA-Z0-9]','','g')) > 20 then pts:=pts+25; have:=array_append(have,'scope_detail'); else miss:=array_append(miss,'scope_detail'); end if;
  if coalesce(i.scope_type,'')<>'' then pts:=pts+15; have:=array_append(have,'scope_type'); else miss:=array_append(miss,'scope_type'); end if;
  if i.budget is not null then pts:=pts+15; have:=array_append(have,'budget'); else miss:=array_append(miss,'budget'); end if;
  if coalesce(array_length(i.trades,1),0)>0 or coalesce(i.drawing_file_path,'')<>'' or i.boq is not null then
     pts:=pts+15; have:=array_append(have,'supporting_detail'); else miss:=array_append(miss,'supporting_detail'); end if;

  gready := pts >= 70;

  catchk := public.fn_rfq_required_check(i);
  catok  := coalesce((catchk->>'required_ok')::boolean, true);

  if coalesce((catchk->>'applicable')::boolean,false) then
    for m in select value from jsonb_array_elements(coalesce(catchk->'missing','[]'::jsonb)) loop
      catmiss := array_append(catmiss, coalesce(nullif(m->>'question',''), m->>'key'));
    end loop;
  end if;

  return jsonb_build_object(
    'score', pts,
    'generic_ready', gready,
    'category_required_ok', catok,
    'ready', (gready and catok),
    'have', to_jsonb(have),
    'missing', to_jsonb(miss || catmiss),
    'category_missing', coalesce(catchk->'missing','[]'::jsonb),
    'category_check', catchk,
    'scored_at', now());
end $sc$;

comment on function public.fn_rfq_required_check(public.inquiries) is
  'Per-category required-field gate. Resolves category_specs.fields[] where required=true against the inquiry brief/spec/columns by exact key, concept synonym, shared token, or enumerated option mentioned in free text. Returns required_ok + the missing list. Categories with no spec row are not gated.';
</file>

<file path="supabase/migrations/20260729141025_rfq_required_gate_keyless_field_safety.sql">
-- WHY (follow-up): zero-back-and-forth must never become zero-dispatch.
-- Two defects found while sweeping all 56 categories against the new gate:
--  1) 9 categories (solar, smart-home, swimming-pools, interior-design, it-networking,
--     epoxy-flooring, kitchens, marble-granite, roofing) declare required fields that have
--     a "question" but NO "key". They are unaddressable: no intake answer can ever be
--     stored against them, so gating on them would deadlock those categories forever.
--     They also made the function raise (FOREACH over a null array), which in a BEFORE
--     trigger would have blocked every insert for those categories.
--     Fix: keyless required fields are ADVISORY ONLY (surfaced, never blocking). Add a
--     "key" to those category_specs rows to promote them to real gates.
--  2) _rfq_concept matched "Emirate / area" to the quantity concept because 'area' was
--     tested before 'emirate'. Location is now tested first.

create or replace function public._rfq_concept(k text)
returns text language sql immutable
set search_path to 'public','pg_temp'
as $con$
  select case
    when k is null or btrim(k) = '' then null
    -- location first: "emirate / area" is a place, not a quantity
    when k ~ '(location|emirate|address|site|floor|region|area/|/area)' then 'loc'
    when k ~ '(quantity|qty|size|sizes|dimension|dimensions|area|volume|units|linear|count|sqm|sqft)' then 'qty'
    when k ~ '(scope|supply_install|install)'         then 'scope'
    when k ~ '(timeline|schedule|duration|deadline|when)' then 'time'
    when k ~ '(budget|price|cost)'                    then 'budget'
    when k ~ '(finish|material|fabric|fibre|colou?r)' then 'material'
    when k ~ '(item|product|element|service)'         then 'item'
    else null end;
$con$;

create or replace function public.fn_rfq_required_check(i public.inquiries)
returns jsonb language plpgsql stable security definer
set search_path to 'public','pg_temp'
as $chk$
declare
  spec_fields jsonb; f jsonb; bag jsonb := '{}'::jsonb; blob text;
  k text; v text; bk text; opt text; tok text; toks text[];
  reqn int := 0; have text[] := '{}';
  miss jsonb := '[]'::jsonb; advisory jsonb := '[]'::jsonb; found boolean;
begin
  select cs.fields into spec_fields
    from public.category_specs cs
   where lower(cs.category) = lower(coalesce(i.category,''))
   limit 1;

  if spec_fields is null or jsonb_typeof(spec_fields) <> 'array' then
    return jsonb_build_object('applicable', false, 'reason', 'no category_specs row',
      'category', i.category, 'required_ok', true, 'required_total', 0,
      'present','[]'::jsonb, 'missing','[]'::jsonb, 'advisory_missing','[]'::jsonb, 'checked_at', now());
  end if;

  if i.spec is not null and jsonb_typeof(i.spec) = 'object' then
    for k, v in
      select e.key, case when jsonb_typeof(e.value) in ('object','array')
                         then e.value::text else coalesce(e.value #>> '{}','') end
        from jsonb_each(i.spec) e
    loop
      bag := bag || jsonb_build_object(lower(k), v);
    end loop;

    for k, v in
      select e2.key, case when jsonb_typeof(e2.value) in ('object','array')
                          then e2.value::text else coalesce(e2.value #>> '{}','') end
        from jsonb_each(i.spec) e1
        join lateral jsonb_each(case when jsonb_typeof(e1.value)='object'
                                     then e1.value else '{}'::jsonb end) e2 on true
    loop
      if not public._rfq_answered(bag->>lower(k)) then
        bag := bag || jsonb_build_object(lower(k), v);
      end if;
    end loop;
  end if;

  bag := bag
    || case when coalesce(i.emirate,'') <> '' then
            jsonb_build_object('emirate', i.emirate,
              'location', coalesce(nullif(bag->>'location',''), i.emirate)) else '{}'::jsonb end
    || case when coalesce(i.scope_type,'') <> '' then
            jsonb_build_object('scope', coalesce(nullif(bag->>'scope',''), i.scope_type)) else '{}'::jsonb end
    || case when coalesce(i.budget,'') <> '' then jsonb_build_object('budget', i.budget) else '{}'::jsonb end
    || case when coalesce(array_length(i.trades,1),0) > 0 then
            jsonb_build_object('trades', array_to_string(i.trades,', ')) else '{}'::jsonb end
    || case when coalesce(i.drawing_file_path,'') <> '' or i.boq is not null then
            jsonb_build_object('drawing','provided') else '{}'::jsonb end;

  blob := lower(concat_ws(' ', i.summary, i.raw_input, i.spec::text));
  foreach tok in array coalesce(regexp_split_to_array(lower(coalesce(i.category,'')), '[^a-z0-9]+'), '{}'::text[]) loop
    if length(coalesce(tok,'')) >= 4 then blob := replace(blob, tok, ' '); end if;
  end loop;

  for f in select value from jsonb_array_elements(spec_fields)
            where coalesce((value->>'required')::boolean, false)
  loop
    k := nullif(btrim(lower(coalesce(f->>'key',''))), '');

    -- Keyless required field: unaddressable, so ADVISORY ONLY (never blocks dispatch).
    if k is null then
      advisory := advisory || jsonb_build_object(
        'question', f->>'question', 'reason', 'category_specs field has no key - cannot be gated');
      continue;
    end if;

    reqn := reqn + 1; found := false;

    if public._rfq_answered(bag->>k) then found := true; end if;

    if not found then
      for bk in select key from jsonb_each_text(bag) loop
        if public._rfq_answered(bag->>bk) then
          if public._rfq_concept(k) is not null
             and public._rfq_concept(k) = public._rfq_concept(bk) then
            found := true;
          else
            foreach tok in array coalesce(string_to_array(k,'_'), '{}'::text[]) loop
              if length(coalesce(tok,'')) >= 4
                 and (bk = tok or bk like '%'||tok||'%' or tok like '%'||bk||'%') then
                found := true;
              end if;
            end loop;
          end if;
        end if;
        exit when found;
      end loop;
    end if;

    if not found and jsonb_typeof(f->'options') = 'array' then
      for opt in select lower(o) from jsonb_array_elements_text(f->'options') o loop
        toks := coalesce(regexp_split_to_array(regexp_replace(coalesce(opt,''),'[^a-z0-9 ]',' ','g'), '\s+'), '{}'::text[]);
        foreach tok in array toks loop
          if length(coalesce(tok,'')) >= 4 and blob like '%'||tok||'%' then found := true; end if;
        end loop;
        exit when found;
      end loop;
    end if;

    if found then
      have := array_append(have, k);
    else
      miss := miss || jsonb_build_object('key', k, 'question', f->>'question', 'type', f->>'type');
    end if;
  end loop;

  return jsonb_build_object(
    'applicable', true, 'category', i.category,
    'required_total', reqn,
    'required_ok', (jsonb_array_length(miss) = 0),
    'present', to_jsonb(have),
    'missing', miss,
    'advisory_missing', advisory,
    'checked_at', now());
end $chk$;
</file>

<file path="supabase/migrations/20260729141449_durable_masking_on_inquiries.sql">
-- ANONYMITY MODEL (QuotesDone is an anonymous marketplace) -----------------------------------
-- A supplier must learn NOTHING identifying about a customer until the reveal fee is paid.
-- `quotes` already has a database-level backstop: BEFORE trigger trg_scrub_quote_contacts runs
-- scrub_quote_contacts(), which overwrites notes/scope/conditions/... IN PLACE with
-- public.mask_contacts(). That is safe for quotes because the raw contact string is the
-- supplier's own off-platform bypass attempt - nobody is entitled to see it, ever.
--
-- WHY INQUIRIES ARE NOT MIRRORED IN PLACE: an inquiry's free text is the CUSTOMER's own words.
-- Overwriting summary/spec/budget in place would (a) permanently destroy the customer's own view
-- of their own brief, and (b) destroy the very contact details the 3% reveal fee sells - after a
-- paid reveal supplier_api serves inquiries.summary/spec byte-identically from these same
-- columns, so an in-place mask makes the reveal flow return '[hidden]' forever. Masking here is
-- therefore NON-DESTRUCTIVE: the raw columns are untouched (customer view + reveal flow keep
-- working), and a masked shadow copy is maintained by the same trigger discipline and the SAME
-- public.mask_contacts() regexes, so a supplier-facing reader that forgets to scrub reads a
-- column that is already safe. Durability comes from the trigger, not from reader discipline.

alter table public.inquiries
  add column if not exists summary_masked      text,
  add column if not exists raw_input_masked    text,
  add column if not exists budget_masked       text,
  add column if not exists spec_masked         jsonb,
  add column if not exists boq_masked          jsonb,
  add column if not exists completeness_masked jsonb;

comment on column public.inquiries.summary_masked is
  'Supplier-safe copy of summary, maintained by trg_mask_inquiry_contact. Never write directly.';

-- Deep-mask for JSONB free text (spec / boq / completeness). Applies the EXISTING
-- public.mask_contacts() to every string leaf, so emails, URLs, messenger short links and UAE
-- phone numbers are removed by exactly the regexes already trusted on the quotes side. Numbers,
-- booleans and object KEYS are returned untouched, so BOQ quantities, prices and field names
-- are unaffected.
create or replace function public.mask_contacts_jsonb(j jsonb)
returns jsonb
language plpgsql
immutable
set search_path to 'public', 'pg_temp'
as $function$
declare r jsonb; k text; v jsonb; e jsonb;
begin
  if j is null then return j; end if;
  case jsonb_typeof(j)
    when 'string' then
      return to_jsonb(public.mask_contacts(j #>> '{}'));
    when 'object' then
      r := '{}'::jsonb;
      for k, v in select key, value from jsonb_each(j) loop
        r := r || jsonb_build_object(k, public.mask_contacts_jsonb(v));
      end loop;
      return r;
    when 'array' then
      r := '[]'::jsonb;
      for e in select value from jsonb_array_elements(j) loop
        r := r || jsonb_build_array(public.mask_contacts_jsonb(e));
      end loop;
      return r;
    else
      return j;
  end case;
end;
$function$;

-- Mirrors scrub_quote_contacts(): same BEFORE-trigger placement, same mask_contacts() call, same
-- founder_alerts warn row when something was actually masked (so an attempted off-platform
-- bypass is visible), same swallow-all exception guard so alerting can never block a write.
-- The only deliberate difference is destination: shadow columns instead of in place.
create or replace function public.scrub_inquiry_contacts()
returns trigger
language plpgsql
security definer
set search_path to 'public', 'pg_temp'
as $function$
declare changed boolean := false;
begin
  new.summary_masked      := public.mask_contacts(new.summary);
  new.raw_input_masked    := public.mask_contacts(new.raw_input);
  new.budget_masked       := public.mask_contacts(new.budget);
  new.spec_masked         := public.mask_contacts_jsonb(new.spec);
  new.boq_masked          := public.mask_contacts_jsonb(new.boq);
  new.completeness_masked := public.mask_contacts_jsonb(new.completeness);

  changed := (new.summary_masked      is distinct from new.summary)
          or (new.raw_input_masked    is distinct from new.raw_input)
          or (new.budget_masked       is distinct from new.budget)
          or (new.spec_masked         is distinct from new.spec)
          or (new.boq_masked          is distinct from new.boq)
          or (new.completeness_masked is distinct from new.completeness);

  if changed then
    begin
      insert into public.founder_alerts(level, event, detail, channel)
      values ('warn', 'inquiry_contact_masked',
              'Masked customer contact details in the supplier-facing copy of inquiry '||coalesce(new.id::text,'?')||' from customer '||coalesce(new.customer_id::text,'?')||'.',
              'system');
    exception when others then null; end;
  end if;
  return new;
end;
$function$;

-- Named to sort AFTER the existing BEFORE triggers enrich_inquiry and rfq_complete, so the
-- masked copy is taken from the final enriched values rather than the pre-enrichment ones.
drop trigger if exists trg_mask_inquiry_contact on public.inquiries;
create trigger trg_mask_inquiry_contact
  before insert or update on public.inquiries
  for each row execute function public.scrub_inquiry_contacts();

-- Supplier-facing read surface: the masked copies presented under the ORIGINAL column names, so
-- a reader that selects summary/spec/budget/boq from here cannot emit raw customer text even if
-- it forgets to scrub. security_invoker keeps the caller's RLS - this view adds no bypass.
create or replace view public.inquiries_supplier_safe
with (security_invoker = true) as
select
  i.id, i.category, i.emirate, i.role_needed, i.status, i.created_at,
  i.scope_type, i.trades, i.keywords, i.brief_source, i.urgency,
  i.boq_confidence, i.drawing_redacted_paths, i.outcome, i.hired_supplier_id,
  i.summary_masked      as summary,
  i.raw_input_masked    as raw_input,
  i.budget_masked       as budget,
  i.spec_masked         as spec,
  i.boq_masked          as boq,
  i.completeness_masked as completeness
from public.inquiries i;

comment on view public.inquiries_supplier_safe is
  'Anonymity model: pre-reveal supplier-facing reads of inquiries. Customer free text is served from the masked shadow columns. customer_id is deliberately absent - it would let a supplier correlate a buyer across RFQs.';

-- Backfill every existing row through the same trigger.
update public.inquiries set id = id;
</file>

<file path="supabase/migrations/20260729141515_supplier_documentation_scoreboard_view.sql">
-- WHY: The founder maintains a "scoreboard of how much documentation each supplier has shared",
-- but no per-supplier documentation score existed. supplier_score covers response/quality only, and
-- leads.capability_score is 0/20464 populated (dead column). The doc_reminder agent already nudges
-- suppliers but had no way to tell WHO is furthest behind.
-- WHY A VIEW, NOT A COLUMN: a stored column would need a trigger/cron to stay in sync with nine
-- different document path columns plus the documents table, and would silently go stale the moment
-- one of those write paths was missed. A view is recomputed on read and can never drift.
-- WEIGHTS (sum = 100): the trade licence is the mandatory document for a UAE supplier, so it carries
-- the single largest weight (30). An EXPIRED document scores zero for its item and is reported in
-- `missing` separately from a never-supplied one, matching how doc_reminder already phrases it.
create or replace view public.v_supplier_doc_score as
with docs as (
  -- Documents can arrive either as a path column on leads or as a row in public.documents
  -- (email-attachment extraction path). Either counts as "shared".
  select (d.ref_id)::bigint as lead_id,
         bool_or(d.kind = 'licence') as doc_licence,
         bool_or(d.kind = 'catalog') as doc_catalog,
         bool_or(d.kind = 'profile') as doc_profile,
         count(*)::int              as doc_rows
  from public.documents d
  where d.ref_table = 'leads' and d.ref_id ~ '^[0-9]+$'
  group by 1
),
f as (
  select
    l.id                          as lead_id,
    l.company_name,
    coalesce(nullif(btrim(l.claimed_by),''), nullif(btrim(l.email),'')) as contact_email,
    l.approval_status,
    coalesce(l.claimed,false)     as claimed,
    coalesce(l.banned,false)      as banned,
    l.lifecycle_stage,
    cc.name                       as primary_category,
    coalesce(dd.doc_rows,0)       as extracted_doc_rows,
    (coalesce(btrim(l.license_doc_path),'') <> '' or coalesce(dd.doc_licence,false))            as has_licence,
    (l.license_expiry is not null and l.license_expiry < current_date)                          as licence_expired,
    l.license_expiry,
    (coalesce(btrim(l.egr_doc_path),'') <> '')                                                  as has_egr,
    (coalesce(btrim(l.iban_doc_path),'') <> '')                                                 as has_iban,
    (coalesce(btrim(l.vat_doc_path),'') <> '')                                                  as has_vat_doc,
    (coalesce(btrim(l.trn),'') <> '' or coalesce(btrim(l.vat_number),'') <> '')                 as has_vat_no,
    (coalesce(btrim(l.insurance_doc_path),'') <> '')                                            as has_insurance,
    (l.insurance_expiry is not null and l.insurance_expiry < current_date)                      as insurance_expired,
    l.insurance_expiry,
    (coalesce(btrim(l.company_profile_doc_path),'') <> '' or coalesce(dd.doc_profile,false))    as has_profile,
    (coalesce(array_length(l.catalog_doc_paths,1),0) > 0 or coalesce(dd.doc_catalog,false))     as has_catalogue,
    (coalesce(btrim(l.iso_doc_path),'') <> '')                                                  as has_iso,
    (l.iso_expiry is not null and l.iso_expiry < current_date)                                  as iso_expired,
    (coalesce(btrim(l.manufacturer_auth_doc_path),'') <> '')                                    as has_mfa,
    (l.manufacturer_auth_expiry is not null and l.manufacturer_auth_expiry < current_date)      as mfa_expired,
    (coalesce(btrim(l.signed_terms_path),'') <> '')                                             as has_signed_terms
  from public.leads l
  left join docs dd on dd.lead_id = l.id
  left join public.lead_category lc on lc.lead_id = l.id and lc.is_primary
  left join public.catalog_supplier_categories cc on cc.slug = lc.slug
),
s as (
  select f.*,
    ( (case when f.has_licence   and not f.licence_expired   then 30 else 0 end)   -- mandatory, weighs most
    + (case when f.has_egr                                    then 12 else 0 end)
    + (case when f.has_iban                                   then 10 else 0 end)
    + (case when f.has_vat_doc then 10 when f.has_vat_no then 5 else 0 end)        -- certificate beats bare TRN
    + (case when f.has_insurance and not f.insurance_expired  then 10 else 0 end)
    + (case when f.has_profile                                then 10 else 0 end)
    + (case when f.has_catalogue                              then 10 else 0 end)
    + (case when f.has_iso and not f.iso_expired              then  5 else 0 end)
    + (case when f.has_mfa and not f.mfa_expired              then  3 else 0 end)
    )::int as score,
    array_remove(array[
      case when not f.has_licence then 'Trade licence (mandatory)'
           when f.licence_expired then 'Trade licence EXPIRED on '||f.license_expiry::text end,
      case when not f.has_egr        then 'Establishment card' end,
      case when not f.has_iban       then 'Bank IBAN letter' end,
      case when not f.has_vat_doc and not f.has_vat_no then 'VAT certificate / TRN'
           when not f.has_vat_doc                      then 'VAT certificate (TRN on file, document missing)' end,
      case when not f.has_insurance   then 'Insurance certificate'
           when f.insurance_expired   then 'Insurance certificate EXPIRED on '||f.insurance_expiry::text end,
      case when not f.has_profile    then 'Company profile' end,
      case when not f.has_catalogue  then 'Product catalogue' end,
      case when not f.has_iso        then 'ISO certificate'
           when f.iso_expired        then 'ISO certificate EXPIRED' end,
      case when not f.has_mfa        then 'Manufacturer authorisation'
           when f.mfa_expired        then 'Manufacturer authorisation EXPIRED' end,
      case when not f.has_signed_terms then 'Signed Terms & Conditions' end
    ], null) as missing
  from f
)
select
  s.lead_id, s.company_name, s.contact_email, s.primary_category,
  s.approval_status, s.claimed, s.banned, s.lifecycle_stage,
  s.score,
  case when s.score >= 85 then 'A' when s.score >= 70 then 'B'
       when s.score >= 50 then 'C' when s.score >= 25 then 'D' else 'F' end as grade,
  cardinality(s.missing) as missing_count,
  s.missing,
  s.has_licence, s.licence_expired, s.has_egr, s.has_iban,
  s.has_vat_doc, s.has_vat_no, s.has_insurance, s.insurance_expired,
  s.has_profile, s.has_catalogue, s.has_iso, s.has_mfa, s.has_signed_terms,
  s.extracted_doc_rows
from s;

comment on view public.v_supplier_doc_score is
  'Per-supplier documentation completeness, 0-100, recomputed on every read. Weights: trade licence 30 (mandatory), establishment card 12, bank IBAN 10, VAT certificate 10 (5 for TRN only), insurance 10, company profile 10, catalogue 10, ISO 5, manufacturer authorisation 3. Expired documents score 0 and are flagged in `missing`. Source of truth for doc_reminder targeting.';

grant select on public.v_supplier_doc_score to authenticated, service_role;
</file>

<file path="supabase/migrations/20260729141532_customer_master_tracker_view.sql">
-- WHY: The founder's "one main Excel that tracks all customer data (name, mobile, email, document
-- number of the signed T&Cs)" does not exist anywhere - a Dropbox search for xlsx/csv returned zero
-- hits. The per-customer folders and signed T&C PDFs DO exist under /QuotesDone Backup/Customers/,
-- but nothing indexes them. This view is the single tabular source that an export job can render to
-- CSV/XLSX; SQL itself cannot write a workbook.
-- Document number: customers has no explicit T&C document number column, so we derive a stable,
-- human-quotable reference from the customer UUID (QD-TC-XXXXXXXX). It matches the folder suffix
-- fn_enqueue_doc_backups already uses (left(c.id::text,8)), so a row here maps 1:1 to a Dropbox folder.
create or replace view public.v_customer_master as
select
  c.id                                                   as customer_id,
  c.full_name                                            as name,
  c.phone                                                as mobile,
  c.email                                                as email,
  case when coalesce(btrim(c.signed_terms_path),'') <> ''
       then 'QD-TC-' || upper(left(replace(c.id::text,'-',''), 8))
       else null end                                     as tc_document_no,
  c.signed_terms_path                                    as tc_document_path,
  c.signed_terms_url                                     as tc_document_url,
  c.tos_version                                          as tc_version,
  coalesce(c.signed_terms_at, c.tos_accepted_at)         as tc_accepted_at,
  c.tos_ip                                               as tc_accepted_ip,
  '/QuotesDone Backup/Customers/' || public.fn_dbx_safe(coalesce(c.full_name,'Customer'))
    || ' (' || left(c.id::text,8) || ')'                 as dropbox_folder,
  c.phone_verified,
  c.email_verified,
  c.created_at                                           as registered_at
from public.customers c
order by c.created_at desc nulls last;

comment on view public.v_customer_master is
  'Customer master tracker: name, mobile, email, signed T&C document number/path, accepted date and IP, plus the matching Dropbox folder. Intended as the source rowset for a CSV/XLSX export to Dropbox.';

grant select on public.v_customer_master to authenticated, service_role;
</file>

<file path="supabase/migrations/20260729141623_dropbox_category_folder_from_catalog_86.sql">
-- WHY: Supplier Dropbox folders are supposed to sit inside their category folder, one of the 86 in
-- public.catalog_supplier_categories. They did not. fn_enqueue_doc_backups derived the folder name as
--   fn_dbx_safe(coalesce(nullif(btrim(split_part(leads.categories,',',1)),''), nullif(leads.sector,''), 'Uncategorized'))
-- i.e. the first comma-separated token of leads.categories (free-text Yellow-Pages/Maps text such as
-- 'building material suppliers'), falling back to leads.sector (a legacy ~66-value enum, of which only
-- a handful appear among engaged suppliers). Neither is the catalog taxonomy: 0 of 20,464 leads have a
-- categories token that matches any catalog_supplier_categories.slug. That is why Dropbox grew ~18
-- legacy folders ('flooring', 'combined-mep', 'cctv-security') plus strays like 'Suppliers/dj zaino'
-- (a supplier whose free-text categories was its own trading name) and 'Uncategorized'.
-- FIX: derive from lead_category -> catalog_supplier_categories, which maps 12,566 leads onto 83 of
-- the 86 real categories via an is_primary row. Fall back to any non-primary catalog mapping, then to
-- an exact slug/name match on the legacy text, then 'Uncategorized'.
-- SAFETY: this only changes how NEW dropbox_path values are computed. doc_backups.dedupe_key does not
-- include the path and every insert is ON CONFLICT (dedupe_key) DO NOTHING, so already-enqueued and
-- already-uploaded rows keep their existing paths and nothing in Dropbox is moved, renamed or deleted.
create or replace function public.fn_dbx_category(p_lead_id bigint)
returns text
language sql
stable
set search_path to 'public', 'pg_catalog'
as $function$
  select public.fn_dbx_safe(coalesce(
    -- 1. the supplier's primary catalog category (the real 86-item taxonomy)
    (select c.name from public.lead_category lc
       join public.catalog_supplier_categories c on c.slug = lc.slug
      where lc.lead_id = p_lead_id and lc.is_primary
      order by lc.score desc nulls last limit 1),
    -- 2. any catalog category we managed to map, best score first
    (select c.name from public.lead_category lc
       join public.catalog_supplier_categories c on c.slug = lc.slug
      where lc.lead_id = p_lead_id
      order by lc.score desc nulls last limit 1),
    -- 3. legacy text, but only when it is literally a catalog slug or catalog name
    (select c.name from public.leads l
       join public.catalog_supplier_categories c
         on c.slug = btrim(split_part(coalesce(l.categories,''),',',1))
         or lower(c.name) = lower(btrim(split_part(coalesce(l.categories,''),',',1)))
         or c.slug = btrim(coalesce(l.sector,''))
      where l.id = p_lead_id limit 1),
    'Uncategorized'));
$function$;

comment on function public.fn_dbx_category(bigint) is
  'Resolves the Dropbox category folder name for a supplier from catalog_supplier_categories (the 86 real categories) via lead_category. Replaces the legacy leads.categories/leads.sector free-text derivation. Used by fn_enqueue_doc_backups for NEW backup paths only.';

create or replace function public.fn_enqueue_doc_backups()
 returns integer
 language plpgsql
 security definer
 set search_path to 'public', 'pg_catalog'
as $function$
declare n integer := 0; m integer;
begin
  with s as (
    select l.*,
      '/QuotesDone Backup/Suppliers/'
        || public.fn_dbx_category(l.id)
        || '/' || fn_dbx_safe(coalesce(l.company_name,'Supplier')) || ' (' || l.id || ')/' as base
    from public.leads l
    where l.approved_at is not null or l.registration_submitted_at is not null
       or l.signed_terms_path is not null or l.company_profile_doc_path is not null
       or l.license_doc_path is not null or coalesce(l.claimed,false)
  ),
  sd as (
    select s.id, s.base, v.doc_type, v.bucket, v.path
    from s cross join lateral (values
      ('Trade licence','supplier-docs', s.license_doc_path),
      ('Bank IBAN','supplier-docs', s.iban_doc_path),
      ('Establishment card','supplier-docs', s.egr_doc_path),
      ('Insurance','supplier-docs', s.insurance_doc_path),
      ('VAT certificate','supplier-docs', s.vat_doc_path),
      ('ISO certificate','supplier-docs', s.iso_doc_path),
      ('Manufacturer authorization','supplier-docs', s.manufacturer_auth_doc_path),
      ('Company profile','supplier-docs', s.company_profile_doc_path),
      ('Signed Terms & Conditions','signed-terms', s.signed_terms_path)
    ) v(doc_type,bucket,path)
    where v.path is not null and length(v.path)>0
  )
  insert into public.doc_backups(entity,entity_id,doc_type,bucket,path,file_name,dropbox_path,source,dedupe_key)
  select 'supplier', sd.id::text, sd.doc_type, sd.bucket, sd.path,
         regexp_replace(sd.path,'^.*/',''),
         sd.base || sd.doc_type || ' - ' || regexp_replace(sd.path,'^.*/',''),
         'storage', 'S:'||sd.id||':'||sd.doc_type||':'||sd.path
  from sd on conflict (dedupe_key) do nothing;
  get diagnostics m = row_count; n := n + m;

  insert into public.doc_backups(entity,entity_id,doc_type,bucket,path,file_name,dropbox_path,source,dedupe_key)
  select 'supplier', s.id::text, 'Catalogue', 'supplier-docs', cat,
         regexp_replace(cat,'^.*/',''), s.base || 'Catalogue - ' || regexp_replace(cat,'^.*/',''),
         'storage', 'S:'||s.id||':cat:'||cat
  from ( select l.id,
      '/QuotesDone Backup/Suppliers/'
        || public.fn_dbx_category(l.id)
        || '/' || fn_dbx_safe(coalesce(l.company_name,'Supplier')) || ' (' || l.id || ')/' as base, l.catalog_doc_paths
    from public.leads l
    where (l.approved_at is not null or l.registration_submitted_at is not null
       or l.signed_terms_path is not null or l.company_profile_doc_path is not null
       or l.license_doc_path is not null or coalesce(l.claimed,false)) and l.catalog_doc_paths is not null ) s,
    unnest(s.catalog_doc_paths) cat
  where cat is not null and length(cat)>0 on conflict (dedupe_key) do nothing;
  get diagnostics m = row_count; n := n + m;

  insert into public.doc_backups(entity,entity_id,doc_type,source,gen_kind,gen_ref,dropbox_path,dedupe_key)
  select 'supplier', s.id::text, 'Company Details','generated','supplier_details', s.id::text,
         s.base || 'Company Details.pdf', 'S:'||s.id||':details'
  from ( select l.id,
      '/QuotesDone Backup/Suppliers/'
        || public.fn_dbx_category(l.id)
        || '/' || fn_dbx_safe(coalesce(l.company_name,'Supplier')) || ' (' || l.id || ')/' as base
    from public.leads l
    where l.approved_at is not null or l.registration_submitted_at is not null
       or l.signed_terms_path is not null or l.company_profile_doc_path is not null
       or l.license_doc_path is not null or coalesce(l.claimed,false) ) s
  on conflict (dedupe_key) do nothing;
  get diagnostics m = row_count; n := n + m;

  insert into public.doc_backups(entity,entity_id,doc_type,bucket,path,file_name,dropbox_path,source,dedupe_key)
  select 'customer', c.id::text, 'Signed Terms & Conditions','signed-terms', c.signed_terms_path,
         regexp_replace(c.signed_terms_path,'^.*/',''),
         '/QuotesDone Backup/Customers/'||fn_dbx_safe(coalesce(c.full_name,'Customer'))||' ('||left(c.id::text,8)||')/Signed Terms & Conditions - '||regexp_replace(c.signed_terms_path,'^.*/',''),
         'storage', 'C:'||c.id||':terms:'||c.signed_terms_path
  from public.customers c where c.signed_terms_path is not null and length(c.signed_terms_path)>0
  on conflict (dedupe_key) do nothing;
  get diagnostics m = row_count; n := n + m;

  insert into public.doc_backups(entity,entity_id,doc_type,source,gen_kind,gen_ref,dropbox_path,dedupe_key)
  select 'customer', c.id::text, 'Customer Details','generated','customer_details', c.id::text,
         '/QuotesDone Backup/Customers/'||fn_dbx_safe(coalesce(c.full_name,'Customer'))||' ('||left(c.id::text,8)||')/Customer Details.pdf',
         'C:'||c.id||':details'
  from public.customers c on conflict (dedupe_key) do nothing;
  get diagnostics m = row_count; n := n + m;

  insert into public.doc_backups(entity,entity_id,doc_type,bucket,path,file_name,dropbox_path,source,dedupe_key)
  select 'inquiry', i.id::text, 'RFQ drawing','drawing-files', i.drawing_file_path,
         coalesce(i.drawing_file_name, regexp_replace(i.drawing_file_path,'^.*/','')),
         '/QuotesDone Backup/Customers/'||fn_dbx_safe(coalesce(c.full_name,'Customer'))||' ('||left(c.id::text,8)||')/Inquiries/'
           || to_char(i.created_at,'YYYY-MM-DD')||' '||left(i.id::text,8)||' - '||fn_dbx_safe(coalesce(i.status,'inquiry'))
           || '/Drawing - '||coalesce(i.drawing_file_name, regexp_replace(i.drawing_file_path,'^.*/','')),
         'storage', 'I:'||i.id||':drawing:'||i.drawing_file_path
  from public.inquiries i join public.customers c on c.id=i.customer_id
  where i.drawing_file_path is not null and length(i.drawing_file_path)>0
  on conflict (dedupe_key) do nothing;
  get diagnostics m = row_count; n := n + m;

  insert into public.doc_backups(entity,entity_id,doc_type,source,gen_kind,gen_ref,dropbox_path,dedupe_key)
  select 'inquiry', i.id::text, 'Inquiry Summary','generated','inquiry_summary', i.id::text,
         '/QuotesDone Backup/Customers/'||fn_dbx_safe(coalesce(c.full_name,'Customer'))||' ('||left(c.id::text,8)||')/Inquiries/'
           || to_char(i.created_at,'YYYY-MM-DD')||' '||left(i.id::text,8)||' - '||fn_dbx_safe(coalesce(i.status,'inquiry'))
           || '/Inquiry Summary.pdf', 'I:'||i.id||':summary'
  from public.inquiries i join public.customers c on c.id=i.customer_id
  on conflict (dedupe_key) do nothing;
  get diagnostics m = row_count; n := n + m;

  -- Quote comparison reports: one PDF per distinct quote-set (>=2 live quotes). Anonymized A/B/C.
  insert into public.doc_backups(entity,entity_id,doc_type,source,gen_kind,gen_ref,dropbox_path,dedupe_key)
  select 'inquiry', i.id::text, 'Quote Comparison','generated','comparison', i.id::text,
         '/QuotesDone Backup/Customers/'||fn_dbx_safe(coalesce(c.full_name,'Customer'))||' ('||left(c.id::text,8)||')/Inquiries/'
           || to_char(i.created_at,'YYYY-MM-DD')||' '||left(i.id::text,8)||' - '||fn_dbx_safe(coalesce(i.status,'inquiry'))
           || '/Quote Comparison Report '||to_char(now(),'YYYY-MM-DD')||' '||left(sig.sig,8)||'.pdf',
         'CMP:'||i.id||':'||sig.sig
  from public.inquiries i
  join public.customers c on c.id=i.customer_id
  join lateral ( select md5(coalesce(string_agg(q.quote_amount::text||':'||coalesce(q.status,''),'|' order by q.quote_amount),'')) as sig,
                        count(*) as nq
                 from public.quotes q where q.inquiry_id=i.id and q.status<>'draft' ) sig on true
  where sig.nq >= 2
  on conflict (dedupe_key) do nothing;
  get diagnostics m = row_count; n := n + m;

  return n;
end $function$;
</file>

<file path="supabase/migrations/20260802112720_drawing_redaction_runs_provenance.sql">
-- ANONYMITY / REDACTION PROVENANCE (2 Aug 2026, external security review).
-- WHY: QuotesDone sells anonymity - a supplier must not learn who the buyer is until the reveal
-- fee is paid. supplier_api hands matched suppliers a SIGNED URL for every entry in
-- inquiries.drawing_redacted_paths, and it signs ANY object path in the 'drawing-files' bucket.
-- The customer's ORIGINAL, unredacted upload lives in that SAME bucket
-- (drawings/<customer_id>/<ts>_<name>, customer_api storeOriginal), while redacted pages live at
-- redacted/<uuid>/page_pN.jpg. Until now create_inquiry copied drawing.drawing_redacted_paths
-- straight out of the REQUEST BODY into that column, so a modified or buggy frontend could name
-- the original (title block: client name, address, contacts, project number) and every matched
-- supplier would receive it for free, pre-reveal.
-- This table makes redaction output server-owned: drawing_redact writes one row per run, and
-- create_inquiry may only attach paths it can find in a row belonging to the calling customer.
-- It also records pages_in/pages_out so a PARTIAL redaction can be refused instead of silently
-- shipping the pages that happened to succeed.
create table if not exists public.drawing_redaction_runs (
  id           uuid primary key default gen_random_uuid(),
  created_at   timestamptz not null default now(),
  customer_id  uuid references public.customers(id) on delete set null,
  owner_email  text,
  -- raw prefix the caller asked for. drawing_redact deliberately discards the identifying part
  -- when building storage paths; it is kept here (server-side only) so runs made by callers that
  -- do not know customers.id - attach_photos, which is authenticated as the auth user and sends
  -- refphoto/<auth-user-id>/<ts> - can still be attributed to their owner.
  caller_ref   text,
  source_path  text,
  output_paths text[] not null default '{}'::text[],
  pages_in     integer not null default 0,
  pages_out    integer not null default 0,
  skipped      integer not null default 0,
  status       text not null default 'unknown'
);
create index if not exists drawing_redaction_runs_customer_idx on public.drawing_redaction_runs (customer_id, created_at desc);
create index if not exists drawing_redaction_runs_caller_ref_idx on public.drawing_redaction_runs (caller_ref text_pattern_ops);
create index if not exists drawing_redaction_runs_outputs_idx on public.drawing_redaction_runs using gin (output_paths);
-- Service role only: this table maps buyers to object paths, which is exactly what the anonymity
-- model protects. No policies are defined, so anon/authenticated keys can read nothing.
alter table public.drawing_redaction_runs enable row level security;
revoke all on public.drawing_redaction_runs from anon, authenticated;
</file>

<file path="supabase/migrations/20260802115311_supplier_terms_remove_commission_align_fees_v5.sql">
-- LEGAL CONSISTENCY (2 Aug 2026, external code review + founder correction).
-- WHY: the signed Supplier Agreement in app_secrets.supplier_terms_html still ran a 2% COMMISSION
-- model. Clause 7 had already been rewritten to say no commission is charged, but the definitions,
-- the payment-terms clause, the late-payment clause, the non-circumvention clause, the privacy
-- clause, the termination clause and the general-fees clause were all left behind, so the document
-- contradicted itself, contradicted the public website ("no commission, ever") and contradicted
-- app_secrets.supplier_subscription_term. It also stated the CUSTOMER reveal fee as 2% when
-- pricing_config has held 3% (standard and promo) throughout. This is the document suppliers
-- electronically sign and that compliance_archive renders into a PDF certificate, so an internal
-- contradiction here is a live legal exposure, not a typo. Version bumped 4 -> 5 because the
-- commercial terms have materially changed.
-- Safe to apply: zero suppliers have signed to date (leads.accepted_terms_at is null everywhere),
-- so no existing acceptance is being retro-changed.

update app_secrets set value = regexp_replace(value,
  '<li><b>Commission</b>[^<]*</li>',
  '<li><b>Subscription Fee</b> &mdash; the annual supplier subscription fee described in clause 6.</li>')
where key = 'supplier_terms_html';

update app_secrets set value = regexp_replace(value,
  '<h2>6\. Registration fees</h2>.*?</p>',
  '<h2>6. Registration &amp; subscription fees</h2><p>Supplier registration is <b>free of charge until 31 July 2027</b>. From <b>1 August 2027</b> a subscription fee of <b>AED 1,000 per year</b> applies, payable annually in advance. The <b>first 1,000 businesses to register</b> on the Platform are permanently exempt from that fee. QuotesDone will give at least 30 days&#39; notice and seek re-confirmation of acceptance before introducing or varying the fee, as set out in the Amendments section; continued use of the Platform after the effective date constitutes acceptance. The subscription fee, once paid, is non-refundable except as expressly stated at the time.</p>')
where key = 'supplier_terms_html';

update app_secrets set value = regexp_replace(value,
  '<h2>7\. Platform commission</h2>.*?</p>',
