<file path="scripts/record_migration.mjs">
// Record an already-executed statement in supabase_migrations.schema_migrations so the applied
// record and the repository stay in step. This is what `supabase db push` does; the Management API
// executes SQL without recording it, so recording is a separate, explicit act.
//
//   node scripts/record_migration.mjs <version> <name> <path-to-sql>
//
// Prints the version, name, SHA-256 and character count of what was recorded, in the same form the
// recovery manifests use, so the manifest entry can be written from real values.
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { homedir } from 'node:os';

const PROJECT_REF = 'htdblwldjkcgjvmqkbeh';
const [version, name, file] = process.argv.slice(2);
if (!version || !name || !file) {
  console.error('usage: node scripts/record_migration.mjs <version> <name> <file.sql>'); process.exit(2);
}
if (!/^\d{14}$/.test(version)) { console.error('version must be 14 digits'); process.exit(2); }

function token() {
  if (process.env.SUPABASE_ACCESS_TOKEN) return process.env.SUPABASE_ACCESS_TOKEN.trim();
  const p = join(homedir(), '.supabase', 'access-token');
  if (existsSync(p)) return readFileSync(p, 'utf8').trim();
  console.error('No Supabase access token.'); process.exit(2);
}

const body = readFileSync(file, 'utf8');
const tag = `$mig_${version}$`;
if (body.includes(tag)) { console.error('dollar-quote tag collides with the body'); process.exit(2); }

async function run(query) {
  const res = await fetch(`https://api.supabase.com/v1/projects/${PROJECT_REF}/database/query`, {
    method: 'POST',
    headers: { Authorization: `Bearer ${token()}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({ query }),
  });
  const text = await res.text();
  if (!res.ok) { console.error(`Management API ${res.status}: ${text}`); process.exit(3); }
  return JSON.parse(text);
}

await run(`insert into supabase_migrations.schema_migrations (version, name, statements)
           values ('${version}', '${name}', array[${tag}${body}${tag}])
           on conflict (version) do nothing`);

const rows = await run(`select version, name, array_length(statements,1) as n,
       encode(extensions.digest(array_to_string(statements, E';\\n') || ';', 'sha256'),'hex') as sha,
       length(array_to_string(statements, E';\\n')) as chars
  from supabase_migrations.schema_migrations where version = '${version}'`);
if (rows.length !== 1) { console.error('not recorded'); process.exit(1); }
const r = rows[0];
console.log(`| ${r.version} | ${r.name} | \`${r.sha}\` | ${Number(r.chars).toLocaleString('en-US')} |`);
console.log(`statements array length: ${r.n}`);
</file>

<file path="scripts/recover_one.mjs">
// Recover one applied migration verbatim, verified against a committed manifest.
//
//   node scripts/recover_one.mjs <version>
//
// The expected name and SHA-256 are read from the manifests in supabase/migrations/, which are
// committed before this runs. The file is written as <applied version>_<name>.sql so that the
// filename IS the applied version: `supabase db push` then sees it as already applied instead of
// treating it as new work to run.
import { readFileSync, writeFileSync, readdirSync, existsSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { join } from 'node:path';
import { homedir } from 'node:os';

const PROJECT_REF = 'htdblwldjkcgjvmqkbeh';
const MIG = join(process.cwd(), 'supabase', 'migrations');
const version = process.argv[2];
if (!/^\d{14}$/.test(version || '')) { console.error('usage: node scripts/recover_one.mjs <14-digit version>'); process.exit(2); }

const expected = readdirSync(MIG).filter(f => f.endsWith('.md'))
  .flatMap(f => readFileSync(join(MIG, f), 'utf8').split('\n'))
  .map(l => l.match(/^\|\s*\d+\s*\|\s*(\d{14})\s*\|\s*([a-z0-9_]+)\s*\|\s*`([0-9a-f]{64})`/))
  .filter(Boolean).map(m => ({ version: m[1], name: m[2], sha: m[3] }))
  .find(e => e.version === version);
if (!expected) { console.error(`${version} is not in any committed manifest. Add it there first.`); process.exit(2); }

function token() {
  if (process.env.SUPABASE_ACCESS_TOKEN) return process.env.SUPABASE_ACCESS_TOKEN.trim();
  const p = join(homedir(), '.supabase', 'access-token');
  if (existsSync(p)) return readFileSync(p, 'utf8').trim();
  console.error('No Supabase access token.'); process.exit(2);
}

const res = await fetch(`https://api.supabase.com/v1/projects/${PROJECT_REF}/database/query`, {
  method: 'POST',
  headers: { Authorization: `Bearer ${token()}`, 'Content-Type': 'application/json' },
  body: JSON.stringify({
    query: `select version, name, array_to_string(statements, E';\\n') || ';' as sql
              from supabase_migrations.schema_migrations where version = '${version}'`,
  }),
});
if (!res.ok) { console.error(`Management API ${res.status}: ${await res.text()}`); process.exit(3); }
const [row] = await res.json();
if (!row) { console.error(`${version} is not applied in production`); process.exit(1); }
if (row.name !== expected.name) { console.error(`DRIFT: production name ${row.name}, manifest ${expected.name}`); process.exit(1); }

const sha = createHash('sha256').update(row.sql, 'utf8').digest('hex');
if (sha !== expected.sha) { console.error(`DRIFT: hashes ${sha}, manifest says ${expected.sha}`); process.exit(1); }

const file = `${row.version}_${row.name}.sql`;
const header =
  `-- P2-C1 - recovered verbatim from supabase_migrations.schema_migrations.\n` +
  `-- Applied version: ${row.version}   name: ${row.name}\n` +
  `-- SHA-256 of the applied SQL: ${sha}\n` +
  `-- Recovered by scripts/recover_one.mjs against the manifest committed beforehand.\n` +
  `-- The body below is byte-for-byte as applied; only this header was added, and it is\n` +
  `-- excluded from the checksum.\n\n`;
writeFileSync(join(MIG, file), header + row.sql, 'utf8');
console.log(`${file}  ${sha}  ${row.sql.length} chars  - matches the manifest.`);
</file>

<file path="scripts/rename_recovered_to_applied_version.mjs">
// The recovered files were first written with a repository sequence number
// (2026080222NN / 2026080223NN) rather than their applied version. Two problems:
//
//   1. Filename order was inverted against applied order - Stage B.6 (22NN) sorted before
//      Stage A/B/B.5 (23NN), which is the reverse of how they ran.
//   2. Those names are 12 digits, not 14, and none of them exists in schema_migrations. A
//      `supabase db push` would therefore treat all 44 as NEW migrations and try to apply an
//      already-applied Stage A on top of itself.
//
// Renaming each file to <applied version>_<name>.sql fixes both: order becomes applied order, and
// push sees them as already applied. The applied version is read from each file's own header, so
// the rename cannot invent one.
import { readFileSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import { execFileSync } from 'node:child_process';

const MIG = join(process.cwd(), 'supabase', 'migrations');
const files = readdirSync(MIG).filter(f => /^2026080222\d{2}_|^2026080223\d{2}_/.test(f) && f.endsWith('.sql')).sort();
let n = 0;
for (const f of files) {
  const raw = readFileSync(join(MIG, f), 'utf8');
  const m = raw.match(/^-- Applied version: (\d{14})   name: ([a-z0-9_]+)$/m);
  if (!m) { console.error(`${f}: no applied-version header, refusing to rename`); process.exit(1); }
  const target = `${m[1]}_${m[2]}.sql`;
  if (target === f) continue;
  execFileSync('git', ['mv', `supabase/migrations/${f}`, `supabase/migrations/${target}`], { stdio: 'inherit' });
  n++;
}
console.log(`renamed ${n} of ${files.length}`);
</file>

<file path="scripts/sync_migrations_from_prod.js">
// Bring migrations that were applied through the Supabase management API back into the repository.
//
// Why this exists: every drift incident on this project has the same root - SQL applied from a tool
// rather than from a checkout, so production knows something the repo does not. `supabase functions
// download` already closes that gap for edge functions; this closes it for migrations.
//
// Usage:  node scripts/sync_migrations_from_prod.js <kb_import_token> [sinceVersion]
// The token is passed on the command line deliberately: it is a single-purpose, disposable
// credential for kb_corpus_import, never the service-role key, and it is not stored in this file.
const fs = require('fs');
const path = require('path');

const TOKEN = process.argv[2];
const SINCE = process.argv[3] || '20260802000000';
const URL = 'https://htdblwldjkcgjvmqkbeh.supabase.co/functions/v1/kb_corpus_import';
const OUT = path.join(__dirname, '..', 'supabase', 'migrations');

if (!TOKEN) {
  console.error('usage: node scripts/sync_migrations_from_prod.js <kb_import_token> [sinceVersion]');
  process.exit(1);
}

(async () => {
  const res = await fetch(URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ __token: TOKEN, action: 'dump_migrations', since: SINCE }),
  });
  const j = await res.json();
  if (!j.ok) { console.error('failed:', JSON.stringify(j).slice(0, 500)); process.exit(1); }

  let written = 0, skipped = 0;
  for (const m of j.migrations) {
    const file = path.join(OUT, `${m.version}_${m.name}.sql`);
    if (fs.existsSync(file) && fs.readFileSync(file, 'utf8').trim() === String(m.sql).trim()) { skipped++; continue; }
    fs.writeFileSync(file, m.sql.endsWith('\n') ? m.sql : m.sql + '\n', 'utf8');
    console.log('wrote', path.basename(file));
    written++;
  }
  console.log(`\n${j.migrations.length} migrations since ${SINCE}: ${written} written, ${skipped} already current`);
})();
</file>

<file path="scripts/verify_migrations_in_repo.mjs">
// Confirm every migration applied to the database has a file in supabase/migrations/.
// Matching is by NAME, because the repo assigns its own timestamps.
//   node scripts/verify_migrations_in_repo.mjs
import { readdirSync, readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { homedir } from 'node:os';

const PROJECT_REF = 'htdblwldjkcgjvmqkbeh';
const tok = process.env.SUPABASE_ACCESS_TOKEN?.trim()
  ?? readFileSync(join(homedir(), '.supabase', 'access-token'), 'utf8').trim();

const res = await fetch(`https://api.supabase.com/v1/projects/${PROJECT_REF}/database/query`, {
  method: 'POST',
  headers: { Authorization: `Bearer ${tok}`, 'Content-Type': 'application/json' },
  body: JSON.stringify({ query: `select version, name from supabase_migrations.schema_migrations order by version` }),
});
if (!res.ok) { console.error(await res.text()); process.exit(3); }
const applied = await res.json();

const dir = join(process.cwd(), 'supabase', 'migrations');
const files = readdirSync(dir).filter(f => f.endsWith('.sql'));
const fileNames = new Set(files.map(f => f.replace(/^\d+_/, '').replace(/\.sql$/, '')));

const missing = applied.filter(m => !fileNames.has(m.name));
console.log(`applied migrations: ${applied.length}`);
console.log(`repo migration files: ${files.length}`);
console.log(`applied but NOT in repo: ${missing.length}`);
for (const m of missing) console.log(`  MISSING  ${m.version}  ${m.name}`);

// Everything from the Phase 2 work must be present; older history predates this repo convention.
const p2Missing = missing.filter(m => /^(p2_|p1|p2_c1|ops_|kb_)/.test(m.name) && m.version >= '20260802112720');
console.log(`\nphase-2-era applied but not in repo: ${p2Missing.length}`);
for (const m of p2Missing) console.log(`  MISSING  ${m.version}  ${m.name}`);
process.exit(p2Missing.length === 0 ? 0 : 1);
</file>

