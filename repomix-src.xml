<file path="supabase/migrations/20260802120922_founder_decisions_2026_08_02_no_manual_approval_currency_inbox.sql">
-- FOUNDER DECISIONS, 2 Aug 2026, taken in response to the external code review.
-- Three questions the reviewer correctly identified as unanswerable from the code, answered.

-- ---------------------------------------------------------------------------------------------
-- 1. NO MANUAL APPROVAL PATH for supplier registration.
-- The code contained two contradictory ideas: auto-approve when the licence reads, and an implicit
-- human queue ('pending') when it does not. Founder chose fully automatic. A failed licence gate is
-- now a refusal the supplier can fix themselves, not a ticket. This column carries the reason so
-- the portal and the email can name the exact problem instead of saying "pending".
alter table public.leads add column if not exists licence_gate_reason text;
comment on column public.leads.licence_gate_reason is
  'Why automatic approval refused this supplier (no_licence | licence_expired). Null once approved. Set by supplier_api; cleared automatically when a readable, in-date licence is uploaded. There is no human approval queue - this is what the supplier is told to fix.';

-- Retire the human queue that the old behaviour created. These rows asked a person to chase a
-- supplier; under the new policy the supplier is emailed directly and self-serves, so leaving them
-- as needs_review would keep a queue alive that nobody is meant to work.
update public.agent_actions set status = 'logged'
where kind = 'supplier_licence_gate' and status = 'needs_review';

-- ---------------------------------------------------------------------------------------------
-- 2. THE SUPPLIER SUBSCRIPTION FEE IS IN AED. The reviewer flagged that pricing_config carried the
-- number 1000 with NO currency column at all, while the founder's written spec said EUR 1,000 and
-- everything actually built (public site, supplier agreement, supplier_subscription_term) said AED
-- 1,000. Founder confirmed AED. Made explicit so it can never be ambiguous again - a 4x pricing
-- error is not something that should depend on which document you happen to read.
alter table public.pricing_config add column if not exists supplier_reg_currency text not null default 'AED';
alter table public.pricing_config add column if not exists reveal_currency text not null default 'AED';
update public.pricing_config set supplier_reg_currency = 'AED', reveal_currency = 'AED' where id = 1;
comment on column public.pricing_config.supplier_reg_currency is
  'Currency of supplier_reg_fee. Confirmed AED by the founder on 2 Aug 2026. Stripe checkout, the Supplier Agreement, the public supplier page and the accounting entries must all agree with this value.';

-- ---------------------------------------------------------------------------------------------
-- 3. THE COMMAND CENTER IS AN OPERATIONAL CONSOLE, and the dashboard should say so honestly.
-- The reviewer was right that it is not monitoring-only. Founder chose to keep the capability but
-- to stop the dashboard implying he is a bottleneck. The data-side half of that is this split:
-- what genuinely BLOCKS the company vs what is merely available to him.
-- Blocking = money, destruction, credentials, external legal acts, third-party bans - the classes
-- deliberately left gated in the 29 Jul autonomy re-tiering. Everything else is work the company
-- is supposed to be doing itself, and its presence here is a bug in automation, not a decision.
create or replace view public.v_founder_inbox as
select a.id, a.created_at, a.agent, a.kind, a.risk, a.title, a.recommendation,
       a.target_table, a.target_id,
       case
         when a.kind in ('payment_approval','purchase_order','refund_decision','credential_change',
                         'legal_flag','security_incident','supplier_ban','data_deletion')
           then 'blocking'
         else 'automation_gap'
       end as bucket
from public.agent_actions a
where a.status = 'needs_review';

comment on view public.v_founder_inbox is
  'Splits the founder queue in two. bucket=blocking: money, destruction, credentials, legal, security - genuinely his call, deliberately gated. bucket=automation_gap: work the company should be doing unattended that has no executor yet, so it silently landed on him. The second number is the honest measure of how far from unattended we actually are; it should trend to zero, and it is a bug list, not a to-do list.';
</file>

<file path="supabase/migrations/20260802122010_kb_corpus_staging_schema_2026_08_02.sql">
-- QuotesDone knowledge-corpus staging schema (2 Aug 2026).
-- Source: QuotesDone_ALL_KNOWLEDGE_86_CATEGORIES_v2026.07.31 + the supplied ingestion control pack.
--
-- WHY A SEPARATE SCHEMA. The control pack is explicit: ingest into staging, do not replace the live
-- category router until the crosswalk has been reviewed. public.agent_knowledge (1,844 rows) and
-- public.kb_chunks (4,886 rows) are what the company answers from TODAY; dropping 115,000 unreviewed
-- records into them would silently change every answer the platform gives, with no way back. So the
-- corpus lands here, intact and versioned, and promotion into the live tables is a separate,
-- reviewable step per category. Rollback is 'delete where ingestion_run_id = ...', not a restore.
--
-- WHAT IS DELIBERATELY NOT STORED. The supplied staging schema carries a `raw jsonb` copy of every
-- row. Every field of that row is already columnised below, so `raw` would double 174 MB of JSONL
-- for no read path. Dropped on records (kept on the small taxonomy tables, where it is cheap and
-- occasionally useful). 02_category_master.md (119 MB of narrative across the 67 packages) is NOT
-- imported at all - the pack forbids putting a master into a runtime prompt, so the DB has no reason
-- to hold it. Its checksum is recorded in the package manifest instead.
create schema if not exists kb_stage;
revoke all on schema kb_stage from anon, authenticated;
grant usage on schema kb_stage to service_role;

-- Every write is attached to a run. This is the rollback handle and the audit trail.
create table if not exists kb_stage.ingestion_runs (
  id uuid primary key default gen_random_uuid(),
  package_id text not null,
  package_version text not null,
  package_sha256 text,
  status text not null default 'started',
  started_at timestamptz not null default now(),
  completed_at timestamptz,
  inserted_count bigint not null default 0,
  updated_count bigint not null default 0,
  rejected_count bigint not null default 0,
  report jsonb not null default '{}'::jsonb
);
create unique index if not exists kb_stage_runs_pkg_idx
  on kb_stage.ingestion_runs (package_id, package_version, coalesce(package_sha256,''));
create index if not exists kb_stage_runs_status_idx on kb_stage.ingestion_runs (status, started_at desc);

-- SHA-256 per file, so a rerun skips unchanged files instead of re-streaming 174 MB.
create table if not exists kb_stage.file_hashes (
  package_id text not null,
  file_name text not null,
  sha256 text not null,
  rows_seen integer not null default 0,
  last_run_id uuid references kb_stage.ingestion_runs(id) on delete set null,
  updated_at timestamptz not null default now(),
  primary key (package_id, file_name)
);

create table if not exists kb_stage.sources (
  source_id text primary key,
  title text not null,
  publisher text,
  url text,
  source_type text,
  jurisdiction text,
  published_date text,
  accessed_date text,
  notes text,
  raw jsonb not null default '{}'::jsonb,
  updated_at timestamptz not null default now()
);

create table if not exists kb_stage.categories (
  category_slug text primary key,
  category_number integer,
  category_name_en text not null,
  category_name_ar text,
  package_id text not null,
  package_version text not null,
  package_zip text,
  aliases jsonb not null default '[]'::jsonb,
  raw jsonb not null default '{}'::jsonb,
  updated_at timestamptz not null default now()
);

create table if not exists kb_stage.subcategories (
  category_slug text not null references kb_stage.categories(category_slug) on delete cascade,
  subcategory_slug text not null,
  subcategory_number integer,
  name_en text not null,
  name_ar text,
  aliases_en jsonb not null default '[]'::jsonb,
  aliases_ar jsonb not null default '[]'::jsonb,
  raw jsonb not null default '{}'::jsonb,
  primary key (category_slug, subcategory_slug)
);

-- The narrative/searchable body of the corpus. One row per supplied record_id.
-- NOTE ON validation_status: it is imported verbatim and never promoted. The pack is emphatic that
-- draft / source_verified / reviewed must not be mass-promoted to approved, and runtime retrieval
-- filters on it, so this column is the safety boundary between "we have text about it" and "we are
-- willing to say it to a customer".
create table if not exists kb_stage.records (
  record_id text primary key,
  category_slug text not null,
  subcategory_slug text not null,
  module text not null,
  record_type text not null,
  title text not null,
  content text not null,
  structured_data jsonb not null default '{}'::jsonb,
  jurisdiction text,
  authority text,
  source_ids jsonb not null default '[]'::jsonb,
  effective_date text,
  superseded_date text,
  version text not null,
  confidence numeric,
  validation_status text not null,
  review_after text,
  keywords_en jsonb not null default '[]'::jsonb,
  keywords_ar jsonb not null default '[]'::jsonb,
  applies_when jsonb,
  exceptions jsonb not null default '[]'::jsonb,
  escalation_rule jsonb,
  package_id text,
  ingestion_run_id uuid references kb_stage.ingestion_runs(id) on delete set null,
  content_sha256 text,
  updated_at timestamptz not null default now()
);
create index if not exists kb_stage_records_scope_idx on kb_stage.records (category_slug, subcategory_slug, module, record_type);
create index if not exists kb_stage_records_validation_idx on kb_stage.records (validation_status, review_after);
create index if not exists kb_stage_records_run_idx on kb_stage.records (ingestion_run_id);
create index if not exists kb_stage_records_pkg_idx on kb_stage.records (package_id);

-- Superseded versions are kept rather than overwritten, so a bad package version can be rolled back
-- to the previous text rather than to nothing.
create table if not exists kb_stage.record_versions (
  id bigserial primary key,
  record_id text not null,
  version text not null,
  content_sha256 text,
  payload jsonb not null,
  replaced_at timestamptz not null default now(),
  ingestion_run_id uuid references kb_stage.ingestion_runs(id) on delete set null
);
create index if not exists kb_stage_record_versions_idx on kb_stage.record_versions (record_id, replaced_at desc);

-- Deterministic layer. These are the tables that are meant to REPLACE model calls: which question
-- to ask next, whether the brief is complete, whether a supplier is eligible. They are relational
-- on purpose - no embeddings, no chat model, no ambiguity.
create table if not exists kb_stage.questions (
  question_id text primary key,
  record_id text references kb_stage.records(record_id) on delete cascade,
  category_slug text not null,
  subcategory_slug text not null,
  field_key text,
  question_en text,
  question_ar text,
  answer_type text,
  allowed_values jsonb not null default '[]'::jsonb,
  unit text,
  mandatory boolean not null default false,
  activation jsonb,
  impact jsonb not null default '[]'::jsonb,
  on_missing text,
  answerable_by_documents jsonb not null default '[]'::jsonb,
  payload jsonb not null default '{}'::jsonb,
  ingestion_run_id uuid references kb_stage.ingestion_runs(id) on delete set null
);
create index if not exists kb_stage_questions_scope_idx on kb_stage.questions (category_slug, subcategory_slug, mandatory);
create index if not exists kb_stage_questions_field_idx on kb_stage.questions (field_key);

create table if not exists kb_stage.decision_rules (
  rule_id text primary key,
  category_slug text not null,
  subcategory_slug text not null,
  rule_type text,
  priority integer,
  when_json jsonb,
  then_json jsonb,
  source_ids jsonb not null default '[]'::jsonb,
  confidence numeric,
  requires_human_review boolean not null default false,
  version text,
  payload jsonb not null default '{}'::jsonb,
  ingestion_run_id uuid references kb_stage.ingestion_runs(id) on delete set null
);
create index if not exists kb_stage_rules_scope_idx on kb_stage.decision_rules (category_slug, subcategory_slug, priority desc);
create index if not exists kb_stage_rules_type_idx on kb_stage.decision_rules (rule_type);

create table if not exists kb_stage.validation_rules (
  validation_id text primary key,
  record_id text references kb_stage.records(record_id) on delete cascade,
  category_slug text not null,
  subcategory_slug text not null,
  rule_text text,
  severity text,
  on_fail jsonb not null default '[]'::jsonb,
  payload jsonb not null default '{}'::jsonb,
  ingestion_run_id uuid references kb_stage.ingestion_runs(id) on delete set null
);
create index if not exists kb_stage_validations_scope_idx on kb_stage.validation_rules (category_slug, subcategory_slug);

create table if not exists kb_stage.scenario_tests (
  scenario_id text primary key,
  record_id text references kb_stage.records(record_id) on delete cascade,
  category_slug text not null,
  subcategory_slug text not null,
  setup text,
  expected text,
  pass_criteria jsonb not null default '[]'::jsonb,
  status text not null default 'not_executed',
  latest_result jsonb,
  payload jsonb not null default '{}'::jsonb,
  ingestion_run_id uuid references kb_stage.ingestion_runs(id) on delete set null
);
create index if not exists kb_stage_scenarios_scope_idx on kb_stage.scenario_tests (category_slug, subcategory_slug, status);

create table if not exists kb_stage.knowledge_gaps (
  id bigserial primary key,
  package_id text not null,
  category_slug text,
  subcategory_slug text,
  gap text not null,
  severity text,
  raw jsonb not null default '{}'::jsonb,
  ingestion_run_id uuid references kb_stage.ingestion_runs(id) on delete set null
);

-- THE CROSSWALK. The pack is explicit that the 66 knowledge domains, the founder's 84-item supplier
-- list and the live 86-category catalogue are NOT interchangeable, and that routing must use stable
-- slugs/IDs rather than the display number. This table is the only sanctioned bridge between them,
-- and it stays review_status='draft' until a human signs it off.
create table if not exists kb_stage.category_crosswalk (
  knowledge_domain_slug text not null,
  knowledge_subcategory_slug text not null,
  production_category_id text not null,
  production_category_slug text not null,
  relationship_type text not null check (relationship_type in ('primary','secondary','overlap','fallback')),
  routing_priority integer not null default 100,
  review_status text not null default 'draft',
  effective_from date not null default current_date,
  primary key (knowledge_subcategory_slug, production_category_id, knowledge_domain_slug)
);
create index if not exists kb_stage_crosswalk_prod_idx on kb_stage.category_crosswalk (production_category_id, routing_priority);

do $$
declare t record;
begin
  for t in select tablename from pg_tables where schemaname = 'kb_stage' loop
    execute format('alter table kb_stage.%I enable row level security', t.tablename);
    execute format('revoke all on kb_stage.%I from anon, authenticated', t.tablename);
    execute format('grant all on kb_stage.%I to service_role', t.tablename);
  end loop;
end $$;
</file>

<file path="supabase/migrations/20260802122037_kb_operational_86_routing_2026_08_02.sql">
-- OPERATIONAL 86-CATEGORY ROUTING LAYER (2 Aug 2026).
-- The live catalogue public.catalog_supplier_categories already holds exactly 86 rows and its slugs
-- are production values that other tables and URLs depend on. The supplied route manifests carry an
-- EXPECTED slug which may differ; the pack says resolve by num and never overwrite the live slug.
-- These tables therefore key on catalog_num and hold the expected slug only as evidence, never as a
-- source of truth.

create table if not exists public.kb_operational_route (
  catalog_num int primary key,
  route_key text unique not null,
  expected_catalog_slug text,
  catalog_name text not null,
  route_type text not null,
  coverage_status text not null,
  version text not null,
  manifest jsonb not null,
  ingestion_run_id uuid,
  updated_at timestamptz not null default now()
);

create table if not exists public.kb_operational_route_map (
  catalog_num int not null references public.kb_operational_route(catalog_num) on delete cascade,
  package_slug text not null,
  subcategory_slug text not null,
  priority text not null default 'primary',
  package_zip text,
  package_number int,
  primary key (catalog_num, package_slug, subcategory_slug)
);
create index if not exists kb_op_route_map_pkg_idx on public.kb_operational_route_map (package_slug, subcategory_slug);

-- The deterministic first pass. weight lets a specific phrase ("DEWA NOC") beat a generic one
-- ("electrical"); negative lets a phrase actively push a route DOWN, which is how "lift" is kept
-- away from forklift and pallet-truck requests.
create table if not exists public.kb_operational_alias (
  catalog_num int not null references public.kb_operational_route(catalog_num) on delete cascade,
  language text not null,
  alias text not null,
  alias_norm text not null,
  weight int not null default 2,
  negative boolean not null default false,
  source text,
  primary key (catalog_num, language, alias)
);
create index if not exists kb_op_alias_norm_idx on public.kb_operational_alias (alias_norm);
create index if not exists kb_op_alias_lang_idx on public.kb_operational_alias (language, negative);

create table if not exists public.kb_operational_route_test (
  test_id text primary key,
  catalog_num int,
  input text not null,
  expected_action text not null,
  expected jsonb,
  last_result jsonb,
  last_run_at timestamptz
);
create index if not exists kb_op_route_test_num_idx on public.kb_operational_route_test (catalog_num);

-- ACCEPTANCE VIEW. The pack requires proof that all 86 live routes are mapped and none is empty.
-- Driven from the LIVE catalogue, left-joined to the imported routes, so an unmapped live category
-- shows up as UNMAPPED rather than simply being absent.
create or replace view public.v_kb_operational_86_coverage as
select c.num,
       c.slug  as live_catalog_slug,
       c.name  as live_catalog_name,
       r.route_key,
       r.expected_catalog_slug,
       (r.expected_catalog_slug is distinct from c.slug) as slug_differs,
       r.route_type,
       r.coverage_status,
       count(m.subcategory_slug) as mapped_subcategories,
       count(distinct m.package_slug) as mapped_packages,
       case when r.catalog_num is null then 'UNMAPPED'
            when count(m.subcategory_slug) = 0 then 'EMPTY'
            else 'MAPPED' end as verdict
from public.catalog_supplier_categories c
left join public.kb_operational_route r on r.catalog_num = c.num
left join public.kb_operational_route_map m on m.catalog_num = r.catalog_num
group by c.num, c.slug, c.name, r.route_key, r.expected_catalog_slug, r.route_type, r.coverage_status, r.catalog_num
order by c.num;

comment on view public.v_kb_operational_86_coverage is
  'Acceptance proof for the knowledge import: every live supplier category must read MAPPED with at least one mapped subcategory. slug_differs=true is expected and harmless - the live slug wins by design, the expected slug is kept only as import evidence.';

alter table public.kb_operational_route enable row level security;
alter table public.kb_operational_route_map enable row level security;
alter table public.kb_operational_alias enable row level security;
alter table public.kb_operational_route_test enable row level security;
revoke all on public.kb_operational_route, public.kb_operational_route_map,
              public.kb_operational_alias, public.kb_operational_route_test from anon, authenticated;
</file>

<file path="supabase/migrations/20260802122112_kb_stage_record_versioning_trigger.sql">
-- VERSIONING WITHOUT A READ-BEFORE-WRITE. The importer upserts in batches of 500; making it fetch
-- the previous row first to decide whether to archive would double the round trips and open a race
-- between two concurrent packages. The database already has the OLD row in hand during an UPDATE,
-- so archiving belongs here. Only genuine content changes are archived - a rerun of an unchanged
-- package touches nothing, which is what makes the import idempotent.
create or replace function kb_stage.trg_archive_record_version() returns trigger
language plpgsql as $$
begin
  if TG_OP = 'UPDATE'
     and OLD.content_sha256 is distinct from NEW.content_sha256 then
    insert into kb_stage.record_versions (record_id, version, content_sha256, payload, ingestion_run_id)
    values (OLD.record_id, OLD.version, OLD.content_sha256, to_jsonb(OLD), OLD.ingestion_run_id);
    NEW.updated_at := now();
  elsif TG_OP = 'UPDATE' then
    -- unchanged content: keep the original updated_at so "what actually moved in this run" stays
    -- answerable from the table itself.
    NEW.updated_at := OLD.updated_at;
  end if;
  return NEW;
end $$;

drop trigger if exists archive_record_version on kb_stage.records;
create trigger archive_record_version before update on kb_stage.records
  for each row execute function kb_stage.trg_archive_record_version();

-- Rollback handle. Removes everything a run wrote and restores the archived previous version of any
-- record that run overwrote. Documented and tested rather than described.
create or replace function kb_stage.rollback_ingestion_run(p_run_id uuid)
returns jsonb language plpgsql security definer set search_path = kb_stage, public as $$
declare v_restored int := 0; v_deleted int := 0; v_children int := 0; n int;
begin
  -- 1. restore records this run overwrote, newest archived version first
  with latest as (
    select distinct on (rv.record_id) rv.*
    from kb_stage.record_versions rv
    join kb_stage.records r on r.record_id = rv.record_id
    where r.ingestion_run_id = p_run_id
    order by rv.record_id, rv.replaced_at desc
  )
  update kb_stage.records r
     set content        = latest.payload->>'content',
         title          = latest.payload->>'title',
         structured_data= coalesce(latest.payload->'structured_data','{}'::jsonb),
         version        = latest.version,
         content_sha256 = latest.content_sha256,
         validation_status = latest.payload->>'validation_status',
         ingestion_run_id  = (latest.payload->>'ingestion_run_id')::uuid
  from latest where latest.record_id = r.record_id;
  get diagnostics v_restored = row_count;

  -- 2. delete rows this run created (records created by the run have no archived predecessor)
  delete from kb_stage.questions        where ingestion_run_id = p_run_id; get diagnostics n = row_count; v_children := v_children + n;
  delete from kb_stage.decision_rules   where ingestion_run_id = p_run_id; get diagnostics n = row_count; v_children := v_children + n;
  delete from kb_stage.validation_rules where ingestion_run_id = p_run_id; get diagnostics n = row_count; v_children := v_children + n;
  delete from kb_stage.scenario_tests   where ingestion_run_id = p_run_id; get diagnostics n = row_count; v_children := v_children + n;
  delete from kb_stage.knowledge_gaps   where ingestion_run_id = p_run_id; get diagnostics n = row_count; v_children := v_children + n;

  delete from kb_stage.records r
   where r.ingestion_run_id = p_run_id
     and not exists (select 1 from kb_stage.record_versions v where v.record_id = r.record_id);
  get diagnostics v_deleted = row_count;

  delete from kb_stage.file_hashes where last_run_id = p_run_id;
  update kb_stage.ingestion_runs set status = 'rolled_back', completed_at = now() where id = p_run_id;

  return jsonb_build_object('run_id', p_run_id, 'records_restored', v_restored,
                            'records_deleted', v_deleted, 'child_rows_deleted', v_children);
end $$;

revoke all on function kb_stage.rollback_ingestion_run(uuid) from public, anon, authenticated;

