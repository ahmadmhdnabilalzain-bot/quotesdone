async function brainFor(agent: string){ try{ const key = KMAP[agent] || agent; const { data } = await admin.rpc('fn_agent_context', { p_agent_key: key, p_max_chars: 6500 }); return data ? String(data) : ''; }catch(_e){ return ''; } }
