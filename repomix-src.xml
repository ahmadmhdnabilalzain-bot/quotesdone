<file path="supabase/migrations/20260802143601_p1_04c_control_mode_mfa_ref_type_fix.sql">
-- phone_verifications.id is a uuid, not a bigint. Caught by the happy-path test: without it, the
-- ONLY path that actually opens Control Mode would have failed at runtime while every refusal path
-- worked - a gate that can never be opened looks exactly like a gate that works, until the founder
-- needs it at 3am.
alter table public.control_mode_session
  alter column mfa_ref type uuid using nullif(mfa_ref::text,'')::uuid;
</file>

<file path="supabase/migrations/20260802143708_p1_04d_control_mode_otp_hash_match.sql">
-- The OTP codes in phone_verifications are NOT plaintext. They are HMAC-SHA256(code, otp_hmac_key)
-- rendered as lowercase hex - a deliberate hardening on 27 Jul, because an unsalted hash of a
-- 6-digit code is reversible from one table leak by precomputing all 10^6.
-- fn_control_mode_open compared the raw code against that column, so it could never match. Every
-- refusal path worked and the ONE path that actually opens Control Mode was dead: a gate that can
-- never be opened is indistinguishable from a gate that works, right up to the moment the founder
-- needs it.
-- Hash on the SQL side with pgcrypto so there is exactly one implementation, and it produces the
-- same lowercase hex the edge function writes.
create or replace function public.fn_otp_hash(p_code text)
returns text language sql stable security definer set search_path = public, extensions as $$
  select encode(extensions.hmac(p_code, (select value from public.app_secrets where key='otp_hmac_key'), 'sha256'), 'hex');
$$;
revoke all on function public.fn_otp_hash(text) from public, anon, authenticated;
grant execute on function public.fn_otp_hash(text) to service_role;

create or replace function public.fn_control_mode_open(
  p_actor_email text, p_reason text, p_phone text, p_code text,
  p_user_id uuid default null, p_ip text default null, p_ua text default null)
returns jsonb language plpgsql security definer set search_path = public as $$
declare v_pv record; v_id uuid; v_min int := public.fn_control_mode_minutes(); v_hash text;
begin
  if coalesce(btrim(p_reason),'') = '' then
    insert into public.control_mode_audit (actor_email, event, allowed, reason)
    values (p_actor_email, 'open_denied', false, 'no reason given');
    return jsonb_build_object('ok', false, 'error', 'reason_required',
      'message', 'Control Mode needs a reason. It is written into the audit trail beside whatever you change.');
  end if;

  v_hash := public.fn_otp_hash(p_code);

  -- Accept either the hashed form (normal) or a literal match, so a verification row written by an
  -- older code path is still usable. The hashed comparison is the one that matters.
  select * into v_pv from public.phone_verifications
   where phone = p_phone and code in (v_hash, p_code) and used_at is null and expires_at > now()
   order by created_at desc limit 1;

  if not found then
    insert into public.control_mode_audit (actor_email, event, allowed, reason, detail)
    values (p_actor_email, 'open_denied', false, 'mfa_failed', jsonb_build_object('phone_tail', right(coalesce(p_phone,''),4)));
    return jsonb_build_object('ok', false, 'error', 'mfa_failed',
      'message', 'That code is not valid, has expired, or has already been used. Request a new one.');
  end if;

  update public.phone_verifications set used_at = now() where id = v_pv.id;

  update public.control_mode_session
     set closed_at = now(), closed_reason = 'superseded by a new session'
   where actor_email = p_actor_email and closed_at is null;

  insert into public.control_mode_session (user_id, actor_email, reason, expires_at, mfa_method, mfa_ref, ip, user_agent)
  values (p_user_id, p_actor_email, btrim(p_reason), now() + make_interval(mins => v_min),
          'phone_otp', v_pv.id, p_ip, left(coalesce(p_ua,''), 300))
  returning id into v_id;

  insert into public.control_mode_audit (actor_email, event, session_id, allowed, reason, detail)
  values (p_actor_email, 'open', v_id, true, btrim(p_reason), jsonb_build_object('minutes', v_min, 'ip', p_ip));

  return jsonb_build_object('ok', true, 'session_id', v_id, 'expires_at', now() + make_interval(mins => v_min),
                            'minutes', v_min,
                            'message', 'Control Mode is open for ' || v_min || ' minutes. It closes on its own.');
end $$;

revoke all on function public.fn_control_mode_open(text,text,text,text,uuid,text,text) from public, anon, authenticated;
grant execute on function public.fn_control_mode_open(text,text,text,text,uuid,text,text) to service_role;
</file>

<file path="supabase/migrations/20260802144014_p1_07_refunds_ledger.sql">
-- PHASE 1.7 - a real refunds ledger.
--
-- WHY THIS IS A GAP AND NOT A NAMING PROBLEM. The company-operations corpus binds Payments & Revenue
-- to an object called `refunds`. There isn't one. Refunds today are implied by a stripe_transactions
-- row plus, sometimes, a decision_record - which means nobody can answer: how many refunds, at what
-- rate, for what reason, approved by whom, reconciled against which Stripe object, and did the money
-- actually leave. The reveal fee is the only revenue this business has; a refund is the only way it
-- goes backwards. Not being able to count that is not an accounting inconvenience.
--
-- Design notes:
--  * request and settlement are separate states, because a refund that Stripe rejected is a
--    different fact from one nobody has approved yet;
--  * amounts are stored in FILS (integer), not decimal AED - float money is how reconciliations end
--    up 0.01 apart forever;
--  * approver is required for anything outside the automatic window, and the automatic window is a
--    named policy rather than a hardcoded 3;
--  * every row carries the Stripe ids, so reconciliation is a join and not an investigation.

create table if not exists public.refunds (
  id                 bigserial primary key,
  created_at         timestamptz not null default now(),
  updated_at         timestamptz not null default now(),

  inquiry_id         uuid,
  customer_id        uuid,
  supplier_lead_id   bigint,
  quote_id           bigint,

  -- what was originally taken
  original_txn_id    bigint,
  stripe_payment_intent text,
  stripe_charge_id   text,
  stripe_refund_id   text unique,

  amount_fils        bigint not null check (amount_fils > 0),
  currency           text not null default 'AED' check (currency = 'AED'),

  reason_code        text not null check (reason_code in (
                       'supplier_unresponsive','supplier_withdrew','duplicate_charge',
                       'customer_cancelled_in_window','service_not_delivered',
                       'fraud_or_dispute','goodwill','other')),
  reason_note        text,

  status             text not null default 'requested' check (status in (
                       'requested','approved','rejected','processing','succeeded','failed','cancelled')),
  requested_by       text not null,
  requested_at       timestamptz not null default now(),
  decided_by         text,
  decided_at         timestamptz,
  decision_note      text,
  within_auto_window boolean not null default false,

  settled_at         timestamptz,
  failure_reason     text,

  -- finance linkage
  gl_entry_id        bigint,
  reconciled_at      timestamptz,
  reconciliation_note text
);

create index if not exists refunds_status_idx    on public.refunds (status, created_at desc);
create index if not exists refunds_inquiry_idx   on public.refunds (inquiry_id);
create index if not exists refunds_customer_idx  on public.refunds (customer_id);
create index if not exists refunds_stripe_pi_idx on public.refunds (stripe_payment_intent);
create index if not exists refunds_unreconciled_idx on public.refunds (settled_at) where reconciled_at is null and status = 'succeeded';

alter table public.refunds enable row level security;
revoke all on public.refunds from anon, authenticated;
grant all on public.refunds to service_role;

comment on table public.refunds is
  'The refund ledger. One row per refund from request to settlement to reconciliation. Amounts in fils. Created 2 Aug 2026 (Phase 1.7) after the audit found refunds were only implied by stripe_transactions plus a decision_record, so refund rate, reason, approver and reconciliation were all unanswerable.';

create or replace function public.trg_refunds_touch() returns trigger language plpgsql as $$
begin NEW.updated_at := now(); return NEW; end $$;
drop trigger if exists refunds_touch on public.refunds;
create trigger refunds_touch before update on public.refunds for each row execute function public.trg_refunds_touch();

-- REQUEST. Anyone (customer flow, supplier non-response sweep, support) can raise one. Raising is
-- not approving: a request with no decision sits visible in the queue rather than moving money.
create or replace function public.fn_refund_request(
  p_amount_fils bigint, p_reason_code text, p_requested_by text,
  p_inquiry_id uuid default null, p_customer_id uuid default null,
  p_supplier_lead_id bigint default null, p_quote_id bigint default null,
  p_payment_intent text default null, p_charge_id text default null,
  p_note text default null)
returns jsonb language plpgsql security definer set search_path = public as $$
declare v_id bigint; v_days int; v_auto boolean := false; v_paid timestamptz;
begin
  if p_amount_fils is null or p_amount_fils <= 0 then
    return jsonb_build_object('ok', false, 'error', 'amount_required');
  end if;

  select refund_window_working_days into v_days from public.pricing_config where id = 1;

  -- inside the published refund window a refund is a promise the company already made, so it does
  -- not need a human to agree to it again. Outside it, somebody owns the decision.
  select paid_at into v_paid from public.stripe_transactions
   where (p_payment_intent is not null and payment_intent = p_payment_intent) limit 1;
  if v_paid is not null and v_paid > now() - make_interval(days => coalesce(v_days,3)) then
    v_auto := true;
  end if;

  insert into public.refunds (inquiry_id, customer_id, supplier_lead_id, quote_id,
                              stripe_payment_intent, stripe_charge_id,
                              amount_fils, reason_code, reason_note, requested_by,
                              within_auto_window, status)
  values (p_inquiry_id, p_customer_id, p_supplier_lead_id, p_quote_id,
          p_payment_intent, p_charge_id, p_amount_fils, p_reason_code, p_note, p_requested_by,
          v_auto, case when v_auto then 'approved' else 'requested' end)
  returning id into v_id;

  if v_auto then
    update public.refunds set decided_by = 'policy:auto_window', decided_at = now(),
           decision_note = 'Inside the published ' || coalesce(v_days,3) || '-working-day refund window'
     where id = v_id;
  end if;

  return jsonb_build_object('ok', true, 'refund_id', v_id,
                            'status', case when v_auto then 'approved' else 'requested' end,
                            'within_auto_window', v_auto);
end $$;

-- DECIDE. Outside the automatic window a named human (or an authorised agent) approves or rejects.
create or replace function public.fn_refund_decide(
  p_refund_id bigint, p_approve boolean, p_decided_by text, p_note text default null)
returns jsonb language plpgsql security definer set search_path = public as $$
declare r public.refunds;
begin
  select * into r from public.refunds where id = p_refund_id;
  if not found then return jsonb_build_object('ok', false, 'error', 'not_found'); end if;
  if r.status not in ('requested') then
    return jsonb_build_object('ok', false, 'error', 'not_decidable', 'status', r.status);
  end if;
  if coalesce(btrim(p_decided_by),'') = '' then
    return jsonb_build_object('ok', false, 'error', 'decider_required');
  end if;

  update public.refunds
     set status = case when p_approve then 'approved' else 'rejected' end,
         decided_by = p_decided_by, decided_at = now(), decision_note = p_note
   where id = p_refund_id;

  return jsonb_build_object('ok', true, 'refund_id', p_refund_id,
                            'status', case when p_approve then 'approved' else 'rejected' end);
end $$;

-- SETTLE. Called by the Stripe webhook when charge.refunded / refund.updated arrives. Idempotent on
-- stripe_refund_id, because Stripe retries webhooks and a double-settled refund is a double refund.
create or replace function public.fn_refund_settle(
  p_stripe_refund_id text, p_status text, p_amount_fils bigint default null,
  p_payment_intent text default null, p_charge_id text default null,
  p_failure_reason text default null)
returns jsonb language plpgsql security definer set search_path = public as $$
declare r public.refunds; v_status text;
begin
  v_status := case lower(coalesce(p_status,''))
                when 'succeeded' then 'succeeded'
                when 'failed'    then 'failed'
                when 'canceled'  then 'cancelled'
                when 'cancelled' then 'cancelled'
                else 'processing' end;

  select * into r from public.refunds where stripe_refund_id = p_stripe_refund_id;
  if found then
    if r.status = v_status then
      return jsonb_build_object('ok', true, 'refund_id', r.id, 'status', r.status, 'idempotent', true);
    end if;
    update public.refunds
       set status = v_status,
           settled_at = case when v_status = 'succeeded' then coalesce(settled_at, now()) else settled_at end,
           failure_reason = case when v_status = 'failed' then p_failure_reason else failure_reason end
     where id = r.id;
    return jsonb_build_object('ok', true, 'refund_id', r.id, 'status', v_status, 'idempotent', false);
  end if;

  -- Match an approved request that has no Stripe id yet, by payment intent.
  select * into r from public.refunds
   where stripe_refund_id is null and p_payment_intent is not null
     and stripe_payment_intent = p_payment_intent and status in ('approved','processing')
   order by created_at limit 1;

  if found then
    update public.refunds
       set stripe_refund_id = p_stripe_refund_id, stripe_charge_id = coalesce(p_charge_id, stripe_charge_id),
           status = v_status,
           settled_at = case when v_status = 'succeeded' then now() else settled_at end,
           failure_reason = case when v_status = 'failed' then p_failure_reason else null end
     where id = r.id;
    return jsonb_build_object('ok', true, 'refund_id', r.id, 'status', v_status, 'matched_by', 'payment_intent');
  end if;

  -- A refund issued directly in the Stripe dashboard, with no request here. Record it rather than
  -- discard it: an unrecorded refund is exactly the money that never reconciles.
  insert into public.refunds (stripe_refund_id, stripe_payment_intent, stripe_charge_id,
                              amount_fils, reason_code, reason_note, requested_by,
                              status, settled_at, decided_by, decided_at, decision_note)
  values (p_stripe_refund_id, p_payment_intent, p_charge_id,
          coalesce(p_amount_fils, 1), 'other',
          'Issued outside QuotesDone (Stripe dashboard or API). Recorded by the webhook.',
          'stripe_webhook', v_status,
          case when v_status='succeeded' then now() end,
          'stripe_dashboard', now(), 'No in-platform request existed for this refund.')
  returning * into r;
  return jsonb_build_object('ok', true, 'refund_id', r.id, 'status', v_status, 'matched_by', 'created_from_stripe');
end $$;

-- RECONCILIATION. What finance actually needs: settled refunds not yet tied to a ledger entry.
create or replace view public.v_refunds_unreconciled as
select r.id, r.settled_at, r.amount_fils, round(r.amount_fils/100.0, 2) as amount_aed,
       r.currency, r.reason_code, r.stripe_refund_id, r.stripe_payment_intent,
       r.inquiry_id, r.customer_id, r.decided_by
from public.refunds r
where r.status = 'succeeded' and r.reconciled_at is null
order by r.settled_at;

create or replace view public.v_refund_metrics as
select count(*) as refunds_total,
       count(*) filter (where status='requested')  as awaiting_decision,
       count(*) filter (where status='approved')   as approved_not_settled,
       count(*) filter (where status='succeeded')  as settled,
       count(*) filter (where status='failed')     as failed,
       count(*) filter (where status='rejected')   as rejected,
       count(*) filter (where within_auto_window)  as inside_auto_window,
       coalesce(round(sum(amount_fils) filter (where status='succeeded')/100.0, 2), 0) as refunded_aed,
       (select coalesce(round(sum(amount_fils)/100.0,2),0) from public.refunds where status='succeeded'
          and settled_at > now() - interval '30 days') as refunded_aed_30d,
       (select count(*) from public.v_refunds_unreconciled) as unreconciled,
       (select coalesce(jsonb_object_agg(reason_code, c), '{}'::jsonb)
          from (select reason_code, count(*) c from public.refunds where status='succeeded' group by 1) t) as by_reason
from public.refunds;

comment on view public.v_refund_metrics is
  'Payments & Revenue tile. refund rate, value, reason mix and how many settled refunds have not yet been reconciled to the ledger. unreconciled > 0 for more than a day is the signal worth alerting on.';

revoke all on function public.fn_refund_request(bigint,text,text,uuid,uuid,bigint,bigint,text,text,text) from public, anon, authenticated;
revoke all on function public.fn_refund_decide(bigint,boolean,text,text) from public, anon, authenticated;
revoke all on function public.fn_refund_settle(text,text,bigint,text,text,text) from public, anon, authenticated;
grant execute on function public.fn_refund_request(bigint,text,text,uuid,uuid,bigint,bigint,text,text,text) to service_role;
grant execute on function public.fn_refund_decide(bigint,boolean,text,text) to service_role;
grant execute on function public.fn_refund_settle(text,text,bigint,text,text,text) to service_role;
</file>

<file path="supabase/migrations/20260802144301_p1_07b_refunds_link_to_transactions_not_duplicate.sql">
-- CORRECTION, found by the first test: public.transactions ALREADY carries refund_status,
-- refund_reason, refund_requested_at, refund_resolved_at, refund_note, refund_stripe_id,
-- refund_amount_aed, refund_confirmed_at and refund_deadline. My first cut referenced a
-- non-existent stripe_transactions table and, worse, would have become a SECOND place refunds live -
-- exactly the duplicate source of truth the standing rules forbid. transactions.id and quote_id are
-- uuid, not bigint, which the foreign key then caught.
--
-- Resolution. transactions.refund_* stays as the per-reveal STATE the existing os_api refund_resolve
-- flow and customer UI already read. public.refunds is the LEDGER: what a column set on one row
-- structurally cannot hold - more than one partial refund against the same reveal, who approved it
-- and why, the Stripe refund id, settlement, failure reason and reconciliation to finance. The
-- functions keep the two in step, so neither drifts and no existing reader breaks.
alter table public.refunds drop column if exists quote_id;
alter table public.refunds
  add column if not exists transaction_id uuid references public.transactions(id) on delete set null,
  add column if not exists quote_id uuid;
create index if not exists refunds_transaction_idx on public.refunds (transaction_id);

comment on column public.refunds.transaction_id is
  'The reveal this refund is against. transactions.refund_* remains the state the existing UI reads; this ledger holds what a column set cannot - partial refunds, approver, Stripe ids, settlement and reconciliation.';

create or replace function public.fn_refund_request(
  p_amount_fils bigint, p_reason_code text, p_requested_by text,
  p_inquiry_id uuid default null, p_customer_id uuid default null,
  p_supplier_lead_id bigint default null, p_quote_id uuid default null,
  p_payment_intent text default null, p_charge_id text default null,
  p_note text default null, p_transaction_id uuid default null)
returns jsonb language plpgsql security definer set search_path = public as $$
declare v_id bigint; v_auto boolean := false; t public.transactions;
begin
  if p_amount_fils is null or p_amount_fils <= 0 then
    return jsonb_build_object('ok', false, 'error', 'amount_required');
  end if;

  select * into t from public.transactions
   where (p_transaction_id is not null and id = p_transaction_id)
      or (p_transaction_id is null and p_quote_id is not null and quote_id = p_quote_id)
      or (p_transaction_id is null and p_quote_id is null and p_payment_intent is not null and payment_ref = p_payment_intent)
   order by revealed_at desc nulls last limit 1;

  -- Inside the window the customer was promised at reveal, a refund is a commitment already made,
  -- so it does not need a human to agree to it again. Reusing transactions.refund_deadline - which
  -- fn_add_working_days already computed at reveal time - means the window here cannot disagree
  -- with what the customer was told.
  if t.id is not null and t.refund_deadline is not null and t.refund_deadline >= now() then
    v_auto := true;
  end if;

  insert into public.refunds (transaction_id, inquiry_id, customer_id, supplier_lead_id, quote_id,
                              stripe_payment_intent, stripe_charge_id,
                              amount_fils, reason_code, reason_note, requested_by,
                              within_auto_window, status)
  values (t.id, coalesce(p_inquiry_id, t.inquiry_id), coalesce(p_customer_id, t.customer_id),
          coalesce(p_supplier_lead_id, t.supplier_id), coalesce(p_quote_id, t.quote_id),
          coalesce(p_payment_intent, t.payment_ref), p_charge_id,
          p_amount_fils, p_reason_code, p_note, p_requested_by,
          v_auto, case when v_auto then 'approved' else 'requested' end)
  returning id into v_id;

  if v_auto then
    update public.refunds set decided_by = 'policy:auto_window', decided_at = now(),
           decision_note = 'Inside the refund window promised to the customer at reveal (transactions.refund_deadline)'
     where id = v_id;
  end if;

  if t.id is not null then
    update public.transactions
       set refund_status = case when v_auto then 'approved' else 'requested' end,
           refund_reason = coalesce(refund_reason, p_reason_code),
           refund_requested_at = coalesce(refund_requested_at, now()),
           refund_note = coalesce(p_note, refund_note)
     where id = t.id;
  end if;

  return jsonb_build_object('ok', true, 'refund_id', v_id, 'transaction_id', t.id,
                            'status', case when v_auto then 'approved' else 'requested' end,
                            'within_auto_window', v_auto);
end $$;

create or replace function public.fn_refund_decide(
  p_refund_id bigint, p_approve boolean, p_decided_by text, p_note text default null)
returns jsonb language plpgsql security definer set search_path = public as $$
declare r public.refunds; v_new text;
begin
  select * into r from public.refunds where id = p_refund_id;
  if not found then return jsonb_build_object('ok', false, 'error', 'not_found'); end if;
  if r.status <> 'requested' then
    return jsonb_build_object('ok', false, 'error', 'not_decidable', 'status', r.status);
  end if;
  if coalesce(btrim(p_decided_by),'') = '' then
    return jsonb_build_object('ok', false, 'error', 'decider_required');
  end if;
  v_new := case when p_approve then 'approved' else 'rejected' end;
  update public.refunds set status = v_new, decided_by = p_decided_by, decided_at = now(), decision_note = p_note
   where id = p_refund_id;
  if r.transaction_id is not null then
    update public.transactions set refund_status = v_new, refund_resolved_at = now(),
           refund_note = coalesce(p_note, refund_note) where id = r.transaction_id;
  end if;
  return jsonb_build_object('ok', true, 'refund_id', p_refund_id, 'status', v_new);
end $$;

create or replace function public.fn_refund_settle(
  p_stripe_refund_id text, p_status text, p_amount_fils bigint default null,
  p_payment_intent text default null, p_charge_id text default null,
  p_failure_reason text default null)
returns jsonb language plpgsql security definer set search_path = public as $$
declare r public.refunds; v_status text;
begin
  v_status := case lower(coalesce(p_status,''))
                when 'succeeded' then 'succeeded' when 'failed' then 'failed'
                when 'canceled' then 'cancelled'  when 'cancelled' then 'cancelled'
                else 'processing' end;

  select * into r from public.refunds where stripe_refund_id = p_stripe_refund_id;
  if found and r.status = v_status then
    return jsonb_build_object('ok', true, 'refund_id', r.id, 'status', r.status, 'idempotent', true);
  end if;

  if not found then
    select * into r from public.refunds
     where stripe_refund_id is null and p_payment_intent is not null
       and stripe_payment_intent = p_payment_intent and status in ('approved','processing')
     order by created_at limit 1;
    if found then
      update public.refunds set stripe_refund_id = p_stripe_refund_id,
             stripe_charge_id = coalesce(p_charge_id, stripe_charge_id) where id = r.id;
    else
      -- A refund issued straight from the Stripe dashboard with no request here. Recorded rather
      -- than dropped: an unrecorded refund is precisely the money that never reconciles.
      insert into public.refunds (stripe_refund_id, stripe_payment_intent, stripe_charge_id,
                                  amount_fils, reason_code, reason_note, requested_by, status,
                                  decided_by, decided_at, decision_note)
      values (p_stripe_refund_id, p_payment_intent, p_charge_id, coalesce(p_amount_fils, 1), 'other',
              'Issued outside QuotesDone (Stripe dashboard or API). Recorded by the webhook.',
              'stripe_webhook', 'processing', 'stripe_dashboard', now(),
              'No in-platform request existed for this refund.')
      returning * into r;
    end if;
  end if;

  update public.refunds
     set status = v_status,
         settled_at = case when v_status='succeeded' then coalesce(settled_at, now()) else settled_at end,
         failure_reason = case when v_status='failed' then p_failure_reason else failure_reason end
   where id = r.id;

  if r.transaction_id is not null then
    update public.transactions
       set refund_status = v_status, refund_stripe_id = p_stripe_refund_id,
           refund_amount_aed = round(coalesce(p_amount_fils, 0)/100.0, 2),
           refund_confirmed_at = case when v_status='succeeded' then now() else refund_confirmed_at end
     where id = r.transaction_id;
  end if;

  return jsonb_build_object('ok', true, 'refund_id', r.id, 'status', v_status);
end $$;

-- Backfill whatever the column-only model already recorded, so the ledger is complete from day one
-- rather than starting from now. transactions is empty today; the mechanism is what matters.
insert into public.refunds (transaction_id, inquiry_id, customer_id, supplier_lead_id, quote_id,
                            stripe_payment_intent, stripe_refund_id, amount_fils, reason_code,
                            reason_note, requested_by, requested_at, status, decided_by, decided_at,
                            settled_at, reconciliation_note)
select t.id, t.inquiry_id, t.customer_id, t.supplier_id, t.quote_id, t.payment_ref, t.refund_stripe_id,
       greatest(1, round(coalesce(t.refund_amount_aed, t.reveal_fee, 0) * 100)::bigint),
       'other', coalesce(t.refund_reason, 'backfilled from transactions.refund_*'), 'backfill',
       coalesce(t.refund_requested_at, t.revealed_at, now()),
       case lower(coalesce(t.refund_status,''))
         when 'refunded' then 'succeeded' when 'succeeded' then 'succeeded'
         when 'approved' then 'approved'  when 'rejected'  then 'rejected'
         else 'requested' end,
       case when t.refund_resolved_at is not null then 'backfill:unknown' end,
       t.refund_resolved_at, t.refund_confirmed_at,
       'Backfilled 2 Aug 2026 from transactions.refund_* when the ledger was introduced.'
from public.transactions t
where coalesce(t.refund_status,'') <> ''
  and not exists (select 1 from public.refunds r where r.transaction_id = t.id)
on conflict (stripe_refund_id) do nothing;

revoke all on function public.fn_refund_request(bigint,text,text,uuid,uuid,bigint,uuid,text,text,text,uuid) from public, anon, authenticated;
grant execute on function public.fn_refund_request(bigint,text,text,uuid,uuid,bigint,uuid,text,text,text,uuid) to service_role;
drop function if exists public.fn_refund_request(bigint,text,text,uuid,uuid,bigint,bigint,text,text,text);
</file>

<file path="supabase/migrations/20260802150633_p1h_01_action_classification_fail_closed.sql">
-- PHASE 1 HARDENING 1 - CONTROL MODE FAILS CLOSED ON AN UNCLASSIFIED ACTION
--
-- The Phase 1 gate treated "not in the registry" as "read-only". That is the wrong default and the
-- founder was right to reject it: the registry then had to be remembered, and the one time it is
-- forgotten is exactly the time a new mutating action ships unguarded. Two live examples already
-- existed in the code before this migration:
--   * secretary_chat  - forwards message/decision/confirm_token to secretary_act, which ACTS.
--                       Unregistered, therefore treated as read-only, therefore ungated.
--   * record          - fn_os_record is STABLE, a pure read, but Phase 1 registered it as mutating.
--                       Opening any record in the console would have demanded a phone code.
-- Both are fixed here. Classification is now three-valued and mandatory.

alter table public.control_mode_action
  add column if not exists classification text;

update public.control_mode_action
   set classification = case when requires_control then 'mutating' else 'read_only' end
 where classification is null;

-- read_only    - allowed in Observe Mode. The action performs no persistent business write.
-- mutating     - requires an open Control Mode session.
-- mode_control - control_mode_status / _open / _close themselves. They cannot require Control Mode
--                without being unopenable, so they are handled before the gate. They are safe to
--                leave outside it because _open is the MFA challenge, and _status/_close only ever
--                touch the caller's own session. This class is pinned to exactly three names by the
--                constraint below, so it cannot become a loophole.
alter table public.control_mode_action
  drop constraint if exists control_mode_action_classification_chk;
alter table public.control_mode_action
  add constraint control_mode_action_classification_chk
  check (classification in ('read_only','mutating','mode_control'));

alter table public.control_mode_action
  drop constraint if exists control_mode_action_mode_control_pinned;
alter table public.control_mode_action
  add constraint control_mode_action_mode_control_pinned
  check (classification <> 'mode_control'
