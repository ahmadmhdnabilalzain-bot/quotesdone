<file path="supabase/migrations/20260802122520_kb_stage_source_ids_for_derived_tables.sql">
-- The corpus is not uniform. Across the 67 packages the same logical field appears under different
-- names (question_id vs field, scenario_id vs test_id, rule_text vs description) and the supplied
-- short IDs - "Q-001-dewa-related-contractors-project_emirate", "V-002-...", "T-002-..." - are only
-- unique WITHIN a package, because the numeric prefix is the package number and the packages were
-- generated independently. Keying the derived tables on those short IDs would silently collide the
-- moment two packages shared a subcategory slug, and a collided question is a question the customer
-- is never asked.
-- So the primary key is the globally unique record_id, and the supplied short ID is kept alongside
-- and indexed, because decision_rules reference it by name:
--   {"action":"ask_question","question_id":"Q-001-dewa-related-contractors-project_emirate"}
-- Resolution at runtime is (category_slug, subcategory_slug, source_question_id), which is unique.
alter table kb_stage.questions         add column if not exists source_question_id   text;
alter table kb_stage.validation_rules  add column if not exists source_validation_id text;
alter table kb_stage.scenario_tests    add column if not exists source_scenario_id   text;

create index if not exists kb_stage_questions_srcid_idx
  on kb_stage.questions (category_slug, subcategory_slug, source_question_id);
create index if not exists kb_stage_validations_srcid_idx
  on kb_stage.validation_rules (category_slug, subcategory_slug, source_validation_id);
create index if not exists kb_stage_scenarios_srcid_idx
  on kb_stage.scenario_tests (category_slug, subcategory_slug, source_scenario_id);

comment on column kb_stage.questions.source_question_id is
  'The question_id as supplied inside the package (unique only within that package). decision_rules.then_json references this value; resolve it together with category_slug + subcategory_slug, never on its own.';
</file>

<file path="supabase/migrations/20260802123553_kb_stage_rpc_write_path.sql">
-- WRITE PATH FOR A SCHEMA THAT IS NOT ON THE API SURFACE.
-- kb_stage is deliberately not in PostgREST's exposed schemas, so supabase-js cannot address it -
-- the first import attempt failed with "Invalid schema: kb_stage" on every request. The obvious fix
-- (expose kb_stage to the REST API) is the wrong one: it would put 115,000 unreviewed knowledge
-- records, their source lineage and every internal decision rule one policy mistake away from the
-- public API, to save writing this function once.
-- Instead the staging schema stays invisible to the API and these SECURITY DEFINER functions are the
-- only doors into it. p_target is matched against a fixed CASE - caller input never reaches a table
-- name - and the column list is the intersection of the payload's keys with the table's real
-- columns, so an unknown field is ignored rather than throwing, and a column with a default is left
-- to its default instead of being overwritten with null.

create or replace function public.kb_stage_upsert(p_target text, p_rows jsonb)
returns integer language plpgsql security definer set search_path = kb_stage, public as $$
declare
  v_schema text; v_tbl text; v_conflict text;
  v_keys text[]; v_all text; v_set text; v_sql text; v_n int;
begin
  if p_rows is null or jsonb_typeof(p_rows) <> 'array' or jsonb_array_length(p_rows) = 0 then
    return 0;
  end if;

  case p_target
    when 'sources'          then v_schema:='kb_stage'; v_tbl:='sources';            v_conflict:='source_id';
    when 'categories'       then v_schema:='kb_stage'; v_tbl:='categories';         v_conflict:='category_slug';
    when 'subcategories'    then v_schema:='kb_stage'; v_tbl:='subcategories';      v_conflict:='category_slug,subcategory_slug';
    when 'records'          then v_schema:='kb_stage'; v_tbl:='records';            v_conflict:='record_id';
    when 'questions'        then v_schema:='kb_stage'; v_tbl:='questions';          v_conflict:='question_id';
    when 'decision_rules'   then v_schema:='kb_stage'; v_tbl:='decision_rules';     v_conflict:='rule_id';
    when 'validation_rules' then v_schema:='kb_stage'; v_tbl:='validation_rules';   v_conflict:='validation_id';
    when 'scenario_tests'   then v_schema:='kb_stage'; v_tbl:='scenario_tests';     v_conflict:='scenario_id';
    when 'knowledge_gaps'   then v_schema:='kb_stage'; v_tbl:='knowledge_gaps';     v_conflict:='';
    when 'crosswalk'        then v_schema:='kb_stage'; v_tbl:='category_crosswalk'; v_conflict:='knowledge_subcategory_slug,production_category_id,knowledge_domain_slug';
    when 'file_hashes'      then v_schema:='kb_stage'; v_tbl:='file_hashes';        v_conflict:='package_id,file_name';
    when 'op_route'         then v_schema:='public';   v_tbl:='kb_operational_route';      v_conflict:='catalog_num';
    when 'op_route_map'     then v_schema:='public';   v_tbl:='kb_operational_route_map';  v_conflict:='catalog_num,package_slug,subcategory_slug';
    when 'op_alias'         then v_schema:='public';   v_tbl:='kb_operational_alias';      v_conflict:='catalog_num,language,alias';
    when 'op_route_test'    then v_schema:='public';   v_tbl:='kb_operational_route_test'; v_conflict:='test_id';
    else raise exception 'unknown target %', p_target;
  end case;

  select array_agg(a.attname::text order by a.attnum) into v_keys
  from pg_attribute a
  where a.attrelid = format('%I.%I', v_schema, v_tbl)::regclass
    and a.attnum > 0 and not a.attisdropped
    and a.attname in (select jsonb_object_keys(p_rows->0));
  if v_keys is null then raise exception 'payload has no columns matching %.%', v_schema, v_tbl; end if;

  select string_agg(quote_ident(k), ',') into v_all from unnest(v_keys) k;
  select string_agg(format('%I = excluded.%I', k, k), ',') into v_set
  from unnest(v_keys) k
  where v_conflict = '' or k <> all (string_to_array(v_conflict, ','));

  v_sql := format('insert into %I.%I (%s) select %s from jsonb_populate_recordset(null::%I.%I, $1)',
                  v_schema, v_tbl, v_all, v_all, v_schema, v_tbl);
  if v_conflict <> '' then
    v_sql := v_sql || format(' on conflict (%s) do %s', v_conflict,
                             case when v_set is null then 'nothing' else 'update set ' || v_set end);
  end if;

  execute v_sql using p_rows;
  get diagnostics v_n = row_count;
  return v_n;
end $$;

create or replace function public.kb_begin_run(p_package_id text, p_version text, p_sha text)
returns jsonb language plpgsql security definer set search_path = kb_stage, public as $$
declare r kb_stage.ingestion_runs;
begin
  select * into r from kb_stage.ingestion_runs
   where package_id = p_package_id and package_version = p_version
     and coalesce(package_sha256,'') = coalesce(p_sha,'');
  if found then
    return jsonb_build_object('run_id', r.id, 'reused', true, 'status', r.status);
  end if;
  insert into kb_stage.ingestion_runs (package_id, package_version, package_sha256, status)
  values (p_package_id, p_version, coalesce(p_sha,''), 'started') returning * into r;
  return jsonb_build_object('run_id', r.id, 'reused', false, 'status', r.status);
end $$;

create or replace function public.kb_finish_run(p_run_id uuid, p_status text, p_inserted bigint,
                                                p_updated bigint, p_rejected bigint, p_report jsonb)
returns void language sql security definer set search_path = kb_stage, public as $$
  update kb_stage.ingestion_runs
     set status = coalesce(p_status,'completed'), completed_at = now(),
         inserted_count = coalesce(p_inserted,0), updated_count = coalesce(p_updated,0),
         rejected_count = coalesce(p_rejected,0), report = coalesce(p_report,'{}'::jsonb)
   where id = p_run_id;
$$;

create or replace function public.kb_get_hashes(p_package_id text)
returns jsonb language sql security definer set search_path = kb_stage, public as $$
  select coalesce(jsonb_object_agg(file_name, jsonb_build_object('sha256', sha256, 'rows_seen', rows_seen)), '{}'::jsonb)
  from kb_stage.file_hashes where package_id = p_package_id;
$$;

revoke all on function public.kb_stage_upsert(text, jsonb) from public, anon, authenticated;
revoke all on function public.kb_begin_run(text, text, text) from public, anon, authenticated;
revoke all on function public.kb_finish_run(uuid, text, bigint, bigint, bigint, jsonb) from public, anon, authenticated;
revoke all on function public.kb_get_hashes(text) from public, anon, authenticated;
grant execute on function public.kb_stage_upsert(text, jsonb) to service_role;
grant execute on function public.kb_begin_run(text, text, text) to service_role;
grant execute on function public.kb_finish_run(uuid, text, bigint, bigint, bigint, jsonb) to service_role;
grant execute on function public.kb_get_hashes(text) to service_role;
</file>

<file path="supabase/migrations/20260802124315_kb_deterministic_bilingual_router.sql">
-- DETERMINISTIC BILINGUAL ROUTER.
-- This is the piece that is supposed to make the platform cheaper and more predictable: first-pass
-- category routing with no model call at all. A model is only worth paying for when this returns
-- nothing or returns a tie.
--
-- kb_norm() must stay byte-identical in behaviour to the normaliser the importer used to write
-- alias_norm, or the index is useless. Arabic is the reason it is not just lower(): the same phrase
-- is typed with or without hamza on the alef (ا/أ/إ/آ), with ta-marbuta or ha (ة/ه), with ya or
-- alef-maqsura (ي/ى), and with or without harakat. A UAE buyer writing "مقاولو المرافق" must reach
-- the same route as the alias stored from the manifest even when neither of them agrees on hamza.
create or replace function public.kb_norm(p text)
returns text language sql immutable parallel safe as $$
  select nullif(
    btrim(regexp_replace(
      translate(
        regexp_replace(lower(normalize(coalesce(p,''), NFKC)), '[ً-ْٰـ]', '', 'g'),
        'أإآةىؤئ', 'اااهيوي'
      ),
      '[^[:alnum:]؀-ۿ]+', ' ', 'g')),
    '');
$$;

comment on function public.kb_norm(text) is
  'Normaliser shared by the alias importer and the router. Any change here invalidates every stored kb_operational_alias.alias_norm and the aliases must be re-imported.';

-- Scores every route against a customer sentence and explains itself.
-- Scoring, and why it is shaped this way:
--   * a match must be a WHOLE WORD or phrase - substring matching makes "AC" match "vacuum" and
--     "lift" match "shoplifting", and a router that is confidently wrong is worse than one that
--     asks;
--   * specificity beats frequency. "DEWA NOC" (2 words) outranks "electrical" (1 word) because the
--     score multiplies the alias weight by its word count. Without this, every construction inquiry
--     lands on whichever route happens to own the most generic vocabulary;
--   * negative aliases subtract, so a route can actively disown a phrase - that is how "lift" is
--     kept away from forklifts and how "materials" does not swallow "raw materials for catering".
create or replace function public.fn_kb_route(p_text text, p_limit int default 5)
returns table (catalog_num int, live_slug text, live_name text, score numeric,
               matched_aliases jsonb, languages text[])
language sql stable as $$
with q as (select ' ' || kb_norm(p_text) || ' ' as t),
hits as (
  select a.catalog_num, a.alias, a.language, a.weight, a.negative,
         array_length(string_to_array(a.alias_norm, ' '), 1) as words
  from public.kb_operational_alias a, q
  where length(a.alias_norm) >= 3
    and q.t like '%' || ' ' || a.alias_norm || ' ' || '%'
),
scored as (
  select h.catalog_num,
         sum(case when h.negative then -1 else 1 end * h.weight * h.words) as score,
         jsonb_agg(jsonb_build_object('alias', h.alias, 'lang', h.language,
                                      'w', h.weight, 'words', h.words, 'neg', h.negative)
                   order by h.weight * h.words desc) as matched,
         array_agg(distinct h.language) as langs
  from hits h group by h.catalog_num
)
select s.catalog_num, c.slug, c.name, s.score, s.matched, s.langs
from scored s join public.catalog_supplier_categories c on c.num = s.catalog_num
where s.score > 0
order by s.score desc, s.catalog_num
limit greatest(p_limit, 1);
$$;

-- The decision, separated from the scoring so the thresholds are visible and tunable in one place.
-- Returns exactly what the control pack asks a router to return: ranked candidates, confidence,
-- reasons, and an action - route, ask ONE clarifying question, or admit it has nothing.
create or replace function public.fn_kb_route_decide(p_text text)
returns jsonb language plpgsql stable as $$
declare
  v jsonb; top numeric; second numeric; n int; v_action text; v_conf numeric;
begin
  select coalesce(jsonb_agg(to_jsonb(r) order by r.score desc), '[]'::jsonb) into v
  from (select * from public.fn_kb_route(p_text, 5)) r;

  n := jsonb_array_length(v);
  if n = 0 then
    return jsonb_build_object(
      'action', 'ask_clarifying_question', 'confidence', 0, 'candidates', '[]'::jsonb,
      'reason', 'no deterministic alias matched the customer wording',
      'clarification', 'Could you tell me in your own words what you need done or supplied? For example "waterproof a warehouse roof" or "supply 200 office chairs".',
      'normalised', public.kb_norm(p_text));
  end if;

  top    := (v->0->>'score')::numeric;
  second := case when n > 1 then (v->1->>'score')::numeric else 0 end;

  -- Confidence is the winner's share of the top-two mass. Two routes tied at 12 give 0.5 and a
  -- question; a winner at 30 against a runner-up at 4 gives 0.88 and a route. The 0.62 threshold
  -- and the >=6 floor were set so the supplied "ambiguous" tests ask rather than guess, without
  -- making the exact-phrase tests ask too.
  v_conf := round(top / nullif(top + second, 0), 3);
  if top < 6 or v_conf < 0.62 then
    v_action := 'ask_clarifying_question';
  else
    v_action := 'route_or_ask_scope_details';
  end if;

  return jsonb_build_object(
    'action', v_action,
    'confidence', v_conf,
    'top_score', top,
    'candidates', v,
    'catalog_num', case when v_action = 'route_or_ask_scope_details' then (v->0->>'catalog_num')::int else null end,
    'multi_category', (n > 1 and second >= top * 0.75),
    'reason', case when v_action = 'route_or_ask_scope_details'
                   then 'deterministic alias match'
                   else 'leading routes are too close, or the match was too weak to act on' end,
    'clarification', case when v_action = 'ask_clarifying_question' then
        coalesce('Just to point this to the right suppliers - is this closer to "' ||
                 (v->0->>'live_name') || '" or "' || coalesce(v->1->>'live_name','something else') || '"?',
                 'Could you describe what you need in a little more detail?')
      end,
    'normalised', public.kb_norm(p_text));
end $$;

grant execute on function public.kb_norm(text), public.fn_kb_route(text,int), public.fn_kb_route_decide(text) to service_role;
</file>

<file path="supabase/migrations/20260802124428_kb_router_decision_thresholds_v2.sql">
-- ROUTER DECISION RULE, second pass.
-- The first thresholds (absolute floor of 6, confidence >= 0.62) failed 11 of the 258 supplied route
-- tests, and every failure was the same shape: a customer writing ONE unambiguous word - "hvac",
-- "catering", "law", "pharmaceutical" - matched exactly one route, at full confidence, and was asked
-- a clarifying question anyway. That is the worst possible behaviour: the buyer said the category
-- name and we pretended not to understand.
-- The floor was measuring the wrong thing. Score is a proxy for SPECIFICITY (weight x word count),
-- not for certainty; a single high-weight word is a perfect signal with a low score. Certainty is
-- the MARGIN over the runner-up, so that is what the decision uses now:
--   * nothing matched              -> ask. (All 86 supplied "ambiguous" tests land here on their own
--                                     merits - they contain no category vocabulary at all - so this
--                                     rule is doing the work, not a tuned threshold.)
--   * exactly one route matched    -> route. There is nothing to be ambiguous between.
--   * two or more matched          -> route only if the leader is at least 1.5x the runner-up,
--                                     otherwise ask ONE question naming the two real candidates.
-- The residual floor of 3 exists only to stop a single low-weight fragment from deciding anything.
create or replace function public.fn_kb_route_decide(p_text text)
returns jsonb language plpgsql stable as $$
declare
  v jsonb; top numeric; second numeric; n int; v_action text; v_conf numeric; v_reason text;
begin
  select coalesce(jsonb_agg(to_jsonb(r) order by r.score desc), '[]'::jsonb) into v
  from (select * from public.fn_kb_route(p_text, 5)) r;

  n := jsonb_array_length(v);
  if n = 0 then
    return jsonb_build_object(
      'action', 'ask_clarifying_question', 'confidence', 0, 'top_score', 0,
      'candidates', '[]'::jsonb, 'catalog_num', null, 'multi_category', false,
      'reason', 'no deterministic alias matched the customer wording',
      'clarification', 'Could you tell me in your own words what you need supplied or done? For example "waterproof a warehouse roof" or "supply 200 office chairs".',
      'normalised', public.kb_norm(p_text));
  end if;

  top    := (v->0->>'score')::numeric;
  second := case when n > 1 then (v->1->>'score')::numeric else 0 end;
  v_conf := round(top / nullif(top + second, 0), 3);

  if top < 3 then
    v_action := 'ask_clarifying_question';
    v_reason := 'only a weak fragment matched; not enough to act on';
  elsif n = 1 or top >= second * 1.5 then
    v_action := 'route_or_ask_scope_details';
    v_reason := case when n = 1 then 'single deterministic alias match'
                     else 'leading route is decisively ahead of the runner-up' end;
  else
    v_action := 'ask_clarifying_question';
    v_reason := 'leading routes are too close to call';
  end if;

  return jsonb_build_object(
    'action', v_action,
    'confidence', v_conf,
    'top_score', top,
    'candidates', v,
    'catalog_num', case when v_action = 'route_or_ask_scope_details' then (v->0->>'catalog_num')::int else null end,
    -- A genuinely multi-trade request (a fit-out that is also flooring and also joinery) is NOT an
    -- error to be collapsed to one route. Flagged so the intake can open several RFQs rather than
    -- forcing the buyer to pick one.
    'multi_category', (n > 1 and second >= top * 0.75),
    'reason', v_reason,
    'clarification', case when v_action = 'ask_clarifying_question' then
        'Just so this reaches the right suppliers - is this closer to "' || (v->0->>'live_name') ||
        '" or "' || coalesce(v->1->>'live_name', 'something else') || '"?' end,
    'normalised', public.kb_norm(p_text));
end $$;
</file>

<file path="supabase/migrations/20260802125615_kb_runtime_next_question_and_retrieval.sql">
-- RUNTIME LAYER. Importing 115,000 records changes nothing on its own; these two functions are how
-- the corpus actually replaces model calls.
--
-- A NOTE ON validation_status THAT MATTERS OPERATIONALLY: the corpus arrived with ZERO records at
-- 'approved' (71% reviewed, 19% source_verified, 10% draft), and the control pack forbids
-- mass-promoting them. So a retrieval layer written to filter on validation_status='approved' would
-- return nothing at all, forever, and every call would silently fall back to a premium model - the
-- exact cost the import was meant to remove. The rule used here instead:
--   * 'reviewed' and 'source_verified' are usable for CUSTOMER-FACING guidance;
--   * 'draft' is retrievable only for internal reasoning, never quoted to a customer;
--   * anything carrying an escalation_rule, or in the uae_regulations module, is returned with
--     escalate=true so the caller cites the authority instead of paraphrasing the law.
-- Promotion to 'approved' stays a human act, per package, and nothing here does it.

-- ---------------------------------------------------------------------------------------------
-- DETERMINISTIC NEXT QUESTION + COMPLETENESS.
-- This is the function that is supposed to make inquiry_ai cheap. Today a model is asked, on every
-- customer turn, which question to ask next and whether the brief is complete - at ~14,600 input
-- tokens a call. Both are now answerable from a table: the corpus ships 16,588 qualification
-- questions with mandatory flags, activation order and explicit missing-answer behaviour.
create or replace function public.fn_kb_next_question(p_catalog_num int, p_answered jsonb default '{}'::jsonb)
returns jsonb language plpgsql stable as $$
declare v_scope jsonb; v_next jsonb; v_missing jsonb; v_total int; v_answered int; v_blocking int;
begin
  -- scope = the knowledge subcategories this live catalogue route maps to
  with scope as (
    select m.package_slug, m.subcategory_slug, m.priority
    from public.kb_operational_route_map m where m.catalog_num = p_catalog_num
  ),
  qs as (
    select q.question_id, q.source_question_id, q.field_key, q.question_en, q.question_ar,
           q.answer_type, q.allowed_values, q.unit, q.mandatory, q.on_missing, q.impact,
           q.answerable_by_documents, q.category_slug, q.subcategory_slug,
           coalesce((q.activation->>'order')::int, 999) as ord
    from kb_stage.questions q
    join scope s on s.package_slug = q.category_slug and s.subcategory_slug = q.subcategory_slug
    where q.field_key is not null
  ),
  -- One question per field_key across all mapped subcategories. A composite route (signage maps to
  -- 3 packages) otherwise asks "which emirate?" seven times.
  dedup as (
    select distinct on (field_key) * from qs order by field_key, mandatory desc, ord, question_id
  ),
  open as (
    select * from dedup
    where not (p_answered ? field_key)
       or nullif(btrim(coalesce(p_answered->>field_key, '')), '') is null
  )
  select
    (select to_jsonb(o) from open o order by o.mandatory desc, o.ord, o.question_id limit 1),
    (select coalesce(jsonb_agg(jsonb_build_object('field_key', o.field_key, 'mandatory', o.mandatory,
                                                  'on_missing', o.on_missing) order by o.mandatory desc, o.ord), '[]'::jsonb)
       from open o),
    (select count(*) from dedup where mandatory),
    (select count(*) from dedup d where d.mandatory and p_answered ? d.field_key
        and nullif(btrim(coalesce(p_answered->>d.field_key,'')),'') is not null),
    (select count(*) from open o where o.mandatory
        and (o.on_missing is null or o.on_missing ilike 'block%' or o.on_missing ilike '%block%'))
  into v_next, v_missing, v_total, v_answered, v_blocking;

  return jsonb_build_object(
    'catalog_num', p_catalog_num,
    'next_question', v_next,
    'missing', v_missing,
    'mandatory_total', coalesce(v_total, 0),
    'mandatory_answered', coalesce(v_answered, 0),
    'completeness', case when coalesce(v_total,0) = 0 then null
                         else round(coalesce(v_answered,0)::numeric / v_total, 3) end,
    -- The single auditable gate the external reviewer asked for: one boolean, one query, one place.
    'dispatch_eligible', coalesce(v_blocking, 0) = 0,
    'blocking_count', coalesce(v_blocking, 0),
    'source', 'kb_stage.questions (deterministic, no model call)');
end $$;

comment on function public.fn_kb_next_question(int, jsonb) is
  'Deterministic replacement for asking a model "what should I ask next / is this brief complete". Returns the next unanswered question (EN+AR, answer type, allowed values), the full missing list, a completeness ratio and dispatch_eligible. No model call, no cost.';

-- ---------------------------------------------------------------------------------------------
-- RETRIEVAL. The control pack is explicit: send a model a few relevant records or exact source
-- extracts, never a category master. The masters average 1.8 MB each; one of them in a prompt is
-- roughly 450,000 tokens, which is both impossible and pointless.
create or replace function public.fn_kb_retrieve(p_catalog_num int, p_query text,
                                                 p_limit int default 6, p_modules text[] default null)
returns table (record_id text, title text, content text, module text, record_type text,
               authority text, validation_status text, confidence numeric, source_ids jsonb,
               escalate boolean, rank real)
language sql stable as $$
with scope as (
  select m.package_slug, m.subcategory_slug from public.kb_operational_route_map m
  where m.catalog_num = p_catalog_num
), q as (
  select websearch_to_tsquery('simple', coalesce(p_query, '')) tsq
)
select r.record_id, r.title, left(r.content, 4000), r.module, r.record_type, r.authority,
       r.validation_status, r.confidence, r.source_ids,
       (r.escalation_rule is not null or r.module = 'uae_regulations') as escalate,
       ts_rank(to_tsvector('simple', r.title || ' ' || left(r.content, 4000)), q.tsq) as rank
from kb_stage.records r
join scope s on s.package_slug = r.category_slug and s.subcategory_slug = r.subcategory_slug
cross join q
where r.validation_status in ('reviewed', 'source_verified', 'approved')
  and (p_modules is null or r.module = any (p_modules))
  and (q.tsq is null or to_tsvector('simple', r.title || ' ' || left(r.content, 4000)) @@ q.tsq)
order by rank desc, r.confidence desc nulls last, r.record_id
limit greatest(p_limit, 1);
$$;

comment on function public.fn_kb_retrieve(int, text, int, text[]) is
  'Returns at most a handful of relevant, non-draft records for one live catalogue route. Draft records are excluded from anything customer-facing; regulation records and anything with an escalation_rule come back with escalate=true so the caller cites the authority rather than paraphrasing it.';

create index if not exists kb_stage_records_fts_idx
  on kb_stage.records using gin (to_tsvector('simple', title || ' ' || left(content, 4000)));

grant execute on function public.fn_kb_next_question(int, jsonb) to service_role;
grant execute on function public.fn_kb_retrieve(int, text, int, text[]) to service_role;
</file>

<file path="supabase/migrations/20260802125730_kb_derive_missing_question_field_keys.sql">
-- FIELD KEYS: 13,557 of 16,588 qualification questions arrived without one.
-- Why this is not cosmetic. A question with no stable field key cannot be ANSWERED in a way the
-- system can remember. Without it you cannot tell whether the buyer has already said which emirate
-- the project is in, you cannot collapse the same question asked by seven mapped subcategories of a
-- composite route into one, you cannot build the spec object suppliers quote from, and you cannot
-- compute completeness - which means dispatch_eligible can never be true. The corpus would have been
-- 115,000 rows of text with no working deterministic layer, and every inquiry turn would have fallen
-- straight back to a premium model, which is the cost this whole exercise exists to remove.
--
-- The key IS recoverable, deterministically, because the supplied question_id encodes it:
--   Q-008-gypsum-boards-partitions-and-drywall-project-emirate
--   ^pkg ^subcategory_slug                     ^field
-- Strip 'Q-<digits>-<subcategory_slug>-' and normalise separators. Nothing is invented: where the
-- prefix does not match, the field key is left NULL and the question is reported in the gap register
-- rather than guessed at, because a wrong field key silently merges two different questions.
update kb_stage.questions q
set field_key = regexp_replace(
      lower(regexp_replace(q.source_question_id, '^Q-[0-9]+-' || q.subcategory_slug || '-', '')),
      '[^a-z0-9]+', '_', 'g')
where q.field_key is null
  and q.source_question_id is not null
  and q.source_question_id ~ ('^Q-[0-9]+-' || q.subcategory_slug || '-');

-- Second pass for the handful whose id carries a different package prefix shape.
update kb_stage.questions q
set field_key = regexp_replace(lower(regexp_replace(q.source_question_id, '^Q-[0-9]+-', '')), '[^a-z0-9]+', '_', 'g')
where q.field_key is null and q.source_question_id ~ '^Q-[0-9]+-';

-- Record what could not be recovered, so it is a visible gap rather than a silent hole.
insert into kb_stage.knowledge_gaps (package_id, category_slug, subcategory_slug, gap, severity, raw)
select 'derived', q.category_slug, q.subcategory_slug,
       'Qualification question has no derivable field_key, so its answer cannot be stored, deduplicated or counted towards completeness: ' || q.question_id,
       'high', jsonb_build_object('question_id', q.question_id, 'source_question_id', q.source_question_id)
from kb_stage.questions q
where q.field_key is null
  and not exists (select 1 from kb_stage.knowledge_gaps g
                  where g.raw->>'question_id' = q.question_id);

create index if not exists kb_stage_questions_fieldkey_scope_idx
  on kb_stage.questions (category_slug, subcategory_slug, field_key);
</file>

<file path="supabase/migrations/20260802125817_kb_derive_field_keys_pass_2_3.sql">
-- Field-key recovery, passes 2 and 3. A third id shape exists - lower-case
-- 'q-<subcategory_slug>-<field>' (e.g. q-holiday-homes-exact_requirement) - which the first pattern
-- missed because it only matched 'Q-<digits>-'. Same principle: strip the prefix the generator
-- built, never invent.
update kb_stage.questions q
set field_key = regexp_replace(
      lower(regexp_replace(q.source_question_id, '^[Qq]-' || q.subcategory_slug || '-', '')),
      '[^a-z0-9]+', '_', 'g')
where q.field_key is null
  and q.source_question_id is not null
  and q.source_question_id ~* ('^q-' || q.subcategory_slug || '-');

-- Pass 3: no usable id at all (3,031 rows). Here the ONLY stable identifier left is the question's
-- own internal label, which the generator wrote consistently ("scope type", "intended use",
-- "operating conditions"). Slugifying it is a real derivation, not a guess - two questions with the
-- same label inside one subcategory ARE the same question, which is exactly the dedup we want.
-- Marked in payload so a reviewer can tell derived keys from supplied ones.
update kb_stage.questions q
set field_key = regexp_replace(lower(btrim(coalesce(q.payload->>'internal_label_en', q.question_en))), '[^a-z0-9]+', '_', 'g'),
    payload = q.payload || jsonb_build_object('field_key_derived_from', 'internal_label_en')
where q.field_key is null
  and coalesce(nullif(btrim(coalesce(q.payload->>'internal_label_en', q.question_en)), ''), '') <> ''
  and length(regexp_replace(lower(btrim(coalesce(q.payload->>'internal_label_en', q.question_en))), '[^a-z0-9]+', '_', 'g')) between 2 and 80;

-- Trim leading/trailing separators left by the regexes.
update kb_stage.questions set field_key = btrim(field_key, '_')
where field_key like '\_%' or field_key like '%\_';
</file>

<file path="supabase/migrations/20260802130025_kb_dump_migrations_and_late_schema_fixes.sql">
-- Two things this project has repeatedly needed and never had.

-- 1. A way to get migrations applied through the management API back into the repository. Every
-- drift incident on this project has the same root: SQL that exists only in production because it
-- was applied from a tool rather than a checkout. This makes recovering it a single call.
create or replace function public.kb_dump_migrations(p_since text default '20260101000000')
returns jsonb language sql security definer set search_path = public as $$
  select coalesce(jsonb_agg(jsonb_build_object('version', version, 'name', name,
                                               'sql', array_to_string(statements, E'\n\n'))
                            order by version), '[]'::jsonb)
  from supabase_migrations.schema_migrations
  where version >= p_since;
$$;
revoke all on function public.kb_dump_migrations(text) from public, anon, authenticated;
grant execute on function public.kb_dump_migrations(text) to service_role;

-- 2. The two schema changes applied ad hoc during the import, recorded here so the repository is a
-- complete description of the database rather than a nearly-complete one.
alter table kb_stage.decision_rules add column if not exists source_rule_id text;
alter table kb_stage.decision_rules add column if not exists record_id text;
create index if not exists kb_stage_rules_srcid_idx
  on kb_stage.decision_rules (category_slug, subcategory_slug, source_rule_id);
comment on column kb_stage.decision_rules.source_rule_id is
  'rule_id as written inside the package. 39 of the 67 packages wrap their rules in the standard record envelope (rule body in structured_data) while 28 emit them flat; both land here keyed on a globally unique id, with the package-local id kept for cross-references from then_json.';
</file>

<file path="supabase/migrations/20260802130120_kb_retrieve_or_terms_ranking.sql">
-- Retrieval, second pass. The first version used websearch_to_tsquery, which ANDs every term: a
-- perfectly ordinary question - "liquid applied membrane warranty roof" - required all five words in
-- the same record and returned NOTHING for a category holding 3,000 relevant ones. In production
-- that reads as "the knowledge base is empty" and sends the caller straight to a premium model,
-- which is the exact cost this import exists to remove. Filtering should be permissive and RANKING
-- should discriminate: OR the terms with prefix matching, rank by ts_rank, return the top handful.
create or replace function public.fn_kb_retrieve(p_catalog_num int, p_query text,
                                                 p_limit int default 6, p_modules text[] default null)
returns table (record_id text, title text, content text, module text, record_type text,
               authority text, validation_status text, confidence numeric, source_ids jsonb,
               escalate boolean, rank real)
language sql stable as $$
with scope as (
  select m.package_slug, m.subcategory_slug from public.kb_operational_route_map m
  where m.catalog_num = p_catalog_num
), q as (
  select to_tsquery('simple',
           nullif(array_to_string(
             array(select w || ':*' from unnest(regexp_split_to_array(lower(coalesce(p_query,'')), '[^a-z0-9؀-ۿ]+')) w
                   where length(w) >= 3), ' | '), '')) tsq
)
select r.record_id, r.title, left(r.content, 4000), r.module, r.record_type, r.authority,
       r.validation_status, r.confidence, r.source_ids,
       (r.escalation_rule is not null or r.module = 'uae_regulations') as escalate,
       ts_rank(to_tsvector('simple', r.title || ' ' || left(r.content, 4000)), q.tsq) as rank
from kb_stage.records r
join scope s on s.package_slug = r.category_slug and s.subcategory_slug = r.subcategory_slug
cross join q
where r.validation_status in ('reviewed', 'source_verified', 'approved')
  and (p_modules is null or r.module = any (p_modules))
  and (q.tsq is null or to_tsvector('simple', r.title || ' ' || left(r.content, 4000)) @@ q.tsq)
order by rank desc, r.confidence desc nulls last, r.record_id
limit greatest(p_limit, 1);
$$;
</file>

<file path="supabase/migrations/20260802131757_ops_kb_stage_schema_2026_08_02.sql">
-- QuotesDone COMPANY OPERATIONS corpus — staging schema (2 Aug 2026).
-- Source: QuotesDone_COMPANY_OPERATIONS_KNOWLEDGE_v2026.07.31 (3,959 records, 24 departments).
-- Adapted from the supplied 01_STAGING_SCHEMA.sql. Five deliberate changes, each explained below.
--
-- WHY A SECOND STAGING SCHEMA RATHER THAN THE LIVE ORG TABLES. Every one of the 33 objects the
-- mapping guide names already EXISTS in production and is populated - org_departments (15 rows),
-- org_agents (67), dept_library (1,456), employee_knowledge (900), governance_policy (16). This
-- corpus describes 24 target departments and 96 target roles, i.e. a LARGER organisation than the
-- one running. Writing it straight into org_departments would create nine departments with no
-- agents, no authority rows and no health function, and the Command Center would immediately start
-- reporting them as broken. So the corpus lands here intact, the crosswalk between the two is
-- explicit and reviewable, and promotion is a separate decision per department.
create schema if not exists ops_kb_stage;
revoke all on schema ops_kb_stage from public, anon, authenticated;
grant usage on schema ops_kb_stage to service_role;

create table if not exists ops_kb_stage.ingestion_runs (
  id uuid primary key default gen_random_uuid(),
  package_name text not null,
  package_version text not null,
  package_sha256 text,
  status text not null default 'running'
    check (status in ('running','validated','failed','completed','completed_with_errors','rolled_back')),
  started_at timestamptz not null default now(),
  completed_at timestamptz,
  inserted_count bigint not null default 0,
  updated_count bigint not null default 0,
  skipped_count bigint not null default 0,
  rejected_count bigint not null default 0,
  detail jsonb not null default '{}'::jsonb
);

create table if not exists ops_kb_stage.ingestion_files (
  run_id uuid not null references ops_kb_stage.ingestion_runs(id) on delete cascade,
  relative_path text not null,
  sha256 text not null,
  size_bytes bigint,
  status text not null default 'pending'
    check (status in ('pending','validated','imported','skipped','rejected')),
  inserted_count bigint not null default 0,
  updated_count bigint not null default 0,
  skipped_count bigint not null default 0,
  rejected_count bigint not null default 0,
  last_record_id text,
  error_detail jsonb,
  primary key (run_id, relative_path)
);

create table if not exists ops_kb_stage.sources (
  source_id text primary key,
  title text not null,
  source_type text not null,
  publisher text,
  url_or_path text,
  status text,
  scope text,
  verified_on date,
  raw jsonb not null default '{}'::jsonb,
  imported_at timestamptz not null default now()
);

-- The canonical record table. Every field the pack requires preserved is a column, not a jsonb key:
-- implementation_status, validation_status, authority_tier and risk_level are the four that decide
-- whether a record may act, and burying them in jsonb is how they stop being enforced.
create table if not exists ops_kb_stage.records (
  record_id text primary key,
  scope_type text not null check (scope_type in ('company','department','workflow','agent','external_source')),
  scope_key text not null,
  module text not null,
  record_type text not null,
  title text not null,
  content text not null,
  structured_data jsonb not null default '{}'::jsonb,
  source_ids text[] not null default '{}',
  implementation_status text not null check (implementation_status in ('implemented','partial','target_state','external_reference')),
  validation_status text not null check (validation_status in ('source_verified','reviewed','draft','approved','quarantined','superseded')),
  authority_tier text not null check (authority_tier in ('advisory','supervised','gated','autonomous')),
  risk_level text not null check (risk_level in ('low','medium','high','critical')),
  version text not null,
  effective_date date,
  review_after date,
  keywords jsonb not null default '[]'::jsonb,
  dependencies jsonb not null default '[]'::jsonb,
  escalation_rule jsonb not null default '{}'::jsonb,
  content_sha256 text not null,
  package_version text not null,
  ingestion_run_id uuid references ops_kb_stage.ingestion_runs(id),
  source_file text,
  imported_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create index if not exists ops_kb_stage_records_scope_idx on ops_kb_stage.records(scope_type, scope_key, record_type);
create index if not exists ops_kb_stage_records_review_idx on ops_kb_stage.records(review_after)
  where validation_status not in ('superseded','quarantined');
create index if not exists ops_kb_stage_records_sources_gin on ops_kb_stage.records using gin(source_ids);
create index if not exists ops_kb_stage_records_structured_gin on ops_kb_stage.records using gin(structured_data);
create index if not exists ops_kb_stage_records_impl_idx on ops_kb_stage.records(implementation_status, authority_tier, risk_level);

-- ADDITION 1: version history. The security rules require append-only/versioned knowledge history,
-- which the supplied schema has no table for. Same trigger pattern as the supplier corpus.
create table if not exists ops_kb_stage.record_versions (
  id bigserial primary key,
  record_id text not null,
  version text not null,
  content_sha256 text,
  payload jsonb not null,
  replaced_at timestamptz not null default now(),
  ingestion_run_id uuid references ops_kb_stage.ingestion_runs(id) on delete set null
);
create index if not exists ops_kb_stage_record_versions_idx on ops_kb_stage.record_versions(record_id, replaced_at desc);

create or replace function ops_kb_stage.trg_archive_record_version() returns trigger
language plpgsql as $$
begin
  if TG_OP = 'UPDATE' and OLD.content_sha256 is distinct from NEW.content_sha256 then
    insert into ops_kb_stage.record_versions (record_id, version, content_sha256, payload, ingestion_run_id)
    values (OLD.record_id, OLD.version, OLD.content_sha256, to_jsonb(OLD), OLD.ingestion_run_id);
    NEW.updated_at := now();
  elsif TG_OP = 'UPDATE' then
    NEW.updated_at := OLD.updated_at;
  end if;
  return NEW;
end $$;
drop trigger if exists archive_record_version on ops_kb_stage.records;
create trigger archive_record_version before update on ops_kb_stage.records
  for each row execute function ops_kb_stage.trg_archive_record_version();

-- Relational projections. Everything deterministic lives here, not in an embedding.
create table if not exists ops_kb_stage.departments (
  department_key text primary key,
  name text not null,
  implementation_status text not null,
  charter text,
  north_star text,
  production_keys text[] not null default '{}',
  raw jsonb not null default '{}'::jsonb
);

create table if not exists ops_kb_stage.roles (
  record_id text primary key references ops_kb_stage.records(record_id) on delete cascade,
  agent_key text not null,
  department_key text not null,
  title text not null,
  responsibilities text,
  authority_tier text not null,
  max_authority text,
  manager text,
  raw jsonb not null default '{}'::jsonb
);
create index if not exists ops_kb_stage_roles_dept_idx on ops_kb_stage.roles(department_key);

create table if not exists ops_kb_stage.sops (
  record_id text primary key references ops_kb_stage.records(record_id) on delete cascade,
  department_key text not null,
  workflow_key text,
  trigger text,
  steps jsonb not null default '[]'::jsonb,
  required_inputs jsonb,
  required_outputs jsonb,
  definition_of_done jsonb,
  service_level text,
  rollback text,
  authority_tier text not null,
  raw jsonb not null default '{}'::jsonb
);
create index if not exists ops_kb_stage_sops_dept_idx on ops_kb_stage.sops(department_key);

-- enabled=false everywhere by design. The pack is explicit: imported rules and workflows stay
-- disabled until mapped, tested and approved. An imported rule that can fire is an activated rule.
create table if not exists ops_kb_stage.decision_rules (
  record_id text primary key references ops_kb_stage.records(record_id) on delete cascade,
  rule_id text not null unique,
  department_key text not null,
  priority int,
  condition jsonb,
  action jsonb,
  owner text,
  requires_human_review boolean not null default false,
  authority_tier text not null,
  enabled boolean not null default false,
  raw jsonb not null default '{}'::jsonb
);
create index if not exists ops_kb_stage_rules_dept_idx on ops_kb_stage.decision_rules(department_key, priority desc);

create table if not exists ops_kb_stage.exception_playbooks (
  record_id text primary key references ops_kb_stage.records(record_id) on delete cascade,
  exception_key text not null,
  department_key text not null,
  trigger text,
  immediate_actions jsonb,
  recovery jsonb,
  closure jsonb,
  enabled boolean not null default false,
  raw jsonb not null default '{}'::jsonb
);
create index if not exists ops_kb_stage_playbooks_dept_idx on ops_kb_stage.exception_playbooks(department_key);

create table if not exists ops_kb_stage.kpis (
  record_id text primary key references ops_kb_stage.records(record_id) on delete cascade,
  department_key text not null,
  metric_name text not null,
  formula_description text,
  direction text,
  source_candidates jsonb,
  owner text,
  query_sql text,
  enabled boolean not null default false,
  raw jsonb not null default '{}'::jsonb
);
create index if not exists ops_kb_stage_kpis_dept_idx on ops_kb_stage.kpis(department_key);

create table if not exists ops_kb_stage.scenarios (
  record_id text primary key references ops_kb_stage.records(record_id) on delete cascade,
  scenario_key text not null,
  scope_key text not null,
  kind text not null default 'department',
  situation text not null,
  expected_behaviour text not null,
  pass_criteria jsonb,
  last_result text,
  last_run timestamptz,
  raw jsonb not null default '{}'::jsonb
);
create index if not exists ops_kb_stage_scenarios_scope_idx on ops_kb_stage.scenarios(scope_key, kind);

create table if not exists ops_kb_stage.workflows (
  workflow_key text primary key,
  record_id text,
  name text not null,
  trigger text,
  departments text[] not null default '{}',
  steps jsonb not null default '[]'::jsonb,
  hard_gates text[] not null default '{}',
  audit_requirements jsonb,
  definition_of_done jsonb,
  implementation_status text not null,
  enabled boolean not null default false,
  raw jsonb not null default '{}'::jsonb
);

create table if not exists ops_kb_stage.handoffs (
  record_id text primary key references ops_kb_stage.records(record_id) on delete cascade,
  workflow_key text not null,
  from_department text not null,
  to_department text not null,
  sender_action text,
  receiver_action text,
  handoff_payload jsonb not null default '{}'::jsonb,
  acceptance text,
  rejection text,
  enabled boolean not null default false,
  raw jsonb not null default '{}'::jsonb
);
create index if not exists ops_kb_stage_handoffs_wf_idx on ops_kb_stage.handoffs(workflow_key);

-- ADDITION 2: the supplied schema has no home for the 100 event subscriptions, 120 templates or the
-- 28 governance policy records (model routing, memory, audit, data classification, incidents).
-- Without these tables a third of the corpus would have landed as narrative text only.
create table if not exists ops_kb_stage.event_subscriptions (
  record_id text primary key references ops_kb_stage.records(record_id) on delete cascade,
  event_type text not null,
  department_key text not null,
  reason text,
  active boolean not null default false,
  raw jsonb not null default '{}'::jsonb
);
create index if not exists ops_kb_stage_events_idx on ops_kb_stage.event_subscriptions(event_type, department_key);

create table if not exists ops_kb_stage.templates (
  record_id text primary key references ops_kb_stage.records(record_id) on delete cascade,
  department_key text not null,
  template_key text,
  purpose text,
  body text,
  raw jsonb not null default '{}'::jsonb
);
create index if not exists ops_kb_stage_templates_dept_idx on ops_kb_stage.templates(department_key);

create table if not exists ops_kb_stage.policies (
  record_id text primary key references ops_kb_stage.records(record_id) on delete cascade,
  policy_domain text not null,
  policy_key text,
  raw jsonb not null default '{}'::jsonb
);
create index if not exists ops_kb_stage_policies_idx on ops_kb_stage.policies(policy_domain);

-- ADDITION 3: hard gates get their own table. They are the list of things that must NEVER happen
-- autonomously - money movement, legal commitments, identity changes, production deployment. They
-- are worth being queryable on their own rather than filtered out of a jsonb blob at runtime.
create table if not exists ops_kb_stage.hard_gates (
  record_id text primary key references ops_kb_stage.records(record_id) on delete cascade,
  gate_key text not null,
  title text not null,
  rule text,
  raw jsonb not null default '{}'::jsonb
);

create table if not exists ops_kb_stage.live_bindings (
  record_id text primary key references ops_kb_stage.records(record_id) on delete cascade,
  department_key text not null,
  object_name text not null,
  object_kind text,
  found_in_export boolean,
  exists_in_db boolean,
  db_object_kind text,
  read_purpose text,
  write_policy text,
  cache_policy text,
  mapping_status text not null default 'unresolved'
    check (mapping_status in ('unresolved','mapped','validated','rejected','missing')),
  raw jsonb not null default '{}'::jsonb
);
create index if not exists ops_kb_stage_bindings_idx on ops_kb_stage.live_bindings(mapping_status, department_key);

-- ADDITION 4: the production/target department crosswalk as a table, not a CSV in a zip. This is the
-- single most contested object in the whole import - 15 production departments against 24 target
-- ones - and it needs to be queryable, reviewable and versioned.
create table if not exists ops_kb_stage.department_crosswalk (
  production_dept_key text not null,
  target_department_key text not null,
  mapping_type text not null,
