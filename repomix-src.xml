      <audio ref={audioRef} src={S.url} preload='metadata' onTimeUpdate={(e: any) => setCur(e.target.currentTime)} onEnded={() => setPlaying(false)} onLoadedMetadata={(e: any) => setDur(e.target.duration || S.duration)} className='hidden' />
    </Card>
