@tailwind base;
@tailwind components;
@tailwind utilities;

/* ══════════════════════════════════════════════════════════════════════
   QuotesDone — "THE BLIND MATCH"
   Two ownable primitives, everything derives from them:
     1. THE REDACTION BAR — identity as a withheld mark, never a name.
     2. THE NODE FIELD    — suppliers as anonymous points of light.
   Lighting: one key light from the engine. Raised surfaces take a 1px top
   highlight; shadows are navy-tinted, never black (black kills depth on navy).
   ══════════════════════════════════════════════════════════════════════ */
:root{
  --navy:#0C2330; --navy-deep:#06121B; --navy-hi:#173A4B;
  --bg:#0C2330; --bg-deep:#06121B; --surf:#123041;
  --teal:#14B8A6; --teal-light:#6EE7D4; --teal-deep:#0B8276;
  --gold:#E3C065; --gold-light:#F6DD8C;
  --paper:#EAF4F2; --muted:#9DB2B2; --faint:#7C97A3;
  --line:rgba(110,231,212,.10); --line2:rgba(110,231,212,.19);
  --redact:#14303E;
  --key:inset 0 1px 0 rgba(110,231,212,.10);
  --lift:0 40px 100px -55px rgba(0,12,20,.95);
  --e:cubic-bezier(.16,1,.3,1);
}
html{color-scheme:dark;scroll-behavior:smooth;-webkit-text-size-adjust:100%;
  background:linear-gradient(178deg,var(--navy-hi) 0%,var(--navy) 34%,var(--navy-deep) 100%) fixed,var(--navy-deep)}
html,body{padding:0;margin:0}
body{background:transparent;color:var(--paper);min-height:100dvh;-webkit-font-smoothing:antialiased}

/* every in-page anchor must clear the sticky header */
[id]{scroll-margin-top:88px}

/* THE NODE FIELD — fixed behind everything. Falloff is drawn into the canvas. */
#qd-field{position:fixed;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none;opacity:.62}
@media(max-width:1040px){#qd-field{opacity:.38}}

/* logical properties => RTL works automatically, no duplicate CSS */
.container-x{max-width:1200px;margin-inline:auto;padding-inline:24px}
@media(max-width:400px){.container-x{padding-inline:14px}}
@media(min-width:1024px){.container-x{padding-inline:40px}}

h1,h2,h3,h4{text-wrap:balance}
p{text-wrap:pretty}
::selection{background:rgba(20,184,166,.26);color:#fff}

/* ── THE REDACTION BAR ────────────────────────────────────────────────
   A grey rounded rect with a shimmer is the universal "still loading"
   idiom. Redaction is hard-edged, opaque and hatched — a mark that
   WITHHOLDS, not one that is pending. */
.redact{position:relative;display:inline-block;border-radius:1px;background:var(--redact);
  background-image:repeating-linear-gradient(115deg,rgba(110,231,212,.10) 0 2px,transparent 2px 6px);
  box-shadow:inset 0 0 0 1px rgba(110,231,212,.13);vertical-align:middle}
.redact-bar{height:14px;width:120px}
.redact-sq{height:34px;width:34px;border-radius:2px}

/* ── surfaces ─────────────────────────────────────────────────────── */
.surface{background:linear-gradient(170deg,rgba(18,48,65,.62),rgba(10,27,38,.62));
  border:1px solid var(--line);box-shadow:var(--key)}
.surface-hover{transition:border-color .22s var(--e),transform .22s var(--e)}
.surface-hover:hover{border-color:var(--line2);transform:translateY(-3px)}

/* ══════════════════════════════════════════════════════════════════════
   PREMIUM DEPTH LAYER
   Additive utilities that deepen the existing key-light model — never a
   new palette. Glass, layered navy-tinted shadow, neon hairline borders,
   and a soft mesh glow, all derived from the brand teal/gold/navy tokens.
   ══════════════════════════════════════════════════════════════════════ */

/* Glassmorphism: a lit, frosted surface that sits above the node field. */
.glass{
  background:linear-gradient(168deg,rgba(23,58,75,.55),rgba(10,27,38,.42));
  border:1px solid var(--line2);
  -webkit-backdrop-filter:blur(16px) saturate(140%);
  backdrop-filter:blur(16px) saturate(140%);
  box-shadow:var(--key),0 30px 80px -50px rgba(0,12,20,.95),0 2px 10px -6px rgba(0,12,20,.7);
}

/* Multi-layered luxury lift — stacked navy-tinted shadows read as real depth. */
.depth{
  box-shadow:
    var(--key),
    0 2px 6px -3px rgba(0,12,20,.55),
    0 12px 28px -14px rgba(0,12,20,.8),
    0 44px 110px -60px rgba(0,12,20,.98);
}

/* Neon hairline border that lights on hover — hyper-minimal, brand teal. */
.neon-edge{position:relative;isolation:isolate}
.neon-edge::before{
  content:'';position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;
  background:linear-gradient(140deg,rgba(110,231,212,.5),rgba(110,231,212,0) 42%,rgba(227,192,101,.4));
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  opacity:0;transition:opacity .35s var(--e);
}
@media (hover:hover){ .neon-edge:hover::before{opacity:1} }

/* Soft radial mesh glow — a single subtle accent bloom, no gradient soup. */
.mesh-glow{position:relative;isolation:isolate}
.mesh-glow::after{
  content:'';position:absolute;inset:-1px;z-index:-1;border-radius:inherit;pointer-events:none;
  background:
    radial-gradient(60% 90% at 15% 0%,rgba(20,184,166,.16),transparent 60%),
    radial-gradient(55% 80% at 100% 100%,rgba(227,192,101,.10),transparent 62%);
}

/* Ambient section bloom — a wide, low-opacity teal halo behind a hero band. */
.bloom{position:relative;isolation:isolate}
.bloom::before{
  content:'';position:absolute;z-index:-1;inset:auto;left:50%;top:0;translate:-50% -38%;
  width:min(1040px,130%);height:600px;pointer-events:none;
  background:radial-gradient(closest-side,rgba(20,184,166,.22),transparent 72%);
  filter:blur(10px);
}

/* Sharpen display type — optical rendering for razor-sharp headlines. */
.crisp{text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale}

/* ══════════════════════════════════════════════════════════════════════
   LIVING MOTION — always-on, ambient. This is what makes the page feel
   alive at rest: a slow brand-colored aurora drifts behind everything, the
   engine instrument breathes and scans, raised surfaces float. All of it is
   GPU-cheap (transform/opacity only) and fully disabled for reduced-motion.
   ══════════════════════════════════════════════════════════════════════ */

/* AURORA — a slow drift of teal/gold light behind the whole document. */
.aurora{
  position:fixed;inset:-25% -12% auto -12%;height:135vh;z-index:-1;pointer-events:none;
  background:
    radial-gradient(38% 44% at 20% 26%,rgba(20,184,166,.22),transparent 60%),
    radial-gradient(34% 40% at 84% 18%,rgba(227,192,101,.13),transparent 62%),
    radial-gradient(46% 52% at 66% 84%,rgba(11,130,118,.20),transparent 64%);
  filter:blur(34px);
  animation:qd-aurora 24s var(--e) infinite alternate;
  will-change:transform,opacity;
}
@keyframes qd-aurora{
  0%  {transform:translate3d(-3%,-2%,0) scale(1.05) rotate(0deg);  opacity:.72}
  50% {transform:translate3d(5%, 3%,0)  scale(1.16) rotate(4deg);  opacity:1}
  100%{transform:translate3d(-2%,4%,0)  scale(1.08) rotate(-3deg); opacity:.8}
}
@media(max-width:1040px){.aurora{opacity:.62;filter:blur(26px)}}

/* FLOAT — a gentle vertical drift for raised instruments/cards. */
@keyframes qd-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-11px)}}
.qd-float{animation:qd-float 7.5s var(--e) infinite;will-change:transform}

/* PULSE — a live-status halo that ripples outward. */
@keyframes qd-pulse{
  0%  {box-shadow:0 0 0 0 rgba(20,184,166,.55)}
  70% {box-shadow:0 0 0 9px rgba(20,184,166,0)}
  100%{box-shadow:0 0 0 0 rgba(20,184,166,0)}
}
.qd-pulse{animation:qd-pulse 2.4s ease-out infinite}

/* SCAN — a soft light sweep down the engine instrument, reading as "working". */
@keyframes qd-scan{0%{transform:translateY(-120%)}100%{transform:translateY(820%)}}
.qd-scan{position:absolute;inset-inline:0;top:0;height:14%;pointer-events:none;z-index:20;
  background:linear-gradient(180deg,transparent,rgba(110,231,212,.10),transparent);
  animation:qd-scan 5.5s var(--e) infinite;will-change:transform}

/* SHIMMER — a slow sheen that travels across a headline gradient. */
@keyframes qd-shimmer{0%{background-position:0% 50%}100%{background-position:200% 50%}}

@media (prefers-reduced-motion:reduce){
  .neon-edge::before{transition:none}
  .aurora,.qd-float,.qd-pulse,.qd-scan{animation:none}
}

/* ══════════════════════════════════════════════════════════════════════
   HUD / TECHNICAL LAYER
   A precision-instrument vocabulary that reframes the page from "cards on a
   background" to "readouts on an instrument": a faint measurement grid,
   L-shaped corner brackets, indexed section headers and a live node dot.
   All static or transform-only, brand teal, and cheap on mobile.
   ══════════════════════════════════════════════════════════════════════ */

/* Measurement grid — a faint blueprint plane, masked so it fades at edges. */
.grid-tech{position:absolute;inset:0;z-index:0;pointer-events:none;
  background-image:
    linear-gradient(rgba(110,231,212,.055) 1px,transparent 1px),
    linear-gradient(90deg,rgba(110,231,212,.055) 1px,transparent 1px);
  background-size:56px 56px;
  -webkit-mask-image:radial-gradient(ellipse 80% 74% at 50% 30%,#000 36%,transparent 78%);
  mask-image:radial-gradient(ellipse 80% 74% at 50% 30%,#000 36%,transparent 78%);
}
.grid-tech-sm{background-size:32px 32px}
@media(max-width:760px){.grid-tech{background-size:40px 40px}}

/* Four L-shaped corner brackets drawn with backgrounds — no extra elements. */
.corners{--cc:rgba(110,231,212,.5);--cs:15px;--ct:1px;pointer-events:none;
  background:
    linear-gradient(var(--cc),var(--cc)) 0 0/var(--cs) var(--ct) no-repeat,
    linear-gradient(var(--cc),var(--cc)) 0 0/var(--ct) var(--cs) no-repeat,
    linear-gradient(var(--cc),var(--cc)) 100% 0/var(--cs) var(--ct) no-repeat,
    linear-gradient(var(--cc),var(--cc)) 100% 0/var(--ct) var(--cs) no-repeat,
    linear-gradient(var(--cc),var(--cc)) 0 100%/var(--cs) var(--ct) no-repeat,
    linear-gradient(var(--cc),var(--cc)) 0 100%/var(--ct) var(--cs) no-repeat,
    linear-gradient(var(--cc),var(--cc)) 100% 100%/var(--cs) var(--ct) no-repeat,
    linear-gradient(var(--cc),var(--cc)) 100% 100%/var(--ct) var(--cs) no-repeat;
}

/* A live status dot with a soft breathing ring (used to head each section). */
.node-dot{position:relative;display:inline-block;width:7px;height:7px;border-radius:99px;
  background:var(--teal);box-shadow:0 0 10px rgba(20,184,166,.9)}
.node-dot::after{content:'';position:absolute;inset:-4px;border-radius:99px;
  border:1px solid rgba(20,184,166,.5);animation:qd-pulse 2.4s ease-out infinite}

/* A hairline connector rail for the process sequence. */
.rail{position:absolute;height:1px;top:0;inset-inline:0;
  background:linear-gradient(90deg,transparent,var(--line2) 12%,var(--line2) 88%,transparent)}

/* Techy press feedback — a crisp, satisfying push-down on tap. */
.press{transition:transform .13s var(--e)}
.press:active{transform:scale(.96)}
@media (prefers-reduced-motion:reduce){.node-dot::after{animation:none}.press{transition:none}}

/* ══════════════════════════════════════════════════════════════════════
   COMMAND-DECK REWORK LAYER
   The homepage is reframed as one continuous intelligent instrument:
   centered section kickers, a display type treatment, an animated data
   beam threading the process, a seamless marquee, and a rotating conic
   halo for the hero. Brand teal/gold only; all transform/opacity.
   ══════════════════════════════════════════════════════════════════════ */

/* Gradient display text — a teal→paper→gold sheen for the biggest headlines. */
.text-brand-grad{
  background:linear-gradient(96deg,#EAF4F2 0%,#6EE7D4 42%,#EAF4F2 62%,#E3C065 100%);
  background-size:200% 100%;
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
  animation:qd-shimmer 9s linear infinite;
}
@media (prefers-reduced-motion:reduce){.text-brand-grad{animation:none}}

/* A crisp hairline that separates each section with a centered node. */
.divider-node{position:relative;height:1px;
  background:linear-gradient(90deg,transparent,var(--line2) 20%,var(--line2) 80%,transparent)}
.divider-node::after{content:'';position:absolute;left:50%;top:50%;width:5px;height:5px;
  translate:-50% -50%;border-radius:99px;background:var(--teal);
  box-shadow:0 0 10px rgba(20,184,166,.9)}

/* Animated data beam — a pulse of light travels the process connector. */
.beam{position:absolute;top:0;inset-inline:0;height:1px;overflow:visible;
  background:linear-gradient(90deg,transparent,var(--line2) 12%,var(--line2) 88%,transparent)}
.beam::after{content:'';position:absolute;top:-1px;left:0;width:120px;height:3px;border-radius:99px;
  background:linear-gradient(90deg,transparent,rgba(110,231,212,.95),transparent);
  filter:blur(.3px);animation:qd-beam 4.6s var(--e) infinite}
@keyframes qd-beam{0%{left:-16%;opacity:0}12%{opacity:1}88%{opacity:1}100%{left:100%;opacity:0}}
[dir="rtl"] .beam::after{animation-direction:reverse}
@media (prefers-reduced-motion:reduce){.beam::after{animation:none;opacity:0}}

/* Seamless marquee for the trust/coverage ticker. */
.marquee{display:flex;width:max-content;animation:qd-marquee 34s linear infinite}
.marquee:hover{animation-play-state:paused}
@keyframes qd-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
[dir="rtl"] .marquee{animation-direction:reverse}
@media (prefers-reduced-motion:reduce){.marquee{animation:none}}

/* Rotating conic halo — a slow "engine ring" behind the hero instrument. */
.halo{position:absolute;border-radius:99px;pointer-events:none;z-index:-1;
  background:conic-gradient(from 0deg,transparent 0deg,rgba(20,184,166,.22) 60deg,transparent 140deg,rgba(227,192,101,.14) 220deg,transparent 300deg);
  filter:blur(30px);animation:qd-rotate 22s linear infinite;will-change:transform}
@keyframes qd-rotate{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.halo{animation:none}}

/* Numbered chip used across the reworked bento cards. */
.idx{font-variant-numeric:tabular-nums;font-feature-settings:"tnum";letter-spacing:.02em}

/* Card hover lift shared by the new bento tiles. */
.tile{transition:transform .4s var(--e),border-color .4s var(--e),box-shadow .4s var(--e)}
@media (hover:hover){.tile:hover{transform:translateY(-4px)}}
@media (prefers-reduced-motion:reduce){.tile{transition:none}.tile:hover{transform:none}}

/* ── the key light sweeps the primary action ──────────────────────── */
.btn-key{position:relative;overflow:hidden;isolation:isolate}
.btn-key::after{content:'';position:absolute;inset:0;transform:translateX(-120%);
  background:linear-gradient(100deg,transparent 35%,rgba(255,255,255,.42) 50%,transparent 65%)}
.btn-key:hover::after{transform:translateX(120%);transition:transform .75s var(--e)}
[dir="rtl"] .btn-key::after{transform:translateX(120%)}
[dir="rtl"] .btn-key:hover::after{transform:translateX(-120%)}

/* ── reveal ───────────────────────────────────────────────────────────
   CSS-only, scroll-driven. No JS, no IntersectionObserver, no class
   toggling — so there is no code path in which content can fail to appear.
   Browsers without scroll-driven animations (Safari, Firefox today) simply
   render the content, which is the correct fallback. `both` holds the end
   keyframe for anything already past the range at load, so above-the-fold
   content is never stuck in the start state. */
@keyframes qd-reveal{
  from{opacity:0;transform:translateY(22px) scale(.99);filter:blur(5px)}
  to  {opacity:1;transform:none;filter:none}
}
@supports (animation-timeline: view()){
  @media (prefers-reduced-motion: no-preference){
    .reveal{
      animation:qd-reveal 1ms linear both;
      animation-timeline:view();
      animation-range:entry 0% cover 26%;
    }
  }
}

/* ── focus, tap, notch ────────────────────────────────────────────── */
a:focus-visible,button:focus-visible{outline:2px solid var(--teal);outline-offset:3px;border-radius:6px}
button,a{touch-action:manipulation;-webkit-tap-highlight-color:rgba(20,184,166,.18)}
.tabular{font-variant-numeric:tabular-nums}



/* ── blog article prose ──────────────────────────────────────────────
   Bodies come from the CMS as raw HTML, so they are styled here rather
   than with utility classes. Measure is capped for readability. */
.qd-prose{color:#C3D6D4;font-size:16.5px;line-height:1.78}
.qd-prose > * + *{margin-top:1.15em}
.qd-prose p{text-wrap:pretty;max-width:70ch}
.qd-prose h2{font-family:var(--font-head),system-ui,sans-serif;color:#fff;font-weight:600;
  font-size:clamp(21px,2.4vw,27px);line-height:1.2;letter-spacing:-.028em;
  text-wrap:balance;margin-top:2.2em;margin-bottom:.5em}
.qd-prose h3{font-family:var(--font-head),system-ui,sans-serif;color:#fff;font-weight:600;
  font-size:18.5px;line-height:1.3;letter-spacing:-.02em;margin-top:1.8em;margin-bottom:.4em}
.qd-prose a{color:#6EE7D4;text-decoration:underline;text-underline-offset:3px;
  text-decoration-thickness:1px;transition:color .22s var(--e)}
.qd-prose a:hover{color:#fff}
.qd-prose strong,.qd-prose b{color:#fff;font-weight:600}
.qd-prose ul,.qd-prose ol{padding-inline-start:1.4em;max-width:70ch}
.qd-prose li{margin:.5em 0}
.qd-prose li::marker{color:#6EE7D4}
.qd-prose blockquote{border-inline-start:2px solid rgba(110,231,212,.35);
  padding-inline-start:1.1em;color:#9DB2B2;font-style:italic}
.qd-prose table{width:100%;border-collapse:collapse;font-size:14.5px;
  display:block;overflow-x:auto}
.qd-prose th,.qd-prose td{border:1px solid rgba(110,231,212,.10);padding:10px 12px;text-align:start}
.qd-prose th{background:rgba(110,231,212,.05);color:#fff;font-weight:600;white-space:nowrap}
.qd-prose code{font-family:var(--font-mono),ui-monospace,monospace;font-size:.9em;
  background:rgba(110,231,212,.06);padding:.15em .4em;border-radius:5px;color:#6EE7D4}
.qd-prose img{max-width:100%;height:auto;border-radius:14px}
.qd-prose hr{border:0;border-top:1px solid rgba(110,231,212,.10);margin:2em 0}

/* ---- shadcn/ui theme tokens (used only by the OS shell, wrapped in .osx) ---- */
@layer base {
  :root {
    --background: 205 52% 11%;
    --foreground: 180 25% 94%;
    --card: 204 44% 14%;
    --card-foreground: 180 25% 94%;
    --popover: 205 46% 12%;
    --popover-foreground: 180 25% 94%;
    --primary: 172 79% 40%;
    --primary-foreground: 205 52% 9%;
    --secondary: 200 34% 20%;
    --secondary-foreground: 180 25% 94%;
    --muted-foreground: 185 12% 66%;
    --accent: 43 68% 64%;
    --accent-foreground: 205 52% 11%;
    --destructive: 0 72% 51%;
    --destructive-foreground: 0 0% 100%;
    --border: 200 26% 22%;
    --input: 200 26% 24%;
    --ring: 172 79% 45%;
    --radius: 0.65rem;
  }
}
.osx { background: transparent; color: hsl(var(--foreground)); }
.osx * { border-color: hsl(var(--border)); }
.osx ::-webkit-scrollbar { width: 10px; height: 10px; }
.osx ::-webkit-scrollbar-thumb { background: rgba(255,255,255,.12); border-radius: 8px; }

/* ══ OS CONSOLE — deep-navy theme (scoped to .osx ONLY). The portal now shares
   the premium dark field of the marketing site instead of flipping to white:
   the dark qd-panel cards and #fff figures were built for a dark background,
   so a light root left dark cards floating on white. These tokens fix that. ══ */
.osx{
  --background: 205 52% 9%;
  --foreground: 180 25% 94%;
  --card: 204 44% 13%;
  --card-foreground: 180 25% 94%;
  --popover: 205 46% 11%;
  --popover-foreground: 180 25% 94%;
  --primary: 172 79% 42%;
  --primary-foreground: 205 52% 9%;
  --secondary: 200 34% 18%;
  --secondary-foreground: 180 25% 94%;
  --muted-foreground: 185 14% 64%;
  --accent: 43 68% 64%;
  --accent-foreground: 205 52% 11%;
  --destructive: 0 72% 51%;
  --destructive-foreground: 0 0% 100%;
  --border: 200 26% 22%;
  --input: 200 26% 24%;
  --ring: 172 79% 45%;
  --radius: 0.7rem;
  background: hsl(var(--background));
  color: hsl(var(--foreground));
}
.osx ::-webkit-scrollbar-thumb{ background: rgba(255,255,255,.14); border-radius: 8px; }
.osx ::selection{ background: hsl(173 80% 33% / .18); color: inherit; }
/* Give raised surfaces (shadcn Card = rounded + border + bg-card) a soft, modern
   shadow so the console reads as layered panels, not flat boxes. */
.osx .rounded-lg.border,
.osx .rounded-xl.border{ box-shadow: inset 0 1px 0 rgba(110,231,212,.05), 0 18px 44px -30px rgba(0,12,20,.9); }

/* ── PORTAL MATERIAL ───────────────────────────────────────────────────
   The portal already inherited the brand PALETTE (--primary is the brand
   teal), but not the brand MATERIAL. A flat card on a lit navy field reads
   as a form, not as a surface. These classes carry the same lighting model
   as the marketing surfaces: one key light from above, a 1px top highlight
   on anything raised, and navy-tinted shadow — black shadow kills depth on
   navy, which is why --lift is tinted. */
.qd-panel{
  position:relative;
  background:linear-gradient(170deg,rgba(18,48,65,.72),rgba(10,27,38,.72));
  border:1px solid var(--line);
  border-radius:14px;
  box-shadow:var(--key),0 24px 60px -40px rgba(0,12,20,.9);
  backdrop-filter:blur(6px);
}
/* the key-light highlight is a hairline, not a border: it must fade at the
   corners the way a real specular does, so it is drawn rather than stroked */
.qd-panel::before{
  content:'';position:absolute;inset-inline:14px;top:0;height:1px;pointer-events:none;
  background:linear-gradient(90deg,transparent,rgba(110,231,212,.30),transparent);
}
.qd-panel-hover{transition:border-color .22s var(--e),transform .22s var(--e),box-shadow .22s var(--e)}
@media (hover:hover){
  .qd-panel-hover:hover{border-color:var(--line2);transform:translateY(-2px);
    box-shadow:var(--key),0 34px 76px -44px rgba(0,12,20,.95)}
}
@media (prefers-reduced-motion:reduce){
  .qd-panel-hover{transition:none}
  .qd-panel-hover:hover{transform:none}
}

/* KPI numerals: tabular so columns of figures align, and optically tightened
   at display size the way the marketing headlines are */
.qd-figure{font-variant-numeric:tabular-nums;letter-spacing:-.03em;line-height:1.02;color:#fff}

/* Segmented tab bar — an inset well with a raised active pill, so the
   selected tab reads as nearer to the viewer rather than merely tinted. */
.qd-tabs{background:rgba(6,18,27,.55);border:1px solid var(--line);border-radius:12px;
  box-shadow:inset 0 1px 3px rgba(0,12,20,.55)}
.qd-tab{border-radius:9px;transition:color .18s var(--e),background .18s var(--e)}
.qd-tab:hover{color:var(--paper)}
.qd-tab-on{background:linear-gradient(180deg,rgba(20,184,166,.24),rgba(20,184,166,.13));
  color:var(--teal-light);box-shadow:inset 0 1px 0 rgba(110,231,212,.26),0 6px 16px -10px rgba(0,12,20,.9)}

/* Section rhythm: the portal was uniformly spaced, which flattens hierarchy. */
.qd-section + .qd-section{margin-top:26px}

/* ── PORTAL COMMAND-DECK ENTRY ─────────────────────────────────────────
   Aligns the supplier sign-in with the marketing site's command-deck
   language: a brand-mark badge, gradient title, and corner-bracket frame
   on the auth card, plus a hairline glow under the sticky top bar. */
.qd-topbar{box-shadow:0 1px 0 rgba(110,231,212,.10),0 18px 40px -34px rgba(0,12,20,.9)}
.qd-brandbadge{background:linear-gradient(168deg,rgba(20,184,166,.22),rgba(20,184,166,.05));
  border:1px solid var(--line2);
  box-shadow:inset 0 1px 0 rgba(110,231,212,.28),0 18px 34px -18px rgba(20,184,166,.7)}
.qd-grad-text{background:linear-gradient(96deg,#EAF4F2 0%,#6EE7D4 46%,#EAF4F2 62%,#E3C065 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}
/* Four corner ticks drawn from a single pseudo-element. */
.qd-login::after{content:'';position:absolute;inset:9px;pointer-events:none;opacity:.5;
  background:
   linear-gradient(#6ee7d4,#6ee7d4) 0 0/13px 2px,
   linear-gradient(#6ee7d4,#6ee7d4) 0 0/2px 13px,
   linear-gradient(#6ee7d4,#6ee7d4) 100% 0/13px 2px,
   linear-gradient(#6ee7d4,#6ee7d4) 100% 0/2px 13px,
   linear-gradient(#6ee7d4,#6ee7d4) 0 100%/13px 2px,
   linear-gradient(#6ee7d4,#6ee7d4) 0 100%/2px 13px,
   linear-gradient(#6ee7d4,#6ee7d4) 100% 100%/13px 2px,
   linear-gradient(#6ee7d4,#6ee7d4) 100% 100%/2px 13px;
  background-repeat:no-repeat}

/* ══════════════════════════════════════════════════════════════════
   ARABIC TYPOGRAPHY LAYER
   Tailwind utilities are direction-agnostic, so every tracking-*,
   uppercase and tight leading-* on a shared component also lands on
   Arabic. In Arabic all three are wrong:
     · letter-spacing severs letter-joining (the script is cursive)
     · uppercase is a no-op that leaves the tracking damage behind
     · Latin leading crowds Arabic ascenders/descenders
   Selector specificity (0,1,1)+ beats Tailwind's (0,1,0), so no
   !important is needed. English is completely untouched.
   ══════════════════════════════════════════════════════════════════ */
html[dir="rtl"] :is(h1,h2,h3,h4,h5,h6,p,a,span,div,li,button,label,strong,em,dt,dd,td,th,small,figcaption,blockquote){
  letter-spacing:0;
}
html[dir="rtl"] .uppercase,html[dir="rtl"] [class*="uppercase"]{ text-transform:none; }
html[dir="rtl"] :is(h1,h2,h3,h4){ line-height:1.45; }
html[dir="rtl"] p{ line-height:1.9; }
/* Arabic has no serif/sans axis — hierarchy comes from weight, so give
   headings real weight separation instead of a second family. */
html[dir="rtl"] :is(h1,h2,h3){ font-weight:800; }
/* Latin runs inside Arabic (brand name, AED figures, licence no.)
   must not be re-ordered by the bidi algorithm. */
[dir="rtl"] .ltr{ direction:ltr; unicode-bidi:isolate; }
[dir="rtl"] .tabular{ font-variant-numeric:tabular-nums; direction:ltr; unicode-bidi:isolate; }
/* gradient-clipped text renders poorly across joined Arabic glyphs */
[dir="rtl"] .bg-clip-text{
  background:none !important; -webkit-text-fill-color:currentColor; color:#F6DD8C;
}

/* Doc pages (FAQ / legal / services / marketing) inject their own <style>
   via dangerouslySetInnerHTML with .mk/.lg-scoped selectors at (0,2,0),
   which outranks the rules above and re-applies Latin tracking to Arabic.
   Arabic letter-joining is a correctness requirement, not a preference,
   so these are !important and scoped strictly to [dir=rtl]. English is
   never matched by any of it. */
html[dir="rtl"] body *{ letter-spacing:0 !important; }
html[dir="rtl"] body *{ text-transform:none !important; }
html[dir="rtl"] :is(h1,h2,h3,h4){ line-height:1.45 !important; }
html[dir="rtl"] :is(p,li){ line-height:1.9 !important; }
</file>

