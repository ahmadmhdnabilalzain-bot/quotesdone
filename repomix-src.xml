create or replace function public.fn_control_mode_require(p_actor_email text, p_action text)
returns jsonb language plpgsql security definer set search_path to 'public' as $fn$
declare v_class text; v_s record;
begin
  select classification into v_class from public.control_mode_action where action = p_action;

  -- FAIL CLOSED. An action nobody classified is an action nobody thought about, and the cost of
  -- being wrong is asymmetric: refusing a read is an inconvenience, allowing an unreviewed mutation
  -- is the incident. The refusal is audited so the missing classification is discoverable.
  if v_class is null then
    insert into public.control_mode_audit (actor_email, event, action, allowed, reason)
    values (p_actor_email, 'action_unclassified', p_action, false, 'action is not in control_mode_action');
    return jsonb_build_object(
      'allowed', false, 'mode', 'observe', 'error', 'action_classification_required',
      'message', 'This action has not been classified as read-only or mutating, so it is refused. '
              || 'Classify it in control_mode_action (and in os_api ACTION_CLASS) before using it.');
  end if;

  if v_class = 'read_only' then
    return jsonb_build_object('allowed', true, 'mode', 'observe', 'reason', 'action is registered read-only');
  end if;

  if v_class = 'mode_control' then
    return jsonb_build_object('allowed', true, 'mode', 'observe', 'reason', 'Control Mode plumbing; handled before the gate');
  end if;

  select * into v_s from public.control_mode_session
   where actor_email = p_actor_email and closed_at is null and expires_at > now()
   order by opened_at desc limit 1;

  if not found then
    insert into public.control_mode_audit (actor_email, event, action, allowed, reason)
    values (p_actor_email, 'action_denied', p_action, false, 'no active Control Mode session');
    return jsonb_build_object('allowed', false, 'mode', 'observe', 'error', 'control_mode_required',
      'message', 'This changes something, so it needs Control Mode. Open it with a code sent to your phone, and say why.');
  end if;

  update public.control_mode_session set actions_used = actions_used + 1 where id = v_s.id;
  insert into public.control_mode_audit (actor_email, event, action, session_id, allowed, reason)
  values (p_actor_email, 'action_allowed', p_action, v_s.id, true, v_s.reason);

  return jsonb_build_object('allowed', true, 'mode', 'control', 'session_id', v_s.id, 'reason', v_s.reason,
                            'seconds_remaining', greatest(0, extract(epoch from (v_s.expires_at - now()))::int));
end $fn$;

revoke all on function public.fn_control_mode_require(text, text) from public, anon, authenticated;

create or replace view public.v_os_action_classification as
select classification, count(*) as actions,
       string_agg(action, ', ' order by action) as action_list
from public.control_mode_action group by classification;

comment on table public.control_mode_action is
  'Every os_api action, explicitly classified. An action absent from this table is refused by fn_control_mode_require with action_classification_required - absence is never permission.';
</file>

<file path="supabase/migrations/20260802150755_p1h_02_control_mode_purpose_bound_challenge.sql">
-- PHASE 1 HARDENING 2 - CONTROL MODE MFA IS PURPOSE-BOUND
--
-- WHAT WAS WRONG. fn_control_mode_open consumed any unused public.phone_verifications row matching
-- the phone. That table is written by login_otp (sign-in) and kyc (customer / supplier contact
-- confirmation). So a code issued to sign in - or to a supplier confirming their own mobile - was a
-- valid Control Mode credential. The user never consented to raising privilege; they consented to
-- logging in. It also accepted the code in plaintext as well as hashed, so any path that ever wrote
-- an unhashed code would have been a second way in.
--
-- WHAT REPLACES IT. A challenge that only exists for this purpose:
--   * bound to a registered admin identity (control_mode_identity), not to whoever knows a phone
--   * purpose = 'control_mode', constrained, so it cannot be minted for anything else
--   * the phone is resolved at challenge time from app_secrets - it is configuration, never source
--   * a one-time nonce the caller must return, so the challenge id alone is not enough
--   * short expiry, an attempt limit, and single consumption
-- phone_verifications is no longer read by Control Mode at all.

create table if not exists public.control_mode_identity (
  admin_email       text primary key,
  phone_secret_key  text not null default 'admin_mfa_phone',
  active            boolean not null default true,
  note              text,
  created_at        timestamptz not null default now()
);
comment on table public.control_mode_identity is
  'Who may open Control Mode, and which app_secrets key holds the number their code goes to. The number itself is never stored here and never appears in source - changing it is one app_secrets update.';

-- Seed from the existing admin list. Read straight out of app_secrets so no address is retyped
-- into a migration.
insert into public.control_mode_identity (admin_email, note)
select distinct lower(btrim(e)), 'seeded from app_secrets.admin_emails, 2 Aug 2026'
  from regexp_split_to_table(coalesce((select value from public.app_secrets where key='admin_emails'),''), '[,;[:space:]]+') e
 where btrim(e) <> ''
on conflict (admin_email) do nothing;

create table if not exists public.control_mode_challenge (
  id            uuid primary key default gen_random_uuid(),
  admin_email   text not null references public.control_mode_identity(admin_email) on delete cascade,
  purpose       text not null default 'control_mode',
  nonce         text not null,
  code_hash     text not null,
  phone_tail    text,
  expires_at    timestamptz not null,
  attempts      int not null default 0,
  max_attempts  int not null default 5,
  consumed_at   timestamptz,
  consumed_why  text,
  ip            text,
  created_at    timestamptz not null default now(),
  constraint control_mode_challenge_purpose_chk check (purpose = 'control_mode')
);
create index if not exists control_mode_challenge_open_idx
  on public.control_mode_challenge (admin_email, consumed_at, expires_at);

alter table public.control_mode_identity  enable row level security;
alter table public.control_mode_challenge enable row level security;

create or replace function public.fn_control_mode_challenge_minutes()
returns int language sql stable security definer set search_path to 'public' as $fn$
  select greatest(1, least(15, coalesce((select value from public.app_secrets where key='control_mode_challenge_minutes')::int, 5)));
$fn$;

-- Start a challenge. The caller (os_api) generates the code and passes only its HMAC, so the
-- plaintext exists in exactly two places: the edge function's memory for the length of one request,
-- and the message on the founder's phone. It is never stored and never returned.
create or replace function public.fn_control_mode_challenge_start(
  p_actor_email text, p_code_hash text, p_ip text default null)
returns jsonb language plpgsql security definer set search_path to 'public' as $fn$
declare v_id record; v_phone text; v_recent int; v_row public.control_mode_challenge%rowtype; v_min int;
begin
  select * into v_id from public.control_mode_identity
   where admin_email = lower(btrim(p_actor_email)) and active;
  if not found then
    insert into public.control_mode_audit (actor_email, event, allowed, reason)
    values (p_actor_email, 'challenge_denied', false, 'not a registered Control Mode identity');
    return jsonb_build_object('ok', false, 'error', 'not_a_control_mode_identity',
      'message', 'This account is not registered for Control Mode. Registering one is itself a Control Mode change.');
  end if;

  select value into v_phone from public.app_secrets where key = v_id.phone_secret_key;
  if coalesce(length(btrim(v_phone)),0) < 8 then
    insert into public.control_mode_audit (actor_email, event, allowed, reason)
    values (p_actor_email, 'challenge_denied', false, 'no phone configured at ' || v_id.phone_secret_key);
    return jsonb_build_object('ok', false, 'error', 'control_mode_phone_not_configured',
      'message', 'No Control Mode phone number is configured. Set app_secrets.' || v_id.phone_secret_key || '.');
  end if;

  -- Rate limit. Without one, an attacker with a session cookie can spray the founder's phone until
  -- a code is approved out of irritation.
  select count(*) into v_recent from public.control_mode_challenge
   where admin_email = v_id.admin_email and created_at > now() - interval '1 hour';
  if v_recent >= 5 then
    insert into public.control_mode_audit (actor_email, event, allowed, reason)
    values (p_actor_email, 'challenge_denied', false, 'rate limit: 5 challenges per hour');
    return jsonb_build_object('ok', false, 'error', 'too_many_challenges',
      'message', 'Too many Control Mode codes requested in the last hour. Wait, then try again.');
  end if;

  -- Anything still open is void. Two live codes means two ways in.
  update public.control_mode_challenge
     set consumed_at = now(), consumed_why = 'superseded'
   where admin_email = v_id.admin_email and consumed_at is null;

  v_min := public.fn_control_mode_challenge_minutes();
  insert into public.control_mode_challenge (admin_email, nonce, code_hash, phone_tail, expires_at, ip)
  values (v_id.admin_email, encode(extensions.gen_random_bytes(18), 'hex'), p_code_hash,
          right(btrim(v_phone), 4), now() + make_interval(mins => v_min), p_ip)
  returning * into v_row;

  insert into public.control_mode_audit (actor_email, event, allowed, reason, detail)
  values (p_actor_email, 'challenge_started', true, 'control_mode challenge issued',
          jsonb_build_object('challenge_id', v_row.id, 'phone_tail', v_row.phone_tail, 'minutes', v_min));

  return jsonb_build_object('ok', true, 'challenge_id', v_row.id, 'nonce', v_row.nonce,
                            'expires_at', v_row.expires_at, 'phone_tail', v_row.phone_tail,
                            'phone', btrim(v_phone), 'minutes', v_min);
end $fn$;

-- The old generic-verification opener. Dropped, not left beside the new one: leaving it would mean
-- the weaker path is still callable and the hardening is decoration.
drop function if exists public.fn_control_mode_open(text, text, text, text, uuid, text, text);

create or replace function public.fn_control_mode_open(
  p_actor_email text, p_reason text, p_challenge_id uuid, p_nonce text, p_code text,
  p_user_id uuid default null, p_ip text default null, p_ua text default null)
returns jsonb language plpgsql security definer set search_path to 'public' as $fn$
declare v_c public.control_mode_challenge%rowtype; v_id uuid; v_min int := public.fn_control_mode_minutes();
begin
  if coalesce(btrim(p_reason),'') = '' then
    insert into public.control_mode_audit (actor_email, event, allowed, reason)
    values (p_actor_email, 'open_denied', false, 'no reason given');
    return jsonb_build_object('ok', false, 'error', 'reason_required',
      'message', 'Control Mode needs a reason. It is written into the audit trail beside whatever you change.');
  end if;

  select * into v_c from public.control_mode_challenge
   where id = p_challenge_id
     and admin_email = lower(btrim(p_actor_email))
     and purpose = 'control_mode'
   for update;

  if not found then
    insert into public.control_mode_audit (actor_email, event, allowed, reason)
    values (p_actor_email, 'open_denied', false, 'no such Control Mode challenge for this identity');
    return jsonb_build_object('ok', false, 'error', 'challenge_not_found',
      'message', 'That Control Mode request does not exist, or belongs to a different account. Start a new one.');
  end if;

  if v_c.consumed_at is not null then
    insert into public.control_mode_audit (actor_email, event, allowed, reason)
    values (p_actor_email, 'open_denied', false, 'challenge already used: ' || coalesce(v_c.consumed_why,'used'));
    return jsonb_build_object('ok', false, 'error', 'challenge_already_used',
      'message', 'That code has already been used. Request a new one.');
  end if;

  if v_c.expires_at <= now() then
    update public.control_mode_challenge set consumed_at = now(), consumed_why = 'expired' where id = v_c.id;
    insert into public.control_mode_audit (actor_email, event, allowed, reason)
    values (p_actor_email, 'open_denied', false, 'challenge expired');
    return jsonb_build_object('ok', false, 'error', 'challenge_expired',
      'message', 'That code has expired. Request a new one.');
  end if;

  if v_c.attempts >= v_c.max_attempts then
    update public.control_mode_challenge set consumed_at = now(), consumed_why = 'attempts_exhausted' where id = v_c.id;
    insert into public.control_mode_audit (actor_email, event, allowed, reason)
    values (p_actor_email, 'open_denied', false, 'attempt limit reached');
    return jsonb_build_object('ok', false, 'error', 'too_many_attempts',
      'message', 'Too many wrong codes. That request is closed - start a new one.');
  end if;

  -- Nonce and code are checked together, and only the hashed code is ever compared.
  if v_c.nonce <> coalesce(p_nonce,'') or v_c.code_hash <> public.fn_otp_hash(coalesce(p_code,'')) then
    update public.control_mode_challenge set attempts = attempts + 1 where id = v_c.id;
    insert into public.control_mode_audit (actor_email, event, allowed, reason, detail)
    values (p_actor_email, 'open_denied', false, 'mfa_failed',
            jsonb_build_object('attempt', v_c.attempts + 1, 'of', v_c.max_attempts));
    return jsonb_build_object('ok', false, 'error', 'mfa_failed',
      'attempts_left', greatest(0, v_c.max_attempts - (v_c.attempts + 1)),
      'message', 'That code is not right. Check the message and try again.');
  end if;

  update public.control_mode_challenge set consumed_at = now(), consumed_why = 'opened' where id = v_c.id;

  update public.control_mode_session
     set closed_at = now(), closed_reason = 'superseded by a new session'
   where actor_email = p_actor_email and closed_at is null;

  insert into public.control_mode_session (user_id, actor_email, reason, expires_at, mfa_method, mfa_ref, ip, user_agent)
  values (p_user_id, p_actor_email, btrim(p_reason), now() + make_interval(mins => v_min),
          'control_mode_challenge', v_c.id, p_ip, left(coalesce(p_ua,''), 300))
  returning id into v_id;

  insert into public.control_mode_audit (actor_email, event, session_id, allowed, reason, detail)
  values (p_actor_email, 'open', v_id, true, btrim(p_reason),
          jsonb_build_object('minutes', v_min, 'ip', p_ip, 'challenge_id', v_c.id));

  return jsonb_build_object('ok', true, 'session_id', v_id, 'expires_at', now() + make_interval(mins => v_min),
                            'minutes', v_min,
                            'message', 'Control Mode is open for ' || v_min || ' minutes. It closes on its own.');
end $fn$;

-- Sweep expired challenges alongside expired sessions, on the cron that already runs every 5 min.
create or replace function public.fn_control_mode_sweep()
returns integer language plpgsql security definer set search_path to 'public' as $fn$
declare v_sessions int;
begin
  with c as (
    update public.control_mode_session set closed_at = now(), closed_reason = 'expired'
     where closed_at is null and expires_at <= now() returning id, actor_email
  ), a as (
    insert into public.control_mode_audit (actor_email, event, session_id, allowed, reason)
    select actor_email, 'expired', id, true, 'session timed out' from c
  )
  select count(*)::int into v_sessions from c;

  update public.control_mode_challenge
     set consumed_at = now(), consumed_why = 'expired'
   where consumed_at is null and expires_at <= now();

  delete from public.control_mode_challenge where consumed_at < now() - interval '7 days';

  return v_sessions;
end $fn$;

revoke all on function public.fn_control_mode_challenge_start(text, text, text) from public, anon, authenticated;
revoke all on function public.fn_control_mode_open(text, text, uuid, text, text, uuid, text, text) from public, anon, authenticated;
revoke all on function public.fn_control_mode_sweep() from public, anon, authenticated;
revoke all on function public.fn_control_mode_challenge_minutes() from public, anon, authenticated;

create or replace view public.v_control_mode_identity as
select admin_email, phone_secret_key, active,
       (select right(btrim(value),4) from public.app_secrets s where s.key = i.phone_secret_key) as phone_tail,
       note, created_at
from public.control_mode_identity i;
</file>

<file path="supabase/migrations/20260802151052_p1h_03_register_control_mode_challenge_action.sql">
-- control_mode_challenge is the new first step of opening Control Mode. It is mode_control for the
-- same reason control_mode_open is: requiring Control Mode to request a Control Mode code would make
-- Control Mode unopenable. It is safe outside the gate because it takes no input that selects a
-- destination - the phone comes from the identity registration, not the request - and it is rate
-- limited to five per hour per identity.
alter table public.control_mode_action drop constraint if exists control_mode_action_mode_control_pinned;
alter table public.control_mode_action
  add constraint control_mode_action_mode_control_pinned
  check (classification <> 'mode_control'
         or action in ('control_mode_status','control_mode_open','control_mode_close','control_mode_challenge'));

insert into public.control_mode_action (action, classification, risk, description) values
  ('control_mode_challenge','mode_control','high',
   'Mints a Control Mode code and sends it to the registered admin phone. Rate limited; never accepts a phone from the request.')
on conflict (action) do update
  set classification = excluded.classification, risk = excluded.risk, description = excluded.description;
</file>

<file path="supabase/migrations/20260802151535_p1h_04_single_source_supplier_pricing.sql">
-- PHASE 1 HARDENING 4 - ONE SOURCE OF TRUTH FOR THE SUPPLIER SUBSCRIPTION
--
-- WHAT THE PRICING TEST FOUND. Phase 1.2 CHECK-locked pricing_config.supplier_reg_fee / _currency /
-- _period. But nothing that actually charges a supplier reads pricing_config:
--   fn_subscription_billing_run -> app_secrets.supplier_subscription_aed  (default 1000)
--   v_supplier_billing          -> app_secrets.supplier_subscription_aed, .supplier_subscription_start,
--                                  .founding_free_limit
--   supplier_api pay_registration -> leads.registration_fee_due, written by the run above
-- Both currently say 1000, so there is no live discrepancy - but the constraint was guarding a value
-- the biller never reads. Two sources that agree by luck are one silent incident away from two
-- sources that do not, and the one under a CHECK was the wrong one.
--
-- This collapses them. fn_supplier_subscription() is now the only place the fee, currency, period,
-- start date and free limit are resolved: pricing_config first (constrained), app_secrets second
-- (operational override, still honoured so nothing breaks), literal last. Every reader goes through
-- it, and v_pricing_consistency reports if the two ever disagree.

create or replace function public.fn_supplier_subscription()
returns table (fee numeric, currency text, period text, start_date date, free_limit int,
               fee_source text, start_source text, free_source text)
language sql stable security definer set search_path to 'public' as $fn$
  with pc as (select * from public.pricing_config order by id limit 1),
       s as (
         select
           (select nullif(value,'')::numeric from public.app_secrets where key='supplier_subscription_aed')  as fee,
           (select nullif(value,'')::date    from public.app_secrets where key='supplier_subscription_start') as start_date,
           (select nullif(value,'')::int     from public.app_secrets where key='founding_free_limit')         as free_limit
       )
  select
    coalesce((select supplier_reg_fee::numeric from pc), (select fee from s), 1000)                as fee,
    coalesce((select supplier_reg_currency from pc), 'AED')                                        as currency,
    coalesce((select supplier_reg_period   from pc), 'yearly')                                     as period,
    coalesce((select start_date from s), date '2027-08-01')                                        as start_date,
    coalesce((select supplier_free_count from pc), (select free_limit from s), 1000)               as free_limit,
    case when (select supplier_reg_fee from pc) is not null then 'pricing_config'
         when (select fee from s) is not null then 'app_secrets' else 'default' end                as fee_source,
    case when (select start_date from s) is not null then 'app_secrets' else 'default' end         as start_source,
    case when (select supplier_free_count from pc) is not null then 'pricing_config'
         when (select free_limit from s) is not null then 'app_secrets' else 'default' end         as free_source;
$fn$;

-- Rebuilt to read the resolver rather than app_secrets directly. Logic below the cfg CTE is
-- unchanged, deliberately: this migration moves where the numbers come from, nothing else.
create or replace view public.v_supplier_billing as
 WITH cfg AS (
     SELECT s.start_date, s.fee, s.free_limit,
            COALESCE((SELECT lower(a.value) = 'true' FROM app_secrets a WHERE a.key = 'subscription_honour_12m'), false) AS honour_12m
       FROM public.fn_supplier_subscription() s
    ), s AS (
     SELECT l.id AS supplier_id, l.company_name, l.claimed_by AS email, l.founding_rank,
            l.subscription_exempt, l.subscription_paid_until, l.banned, l.matching_blocked,
            COALESCE(l.registration_submitted_at, l.approved_at, l.created_at)::date AS registered_on,
            c.start_date, c.fee, c.free_limit, c.honour_12m
       FROM leads l CROSS JOIN cfg c
      WHERE COALESCE(l.claimed, false) = true AND l.approval_status = 'approved'
    )
 SELECT supplier_id, company_name, email, founding_rank, subscription_exempt, registered_on,
    subscription_paid_until,
    CASE WHEN honour_12m THEN GREATEST(start_date, (registered_on + '1 year'::interval)::date)
         ELSE start_date END AS billing_starts_on,
    CASE WHEN subscription_exempt THEN 'exempt'
         WHEN CURRENT_DATE < CASE WHEN honour_12m THEN GREATEST(start_date, (registered_on + '1 year'::interval)::date) ELSE start_date END THEN 'not_due'
         WHEN subscription_paid_until IS NOT NULL AND subscription_paid_until >= CURRENT_DATE THEN 'active'
         WHEN subscription_paid_until IS NULL THEN 'due'
         ELSE 'past_due' END AS billing_status,
    CASE WHEN subscription_exempt THEN 0::numeric
         WHEN CURRENT_DATE < CASE WHEN honour_12m THEN GREATEST(start_date, (registered_on + '1 year'::interval)::date) ELSE start_date END THEN 0::numeric
         WHEN subscription_paid_until IS NOT NULL AND subscription_paid_until >= CURRENT_DATE THEN 0::numeric
         ELSE fee END AS amount_due_aed,
    fee AS annual_fee_aed, free_limit
   FROM s;

create or replace function public.fn_subscription_billing_run(p_dry_run boolean DEFAULT false)
returns json language plpgsql security definer set search_path to 'public', 'pg_temp' as $fn$
declare r record; v_flagged int := 0; v_cfg record; v_admin text;
begin
  select * into v_cfg from public.fn_supplier_subscription();
  v_admin := coalesce((select split_part(value,',',1) from app_secrets where key='admin_emails'),'management@quotesdone.com');

  for r in
    select b.* from v_supplier_billing b
    where b.billing_status in ('due','past_due')
      and coalesce(b.email,'') <> ''
      and not exists (
        select 1 from notifications n
        where n.type='subscription_due' and n.lead_id = b.supplier_id
          and n.created_at > now() - interval '30 days')
  loop
    if not p_dry_run then
      update leads set registration_fee_due = v_cfg.fee, registration_status = 'due' where id = r.supplier_id;
      insert into notifications(type,to_email,to_role,lead_id,channel,subject,body,status)
      values('subscription_due', r.email, 'supplier', r.supplier_id, 'email',
        'Your QuotesDone annual subscription is due',
        'Dear '||coalesce(r.company_name,'there')||E',\n\nYour QuotesDone annual supplier subscription of '||v_cfg.currency||' '||v_cfg.fee||E' is now due.\n\nYou keep paying no commission on the jobs you win — this is the annual subscription only. You can settle it securely on the supplier portal: https://quotesdone.com/suppliers\n\nIf it is not settled, your profile is paused from receiving new customer requests until it is.\n\nThank you for being part of QuotesDone.',
        'queued');
    end if;
    v_flagged := v_flagged + 1;
  end loop;

  if v_flagged > 0 and not p_dry_run then
    insert into notifications(type,to_email,to_role,channel,subject,body,status)
    values('subscription_billing_summary', v_admin,'admin','email','Supplier subscriptions invoiced',
      v_flagged||' supplier(s) were invoiced '||v_cfg.currency||' '||v_cfg.fee||' for their annual subscription. Founding suppliers (first '||
      v_cfg.free_limit||') are exempt and were not billed.','queued');
  end if;

  return json_build_object('billing_starts', v_cfg.start_date, 'fee', v_cfg.fee, 'currency', v_cfg.currency,
    'free_limit', v_cfg.free_limit, 'invoiced', v_flagged, 'dry_run', p_dry_run, 'ran_at', now());
end $fn$;

-- The consistency report. One row per fact, with every place that states it and whether they agree.
create or replace view public.v_pricing_consistency as
with c as (select * from public.fn_supplier_subscription()),
     pc as (select * from public.pricing_config order by id limit 1),
     s as (
       select (select nullif(value,'')::numeric from public.app_secrets where key='supplier_subscription_aed')  as fee,
              (select nullif(value,'')::date    from public.app_secrets where key='supplier_subscription_start') as start_date,
              (select nullif(value,'')::int     from public.app_secrets where key='founding_free_limit')         as free_limit
     )
select 'annual_fee' as fact,
       (select fee::text from c) as resolved,
       (select supplier_reg_fee::text from pc) as pricing_config,
       (select fee::text from s) as app_secrets,
       ((select supplier_reg_fee::numeric from pc) is not distinct from coalesce((select fee from s), (select supplier_reg_fee::numeric from pc))) as agree
union all
select 'currency', (select currency from c), (select supplier_reg_currency from pc), null, (select supplier_reg_currency from pc) = 'AED'
union all
select 'period', (select period from c), (select supplier_reg_period from pc), null, (select supplier_reg_period from pc) = 'yearly'
union all
select 'billing_starts', (select start_date::text from c), null, (select start_date::text from s),
       coalesce((select start_date from s), date '2027-08-01') = date '2027-08-01'
union all
select 'free_registrations', (select free_limit::text from c), (select supplier_free_count::text from pc), (select free_limit::text from s),
       (select supplier_free_count from pc) is not distinct from coalesce((select free_limit from s), (select supplier_free_count from pc));

revoke all on function public.fn_supplier_subscription() from public, anon, authenticated;

comment on function public.fn_supplier_subscription() is
  'The only resolver for supplier subscription pricing. pricing_config first (CHECK-constrained), app_secrets second, literal last. v_supplier_billing, fn_subscription_billing_run and v_pricing_consistency all read it.';
</file>

<file path="supabase/migrations/20260802152054_p1h_05_refund_settle_ordering_safe.sql">
-- PHASE 1 HARDENING 3 - REFUND SETTLEMENT SURVIVES OUT-OF-ORDER AND DUPLICATE DELIVERY
--
-- Stripe guarantees at-least-once delivery, not ordering. The Phase 1 version applied whatever
-- status arrived last, so this sequence lost money-truth:
--     refund.updated  (succeeded)   -> refunds.status = succeeded, settled_at set
--     refund.created  (pending)     -> refunds.status = processing        <-- regression
-- A refund that has completed then reads as still in flight, the reconciliation view lists it as
-- outstanding, and finance chases a payment that already left. Nothing in the old function stopped
-- it, and it needs no unusual conditions: two events emitted milliseconds apart routinely arrive
-- reversed.
--
-- Status now moves in one direction only, by rank:
--     processing (1) -> cancelled (2) -> failed (3) -> succeeded (4)
-- A lower-ranked arrival is recorded as out-of-order and discarded. An equal one is idempotent.
-- succeeded is absorbing: once Stripe has confirmed the money moved, nothing downgrades it.

create or replace function public.fn_refund_status_rank(p_status text)
returns int language sql immutable as $fn$
  select case lower(coalesce(p_status,''))
           when 'succeeded' then 4 when 'failed' then 3
           when 'cancelled' then 2 when 'canceled' then 2
           else 1 end;
$fn$;

create or replace function public.fn_refund_settle(
  p_stripe_refund_id text, p_status text, p_amount_fils bigint default null,
  p_payment_intent text default null, p_charge_id text default null, p_failure_reason text default null)
returns jsonb language plpgsql security definer set search_path to 'public' as $fn$
declare r public.refunds; v_status text; v_new_rank int; v_old_rank int; v_amount bigint; v_note text;
begin
  if coalesce(btrim(p_stripe_refund_id),'') = '' then
    return jsonb_build_object('ok', false, 'error', 'stripe_refund_id_required');
  end if;

  v_status := case lower(coalesce(p_status,''))
                when 'succeeded' then 'succeeded' when 'failed' then 'failed'
                when 'canceled' then 'cancelled'  when 'cancelled' then 'cancelled'
                else 'processing' end;
  v_new_rank := public.fn_refund_status_rank(v_status);

  select * into r from public.refunds where stripe_refund_id = p_stripe_refund_id for update;

  if found then
    v_old_rank := public.fn_refund_status_rank(r.status);
    -- Same state twice: duplicate delivery. Cheap, silent, correct.
    if r.status = v_status then
      return jsonb_build_object('ok', true, 'refund_id', r.id, 'status', r.status,
                                'idempotent', true, 'applied', false);
    end if;
    -- An older state arriving late. Recorded, not applied.
    if v_new_rank < v_old_rank then
      update public.refunds
         set reconciliation_note = left(coalesce(reconciliation_note || ' | ', '')
             || 'out-of-order ' || v_status || ' event ignored at ' || to_char(now(),'YYYY-MM-DD HH24:MI') , 500)
       where id = r.id;
      return jsonb_build_object('ok', true, 'refund_id', r.id, 'status', r.status,
                                'out_of_order', true, 'applied', false, 'ignored_status', v_status);
    end if;
  else
    -- Not seen before. Attach it to an in-platform request for the same payment intent if one is
    -- waiting; otherwise it was issued straight from the Stripe dashboard.
    select * into r from public.refunds
     where stripe_refund_id is null and p_payment_intent is not null
       and stripe_payment_intent = p_payment_intent and status in ('approved','processing')
     order by created_at limit 1 for update;

    if found then
      update public.refunds set stripe_refund_id = p_stripe_refund_id,
             stripe_charge_id = coalesce(p_charge_id, stripe_charge_id) where id = r.id;
      v_old_rank := public.fn_refund_status_rank(r.status);
    else
      -- amount_fils carries a CHECK (> 0), so a missing amount cannot simply be stored as zero.
      -- It is stored as 1 fils and said so in writing, because a refund recorded with an obviously
      -- wrong amount and a note gets fixed, while a refund that was never recorded does not.
      v_amount := nullif(coalesce(p_amount_fils, 0), 0);
      v_note := case when v_amount is null
                then 'Issued outside QuotesDone (Stripe dashboard or API). THE EVENT CARRIED NO AMOUNT - the 1 fils here is a placeholder, check Stripe and correct it.'
                else 'Issued outside QuotesDone (Stripe dashboard or API). Recorded by the webhook.' end;
      insert into public.refunds (stripe_refund_id, stripe_payment_intent, stripe_charge_id,
                                  amount_fils, reason_code, reason_note, requested_by, status,
                                  decided_by, decided_at, decision_note, reconciliation_note)
      values (p_stripe_refund_id, p_payment_intent, p_charge_id, coalesce(v_amount, 1), 'other',
              v_note, 'stripe_webhook', 'processing', 'stripe_dashboard', now(),
              'No in-platform request existed for this refund.',
              case when v_amount is null then 'amount missing from the Stripe event' else null end)
      returning * into r;
      v_old_rank := 1;
      if v_new_rank < v_old_rank then v_new_rank := v_old_rank; end if;
    end if;
  end if;

  update public.refunds
     set status = v_status,
         amount_fils = case when coalesce(p_amount_fils,0) > 0 then p_amount_fils else amount_fils end,
         stripe_charge_id = coalesce(p_charge_id, stripe_charge_id),
         stripe_payment_intent = coalesce(p_payment_intent, stripe_payment_intent),
         settled_at = case when v_status = 'succeeded' then coalesce(settled_at, now()) else settled_at end,
         failure_reason = case when v_status = 'failed' then p_failure_reason else failure_reason end,
         updated_at = now()
   where id = r.id;

  if r.transaction_id is not null then
    update public.transactions
       set refund_status = v_status, refund_stripe_id = p_stripe_refund_id,
           refund_amount_aed = case when coalesce(p_amount_fils,0) > 0
                                    then round(p_amount_fils/100.0, 2) else refund_amount_aed end,
           refund_confirmed_at = case when v_status = 'succeeded' then coalesce(refund_confirmed_at, now())
                                      else refund_confirmed_at end
     where id = r.transaction_id;
  end if;

  return jsonb_build_object('ok', true, 'refund_id', r.id, 'status', v_status, 'applied', true);
end $fn$;

revoke all on function public.fn_refund_settle(text, text, bigint, text, text, text) from public, anon, authenticated;
revoke all on function public.fn_refund_status_rank(text) from public, anon, authenticated;

comment on function public.fn_refund_settle(text, text, bigint, text, text, text) is
  'Applies a Stripe refund event. Idempotent on repeat delivery and monotonic in status, so out-of-order events cannot walk a settled refund backwards.';
</file>

<file path="supabase/migrations/20260802154210_p1h_06_control_mode_single_identity.sql">
-- FINAL ACTION 1 - ONE CONTROL MODE IDENTITY, AND NO SHARED MFA PHONE EVER AGAIN
--
-- Two identities were seeded from app_secrets.admin_emails and BOTH pointed at the same
-- app_secrets.admin_mfa_phone. That is worse than it looks: with a shared destination, the code that
-- arrives on the phone does not say which account it belongs to, so the second factor stops
-- identifying anyone. Whoever holds either console session can request a code, and the person
-- holding the phone cannot tell the two apart. A second factor that cannot distinguish two
-- principals is a shared password with extra steps.
--
-- management@quotesdone.com is kept: it is the first entry in app_secrets.admin_emails and the
-- address fn_subscription_billing_run already treats as the company's primary admin, so "primary"
-- is a fact in the configuration rather than a guess made here.
--
-- The other identity is DEACTIVATED, not deleted. Deleting would cascade its challenge history out
-- of the audit trail, and the record of who could once do this is worth keeping. Reactivating is one
-- update - but it now requires giving that person their own phone_secret_key, because of the index
-- below.

update public.control_mode_identity
   set active = false,
       note = coalesce(note || ' | ', '')
           || 'deactivated 2 Aug 2026 on founder instruction: Control Mode is restricted to the primary admin identity'
 where admin_email <> 'management@quotesdone.com';

update public.control_mode_identity
   set note = coalesce(note || ' | ', '')
           || 'primary Control Mode identity, confirmed 2 Aug 2026'
 where admin_email = 'management@quotesdone.com';

-- Any challenge belonging to a now-inactive identity is void immediately. Leaving a live code for a
-- deactivated account open would mean the deactivation takes up to five minutes to bite.
update public.control_mode_challenge c
   set consumed_at = now(), consumed_why = 'identity deactivated'
  from public.control_mode_identity i
 where i.admin_email = c.admin_email and i.active = false and c.consumed_at is null;

update public.control_mode_session s
   set closed_at = now(), closed_reason = 'identity deactivated'
  from public.control_mode_identity i
 where i.admin_email = s.actor_email and i.active = false and s.closed_at is null;

-- Structural, not procedural. Two ACTIVE identities can no longer point at the same phone secret,
-- so the failure mode above cannot be recreated by someone adding a row in a hurry. Inactive rows
-- are exempt, which is what keeps the history above legal.
create unique index if not exists control_mode_identity_one_active_per_phone
  on public.control_mode_identity (phone_secret_key)
  where active;

comment on index public.control_mode_identity_one_active_per_phone is
  'One active Control Mode identity per MFA phone. A shared destination makes the second factor unable to tell two principals apart, which is the whole point of having one.';

create or replace function public.fn_control_mode_identity_active(p_email text)
returns boolean language sql stable security definer set search_path to 'public' as $fn$
  select exists (select 1 from public.control_mode_identity
                  where admin_email = lower(btrim(p_email)) and active);
$fn$;
revoke all on function public.fn_control_mode_identity_active(text) from public, anon, authenticated;
</file>

<file path="supabase/migrations/20260802154400_p1h_07_refund_transition_matrix_and_unknown_amounts.sql">
-- FINAL ACTIONS 2 AND 3 - AN EXPLICIT TRANSITION MATRIX, AND NO INVENTED MONEY
--
-- (3) WHY THE RANK WAS THE WRONG SHAPE. A numeric rank encodes "later beats earlier" and nothing
-- else. It cannot express that a failed refund does not later succeed (Stripe issues a NEW refund
-- id for a retry), nor that cancelled is terminal, and every future reader has to reverse-engineer
-- the policy from four integers. The permitted transitions are now data: one row per pair, with the
-- reason written down. Anything not listed as allowed is refused and recorded - which is the same
-- fail-closed rule the action classifier uses, applied to money.
--
-- (2) WHY THE 1-FILS PLACEHOLDER WAS INDEFENSIBLE. It put a fabricated financial amount into the
-- ledger. A note beside it does not undo that: totals summed it, the GL would post it, and any
-- report that did not happen to read the note was wrong by a real number. Unknown is now
-- represented as unknown - NULL - and excluded from every total. The webhook first tries to answer
-- the question properly by asking Stripe for the refund by id; only if that fails does the row stay
-- unknown, and it stays in the reconciliation queue until a human or a later event resolves it.

-- ---------------------------------------------------------------------------------------------
-- 2a. amount_fils may be unknown, and says where it came from.
-- ---------------------------------------------------------------------------------------------
alter table public.refunds drop constraint if exists refunds_amount_fils_check;
alter table public.refunds add constraint refunds_amount_fils_check
  check (amount_fils is null or amount_fils > 0);

alter table public.refunds add column if not exists amount_source text;
alter table public.refunds drop constraint if exists refunds_amount_source_check;
alter table public.refunds add constraint refunds_amount_source_check
  check (amount_source is null or amount_source in ('in_platform_request','webhook_event','stripe_api','manual','unknown'));

-- A settled refund with no amount is not a valid financial record. It is allowed to exist - losing
-- it would be worse - but it can never be silently complete.
alter table public.refunds drop constraint if exists refunds_settled_needs_amount;
alter table public.refunds add constraint refunds_settled_needs_amount
  check (status <> 'succeeded' or amount_fils is not null or reconciliation_note is not null);

update public.refunds set amount_source = 'in_platform_request' where amount_source is null and amount_fils is not null;

-- ---------------------------------------------------------------------------------------------
-- 2b. Quarantine, for events that cannot be turned into a refund row at all.
-- ---------------------------------------------------------------------------------------------
create table if not exists public.refund_event_quarantine (
  id                bigserial primary key,
  stripe_refund_id  text,
  stripe_event_id   text,
  event_type        text,
  reason            text not null,
  payload           jsonb,
  created_at        timestamptz not null default now(),
  resolved_at       timestamptz,
  resolved_by       text,
  resolution_note   text
);
create index if not exists refund_event_quarantine_open_idx
  on public.refund_event_quarantine (resolved_at, created_at);
alter table public.refund_event_quarantine enable row level security;
comment on table public.refund_event_quarantine is
  'Refund events that could not be recorded as a refund - no id, an illegal status transition, or an amount that could not be established. Nothing is ever dropped; it waits here to be resolved.';

create or replace function public.fn_refund_quarantine(
  p_stripe_refund_id text, p_event_type text, p_reason text, p_payload jsonb default null,
  p_stripe_event_id text default null)
returns bigint language sql security definer set search_path to 'public' as $fn$
  insert into public.refund_event_quarantine (stripe_refund_id, stripe_event_id, event_type, reason, payload)
  values (nullif(btrim(coalesce(p_stripe_refund_id,'')),''), nullif(btrim(coalesce(p_stripe_event_id,'')),''),
          p_event_type, p_reason, p_payload)
  returning id;
$fn$;

-- ---------------------------------------------------------------------------------------------
-- 3. The transition matrix.
-- ---------------------------------------------------------------------------------------------
create table if not exists public.refund_status_transition (
  from_status text not null,
  to_status   text not null,
  allowed     boolean not null,
  note        text,
  primary key (from_status, to_status)
);
alter table public.refund_status_transition enable row level security;

delete from public.refund_status_transition;
insert into public.refund_status_transition (from_status, to_status, allowed, note) values
  -- In-platform states, before Stripe has said anything.
  ('requested','processing',true ,'Stripe accepted the refund.'),
  ('requested','succeeded' ,true ,'Fast settlement; Stripe confirmed before we saw the pending event.'),
  ('requested','failed'    ,true ,'Stripe refused it outright.'),
  ('requested','cancelled' ,true ,'Withdrawn before Stripe acted.'),
  ('approved' ,'processing',true ,'Normal path: approved here, now in flight at Stripe.'),
  ('approved' ,'succeeded' ,true ,'Fast settlement, or refund.updated arrived before refund.created.'),
  ('approved' ,'failed'    ,true ,'Stripe refused it.'),
  ('approved' ,'cancelled' ,true ,'Cancelled before Stripe settled.'),
  -- In flight.
  ('processing','succeeded',true ,'The money moved.'),
  ('processing','failed'   ,true ,'Stripe could not complete it.'),
  ('processing','cancelled',true ,'Cancelled while in flight.'),
  ('processing','requested',false,'Backwards. A late refund.created after we already knew it was in flight.'),
  ('processing','approved' ,false,'Backwards.'),
  -- Terminal states. These are the whole point of the matrix.
  ('succeeded','processing',false,'OUT OF ORDER. A late refund.created after settlement. Money that has moved does not go back in flight.'),
  ('succeeded','requested' ,false,'Out of order.'),
  ('succeeded','approved'  ,false,'Out of order.'),
  ('succeeded','failed'    ,false,'CONTRADICTORY. Stripe does not fail a refund it has already settled. Quarantine and investigate.'),
  ('succeeded','cancelled' ,false,'Contradictory: a settled refund cannot be cancelled.'),
  ('failed','processing'   ,false,'Out of order. Stripe issues a NEW refund id to retry; the failed one stays failed.'),
  ('failed','requested'    ,false,'Out of order.'),
  ('failed','approved'     ,false,'Out of order.'),
  ('failed','succeeded'    ,false,'Stripe issues a new refund id for a retry, so this should never arrive. If it does, quarantine it rather than quietly booking a refund twice.'),
  ('failed','cancelled'    ,false,'Terminal.'),
  ('cancelled','processing',false,'Terminal.'),
  ('cancelled','succeeded' ,false,'A cancelled refund that settles means two systems disagree. Quarantine it.'),
  ('cancelled','failed'    ,false,'Terminal.'),
  ('cancelled','requested' ,false,'Out of order.'),
  ('cancelled','approved'  ,false,'Out of order.'),
  -- Nothing moves out of rejected via a webhook: rejection is a decision made here, and Stripe was
  -- never asked. A Stripe event for a rejected refund means someone refunded it outside the
  -- platform after we said no - which is exactly the case worth quarantining rather than absorbing.
  ('rejected','processing' ,false,'Refunded outside the platform after an in-platform rejection.'),
  ('rejected','succeeded'  ,false,'Refunded outside the platform after an in-platform rejection. Investigate.'),
  ('rejected','failed'     ,false,'Unexpected.'),
  ('rejected','cancelled'  ,false,'Unexpected.');

comment on table public.refund_status_transition is
  'Every permitted refund status change, with its reason. A transition absent from this table, or present with allowed=false, is refused by fn_refund_settle and the event is quarantined. succeeded, failed and cancelled are terminal.';

create or replace function public.fn_refund_transition_allowed(p_from text, p_to text)
returns boolean language sql stable security definer set search_path to 'public' as $fn$
  select coalesce((select allowed from public.refund_status_transition
                    where from_status = p_from and to_status = p_to), false);
$fn$;

-- ---------------------------------------------------------------------------------------------
-- The settlement function, rebuilt on both.
-- ---------------------------------------------------------------------------------------------
create or replace function public.fn_refund_settle(
  p_stripe_refund_id text, p_status text, p_amount_fils bigint default null,
  p_payment_intent text default null, p_charge_id text default null, p_failure_reason text default null,
  p_amount_source text default 'webhook_event', p_stripe_event_id text default null)
returns jsonb language plpgsql security definer set search_path to 'public' as $fn$
declare r public.refunds; v_status text; v_amount bigint; v_src text; v_q bigint;
begin
  if coalesce(btrim(p_stripe_refund_id),'') = '' then
    v_q := public.fn_refund_quarantine(null, 'refund', 'event carried no refund id',
             jsonb_build_object('status', p_status, 'payment_intent', p_payment_intent), p_stripe_event_id);
    return jsonb_build_object('ok', false, 'error', 'stripe_refund_id_required', 'quarantined', v_q);
  end if;

  v_status := case lower(coalesce(p_status,''))
                when 'succeeded' then 'succeeded' when 'failed' then 'failed'
                when 'canceled' then 'cancelled'  when 'cancelled' then 'cancelled'
                else 'processing' end;
  v_amount := nullif(coalesce(p_amount_fils, 0), 0);
  v_src    := case when v_amount is null then null else coalesce(p_amount_source, 'webhook_event') end;

  select * into r from public.refunds where stripe_refund_id = p_stripe_refund_id for update;

  if not found then
    select * into r from public.refunds
     where stripe_refund_id is null and p_payment_intent is not null
       and stripe_payment_intent = p_payment_intent and status in ('approved','processing','requested')
     order by created_at limit 1 for update;

    if found then
      update public.refunds set stripe_refund_id = p_stripe_refund_id,
             stripe_charge_id = coalesce(p_charge_id, stripe_charge_id) where id = r.id;
    else
      -- Issued outside the platform. Recorded with whatever is actually known, and NOTHING invented:
      -- if the amount is unknown it stays NULL and the row is marked unreconciled.
      insert into public.refunds (stripe_refund_id, stripe_payment_intent, stripe_charge_id,
                                  amount_fils, amount_source, reason_code, reason_note, requested_by, status,
                                  decided_by, decided_at, decision_note, reconciliation_note)
      values (p_stripe_refund_id, p_payment_intent, p_charge_id, v_amount,
              coalesce(v_src, 'unknown'), 'other',
              'Issued outside QuotesDone (Stripe dashboard or API). Recorded by the webhook.',
              'stripe_webhook', 'processing', 'stripe_dashboard', now(),
              'No in-platform request existed for this refund.',
              case when v_amount is null
                   then 'AMOUNT UNKNOWN - the event carried none and Stripe could not be read. Excluded from all financial totals until resolved.'
                   else null end)
      returning * into r;

      if v_amount is null then
        perform public.fn_refund_quarantine(p_stripe_refund_id, 'refund',
          'amount unknown: absent from the event and not retrievable from Stripe',
          jsonb_build_object('status', v_status, 'payment_intent', p_payment_intent, 'refund_row', r.id),
          p_stripe_event_id);
      end if;

      return jsonb_build_object('ok', true, 'refund_id', r.id, 'status', r.status, 'applied', true,
                                'created', true, 'amount_known', v_amount is not null);
    end if;
  end if;

  -- Duplicate delivery: same state twice. Cheap, silent, correct - but still take the chance to fill
  -- in an amount we did not have before.
  if r.status = v_status then
    if r.amount_fils is null and v_amount is not null then
      update public.refunds
         set amount_fils = v_amount, amount_source = v_src,
             reconciliation_note = 'amount resolved from a later ' || coalesce(p_amount_source,'event'),
             updated_at = now()
       where id = r.id;
      return jsonb_build_object('ok', true, 'refund_id', r.id, 'status', r.status,
                                'idempotent', true, 'applied', false, 'amount_resolved', true);
    end if;
    return jsonb_build_object('ok', true, 'refund_id', r.id, 'status', r.status,
                              'idempotent', true, 'applied', false);
  end if;

  -- The matrix decides. Not a rank, not an ordering heuristic - a declared policy with a reason
  -- attached to every refusal.
  if not public.fn_refund_transition_allowed(r.status, v_status) then
    v_q := public.fn_refund_quarantine(p_stripe_refund_id, 'refund',
      'transition not permitted: ' || r.status || ' -> ' || v_status || '. '
      || coalesce((select note from public.refund_status_transition
                    where from_status = r.status and to_status = v_status), 'no rule declared for this pair'),
      jsonb_build_object('refund_row', r.id, 'from', r.status, 'to', v_status,
                         'amount_fils', p_amount_fils, 'payment_intent', p_payment_intent),
      p_stripe_event_id);
    update public.refunds
       set reconciliation_note = left(coalesce(reconciliation_note || ' | ', '')
           || 'refused ' || r.status || '->' || v_status || ' at ' || to_char(now(),'YYYY-MM-DD HH24:MI'), 500),
           updated_at = now()
     where id = r.id;
    return jsonb_build_object('ok', true, 'refund_id', r.id, 'status', r.status, 'applied', false,
                              'refused_transition', r.status || '->' || v_status, 'quarantined', v_q);
  end if;

  update public.refunds
     set status = v_status,
         amount_fils   = coalesce(v_amount, amount_fils),
         amount_source = case when v_amount is not null then v_src else amount_source end,
         stripe_charge_id = coalesce(p_charge_id, stripe_charge_id),
         stripe_payment_intent = coalesce(p_payment_intent, stripe_payment_intent),
         settled_at = case when v_status = 'succeeded' then coalesce(settled_at, now()) else settled_at end,
         failure_reason = case when v_status = 'failed' then p_failure_reason else failure_reason end,
         reconciliation_note = case
             when v_status = 'succeeded' and coalesce(v_amount, amount_fils) is null
             then 'AMOUNT UNKNOWN on a settled refund - excluded from all financial totals until resolved.'
             else reconciliation_note end,
         updated_at = now()
   where id = r.id;

  if r.transaction_id is not null then
    update public.transactions
       set refund_status = v_status, refund_stripe_id = p_stripe_refund_id,
           refund_amount_aed = case when v_amount is not null then round(v_amount/100.0, 2) else refund_amount_aed end,
           refund_confirmed_at = case when v_status = 'succeeded' then coalesce(refund_confirmed_at, now())
                                      else refund_confirmed_at end
     where id = r.transaction_id;
  end if;

  return jsonb_build_object('ok', true, 'refund_id', r.id, 'status', v_status, 'applied', true,
                            'amount_known', coalesce(v_amount, r.amount_fils) is not null);
end $fn$;

drop function if exists public.fn_refund_status_rank(text);

revoke all on function public.fn_refund_settle(text, text, bigint, text, text, text, text, text) from public, anon, authenticated;
revoke all on function public.fn_refund_transition_allowed(text, text) from public, anon, authenticated;
revoke all on function public.fn_refund_quarantine(text, text, text, jsonb, text) from public, anon, authenticated;
</file>

<file path="supabase/migrations/20260802154511_p1h_08_refund_views_exclude_unknown_amounts.sql">
-- FINAL ACTION 2, continued - unknown amounts are excluded from every financial total, counted
-- separately, and held in the reconciliation queue until resolved.
--
-- sum() already ignores NULL, so the totals below are correct the moment amount_fils can be NULL.
-- What was missing is the honesty: a total that quietly omits three refunds looks identical to a
-- total that had nothing to omit. Every money figure now carries the number of refunds it could not
-- include, so a reader can see the difference.
--
-- Both views are dropped and recreated rather than replaced: the column list changes, and Postgres
-- will not let CREATE OR REPLACE reshape one.

drop view if exists public.v_refund_metrics;
drop view if exists public.v_refunds_unreconciled;

create view public.v_refunds_unreconciled as
select r.id, r.settled_at, r.amount_fils,
       case when r.amount_fils is null then null else round(r.amount_fils::numeric / 100.0, 2) end as amount_aed,
       r.amount_fils is null as amount_unknown,
       r.amount_source, r.currency, r.reason_code, r.status,
       r.stripe_refund_id, r.stripe_payment_intent, r.inquiry_id, r.customer_id, r.decided_by,
       r.reconciliation_note,
       case when r.amount_fils is null then 'amount unknown - resolve before reconciling'
            when r.settled_at is null  then 'settled_at missing'
            else 'awaiting reconciliation' end as blocker
  from public.refunds r
 where r.reconciled_at is null
   and (r.status = 'succeeded' or r.amount_fils is null)
 order by r.amount_fils is null desc, r.settled_at nulls first;

comment on view public.v_refunds_unreconciled is
  'The finance queue. A refund stays here until it is reconciled - and a refund whose amount is unknown stays here whatever its status, because it cannot be reconciled at all.';

create view public.v_refund_metrics as
select
  count(*) as refunds_total,
  count(*) filter (where status = 'requested') as awaiting_decision,
  count(*) filter (where status = 'approved')  as approved_not_settled,
  count(*) filter (where status = 'succeeded') as settled,
  count(*) filter (where status = 'failed')    as failed,
  count(*) filter (where status = 'rejected')  as rejected,
  count(*) filter (where status = 'cancelled') as cancelled,
  count(*) filter (where within_auto_window)   as inside_auto_window,

  -- Money. NULL amounts are excluded by sum(); the count beside each total says how many.
  coalesce(round(sum(amount_fils) filter (where status = 'succeeded') / 100.0, 2), 0::numeric) as refunded_aed,
  count(*) filter (where status = 'succeeded' and amount_fils is null) as settled_amount_unknown,
  count(*) filter (where amount_fils is null)                          as amount_unknown_total,

  (select coalesce(round(sum(r2.amount_fils) / 100.0, 2), 0::numeric) from public.refunds r2
    where r2.status = 'succeeded' and r2.settled_at > now() - interval '30 days') as refunded_aed_30d,
  (select count(*) from public.refunds r3
    where r3.status = 'succeeded' and r3.settled_at > now() - interval '30 days'
      and r3.amount_fils is null) as refunded_aed_30d_amount_unknown,

  (select count(*) from public.v_refunds_unreconciled) as unreconciled,
  (select count(*) from public.refund_event_quarantine where resolved_at is null) as quarantined_events,

  (select coalesce(jsonb_object_agg(t.reason_code, t.c), '{}'::jsonb)
     from (select reason_code, count(*) as c from public.refunds
            where status = 'succeeded' group by reason_code) t) as by_reason,

  -- One flag a dashboard can act on without reading the columns above.
  (count(*) filter (where amount_fils is null) > 0
   or (select count(*) from public.refund_event_quarantine where resolved_at is null) > 0) as needs_attention
from public.refunds;

comment on view public.v_refund_metrics is
  'Refund totals. Amounts that are unknown are NOT included in any money figure; the count beside each figure says how many were left out. needs_attention is true whenever a total is incomplete.';

-- Resolving an unknown amount by hand, with the correction on the record rather than in a chat.
create or replace function public.fn_refund_amount_resolve(
  p_stripe_refund_id text, p_amount_fils bigint, p_by text, p_source text default 'manual', p_note text default null)
returns jsonb language plpgsql security definer set search_path to 'public' as $fn$
declare r public.refunds;
begin
  if coalesce(p_amount_fils, 0) <= 0 then
    return jsonb_build_object('ok', false, 'error', 'amount_must_be_positive');
  end if;
  select * into r from public.refunds where stripe_refund_id = p_stripe_refund_id for update;
  if not found then return jsonb_build_object('ok', false, 'error', 'refund_not_found'); end if;

  update public.refunds
     set amount_fils = p_amount_fils,
         amount_source = coalesce(p_source, 'manual'),
         reconciliation_note = left('amount resolved by ' || coalesce(p_by,'unknown') || ' on '
             || to_char(now(),'YYYY-MM-DD') || coalesce(': ' || p_note, ''), 500),
         updated_at = now()
   where id = r.id;

  update public.refund_event_quarantine
     set resolved_at = now(), resolved_by = p_by,
         resolution_note = 'amount supplied: ' || p_amount_fils || ' fils'
   where stripe_refund_id = p_stripe_refund_id and resolved_at is null and reason like 'amount unknown%';

  if r.transaction_id is not null then
    update public.transactions set refund_amount_aed = round(p_amount_fils/100.0, 2) where id = r.transaction_id;
  end if;

  return jsonb_build_object('ok', true, 'refund_id', r.id, 'amount_fils', p_amount_fils);
end $fn$;

revoke all on function public.fn_refund_amount_resolve(text, bigint, text, text, text) from public, anon, authenticated;

create or replace view public.v_refund_quarantine_open as
select id, stripe_refund_id, event_type, reason, created_at,
       now() - created_at as waiting,
       payload
  from public.refund_event_quarantine
 where resolved_at is null
 order by created_at;
</file>

<file path="supabase/migrations/20260802154652_p1h_09_drop_superseded_refund_settle_overload.sql">
-- Adding two defaulted parameters to fn_refund_settle created a SECOND function rather than
-- replacing the first: Postgres overloads on argument list, not on name. Both were callable, and
-- the six-argument one still carried the rank-based logic with no transition matrix and no
-- quarantine - so the weaker path was live beside the stronger one, which is exactly the pattern
-- the Control Mode work exists to avoid. Dropped.
drop function if exists public.fn_refund_settle(text, text, bigint, text, text, text);
</file>

<file path="supabase/migrations/20260802154746_p1h_10_refund_amount_nullable.sql">
-- The CHECK (amount_fils > 0) was relaxed, but the column was still NOT NULL - so "store unknown as
-- unknown" was still impossible and every dashboard-issued refund with no amount would have been
-- rejected outright, which is worse than the 1-fils placeholder it replaced. Caught by the test
-- rather than by reading, which is the argument for the tests.
alter table public.refunds alter column amount_fils drop not null;

comment on column public.refunds.amount_fils is
  'Refund amount in fils. NULL means genuinely unknown - the event carried none and Stripe could not be read. NULL is excluded from every financial total and keeps the row in v_refunds_unreconciled until resolved. It is never a placeholder.';
comment on column public.refunds.amount_source is
  'Where the amount came from: in_platform_request, webhook_event, stripe_api, manual, or unknown.';
</file>

<file path="supabase/migrations/20260802161500_p2_01_route_regulatory_coverage_status.sql">
-- PHASE 2 CORRECTION 2 - REGULATORY COVERAGE IS ASSERTED, NOT INFERRED
--
-- The crosswalk inferred "no regulator" from "no authority named in the records". The founder is
-- right that this is unsound: Pharmaceuticals showing zero authorities does not mean pharmaceuticals
-- are unregulated, it means the corpus does not say so. Absence of evidence was being read as
-- evidence of absence - the same fail-open mistake the Control Mode work existed to remove, applied
-- to regulation instead of to actions.
--
-- Coverage is now an explicit, four-valued assertion that someone has to make on purpose:
--   confirmed_none    - checked, and this route genuinely carries no regulatory requirement
--   confirmed_covered - checked, and the authorities and sources present are sufficient
--   incomplete        - known to be missing mappings; work identified
--   requires_review   - nobody has checked. THE DEFAULT.
--
-- Default is requires_review because the cost is asymmetric: holding a route out of activation for
-- a week costs a week, activating a regulated route with no escalation path costs a permit, a
-- customer, or a licence.

alter table public.kb_operational_route
  add column if not exists regulatory_coverage_status text not null default 'requires_review';

alter table public.kb_operational_route drop constraint if exists kb_route_reg_coverage_chk;
alter table public.kb_operational_route add constraint kb_route_reg_coverage_chk
  check (regulatory_coverage_status in ('confirmed_none','confirmed_covered','incomplete','requires_review'));

alter table public.kb_operational_route add column if not exists regulatory_coverage_note text;
alter table public.kb_operational_route add column if not exists regulatory_reviewed_by text;
alter table public.kb_operational_route add column if not exists regulatory_reviewed_at timestamptz;

-- The five the founder named. Each shows zero named authorities in the corpus and each is, in fact,
-- a licensed profession or a controlled product class in the UAE.
update public.kb_operational_route
   set regulatory_coverage_status = 'requires_review',
       regulatory_coverage_note = case catalog_num
         when 38 then 'Zero authorities in corpus. Audit is licensed - UAE Ministry of Economy and Tourism register, ADGM/DIFC regimes. Mapping missing.'
         when 39 then 'Zero authorities in corpus. Tax agents are registered with the Federal Tax Authority. Mapping missing.'
         when 41 then 'Zero authorities in corpus. Legal practice is licensed per emirate (Dubai Legal Affairs Department, ADJD). Mapping missing.'
         when 61 then 'Zero authorities in corpus. Medical devices are controlled by MOHAP and the health authorities (DHA, DoH Abu Dhabi). Mapping missing.'
         when 62 then 'Zero authorities in corpus. Pharmaceuticals are controlled by MOHAP registration and import permits. Mapping missing.'
       end,
       regulatory_reviewed_at = now(),
       regulatory_reviewed_by = 'founder instruction 2 Aug 2026'
 where catalog_num in (38, 39, 41, 61, 62);

-- Everything else starts unreviewed, which is the honest state. Nothing is silently promoted.

create or replace function public.fn_kb_route_activation_blocked(p_catalog_num int)
returns jsonb language plpgsql stable security definer set search_path to 'public' as $fn$
declare r record; v_reasons text[] := '{}';
begin
  select * into r from public.kb_operational_route where catalog_num = p_catalog_num;
  if not found then
    return jsonb_build_object('blocked', true, 'reasons', array['no such route']);
  end if;

  if r.regulatory_coverage_status <> 'confirmed_none'
     and r.regulatory_coverage_status <> 'confirmed_covered' then
    v_reasons := v_reasons || ('regulatory coverage is ' || r.regulatory_coverage_status);
  end if;

  if not exists (select 1 from public.kb_operational_route_map m where m.catalog_num = p_catalog_num) then
    v_reasons := v_reasons || 'no mapped subcategory';
  end if;

  if not exists (select 1 from public.kb_operational_alias a
                  where a.catalog_num = p_catalog_num and a.language = 'ar') then
    v_reasons := v_reasons || 'no Arabic alias';
  end if;

  return jsonb_build_object('blocked', array_length(v_reasons, 1) is not null,
                            'reasons', coalesce(v_reasons, '{}'),
                            'regulatory_coverage_status', r.regulatory_coverage_status,
                            'route', r.catalog_name);
end $fn$;

revoke all on function public.fn_kb_route_activation_blocked(int) from public, anon, authenticated;

comment on column public.kb_operational_route.regulatory_coverage_status is
  'Asserted, never inferred. requires_review is the default because zero named authorities in the corpus means nobody checked, not that nothing applies. fn_kb_route_activation_blocked refuses activation until it is confirmed_none or confirmed_covered.';

create or replace view public.v_kb_route_regulatory_status as
select r.catalog_num, r.catalog_name, r.regulatory_coverage_status, r.regulatory_coverage_note,
       (select count(distinct nullif(btrim(k.authority),''))
          from public.kb_operational_route_map m
          join kb_stage.records k on k.subcategory_slug = m.subcategory_slug
         where m.catalog_num = r.catalog_num) as named_authorities_in_corpus,
       public.fn_kb_route_activation_blocked(r.catalog_num) as activation_gate
  from public.kb_operational_route r;
</file>

<file path="supabase/migrations/20260802165000_p2_02_scenario_expectation_change_ledger.sql">
-- P2-C5 - THE EXPECTATION LEDGER. APPEND-ONLY, AND ENFORCED BY THE DATABASE.
--
-- Taken out of the stated order deliberately: P2-C1 will change what some MEP scenarios expect, and
-- the rule is that any such change carries its original, its replacement, a reason and an approving
-- work item. The ledger therefore has to exist BEFORE the thing that writes to it. Building MEP
-- first would mean the first expectation changes are made with nowhere to record them - exactly the
-- silent edit this control exists to prevent. Nothing here touches routing.
--
-- A rule in a document is obeyed until the night someone is tired and the suite is red. `expected`
-- is now unwritable in place; the only path is fn_scenario_expectation_change, which will not run
-- without a reason, a real work item and a person.
--
-- Two shape notes. scenario_tests.expected is TEXT, so the ledger stores text - normalising into
-- jsonb would mean a comparison that can silently reformat, and therefore silently differ. And
-- work_item is validated by trigger rather than a foreign key, because only 7 of 193 spec_backlog
-- rows carry a spec_ref: a partial unique index cannot back an FK, and making spec_ref mandatory on
-- 186 unrelated legacy rows to satisfy one constraint would be the tail wagging the dog.

create unique index if not exists spec_backlog_spec_ref_uidx
  on public.spec_backlog (spec_ref) where spec_ref is not null;

create table if not exists public.scenario_expectation_baseline (
  scenario_id   text primary key,
  expected      text not null,
  expected_sha  text not null,
  captured_at   timestamptz not null default now()
);

insert into public.scenario_expectation_baseline (scenario_id, expected, expected_sha)
select s.scenario_id, coalesce(s.expected, ''),
       encode(extensions.digest(coalesce(s.expected, ''), 'sha256'), 'hex')
  from kb_stage.scenario_tests s
on conflict (scenario_id) do nothing;

create table if not exists public.scenario_expectation_change (
  id                bigserial primary key,
  scenario_id       text not null,
  original_expected text not null,
  new_expected      text not null,
  reason            text not null,
  work_item         text not null,
  changed_by        text not null,
  changed_at        timestamptz not null default now(),
  constraint sec_reason_not_blank     check (btrim(reason) <> ''),
  constraint sec_work_item_not_blank  check (btrim(work_item) <> ''),
  constraint sec_changed_by_not_blank check (btrim(changed_by) <> ''),
  constraint sec_actually_changed     check (original_expected is distinct from new_expected)
);
create index if not exists scenario_expectation_change_scenario_idx
  on public.scenario_expectation_change (scenario_id, changed_at desc);
alter table public.scenario_expectation_change enable row level security;
alter table public.scenario_expectation_baseline enable row level security;

comment on table public.scenario_expectation_change is
  'Append-only. Every change to a scenario expectation: what it was, what it became, why, under which work item, by whom. UPDATE and DELETE are refused by trigger.';

create or replace function public.trg_expectation_ledger_append_only()
returns trigger language plpgsql as $fn$
begin
  raise exception 'scenario_expectation_change is append-only: % is not permitted.', tg_op
    using hint = 'The point of this table is that history cannot be rewritten. Record a new change instead.';
end $fn$;

drop trigger if exists expectation_ledger_no_update on public.scenario_expectation_change;
create trigger expectation_ledger_no_update before update or delete on public.scenario_expectation_change
  for each row execute function public.trg_expectation_ledger_append_only();

drop trigger if exists expectation_baseline_immutable on public.scenario_expectation_baseline;
create trigger expectation_baseline_immutable before update or delete on public.scenario_expectation_baseline
  for each row execute function public.trg_expectation_ledger_append_only();

create or replace function public.trg_expectation_work_item_real()
returns trigger language plpgsql as $fn$
begin
  if not exists (select 1 from public.spec_backlog where spec_ref = new.work_item) then
    raise exception 'work_item % does not resolve to a tracked item in spec_backlog', new.work_item
      using hint = 'Open the work item first. An expectation change approved by nothing is approved by nobody.';
  end if;
  return new;
end $fn$;

drop trigger if exists expectation_work_item_real on public.scenario_expectation_change;
create trigger expectation_work_item_real before insert on public.scenario_expectation_change
  for each row execute function public.trg_expectation_work_item_real();

create or replace function public.trg_scenario_expected_needs_ledger()
returns trigger language plpgsql as $fn$
begin
  if new.expected is distinct from old.expected
     and coalesce(current_setting('quotesdone.expectation_change', true), '') <> 'approved' then
    raise exception 'scenario_tests.expected cannot be changed directly (scenario %)', old.scenario_id
      using hint = 'Use public.fn_scenario_expectation_change(scenario_id, new_expected, reason, work_item, changed_by).';
  end if;
  return new;
end $fn$;

drop trigger if exists scenario_expected_needs_ledger on kb_stage.scenario_tests;
create trigger scenario_expected_needs_ledger before update on kb_stage.scenario_tests
  for each row execute function public.trg_scenario_expected_needs_ledger();

create or replace function public.fn_scenario_expectation_change(
  p_scenario_id text, p_new_expected text, p_reason text, p_work_item text, p_changed_by text)
returns jsonb language plpgsql security definer set search_path to 'public' as $fn$
declare v_current text; v_id bigint;
begin
  if coalesce(btrim(p_reason),'') = '' then
    return jsonb_build_object('ok', false, 'error', 'reason_required',
      'message', 'An expectation change without a written reason is a silent edit with extra steps.');
  end if;
  if coalesce(btrim(p_changed_by),'') = '' then
    return jsonb_build_object('ok', false, 'error', 'changed_by_required');
  end if;
  if not exists (select 1 from public.spec_backlog where spec_ref = p_work_item) then
    return jsonb_build_object('ok', false, 'error', 'unknown_work_item',
      'message', 'work_item must resolve to a tracked item in spec_backlog. Open one first.');
  end if;

  select expected into v_current from kb_stage.scenario_tests where scenario_id = p_scenario_id;
  if not found then return jsonb_build_object('ok', false, 'error', 'unknown_scenario'); end if;
  if coalesce(v_current,'') is not distinct from coalesce(p_new_expected,'') then
    return jsonb_build_object('ok', false, 'error', 'no_change');
  end if;

  insert into public.scenario_expectation_change
    (scenario_id, original_expected, new_expected, reason, work_item, changed_by)
  values (p_scenario_id, coalesce(v_current,''), coalesce(p_new_expected,''), btrim(p_reason), p_work_item, btrim(p_changed_by))
  returning id into v_id;

  perform set_config('quotesdone.expectation_change', 'approved', true);
  update kb_stage.scenario_tests set expected = p_new_expected where scenario_id = p_scenario_id;
  perform set_config('quotesdone.expectation_change', '', true);

  return jsonb_build_object('ok', true, 'ledger_id', v_id, 'scenario_id', p_scenario_id, 'work_item', p_work_item);
