// @ts-nocheck
'use client';
/* QuotesDone OS — full port of os3 (every function preserved). Runs the original
   os3 application logic inside a Next.js client component. Single codebase. */
import { useEffect, useRef } from 'react';
import { createClient } from '@supabase/supabase-js';

const SHELL = `<style>
  :root{
    --bg:#f5f6f8; --panel:#ffffff; --ink:#0f1720; --muted:#5b6672; --line:#e6e9ee;
    --rail:#0f1b2d; --rail-ink:#c7d2e0; --rail-ink-dim:#7f8da0; --rail-active:#12b3a6;
    --brand:#0E7C73; --brand-2:#12b3a6; --accent:#2f6df6;
    --ok:#12a150; --warn:#d9820b; --bad:#e02424; --info:#2f6df6;
    --chip:#eef1f5; --shadow:0 1px 2px rgba(16,24,40,.06),0 4px 16px rgba(16,24,40,.06);
    --radius:14px;
  }
  [data-theme="dark"]{
    --bg:#0b1220; --panel:#111a2b; --ink:#e8eef7; --muted:#9fb0c4; --line:#1e2b41;
    --rail:#0a1120; --rail-ink:#b9c6d8; --chip:#182338; --shadow:0 1px 2px rgba(0,0,0,.4);
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{background:var(--bg);color:var(--ink);font:14px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased}
  .app{display:grid;grid-template-columns:248px 1fr 336px;grid-template-rows:56px 1fr;height:100vh;grid-template-areas:"rail top top" "rail main aside"}
  /* rail */
  .rail{grid-area:rail;background:var(--rail);color:var(--rail-ink);display:flex;flex-direction:column;overflow-y:auto}
  .brand{display:flex;align-items:center;gap:10px;padding:16px 18px;font-weight:700;color:#fff;font-size:15px;letter-spacing:.2px}
  .brand .dot{width:22px;height:22px;border-radius:7px;background:linear-gradient(135deg,var(--brand-2),var(--brand));display:grid;place-items:center;color:#fff;font-size:12px}
  .navgroup{padding:8px 10px}
  .navlabel{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#5f6f88;padding:10px 12px 6px}
  .navitem{display:flex;align-items:center;gap:11px;padding:9px 12px;border-radius:10px;cursor:pointer;color:var(--rail-ink);font-weight:500;position:relative}
  .navitem:hover{background:rgba(255,255,255,.05);color:#fff}
  .navitem.active{background:linear-gradient(90deg,rgba(18,179,166,.18),rgba(18,179,166,.04));color:#fff}
  .navitem.active::before{content:"";position:absolute;left:0;top:8px;bottom:8px;width:3px;border-radius:3px;background:var(--brand-2)}
  .navitem .ic{width:18px;text-align:center;opacity:.9}
  .navitem .lbl{flex:1}
  .badge{min-width:20px;height:20px;padding:0 6px;border-radius:10px;background:#22314c;color:#cdd8ea;font-size:11px;font-weight:700;display:grid;place-items:center}
  .badge.hot{background:#e02424;color:#fff}
  .badge.warn{background:#d9820b;color:#fff}
  .railfoot{margin-top:auto;padding:14px 16px;font-size:12px;color:#5f6f88;border-top:1px solid rgba(255,255,255,.06)}
  /* top */
  .top{grid-area:top;background:var(--panel);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:14px;padding:0 18px}
  .search{flex:1;max-width:620px;display:flex;align-items:center;gap:9px;background:var(--chip);border:1px solid var(--line);border-radius:11px;padding:8px 12px;cursor:text;color:var(--muted)}
  .search kbd{margin-left:auto;background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:1px 6px;font-size:11px;color:var(--muted)}
  .top .sp{flex:1}
  .iconbtn{width:36px;height:36px;border:1px solid var(--line);background:var(--panel);border-radius:10px;cursor:pointer;color:var(--ink);font-size:15px;display:grid;place-items:center}
  .iconbtn:hover{background:var(--chip)}
  .who{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted)}
  .who .av{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--brand-2),var(--brand));color:#fff;display:grid;place-items:center;font-weight:700;font-size:12px}
  /* main */
  .main{grid-area:main;overflow-y:auto;padding:22px 24px}
  .aside{grid-area:aside;overflow-y:auto;border-left:1px solid var(--line);background:var(--panel);padding:18px}
  .wshead{display:flex;align-items:center;gap:12px;margin:0 0 4px}
  .wshead h1{font-size:20px;margin:0;font-weight:700;letter-spacing:-.01em}
  .wssub{color:var(--muted);font-size:13px;margin:0 0 18px}
  .pill{font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px;text-transform:capitalize}
  .pill.good{background:rgba(18,161,80,.13);color:var(--ok)} .pill.attention{background:rgba(217,130,11,.14);color:var(--warn)} .pill.bad{background:rgba(224,36,36,.12);color:var(--bad)}
  .grid{display:grid;gap:14px}
  .kpis{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}
  .cards2{grid-template-columns:1fr 1fr}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:16px;box-shadow:var(--shadow)}
  .card h3{margin:0 0 12px;font-size:13px;font-weight:700;color:var(--ink);display:flex;align-items:center;gap:8px}
  .card h3 .tag{margin-left:auto;font-size:11px;font-weight:600;color:var(--muted)}
  .kpi .lbl{font-size:12px;color:var(--muted);margin-bottom:6px}
  .kpi .val{font-size:24px;font-weight:750;letter-spacing:-.02em}
  .kpi .val small{font-size:13px;color:var(--muted);font-weight:600}
  .kpi .sub{font-size:11px;color:var(--muted);margin-top:3px}
  .row{display:flex;align-items:center;justify-content:space-between;padding:7px 0;border-bottom:1px dashed var(--line);font-size:13px}
  .row:last-child{border-bottom:0}
  .row .k{color:var(--muted)} .row .v{font-weight:650}
  .bar{height:8px;border-radius:6px;background:var(--chip);overflow:hidden;margin-top:5px}
  .bar>span{display:block;height:100%;border-radius:6px;background:linear-gradient(90deg,var(--brand-2),var(--brand))}
  .gauge{display:flex;align-items:center;gap:16px}
  .gauge .num{font-size:40px;font-weight:800;letter-spacing:-.03em;line-height:1}
  .comp{margin-top:4px}
  .comp .row{border:0;padding:5px 0}
  .comp .cbar{height:7px}
  .att{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}
  .att:last-child{border-bottom:0}
  .att .ico{width:30px;height:30px;border-radius:8px;background:var(--chip);display:grid;place-items:center;font-size:14px;flex:none}
  .att .t{font-size:13px;font-weight:600;line-height:1.3}
  .att .m{font-size:11px;color:var(--muted);margin-top:2px}
  .tsk{display:flex;gap:9px;align-items:flex-start;padding:9px 0;border-bottom:1px solid var(--line)}
  .tsk:last-child{border-bottom:0}
  .dotp{width:8px;height:8px;border-radius:50%;margin-top:5px;flex:none;background:var(--muted)}
  .dotp.low{background:#9aa7b5}.dotp.normal{background:var(--info)}.dotp.high{background:var(--warn)}.dotp.urgent{background:var(--bad)}
  .asideh{font-size:12px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin:18px 0 8px;font-weight:700}
  .asideh:first-child{margin-top:0}
  .muted{color:var(--muted)} .small{font-size:12px}
  .chiprow{display:flex;flex-wrap:wrap;gap:6px}
  .chip{background:var(--chip);border-radius:8px;padding:5px 9px;font-size:12px}
  .qa{display:flex;flex-direction:column;gap:8px}
  .qa button{text-align:left;border:1px solid var(--line);background:var(--panel);border-radius:10px;padding:10px 12px;cursor:pointer;color:var(--ink);font-weight:600;font-size:13px}
  .qa button:hover{background:var(--chip)}
  .skel{height:96px;border-radius:var(--radius);background:linear-gradient(90deg,var(--chip),var(--panel),var(--chip));background-size:200% 100%;animation:sk 1.2s infinite}
  @keyframes sk{0%{background-position:200% 0}100%{background-position:-200% 0}}
  /* palette */
  .ovl{position:fixed;inset:0;background:rgba(8,14,24,.42);backdrop-filter:blur(2px);display:none;align-items:flex-start;justify-content:center;padding-top:12vh;z-index:80}
  .ovl.on{display:flex}
  .pal{width:min(680px,92vw);background:var(--panel);border:1px solid var(--line);border-radius:16px;box-shadow:0 24px 60px rgba(0,0,0,.35);overflow:hidden}
  .pal input{width:100%;border:0;outline:0;padding:16px 18px;font-size:16px;background:var(--panel);color:var(--ink);border-bottom:1px solid var(--line)}
  .palres{max-height:52vh;overflow-y:auto;padding:6px}
  .palg{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);padding:10px 12px 4px;font-weight:700}
  .palitem{display:flex;gap:10px;align-items:center;padding:9px 12px;border-radius:9px;cursor:pointer}
  .palitem:hover,.palitem.sel{background:var(--chip)}
  .palitem .n{font-weight:600;font-size:13px}.palitem .s{font-size:11px;color:var(--muted)}
  .palitem .tp{margin-left:auto;font-size:11px;color:var(--muted);text-transform:capitalize}
  /* drawer */
  .drw{position:fixed;top:0;right:0;bottom:0;width:min(560px,94vw);background:var(--panel);border-left:1px solid var(--line);box-shadow:-16px 0 40px rgba(0,0,0,.18);transform:translateX(100%);transition:transform .22s;z-index:70;overflow-y:auto}
  .drw.on{transform:none}
  .drwh{position:sticky;top:0;background:var(--panel);border-bottom:1px solid var(--line);padding:16px 18px;display:flex;align-items:center;gap:10px}
  .drwh h2{margin:0;font-size:16px}
  .drwbody{padding:16px 18px}
  .toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(20px);background:#0f1b2d;color:#fff;padding:11px 18px;border-radius:10px;opacity:0;transition:.2s;z-index:120;font-size:13px}
  .toast.on{opacity:1;transform:translateX(-50%)}
  .burger{display:none}
  @media(max-width:1180px){.app{grid-template-columns:248px 1fr;grid-template-areas:"rail top" "rail main"}.aside{display:none}}
  @media(max-width:820px){.app{grid-template-columns:1fr;grid-template-areas:"top" "main"}.rail{position:fixed;inset-block:0;left:0;width:248px;z-index:90;transform:translateX(-260px);transition:transform .2s}.rail.open{transform:none}.burger{display:grid}}

/* --- port overrides (Tailwind preflight neutralisation for OS controls) --- */
.main .btn,.card .btn{border:1px solid var(--line);background:var(--panel);color:var(--ink);border-radius:8px;padding:6px 12px;font:inherit;font-weight:600;cursor:pointer;margin:0 2px}
.main .btn:hover,.card .btn:hover{background:var(--chip)}
.card table th,.card table td{padding:7px 8px}
button{font-family:inherit}
</style>
<div class="app" id="app" style="display:none">
  <nav class="rail" id="rail">
    <div class="brand"><span class="dot">◆</span> QuotesDone <span style="font-weight:600;color:#5f6f88;font-size:12px">OS</span></div>
    <div id="navroot"></div>
    <div class="railfoot">v3 · <span id="whoami">—</span></div>
  </nav>
  <header class="top">
    <button class="iconbtn burger" id="burger">☰</button>
    <div class="search" id="searchbtn"><span>🔍</span> <span>Search suppliers, customers, RFQs, docs…</span> <kbd>Ctrl K</kbd></div>
    <div class="sp"></div>
    <button class="iconbtn" id="themebtn" title="Theme">◐</button>
    <button class="iconbtn" id="refreshbtn" title="Refresh">⟳</button>
    <div class="who"><span class="av" id="avatar">?</span></div>
  </header>
  <main class="main" id="main"></main>
  <aside class="aside" id="aside"></aside>
</div>

<div class="ovl" id="palette"><div class="pal"><input id="palinput" placeholder="Search across the platform…" autocomplete="off"><div class="palres" id="palres"><div class="palg">Type to search</div></div></div></div>
<div class="drw" id="drawer"><div class="drwh"><button class="iconbtn" id="drwclose">✕</button><h2 id="drwtitle">Record</h2></div><div class="drwbody" id="drwbody"></div></div>
<div class="toast" id="toast"></div>`;

export function OsApp() {
  const booted = useRef(false);
  useEffect(() => {
    if (booted.current) return; booted.current = true;
    (async () => {
const URL='https://htdblwldjkcgjvmqkbeh.supabase.co';
  const ANON='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh0ZGJsd2xkamtjZ2p2bXFrYmVoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA3ODU1NDYsImV4cCI6MjA5NjM2MTU0Nn0.cF9ZR_Qo1YBhLvhTLS8aANlYb6c9rTsuQS6kLxGw_Bo';
  const SB=createClient(URL,ANON);
  function ready(session){ window.OS_AUTH={ Authorization:'Bearer '+session.access_token }; window.OS_EMAIL=session.user?.email||''; window.dispatchEvent(new Event('os-auth-ready')); }
  const _osk=(new URLSearchParams(location.search).get('k'))||(function(){try{return localStorage.getItem('os_k')}catch(_e){return null}})()||''; if(_osk){ try{localStorage.setItem('os_k',_osk)}catch(_e){} window.OS_AUTH={Authorization:'Bearer '+ANON,'x-os-key':_osk}; window.OS_EMAIL='preview'; window.dispatchEvent(new Event('os-auth-ready')); }
  const { data:{ session } } = _osk ? {data:{session:null}} : await SB.auth.getSession();
  if(session){ ready(session); }
  else if(!_osk){
    document.body.insertAdjacentHTML('beforeend','<div id="lg" style="position:fixed;inset:0;display:grid;place-items:center;background:var(--bg);z-index:99"><form id="lf" style="background:var(--panel);padding:26px;border-radius:14px;min-width:320px;box-shadow:0 12px 40px rgba(0,0,0,.18);border:1px solid var(--line)"><div style="font-weight:800;font-size:17px;margin-bottom:4px">QuotesDone OS</div><div style="color:#5b6672;font-size:13px;margin-bottom:16px">Sign in with your admin account</div><input id="em" type="email" placeholder="admin email" style="width:100%;height:40px;margin-bottom:9px;padding:0 12px;border:1px solid var(--line);border-radius:9px;background:var(--bg)"><input id="pw" type="password" placeholder="password" style="width:100%;height:40px;margin-bottom:14px;padding:0 12px;border:1px solid var(--line);border-radius:9px;background:var(--bg)"><button style="width:100%;height:42px;background:linear-gradient(135deg,#12b3a6,#0E7C73);color:#fff;border:0;border-radius:9px;font-weight:700;cursor:pointer">Sign in</button><div id="er" style="color:#e02424;font-size:13px;margin-top:10px"></div></form></div>');
    document.getElementById('lf').addEventListener('submit',async(e)=>{e.preventDefault();const{data,error}=await SB.auth.signInWithPassword({email:em.value.trim(),password:pw.value});if(error||!data.session){document.getElementById('er').textContent='Sign-in failed — check credentials.';return;}document.getElementById('lg').remove();ready(data.session);});
  }
const $=s=>document.querySelector(s), el=(t,c,h)=>{const e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e;};
const FN=URLBASE();
function URLBASE(){return 'https://htdblwldjkcgjvmqkbeh.supabase.co/functions/v1';}
function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('on');setTimeout(()=>t.classList.remove('on'),2200);}
const money=n=>{n=Number(n||0);return 'AED '+n.toLocaleString('en-AE',{maximumFractionDigits:0});};
const num=n=>Number(n||0).toLocaleString('en-AE',{maximumFractionDigits:1});
const pct=n=>(n==null?'—':num(n)+'%');
const cap=s=>String(s||'').replace(/[_-]+/g,' ').replace(/\b\w/g,c=>c.toUpperCase());
const ago=t=>{if(!t)return '';const d=(Date.now()-new Date(t))/6e4;if(d<60)return Math.round(d)+'m ago';if(d<1440)return Math.round(d/60)+'h ago';return Math.round(d/1440)+'d ago';};

// ---- os_api gateway ----
async function api(action,body){
  const ctl=new AbortController(); const to=setTimeout(()=>ctl.abort(),20000);
  let r; try{ r=await fetch(FN+'/os_api',{method:'POST',signal:ctl.signal,headers:{'Content-Type':'application/json',...(window.OS_AUTH||{})},body:JSON.stringify({action,...(body||{})})}); }
  finally{ clearTimeout(to); }
  const j=await r.json().catch(()=>({}));
  if(r.status===401){ toast('Session expired — refresh to sign in.'); throw new Error('unauthorized'); }
  if(r.status===403){ toast('Not authorized — sign in as an admin.'); throw new Error('forbidden'); }
  if(j.error) throw new Error(j.error);
  return j.data;
}

// ---- modules ----
const MODULES=[
  {group:'Command'},{id:'secretary',ic:'✵',label:'Command Console',kind:'secretary'},
  {id:'exec',   ic:'◎', label:'Executive HQ', badge:null, kind:'exec'},
  {id:'ea',     ic:'🗓', label:'Assistant', kind:'ws', action:'ws.ea'},
  {id:'inbox',  ic:'✉', label:'Inbox', kind:'inbox'},
  {id:'analytics',ic:'▤',label:'Analytics', kind:'ws', action:'ws.analytics'},
  {id:'reports',ic:'📊',label:'Reports', kind:'reports'},
  {id:'audit',ic:'🧾',label:'Audit log', kind:'audit'},
  {id:'content',ic:'📝',label:'Content & Pages', kind:'content'},
  {id:'strategy',ic:'🧭',label:'Strategy', kind:'ws', action:'ws.strategy'},
  {id:'marketing',ic:'📣',label:'Marketing', kind:'ws', action:'ws.marketing'},
  {group:'Marketplace'},
  {id:'marketplace',ic:'⇄',label:'RFQs & Procurement', badge:'rfqs_active', kind:'rfqs'},
  {id:'suppliers',ic:'⚒',label:'Suppliers', badge:'suppliers_review', kind:'suppliers'},
  {id:'customers',ic:'☺',label:'Customers', kind:'customers'},
  {id:'operations',ic:'⚙',label:'Operations', badge:'disputes', kind:'ws', action:'ws.operations'},
  {group:'Intelligence'},
  {id:'ai',     ic:'✦', label:'Smart Engine Agents', kind:'agents'},
  {id:'knowledge',ic:'❋',label:'Knowledge', badge:'knowledge_review', kind:'ws', action:'ws.knowledge'},
  {id:'documents',ic:'▢',label:'Documents', badge:'documents_review', kind:'ws', action:'ws.documents'},
  {group:'Business'},
  {id:'finance',ic:'$',label:'Finance (CFO)', kind:'finance'},
  {id:'company',ic:'⌂',label:'Company', kind:'ws', action:'ws.company'},
  {id:'governance',ic:'⚖',label:'Smart Engine Governance', kind:'ws', action:'ws.governance'},
  {group:'Trust & Safety'},
  {id:'fraud',ic:'⚠',label:'Fraud & Safety', badge:'fraud_open', kind:'fraud', action:'ws.fraud'},
  {id:'refunds',ic:'↩',label:'Refunds & Disputes', badge:'disputes', kind:'refunds', action:'ws.refunds'},
  {group:'Account'},
  {id:'logout', ic:'⎋', label:'Sign out', kind:'logout'},
];
let NAV={badges:{}}, CUR='secretary';

function renderNav(){
  const root=$('#navroot'); root.innerHTML='';
  let g=el('div','navgroup');
  MODULES.forEach(m=>{
    if(m.group){ root.appendChild(g); g=el('div','navgroup'); g.appendChild(el('div','navlabel',m.group)); return; }
    const it=el('div','navitem'+(m.id===CUR?' active':''));
    it.innerHTML=`<span class="ic">${m.ic}</span><span class="lbl">${m.label}</span>`;
    const bv=m.badge?Number(NAV.badges?.[m.badge]||0):0;
    if(bv>0){ const b=el('span','badge'+(m.badge==='approvals'||m.badge==='disputes'&&bv>0?' warn':'')); b.textContent=bv>99?'99+':bv; it.appendChild(b);}
    it.onclick=()=>{ if(m.kind==='logout'){ try{Object.keys(localStorage).forEach(k=>{ if(/sb-.*-auth-token/.test(k)||k.indexOf('qd-')===0||k.indexOf('supabase')===0) localStorage.removeItem(k); });}catch(_e){} location.href='/os'; return; } CUR=m.id; renderNav(); openModule(m); if(window.innerWidth<820)$('#rail').classList.remove('open'); };
    g.appendChild(it);
  });
  root.appendChild(g);
}

function openModule(m){
  if(m.kind==='secretary') return loadSecretary();
  if(m.kind==='exec') return loadExec();
  if(m.kind==='finance') return loadFinance();
  if(m.kind==='customers') return loadCustomers();
  if(m.kind==='agents') return loadAgents();
  if(m.kind==='rfqs') return loadRfqs();
  if(m.kind==='inbox') return loadInbox();
  if(m.kind==='suppliers') return loadSuppliers();
  if(m.kind==='reports') return loadReports();
  if(m.kind==='fraud') return loadFraud(m);
  if(m.kind==='refunds') return loadRefunds(m);
  if(m.kind==='ws') return loadWs(m);
}

// ================= COMMAND CONSOLE (Secretary) =================
async function loadSecretary(){
  const main=$('#main'); const aside=$('#aside'); if(aside) aside.innerHTML='';
  if(!window.__secHist) window.__secHist=[]; if(!window.__secAtt) window.__secAtt=[];
  const secEsc=(s)=>String(s==null?'':s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
  main.innerHTML='<div class="card" style="display:flex;flex-direction:column;height:calc(100vh - 150px);min-height:440px;padding:14px">'
    +'<div style="display:flex;align-items:center;gap:10px;border-bottom:1px solid #eceeee;padding-bottom:10px;margin-bottom:10px">'
    +'<div style="width:34px;height:34px;border-radius:9px;background:#0E7C73;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800">✵</div>'
    +'<div><div style="font-weight:800;font-size:16px;line-height:1.1">Command Console</div><div style="font-size:12px;color:#6b7280">Your Secretary — instruct it, attach a document, and it acts across the whole team.</div></div>'
    +'<button id="secClear" style="margin-left:auto;background:#f3f4f6;border:1px solid #e5e7eb;border-radius:8px;padding:6px 10px;cursor:pointer">Clear</button>'
    +'</div>'
    +'<div id="secMsgs" style="flex:1;overflow:auto;display:flex;flex-direction:column;gap:10px;padding:4px"></div>'
    +'<div id="secAtts" style="display:flex;flex-wrap:wrap;gap:6px;margin:6px 0 0"></div>'
    +'<div style="display:flex;gap:8px;align-items:flex-end;border-top:1px solid #eceeee;padding-top:10px;margin-top:8px">'
    +'<label title="Attach a document" style="cursor:pointer;background:#f3f4f6;border:1px solid #e5e7eb;border-radius:9px;padding:9px 11px;font-size:16px">📎<input id="secFile" type="file" accept="image/*,application/pdf" style="display:none"></label>'
    +'<textarea id="secInput" rows="2" placeholder="e.g. Approve supplier 30412 — or attach an invoice and say: log this to finance" style="flex:1;resize:vertical;padding:10px;border:1px solid #d1d5db;border-radius:10px;font:inherit;min-height:44px"></textarea>'
    +'<button id="secSend" style="background:#0E7C73;color:#fff;border:0;border-radius:10px;padding:11px 18px;font-weight:700;cursor:pointer">Send</button>'
    +'</div></div>';
  const msgs=$('#secMsgs');
  function bubble(role,html){ const b=el('div'); b.style.cssText='max-width:82%;padding:10px 12px;border-radius:12px;white-space:pre-wrap;word-break:break-word;font-size:14px;line-height:1.45;'+(role==='user'?'align-self:flex-end;background:#0E7C73;color:#fff':'align-self:flex-start;background:#f1f5f5;color:#111827'); b.innerHTML=html; msgs.appendChild(b); msgs.scrollTop=msgs.scrollHeight; return b; }
  function renderAtts(){ const box=$('#secAtts'); if(!box) return; box.innerHTML=''; (window.__secAtt||[]).forEach((a,i)=>{ const c=el('span'); c.style.cssText='background:#eef6f5;border:1px solid #cfe3e0;border-radius:20px;padding:3px 10px;font-size:12px;cursor:pointer'; c.textContent='📄 '+a.name+'  ✕'; c.onclick=()=>{ window.__secAtt.splice(i,1); renderAtts(); }; box.appendChild(c); }); }
  (window.__secHist||[]).forEach(m=>bubble(m.role, secEsc(m.content))); renderAtts();
  if(!window.__secHist.length) bubble('assistant','Hi — I am your Secretary. Ask me to check status, approve a supplier, draft content, log a finance entry, or attach an invoice and tell me what to do with it.');
  $('#secClear').onclick=()=>{ window.__secHist=[]; window.__secAtt=[]; loadSecretary(); };
  $('#secFile').onchange=async(e)=>{ const f=e.target&&e.target.files&&e.target.files[0]; if(!f){return;} const chip=bubble('assistant','Reading '+secEsc(f.name)+'…'); try{ const b64=await new Promise((res,rej)=>{ const rd=new FileReader(); rd.onload=()=>res(String(rd.result||'')); rd.onerror=rej; rd.readAsDataURL(f); }); const d=await api('extract_doc',{filename:f.name,mime:f.type,b64:b64}); if(d&&d.ok&&d.text){ window.__secAtt.push({name:f.name,text:d.text}); chip.textContent='Attached: '+f.name+' ('+d.text.length+' chars read). Now tell me what to do with it.'; renderAtts(); } else { chip.textContent='Could not read '+f.name+((d&&d.detail)?(' — '+d.detail):''); } }catch(_err){ chip.textContent='Could not read '+f.name; } if(e.target) e.target.value=''; };
  async function send(){ const inp=$('#secInput'); const text=((inp&&inp.value)||'').trim(); const atts=(window.__secAtt||[]).slice(); if(!text && !atts.length) return; if(inp) inp.value=''; const attNote=atts.length?(' 📎 '+atts.map(a=>a.name).join(', ')):''; window.__secHist.push({role:'user',content:(text||'(document attached)')+attNote}); bubble('user', secEsc(text||'(document attached)')+(attNote?('<div style="opacity:.8;font-size:11px;margin-top:4px">'+secEsc(attNote.trim())+'</div>'):'')); window.__secAtt=[]; renderAtts(); const think=bubble('assistant','…'); try{ const hist=(window.__secHist||[]).slice(-8).map(m=>({role:m.role==='user'?'user':'assistant',content:String(m.content||'')})); const d=await api('secretary_chat',{message:text||'Please handle the attached document.',history:hist,attachments:atts}); think.remove(); const reply=(d&&d.reply)||'Done.'; window.__secHist.push({role:'assistant',content:reply}); const rb=bubble('assistant', secEsc(reply)); if(d&&d.needs_confirmation&&d.confirm_token){ const row=el('div'); row.style.cssText='display:flex;gap:8px;margin-top:8px'; const yes=el('button'); yes.textContent='Confirm'; yes.style.cssText='background:#0E7C73;color:#fff;border:0;border-radius:8px;padding:7px 14px;font-weight:700;cursor:pointer'; const no=el('button'); no.textContent='Cancel'; no.style.cssText='background:#f3f4f6;border:1px solid #e5e7eb;border-radius:8px;padding:7px 14px;cursor:pointer'; row.appendChild(yes); row.appendChild(no); rb.appendChild(row); yes.onclick=async()=>{ yes.disabled=no.disabled=true; try{ const r=await api('secretary_chat',{confirm_token:d.confirm_token,decision:'confirm'}); const rp=(r&&r.reply)||'Done.'; window.__secHist.push({role:'assistant',content:rp}); bubble('assistant', secEsc(rp)); }catch(_e){ bubble('assistant','Could not complete that action.'); } }; no.onclick=async()=>{ yes.disabled=no.disabled=true; try{ const r=await api('secretary_chat',{confirm_token:d.confirm_token,decision:'cancel'}); bubble('assistant', secEsc((r&&r.reply)||'Cancelled.')); }catch(_e){ bubble('assistant','Cancelled.'); } }; } }catch(err){ think.textContent='Error: '+((err&&err.message)||'could not reach the Secretary'); } }
  $('#secSend').onclick=send;
  const si=$('#secInput'); if(si) si.addEventListener('keydown',(e)=>{ if(e.key==='Enter'&&(e.metaKey||e.ctrlKey)){ e.preventDefault(); send(); } });
}

// ================= EXECUTIVE COMMAND CENTER =================
async function loadExec(){
  const main=$('#main'); main.innerHTML=skeleton(); const aside=$('#aside'); aside.innerHTML='';
  let d; try{ d=await api('ws.exec'); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  const c=d.command||{}, ops=c.ops||{}, rev=ops.revenue||{}, mk=ops.marketplace||{}, op=ops.operations||{}, inf=ops.infrastructure||{}, cnt=c.counts||{}, h=c.health||{};
  const band=(h.band||'good').toLowerCase(); const bandc=band==='good'?'good':(band==='bad'||band==='critical'?'bad':'attention');
  main.innerHTML='';
  main.appendChild(el('div','wshead',`<h1>Executive Command Center</h1><span class="pill ${bandc}">${cap(h.band||'—')}</span>`));
  main.appendChild(el('p','wssub',`Operational headquarters · health index ${num(h.index??ops.health_index)} / 100 · as of ${new Date(ops.as_of||Date.now()).toLocaleString('en-AE')}`));

  const kpis=el('div','grid kpis');
  kpis.append(
    kpi('Cash received', money(rev.cash_received_aed), 'lifetime, net'),
    kpi('Pending fees', money(rev.pending_fees_aed), 'awaiting collection'),
    kpi('Revenue — month', money(rev.month_aed), 'this calendar month'),
    kpi('Revenue — today', money(rev.today_aed), ''),
    kpi('Outstanding', String(rev.outstanding_invoices??0), 'open invoices'),
  );
  main.appendChild(kpis);

  // health + marketplace
  const row1=el('div','grid cards2');
  // health card
  const hc=el('div','card'); hc.appendChild(el('h3',null,'Company Health Index'));
  const comps=h.components||{};
  hc.appendChild(el('div','gauge',`<div class="num" style="color:${bandc==='good'?'var(--ok)':bandc==='bad'?'var(--bad)':'var(--warn)'}">${num(h.index??0)}</div><div class="muted small">out of 100<br>${cap(h.band||'')}${h.components_present?` · ${h.components_present} signals`:''}</div>`));
  const cwrap=el('div','comp');
  Object.entries(comps).forEach(([k,v])=>{ if(v==null)return; cwrap.appendChild(el('div','row',`<span class="k">${cap(k)}</span><span class="v">${num(v)}</span>`)); const b=el('div','bar cbar');b.innerHTML=`<span style="width:${Math.max(2,Math.min(100,Number(v)))}%"></span>`;cwrap.appendChild(b); });
  hc.appendChild(cwrap); row1.appendChild(hc);
  // marketplace
  row1.appendChild(statCard('Marketplace', [
    ['Active RFQs', num(mk.active_rfqs), cnt.rfqs_active!=null?`${cnt.rfqs_active} live`:''],
    ['RFQs today', num(mk.rfqs_today)],
    ['Conversion', pct(mk.conversion_pct)],
    ['Avg quotes / RFQ', num(mk.avg_quotes_per_rfq)],
    ['Supplier acceptance', pct((mk.supplier_acceptance_pct||0)*100>100?mk.supplier_acceptance_pct:mk.supplier_acceptance_pct*100)],
    ['Avg hrs to 1st quote', num(mk.avg_hours_to_first_quote)],
    ['Completed today', num(mk.completed_today)],
  ]));
  main.appendChild(row1);

  const row2=el('div','grid cards2');
  row2.appendChild(statCard('Operations', [
    ['Escalations', num(op.escalations), Number(op.escalations)>0?'need review':''],
    ['Disputes', num(op.disputes)],
    ['Onboarding queue', num(op.onboarding_queue)],
    ['Smart Engine confidence', pct(op.ai_confidence_pct)],
    ['RFQs awaiting clarification', num(op.rfqs_waiting_clarification)],
  ]));
  row2.appendChild(statCard('Infrastructure', [
    ['Uptime', pct(inf.uptime_pct)],
    ['API latency', num(inf.api_latency_ms)+' ms'],
    ['Failed jobs (24h)', num(inf.failed_jobs_24h)],
    ['Queue size', num(inf.queue_size)],
    ['Backup age', num(inf.backup_age_hours)+' h'],
  ]));
  main.appendChild(row2);

  main.appendChild(statCard('Business counts', [
    ['Suppliers', num(cnt.suppliers_total)],
    ['RFQs total', num(cnt.rfqs_total)],
    ['Quotes total', num(cnt.quotes_total)],
    ['Decisions 24h', num(cnt.decisions_24h)],
    ['Decisions 7d', num(cnt.decisions_7d)],
    ['RFQs revealed', num(cnt.rfqs_revealed)],
    ['RFQs cancelled', num(cnt.rfqs_cancelled)],
  ]));

  // ---- right: contextual intelligence ----
  renderExecAside(c.attention||[], d.tasks||[]);
}
function renderExecAside(attention, tasks){
  const a=$('#aside'); a.innerHTML='';
  a.appendChild(el('div','asideh',`Needs attention${attention.length?` · ${attention.length}`:''}`));
  if(!attention.length) a.appendChild(el('div','muted small','Nothing pending. 🎉'));
  attention.slice(0,8).forEach(x=>{
    const it=el('div','att');
    it.innerHTML=`<div class="ico">${x.kind==='ai_gate'?'✦':x.kind==='action_gate'?'⚑':'●'}</div><div><div class="t">${cap(x.decision||x.kind)}</div><div class="m">${cap(x.actor||'')}${x.route_to?` → ${x.route_to}`:''} · ${ago(x.created_at)}</div></div>`;
    it.style.cursor='pointer'; it.onclick=()=>navTo(x.kind==='ai_gate'?'ai':'approvals');
    a.appendChild(it);
  });
  a.appendChild(el('div','asideh','Your tasks'));
  if(!tasks.length) a.appendChild(el('div','muted small','No open tasks.'));
  tasks.slice(0,8).forEach(t=>{
    const it=el('div','tsk');
    it.innerHTML=`<span class="dotp ${t.priority||'normal'}"></span><div><div class="t" style="font-size:13px;font-weight:600">${t.title||''}</div><div class="m muted small">${cap(t.status||'')}${t.due?` · due ${t.due}`:''}</div></div>`;
    it.style.cursor='pointer'; it.onclick=()=>navTo('tasks');
    a.appendChild(it);
  });
  a.appendChild(el('div','asideh','Quick actions'));
  const qa=el('div','qa');
  qa.append(
    actBtn('🔍  Universal search',()=>openPalette()),
    actBtn('⇄  Review RFQs',()=>navTo('marketplace')),
    actBtn('✦  Smart Engine agents status',()=>navTo('ai')),
    actBtn('⟳  Refresh HQ',()=>loadExec()),
  );
  a.appendChild(qa);
}

// ================= SUPPLIERS (list via ws.suppliers) =================
async function loadSuppliers(){
  CUR='suppliers'; renderNav();
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let d; try{ d=await api('ws.suppliers',{params:{limit:40}}); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  const k=d.kpis||{}, rows=d.rows||[];
  main.innerHTML=''; main.appendChild(el('div','wshead','<h1>Suppliers</h1>'));
  main.appendChild(el('p','wssub','Directory workspace · click any supplier for its 360° view'));
  const kp=el('div','grid kpis');
  kp.append(kpi('Total',num(k.total)),kpi('Approved',num(k.approved)),kpi('Verified',num(k.verified)),kpi('Pending review',num(k.pending_review)),kpi('Matching blocked',num(k.matching_blocked)),kpi('Licences expiring',num(k.licenses_expiring)));
  main.appendChild(kp);
  main.appendChild(renderSupplierSuccess(d.success||{}));
  const c=el('div','card'); c.appendChild(el('h3',null,`Directory <span class="tag">${rows.length} shown</span>`));
  rows.forEach(r=>{ const row=el('div','row'); row.style.cursor='pointer';
    row.innerHTML=`<span class="k">${escapeH(r.company_name||('#'+r.id))} <span class="muted small">${escapeH([r.sector,r.emirate].filter(Boolean).join(' · '))}</span></span><span class="v">${r.rating?('★ '+r.rating):''} ${r.approval_status?('· '+cap(r.approval_status)):(r.verified?'· verified':'')}</span>`;
    row.onclick=()=>openSupplier360(r.id); c.appendChild(row); });
  if(!rows.length) c.appendChild(el('div','muted small','No suppliers.'));
  main.appendChild(c);
  $('#aside').innerHTML='<div class="asideh">Directory</div><div class="muted small">'+num(k.total)+' suppliers in the marketplace. Click a row to open the full 360° workspace: Smart Engine insights, compliance, capabilities, financials, documents, quotes, reviews and timeline.</div>';
}
function renderSupplierSuccess(sc){
  const k=sc.kpis||{}, att=sc.attention||[];
  const wrap=el('div','card');
  wrap.appendChild(el('h3',null,`Supplier Success <span class="tag">🤝 agent</span>`));
  const g=el('div','grid kpis');
  g.append(kpi('Avg health',(k.avg_health??'—')),kpi('Avg quality',(k.avg_quality??'—')),kpi('% compliant',(k.pct_compliant??'—')+'%'),kpi('Retention',(k.retention_rate??'—')+'%'),kpi('Response',(k.avg_response_score??'—')));
  wrap.appendChild(g);
  const chips=el('div','row');
  chips.innerHTML=`<span class="k">Risk tiers</span><span class="v"><span class="tag" style="background:#fee2e2;color:#991b1b">High ${num(k.risk_high)}</span> <span class="tag" style="background:#fef3c7;color:#92400e">Med ${num(k.risk_medium)}</span> <span class="tag" style="background:#dcfce7;color:#166534">Low ${num(k.risk_low)}</span> · <span class="muted small">${num(k.dormant_count)} dormant · ${num(sc.open_risk)} awaiting your review</span></span>`;
  wrap.appendChild(chips);
  if(att.length){
    wrap.appendChild(el('div','muted small','Needs attention — lowest health first'));
    att.forEach(a=>{ const row=el('div','row'); row.style.cursor='pointer';
      const col=a.risk_tier==='high'?'#dc2626':(a.risk_tier==='medium'?'#d97706':'#16a34a');
      row.innerHTML=`<span class="k">${escapeH(a.company_name||('#'+a.id))} <span class="muted small">Q${a.quality} · C${a.compliance} · R${a.response} · Ret${a.retention}${a.dormant?' · dormant':''}</span></span><span class="v"><b style="color:${col}">${a.health}</b> <span class="tag" style="background:${col}22;color:${col}">${a.risk_tier}</span></span>`;
      row.onclick=()=>openSupplier360(a.id); wrap.appendChild(row); });
  } else { wrap.appendChild(el('div','muted small','All active suppliers healthy — nothing needs attention.')); }
  return wrap;
}
function renderCustomerSuccess(sc){
  const k=sc.kpis||{}, att=sc.attention||[];
  const wrap=el('div','card');
  wrap.appendChild(el('h3',null,`Customer Success <span class="tag">💚 agent</span>`));
  const g=el('div','grid kpis');
  g.append(kpi('Avg health',(k.avg_health??'—')),kpi('Satisfaction',(k.avg_satisfaction??'—')),kpi('% progressing',(k.pct_progressing??'—')+'%'),kpi('Resp (hrs)',(k.avg_response_hrs??'—')),kpi('Open disputes',num(k.open_disputes)));
  wrap.appendChild(g);
  const chips=el('div','row');
  chips.innerHTML=`<span class="k">Risk tiers</span><span class="v"><span class="tag" style="background:#fee2e2;color:#991b1b">High ${num(k.risk_high)}</span> <span class="tag" style="background:#fef3c7;color:#92400e">Med ${num(k.risk_medium)}</span> <span class="tag" style="background:#dcfce7;color:#166534">Low ${num(k.risk_low)}</span> · <span class="muted small">${num(k.with_stalled)} stalled · ${num(k.dormant_count)} dormant · ${num(sc.open_escalations)} escalations for you</span></span>`;
  wrap.appendChild(chips);
  if(att.length){
    wrap.appendChild(el('div','muted small','Needs attention — lowest health first'));
    att.forEach(a=>{ const row=el('div','row'); row.style.cursor='pointer';
      const col=a.risk_tier==='high'?'#dc2626':(a.risk_tier==='medium'?'#d97706':'#16a34a');
      row.innerHTML=`<span class="k">${escapeH(a.name||('#'+a.id))} <span class="muted small">E${a.engagement} · S${a.satisfaction} · P${a.progress} · Sv${a.service}${a.disputes?' · '+a.disputes+' dispute':''}${a.stalled?' · '+a.stalled+' stalled':''}${a.dormant?' · dormant':''}</span></span><span class="v"><b style="color:${col}">${a.health}</b> <span class="tag" style="background:${col}22;color:${col}">${a.risk_tier}</span></span>`;
      row.onclick=()=>openCustomer360(a.id); wrap.appendChild(row); });
  } else { wrap.appendChild(el('div','muted small','All customers healthy — nothing needs attention.')); }
  return wrap;
}
function renderFinanceAI(ai){
  const k=ai.kpis||{}, fc=ai.forecast||{}, hz=(fc.horizons||[]), alerts=ai.alerts||[]; const h=ai.health;
  const wrap=el('div','card');
  const hcol=h==null?'#6b7280':(h>=65?'#16a34a':(h>=40?'#d97706':'#dc2626'));
  wrap.appendChild(el('h3',null,`Finance Smart Engine <span class="tag">💰 agent</span> <span class="tag" style="background:${hcol}22;color:${hcol}">health ${h??'—'}</span>`));
  const g=el('div','grid kpis');
  g.append(kpi('Collection rate',(k.collection_rate??'—')+'%','collected vs due'),kpi('AR outstanding',money(k.ar_outstanding),(k.ar_overdue>0?money(k.ar_overdue)+' overdue':'')),kpi('AP outstanding',money(k.ap_outstanding),(k.ap_overdue>0?money(k.ap_overdue)+' overdue':'')),kpi('Budget overruns',num(k.budget_overruns)));
  wrap.appendChild(g);
  if(hz.length){
    const fcCard=el('div',null); fcCard.style.marginTop='6px';
    fcCard.appendChild(el('div','muted small','Cash-flow forecast — projected cash / expected revenue'));
    hz.forEach(x=>{ const row=el('div','row'); const neg=Number(x.projected_cash)<0;
      row.innerHTML=`<span class="k">${x.days} days</span><span class="v"><b style="color:${neg?'#dc2626':'#16a34a'}">${money(x.projected_cash)}</b> cash · <span class="muted small">+${money(x.revenue_forecast)} rev · +${money(x.expected_inflows)} in / -${money(x.expected_outflows)} out</span></span>`;
      fcCard.appendChild(row); });
    wrap.appendChild(fcCard);
  }
  if(alerts.length){
    wrap.appendChild(el('div','muted small','Alerts for you'));
    alerts.forEach(a=>{ const col=a.risk==='high'?'#dc2626':(a.risk==='medium'?'#d97706':'#6b7280'); const row=el('div','row');
      row.innerHTML=`<span class="k">${escapeH(a.title||a.signal)} <span class="tag" style="background:${col}22;color:${col}">${a.risk}</span></span><span class="v muted small">${escapeH(a.reco||'')}</span>`;
      wrap.appendChild(row); });
  } else { wrap.appendChild(el('div','muted small','No finance alerts — nothing needs your decision.')); }
  return wrap;
}
function fmtDate(t){ if(!t) return '—'; const d=new Date(t); return isNaN(d)?String(t):d.toLocaleDateString('en-AE'); }
function arrList(v){ if(v==null) return '—'; if(Array.isArray(v)) return v.length?v.slice(0,8).map(x=>String(x)).join(', '):'—'; return String(v); }
async function openSupplier360(id){
  CUR='suppliers'; renderNav();
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let d; try{ d=await api('ws.supplier',{id}); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  if(!d||d.error){ main.innerHTML=`<div class="card">${d&&d.error?d.error:'Not found'}</div>`; return; }
  const p=d.profile||{}, st=d.status||{}, ai=d.ai||{}, comp=d.compliance||{}, cap2=d.capabilities||{}, perf=d.performance||{}, rep=d.reputation||{}, fin=d.financials||{};
  main.innerHTML='';
  const pill = st.banned?'<span class="pill bad">Banned</span>':((st.approval_status==='approved'||st.verified)?'<span class="pill good">Approved</span>':(st.matching_blocked?'<span class="pill bad">Matching blocked</span>':`<span class="pill attention">${cap(st.approval_status||st.verification_status||'Unverified')}</span>`));
  const wh=el('div','wshead'); wh.innerHTML=`<button class="iconbtn" id="backsup" style="margin-right:2px">←</button><h1>${escapeH(p.company_name||('Supplier '+id))}</h1>${pill}`;
  main.appendChild(wh); $('#backsup').onclick=()=>loadSuppliers();
  { const ab=el('div'); ab.style.cssText='display:flex;gap:8px;flex-wrap:wrap;margin:8px 0 4px';
    const mk=(label,fn,danger)=>{ const b=el('button',null,label); b.style.cssText='padding:7px 13px;border-radius:8px;cursor:pointer;font:inherit;font-weight:600;border:1px solid var(--line);background:'+(danger?'#e02424':'var(--panel)')+';color:'+(danger?'#fff':'var(--ink)'); b.onclick=fn; return b; };
    const decide=async(op)=>{ let note=''; if(op==='reject'||op==='ban') note=prompt(cap(op)+' reason (optional):')||''; if(!confirm(cap(op)+' '+(p.company_name||('#'+id))+'?'))return; try{ await ops('supplier_decide',{op,id,note}); toast(cap(op)+' done'); openSupplier360(id); }catch(e){ toast('Failed: '+(e&&e.message||e)); } };
    if(st.approval_status!=='approved') ab.appendChild(mk('✓ Approve',()=>decide('approve')));
    ab.appendChild(mk('✕ Reject',()=>decide('reject')));
    ab.appendChild(st.banned?mk('↺ Unban',()=>decide('unban')):mk('⛔ Ban',()=>decide('ban'),true));
    ab.appendChild(mk('📝 Add note',async()=>{ const body=prompt('Add an internal note:')||''; if(!body.trim())return; try{ await ops('note_add',{entity:'suppliers',id,body}); toast('Note added'); }catch(e){ toast('Failed: '+(e&&e.message||e)); } }));
    ab.appendChild(mk('◷ Create task',async()=>{ const title=prompt('Task title:')||''; if(!title.trim())return; try{ await ops('task_create',{title,entity:'suppliers',entity_id:String(id)}); toast('Task created'); }catch(e){ toast('Failed: '+(e&&e.message||e)); } }));
    main.appendChild(ab);
  }
  try{const _prof=(d.documents||[]).find(x=>x&&x.type==='Company profile'); if(_prof&&_prof.path){ const _pb=el('button'); _pb.textContent='📄 Open company profile'; _pb.style.cssText='margin:8px 0;padding:8px 14px;border-radius:8px;cursor:pointer;background:#0a5f3c;color:#fff;border:0;font:inherit;font-weight:600'; _pb.onclick=()=>openFile('supplier-docs',_prof.path); main.appendChild(_pb);}}catch(_e){}
  main.appendChild(el('p','wssub',`${[p.sector,p.emirate,p.city].filter(Boolean).map(escapeH).join(' · ')}${p.founded_year?' · est. '+p.founded_year:''}`));
  const k=el('div','grid kpis');
  k.append(
    kpi('Revenue generated', money(fin.reveal_fees_generated), 'reveal fees on deals'),
    kpi('Deal value', money(fin.deal_value_total), (fin.deals_count||0)+' deals'),
    kpi('Commission owed', money(fin.commission_owed), 'to QuotesDone'),
    kpi('Win rate', perf.win_rate!=null?Math.round(perf.win_rate*100)+'%':'—', `${perf.quoted||0} quoted / ${perf.won||0} won`),
    kpi('Reputation', rep.reputation_index!=null?num(rep.reputation_index):(perf.perf_score!=null?num(perf.perf_score):'—'), 'index'),
  );
  main.appendChild(k);
  if(ai.capability_summary||ai.review_notes||(ai.review_flags&&ai.review_flags.length)){
    const c=el('div','card'); c.appendChild(el('h3',null,'✦ Smart Engine insights'));
    if(ai.capability_summary) c.appendChild(el('p','small',escapeH(String(ai.capability_summary))));
    if(ai.review_notes) c.appendChild(el('p','small muted',escapeH(String(ai.review_notes))));
    if(ai.review_flags&&ai.review_flags.length) c.appendChild(el('div','chiprow',ai.review_flags.map(f=>`<span class="chip">${escapeH(String(f))}</span>`).join('')));
    if(ai.capability_score!=null) c.appendChild(el('div','row',`<span class="k">Capability score</span><span class="v">${num(ai.capability_score)}</span>`));
    main.appendChild(c);
  }
  const r1=el('div','grid cards2');
  r1.appendChild(statCard('Compliance', [
    ['Trade licence', comp.trade_license_no||'—'],['Authority', comp.license_authority||'—'],
    ['Licence expiry', comp.license_expiry?(comp.license_expiry+(comp.license_expiring?' ⚠':'')):'—'],
    ['TRN', comp.trn||'—'],['VAT number', comp.vat_number||'—'],
    ['Insurance expiry', comp.insurance_expiry?(comp.insurance_expiry+(comp.insurance_expiring?' ⚠':'')):'—'],
    ['ISO certs', arrList(comp.iso_certifications)],['Terms accepted', comp.accepted_terms_at?fmtDate(comp.accepted_terms_at):'—'],
  ]));
  r1.appendChild(statCard('Technical capabilities', [
    ['Brands', arrList(cap2.brands_carried)],['Machinery', arrList(cap2.machinery)],
    ['Engineers', cap2.engineers_count==null?'—':cap2.engineers_count],['Team size', cap2.team_size==null?'—':cap2.team_size],
    ['Warehouse', cap2.warehouse_area?cap2.warehouse_area+' m²':'—'],['Coverage', arrList(cap2.service_emirates)],
    ['Authorizations', arrList(cap2.manufacturer_authorizations)],['References', arrList(cap2.client_references)],
  ]));
  main.appendChild(r1);
  const r2=el('div','grid cards2');
  r2.appendChild(statCard('Performance', [
    ['Matched', perf.matched==null?'—':perf.matched],['Quoted', perf.quoted==null?'—':perf.quoted],['Won', perf.won==null?'—':perf.won],
    ['Win rate', perf.win_rate!=null?Math.round(perf.win_rate*100)+'%':'—'],
    ['Reveal responses', `${perf.rv_responded||0}/${perf.rv_reveals||0}`],
    ['Response rate', perf.rv_response_rate!=null?Math.round(perf.rv_response_rate*100)+'%':'—'],
    ['App rating', perf.app_rating==null?(perf.rating==null?'—':perf.rating):perf.app_rating],
  ]));
  const repRows=Object.entries(rep).filter(([kk,v])=>typeof v==='number').map(([kk,v])=>[cap(kk),num(v)]);
  r2.appendChild(statCard('Reputation', repRows.length?repRows:[['No reputation data yet','']]));
  main.appendChild(r2);
  main.appendChild(statCard('Financials', [
    ['Deals', fin.deals_count==null?0:fin.deals_count],['Deal value', money(fin.deal_value_total)],
    ['Reveal fees generated', money(fin.reveal_fees_generated)],['Commission total', money(fin.commission_total)],
    ['Commission paid', money(fin.commission_paid)],['Commission owed', money(fin.commission_owed)],
  ]));
  main.appendChild(await filesSection('supplier', id));
  const r3=el('div','grid cards2');
  const qc=el('div','card'); qc.appendChild(el('h3',null,`Quotations <span class="tag">${(d.quotes||[]).length}</span>`));
  if((d.quotes||[]).length)(d.quotes||[]).forEach(q=>qc.appendChild(el('div','row',`<span class="k">${money(q.amount)} <span class="muted small">${cap(q.status||'')}</span></span><span class="v muted small">${fmtDate(q.created_at)}</span>`)));
  else qc.appendChild(el('div','muted small','No quotations yet.'));
  r3.appendChild(qc);
  const rc=el('div','card'); rc.appendChild(el('h3',null,`Reviews <span class="tag">${(d.reviews||[]).length}</span>`));
  if((d.reviews||[]).length)(d.reviews||[]).forEach(rv=>rc.appendChild(el('div','row',`<span class="k">★ ${rv.rating==null?'—':rv.rating} <span class="muted small">${escapeH(String(rv.comment||'').slice(0,40))}</span></span><span class="v muted small">${fmtDate(rv.created_at)}</span>`)));
  else rc.appendChild(el('div','muted small','No reviews yet.'));
  r3.appendChild(rc);
  main.appendChild(r3);
  const a=$('#aside'); a.innerHTML='';
  a.appendChild(el('div','asideh','Alerts'));
  const alerts=[];
  if(st.banned) alerts.push('⛔ Banned'+(st.banned_reason?': '+st.banned_reason:''));
  if(st.matching_blocked) alerts.push('🚫 Matching blocked'+(st.matching_block_reason?': '+st.matching_block_reason:''));
  if(comp.license_expiring) alerts.push('⚠ Trade licence expiring');
  if(comp.insurance_expiring) alerts.push('⚠ Insurance expiring');
  if(Number(fin.commission_owed)>0) alerts.push('AED '+fin.commission_owed+' commission owed');
  if(!alerts.length) alerts.push('No open alerts.');
  alerts.forEach(x=>a.appendChild(el('div','small',escapeH(x))));
  a.appendChild(el('div','asideh','Contact'));
  a.appendChild(el('div','small',`${escapeH(p.contact_name||'—')}<br>${escapeH(p.phone||'')}<br>${escapeH(p.email||'')}`));
  a.appendChild(el('div','asideh','Timeline'));
  (d.timeline||[]).slice(0,8).forEach(t=>a.appendChild(el('div','small muted',`${fmtDate(t.at)} — ${escapeH(t.event||'')}`)));
  if(!(d.timeline||[]).length) a.appendChild(el('div','small muted','No history.'));
  a.appendChild(el('div','asideh','Actions'));
  const qa=el('div','qa'); qa.append(actBtn('←  Back to suppliers',()=>loadSuppliers()), actBtn('🔍  Universal search',()=>openPalette())); a.appendChild(qa);
}


// ================= GENERIC WORKSPACE (ws.*) =================
async function loadReports(){
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let d; try{ d=await api('ws.reports'); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  main.innerHTML=''; main.appendChild(el('div','wshead','<h1>Reports</h1>'));
  const k=d.kpis||{}; main.appendChild(el('p','wssub',`${k.total_reports||0} reports · ${k.report_types||0} types · ${k.stale_count||0} needing attention`));
  const fr=d.freshness||{}; const g=el('div','grid kpis'); Object.entries(fr).forEach(([kk,v])=>g.appendChild(kpi(cap(kk),v===true?'✓ fresh':(v===false?'⚠ stale':'—'),''))); main.appendChild(g);
  function pdfLink(id,src){ const b=el('span'); b.style.cssText='cursor:pointer;color:#4a90d9;text-decoration:underline;margin-left:10px;font-size:12px'; b.textContent='Open PDF ↗'; b.onclick=()=>openReportPdf(id,src); return b; }
  function editLink(fn){ const b=el('span'); b.style.cssText='cursor:pointer;color:#12b3a6;text-decoration:underline;margin-left:10px;font-size:12px'; b.textContent='✏️ Edit'; b.onclick=fn; return b; }
  const bt=d.by_type||[]; const c=el('div','card'); c.appendChild(el('h3',null,'Latest by type'));
  if(!bt.length) c.appendChild(el('div','muted small','No reports yet.'));
  bt.forEach(r=>{ const row=el('div','row'); row.innerHTML=`<span class="k">${escapeH(r.report_type)}</span><span class="v muted small">${escapeH(r.title||'')}</span>`; if(r.src==='board'||r.src==='exec'){ row.appendChild(pdfLink(r.id,r.src)); row.appendChild(editLink(r.src==='board'?(()=>editContent('board_report',r.id,[{key:'title',label:'Title',type:'text'},{key:'body',label:'Body',type:'textarea',rows:16}],loadReports)):(()=>editContent('exec_report',r.id,[{key:'summary',label:'Summary',type:'textarea',rows:14},{key:'status',label:'Status',type:'text'}],loadReports)))); } c.appendChild(row); });
  main.appendChild(c);
  const rc=el('div','card'); rc.appendChild(el('h3',null,`Recent <span class="tag">${(d.recent||[]).length}</span>`));
  (d.recent||[]).forEach(r=>{ const row=el('div','row'); row.innerHTML=`<span class="k">${escapeH(r.title||r.report_type)}</span><span class="v muted small">${escapeH(r.created||'')}</span>`; if(r.src==='board'||r.src==='exec') row.appendChild(pdfLink(r.id,r.src)); rc.appendChild(row); });
  main.appendChild(rc);
  if((d.flags||[]).length){ const fc=el('div','card'); fc.appendChild(el('h3',null,'Attention')); (d.flags||[]).forEach(f=>fc.appendChild(el('div','row',`<span class="k">${escapeH(f.title)}</span><span class="v">${escapeH(f.risk||'')}</span>`))); main.appendChild(fc); }
}
async function loadRefunds(m){
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  const E=s=>String(s==null?'':s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
  let d; try{ d=await api('ws.refunds'); }catch(e){ main.innerHTML='<div class="card">Could not load: '+E(e.message)+'</div>'; return; }
  const k=(d.data&&d.data.kpis)||d.kpis||{}; const rows=(d.data&&d.data.pending)||d.pending||[];
  let h='<div class="wshead"><h1>Refunds &amp; Disputes</h1></div><p class="wssub">Pending '+(k.pending||0)+' &middot; In window '+(k.within_window||0)+' &middot; Resolved 30d '+(k.resolved_30d||0)+'</p>';
  if(!rows.length){ h+='<div class="card">No pending refund requests.</div>'; }
  else{ h+='<div class="card"><table style="width:100%;border-collapse:collapse;font-size:13px"><tr style="text-align:left;color:#9fb3c8"><th>Customer</th><th>Supplier</th><th>Fee</th><th>Requested</th><th>Window</th><th>Reason</th><th></th></tr>';
    rows.forEach(r=>{ h+='<tr style="border-top:1px solid rgba(255,255,255,.08)"><td>'+E(r.customer)+'</td><td>'+E(r.supplier)+'</td><td>'+E(r.reveal_fee)+'</td><td>'+E(r.requested)+'</td><td>'+(r.in_window?'open':'closed')+'</td><td>'+E(r.reason)+'</td><td style="white-space:nowrap"><button class="btn rf-ap" data-tx="'+E(r.transaction_id)+'">Approve</button> <button class="btn rf-rj" data-tx="'+E(r.transaction_id)+'">Reject</button></td></tr>'; });
    h+='</table></div>'; }
  main.innerHTML=h;
  $('#aside').innerHTML='<div class="asideh">Refunds</div><div class="muted small">Approve marks the reveal refunded and charges the supplier the 3% non-response fee (blocks them from matching). Reject keeps the fee.</div>';
  main.querySelectorAll('.rf-ap').forEach(b=>{ b.onclick=async()=>{ if(!confirm('Approve this refund? It marks the reveal REFUNDED and charges the supplier the 3% non-response fee (and blocks them from matching).')) return; b.disabled=true; try{ const x=await api('refund_resolve',{transaction_id:b.dataset.tx,op:'approve'}); if(x&&x.error) alert('Error: '+x.error);}catch(e){ alert('Failed: '+e.message);} loadRefunds(m); }; });
  main.querySelectorAll('.rf-rj').forEach(b=>{ b.onclick=async()=>{ const note=prompt('Reason for rejecting (optional)')||''; b.disabled=true; try{ const x=await api('refund_resolve',{transaction_id:b.dataset.tx,op:'reject',note}); if(x&&x.error) alert('Error: '+x.error);}catch(e){ alert('Failed: '+e.message);} loadRefunds(m); }; });
}
async function loadFraud(m){
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  const E=s=>String(s==null?'':s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
  let d; try{ d=await api('ws.fraud'); }catch(e){ main.innerHTML='<div class="card">Could not load: '+E(e.message)+'</div>'; return; }
  const k=(d.data&&d.data.kpis)||d.kpis||{}; const flags=(d.data&&d.data.open_flags)||d.open_flags||[]; const banned=(d.data&&d.data.banned)||d.banned||[];
  let h='<div class="wshead"><h1>Fraud &amp; Safety</h1></div><p class="wssub">Open flags '+(k.open_flags||0)+' &middot; High severity '+(k.high_severity||0)+' &middot; Banned actors '+(k.banned_actors||0)+'</p>';
  h+='<div class="card"><b>Open fraud flags</b>';
  if(!flags.length){ h+='<div class="muted small">No open flags.</div>'; }
  else{ h+='<table style="width:100%;border-collapse:collapse;font-size:13px"><tr style="text-align:left;color:#9fb3c8"><th>Kind</th><th>Subject</th><th>Severity</th><th>When</th><th></th></tr>';
    flags.forEach(f=>{ h+='<tr style="border-top:1px solid rgba(255,255,255,.08)"><td>'+E(f.kind)+'</td><td>'+E(f.subject_type)+':'+E(f.subject_id)+'</td><td>'+E(f.severity)+'</td><td>'+E(f.created)+'</td><td style="white-space:nowrap"><button class="btn fr-ban" data-t="'+E(f.subject_type)+'" data-i="'+E(f.subject_id)+'">Ban</button> <button class="btn fr-dis" data-t="'+E(f.subject_type)+'" data-i="'+E(f.subject_id)+'">Dismiss</button></td></tr>'; });
    h+='</table>'; }
  h+='</div><div class="card"><b>Banned actors</b>';
  if(!banned.length){ h+='<div class="muted small">None.</div>'; }
  else{ h+='<table style="width:100%;border-collapse:collapse;font-size:13px"><tr style="text-align:left;color:#9fb3c8"><th>Kind</th><th>Name</th><th>Reason</th><th></th></tr>';
    banned.forEach(z=>{ h+='<tr style="border-top:1px solid rgba(255,255,255,.08)"><td>'+E(z.kind)+'</td><td>'+E(z.name)+'</td><td>'+E(z.reason)+'</td><td><button class="btn fr-unban" data-t="'+E(z.kind)+'" data-i="'+E(z.subject_id)+'">Unban</button></td></tr>'; });
    h+='</table>'; }
  h+='</div>';
  main.innerHTML=h;
  main.querySelectorAll('.fr-ban').forEach(b=>{ b.onclick=async()=>{ if(!confirm('Ban this actor from the marketplace?')) return; b.disabled=true; try{ await api('fraud_resolve',{subject_type:b.dataset.t,subject_id:b.dataset.i,op:'ban'});}catch(e){alert('Failed: '+e.message);} loadFraud(m); }; });
  main.querySelectorAll('.fr-dis').forEach(b=>{ b.onclick=async()=>{ b.disabled=true; try{ await api('fraud_resolve',{subject_type:b.dataset.t,subject_id:b.dataset.i,op:'dismiss'});}catch(e){alert('Failed: '+e.message);} loadFraud(m); }; });
  main.querySelectorAll('.fr-unban').forEach(b=>{ b.onclick=async()=>{ b.disabled=true; try{ await api('fraud_resolve',{subject_type:b.dataset.t,subject_id:b.dataset.i,op:'unban'});}catch(e){alert('Failed: '+e.message);} loadFraud(m); }; });
}

async function loadWs(m){
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let d; try{ d=await api(m.action); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  main.innerHTML=''; main.appendChild(el('div','wshead',`<h1>${m.label}</h1>`));
  main.appendChild(el('p','wssub','Live workspace data'));
  renderGeneric(main,d);
  $('#aside').innerHTML=`<div class="asideh">Contextual</div><div class="muted small">This module renders live data from the backend. A bespoke command-center layout for ${m.label} is planned in the workspace roadmap.</div>`;
}

// recursive-ish generic renderer: numbers/strings -> KPI chips, arrays -> list cards, objects -> stat cards
function renderGeneric(main,d){
  if(d==null){ main.appendChild(el('div','card','No data.')); return; }
  const scalars=[], objs=[], arrs=[];
  Object.entries(d).forEach(([k,v])=>{
    if(v==null) return;
    if(Array.isArray(v)) arrs.push([k,v]);
    else if(typeof v==='object') objs.push([k,v]);
    else scalars.push([k,v]);
  });
  if(scalars.length){ const g=el('div','grid kpis'); scalars.forEach(([k,v])=>g.appendChild(kpi(cap(k),typeof v==='number'?num(v):String(v),''))); main.appendChild(g); }
  if(objs.length){ const g=el('div','grid cards2'); objs.forEach(([k,v])=>{
      const rows=Object.entries(v).filter(([,x])=>x==null||typeof x!=='object').map(([kk,vv])=>[cap(kk),typeof vv==='number'?num(vv):String(vv??'—')]);
      if(rows.length) g.appendChild(statCard(cap(k),rows));
      else g.appendChild(statCard(cap(k),[['items',Object.keys(v).length]]));
    }); main.appendChild(g); }
  arrs.forEach(([k,v])=>{
    const c=el('div','card'); c.appendChild(el('h3',null,`${cap(k)} <span class="tag">${v.length}</span>`));
    if(!v.length){ c.appendChild(el('div','muted small','None.')); main.appendChild(c); return; }
    v.slice(0,12).forEach(item=>{
      if(item&&typeof item==='object'){
        const name=item.name||item.title||item.label||item.id||JSON.stringify(item).slice(0,60);
        const sub=item.sub||item.status||item.email||item.category||'';
        const r=el('div','row',`<span class="k">${escapeH(String(name))}</span><span class="v">${escapeH(String(sub))}</span>`);
        if(item.id){ r.style.cursor='pointer'; r.onclick=()=>openRecord(guessEntity(k),item.id); }
        let su=item.source_url||item.url||item.link; if(!su && typeof item.source==='string' && /^https?:\/\//.test(item.source)) su=item.source;
        if(su){ const a=el('span'); a.style.cssText='cursor:pointer;color:#4a90d9;text-decoration:underline;margin-left:8px;font-size:12px'; a.textContent='source ↗'; a.onclick=(ev)=>{ev.stopPropagation(); window.open(su,'_blank','noopener');}; r.appendChild(a); }
        c.appendChild(r);
      } else c.appendChild(el('div','row',`<span class="k">${escapeH(String(item))}</span>`));
    });
    main.appendChild(c);
  });
}
function guessEntity(k){ k=k.toLowerCase(); if(k.includes('supplier'))return'supplier'; if(k.includes('customer'))return'customer'; if(k.includes('rfq')||k.includes('inquir'))return'rfq'; if(k.includes('quote'))return'quote'; return k.replace(/s$/,''); }

// ================= FINANCE / CFO COMMAND CENTER =================
async function loadFinance(){
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let d; try{ d=await api('ws.finance'); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  const p=d.pnl||{}, rr=d.run_rate||{}, cash=d.cash||{}, mon=d.monetization||{}, rec=d.receivables||{}, pay=d.payables||{};
  const netPos=(p.net_income||0)>=0;
  main.innerHTML='';
  main.appendChild(el('div','wshead',`<h1>Finance — CFO Command Center</h1><span class="pill ${netPos?'good':'bad'}">${netPos?'Profitable':'Net loss'}</span>`));
  main.appendChild(el('p','wssub',`Wired to the general ledger · as of ${new Date(d.as_of||Date.now()).toLocaleString('en-AE')}`));
  const kpis=el('div','grid kpis');
  kpis.append(
    kpi('Cash position', money(cash.total), 'bank + Stripe clearing'),
    kpi('Revenue (lifetime)', money(p.revenue), ''),
    kpi('Net income', money(p.net_income), (p.margin_pct!=null?p.margin_pct+'% margin':'')),
    kpi('Monthly burn', money(rr.monthly_burn), 'net, last 30d'),
    kpi('Runway', rr.runway_months!=null?rr.runway_months+' mo':'—', rr.runway_months!=null?'at current burn':'fund to extend'),
  );
  main.appendChild(kpis);
  main.appendChild(renderFinanceAI(d.ai||{}));
  const row1=el('div','grid cards2');
  row1.appendChild(statCard('Profit & Loss', [
    ['Revenue', money(p.revenue)],
    ['Expenses', money(p.expenses)],
    ['Net income', money(p.net_income)],
    ['Margin', p.margin_pct!=null?p.margin_pct+'%':'—'],
  ]));
  row1.appendChild(statCard('Run-rate (last 30 days)', [
    ['Revenue 30d', money(rr.revenue_30d)],
    ['Expense 30d', money(rr.expense_30d)],
    ['Net 30d', money(rr.net_30d)],
    ['ARR estimate', money(rr.arr_estimate), 'run-rate x12'],
    ['Monthly burn', money(rr.monthly_burn)],
  ]));
  main.appendChild(row1);
  const row2=el('div','grid cards2');
  row2.appendChild(statCard('Monetization', [
    ['Reveal fees', money(mon.reveal_fees)],
    ['Supplier commissions', money(mon.commissions)],
    ['Registration', money(mon.registration)],
    ['Stripe fees', money(mon.stripe_fees)],
  ]));
  row2.appendChild(statCard('Working capital', [
    ['Commission receivable', money(rec.commission_receivable)],
    ['Trade receivable', money(rec.trade_receivable)],
    ['Overdue commissions', money(rec.overdue_commissions)],
    ['Accounts payable (open)', money(pay.ap_open)],
  ]));
  main.appendChild(row2);
  const accs=(cash.accounts||[]).filter(a=>Number(a.balance)!==0 || ['1000','1050'].includes(a.code));
  const ca=el('div','card'); ca.appendChild(el('h3',null,'Balances'));
  accs.forEach(a=>ca.appendChild(el('div','row',`<span class="k">${a.code} · ${escapeH(String(a.name))}</span><span class="v">${money(a.balance)}</span>`)));
  main.appendChild(ca);
  const bd=el('div','grid cards2');
  bd.appendChild(listCard('Revenue breakdown', d.revenue_breakdown));
  bd.appendChild(listCard('Expense breakdown', d.expense_breakdown));
  main.appendChild(bd);
  const cf=el('div','card'); cf.appendChild(el('h3',null,'Cash flow (recent months)'));
  (d.cashflow||[]).forEach(m=>{ const net=Number(m.net); cf.appendChild(el('div','row',`<span class="k">${m.month}</span><span class="v" style="color:${net>=0?'var(--ok)':'var(--bad)'}">${money(net)} <span class="muted small">in ${money(m.inflow)} · out ${money(m.outflow)}</span></span>`)); });
  if(!(d.cashflow||[]).length) cf.appendChild(el('div','muted small','No posted cash movement yet.'));
  main.appendChild(cf);
  if((d.budgets||[]).length){
    const bg=el('div','card'); bg.appendChild(el('h3',null,'Budget vs actual (YTD)'));
    d.budgets.forEach(b=>bg.appendChild(el('div','row',`<span class="k">${escapeH(String(b.account_name))}</span><span class="v">${money(b.actual_ytd)} / ${money(b.budget_ytd)} <span class="muted small">${b.pct_of_budget!=null?b.pct_of_budget+'%':''}</span></span>`)));
    main.appendChild(bg);
  }
  const a=$('#aside'); a.innerHTML='';
  a.appendChild(el('div','asideh','Financial signals'));
  a.appendChild(el('div','small muted',`Net ${netPos?'profit':'loss'} of ${money(Math.abs(p.net_income||0))} to date. Monthly burn ${money(rr.monthly_burn)}.${rr.runway_months!=null?' Runway '+rr.runway_months+' months.':' Cash is negative — record owner capital to fund operations.'}`));
  const topExp=(d.expense_breakdown||[])[0];
  a.appendChild(el('div','asideh','Largest expense'));
  a.appendChild(el('div','small',topExp?`${escapeH(String(topExp.name))} — ${money(topExp.amount)}`:'—'));
  a.appendChild(el('div','asideh','Receivables to collect'));
  a.appendChild(el('div','small',`${money((rec.commission_receivable||0)+(rec.trade_receivable||0))} outstanding`));
  a.appendChild(el('div','asideh','Quick actions'));
  const qa=el('div','qa');
  qa.append(actBtn('⟳  Refresh finance',()=>loadFinance()), actBtn('◎  Executive HQ',()=>navTo('exec')));
  qa.append(
    actBtn('＋  Record capital',async()=>{ const amt=parseFloat(prompt('Owner capital injection amount (AED):')||''); if(!amt||amt<=0)return; try{ await ops('gl_post',{memo:'Owner capital injection',lines:[{account:'1000',debit:amt,credit:0},{account:'3000',debit:0,credit:amt}]}); toast('Capital recorded'); loadFinance(); }catch(e){ toast('Failed: '+((e&&e.message)||e)); } }),
    actBtn('－  Log expense',async()=>{ const amt=parseFloat(prompt('Expense amount (AED):')||''); if(!amt||amt<=0)return; const cat=(prompt('Expense account — 6000 Software/AI, 6100 Payment fees, 6200 Marketing, 6300 G&A:','6300')||'6300').trim(); const memo=(prompt('Memo (vendor / description):')||'Expense').trim(); try{ await ops('gl_post',{memo,lines:[{account:cat,debit:amt,credit:0},{account:'1000',debit:0,credit:amt}]}); toast('Expense logged'); loadFinance(); }catch(e){ toast('Failed: '+((e&&e.message)||e)); } }),
    actBtn('✓  Collect receivable',async()=>{ const amt=parseFloat(prompt('Amount collected (AED):')||''); if(!amt||amt<=0)return; const acct=(prompt('Receivable account — 1110 Commission, 1100 Trade:','1110')||'1110').trim(); try{ await ops('gl_post',{memo:'Receivable collected',lines:[{account:'1000',debit:amt,credit:0},{account:acct,debit:0,credit:amt}]}); toast('Payment recorded'); loadFinance(); }catch(e){ toast('Failed: '+((e&&e.message)||e)); } })
  );
  a.appendChild(qa);
}
function listCard(title,arr){
  const c=el('div','card'); c.appendChild(el('h3',null,`${title} <span class="tag">${(arr||[]).length}</span>`));
  if(!arr||!arr.length){ c.appendChild(el('div','muted small','None.')); return c; }
  arr.forEach(x=>c.appendChild(el('div','row',`<span class="k">${escapeH(String(x.name))}</span><span class="v">${money(x.amount)}</span>`)));
  return c;
}

async function loadCustomers(){
  CUR='customers'; renderNav();
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let d; try{ d=await api('ws.customers'); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  const k=d.kpis||{}, rows=d.rows||[];
  main.innerHTML=''; main.appendChild(el('div','wshead','<h1>Customers</h1>'));
  main.appendChild(el('p','wssub','Click any customer for its command center'));
  const kp=el('div','grid kpis');
  kp.append(kpi('Total',num(k.total)),kpi('Verified',num(k.verified)),kpi('With RFQs',num(k.with_rfqs)),kpi('Banned',num(k.banned)));
  main.appendChild(kp);
  main.appendChild(renderCustomerSuccess(d.success||{}));
  const c=el('div','card'); c.appendChild(el('h3',null,`Customers <span class="tag">${rows.length}</span>`));
  rows.forEach(r=>{ const row=el('div','row'); row.style.cursor='pointer';
    row.innerHTML=`<span class="k">${escapeH(r.full_name||r.email||'—')} <span class="muted small">${escapeH(r.email||'')}</span></span><span class="v">${r.rfqs||0} RFQ${r.projects?(' · '+r.projects+' proj'):''}</span>`;
    row.onclick=()=>openCustomer360(r.id); c.appendChild(row); });
  if(!rows.length) c.appendChild(el('div','muted small','No customers.'));
  main.appendChild(c);
  $('#aside').innerHTML='<div class="asideh">Customers</div><div class="muted small">Click a customer to open the command center: projects, RFQs, quotes, financial history, lifetime value, relationship score, Smart Engine summary and timeline.</div>';
}
async function openCustomer360(id){
  CUR='customers'; renderNav();
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let d; try{ d=await api('ws.customer',{id}); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  if(!d||d.error){ main.innerHTML=`<div class="card">${d&&d.error?d.error:'Not found'}</div>`; return; }
  const p=d.profile||{}, m=d.metrics||{}, pr=d.preferences||{};
  main.innerHTML='';
  const band = (m.relationship_score>=70)?'good':((m.relationship_score>=40)?'attention':'bad');
  const wh=el('div','wshead'); wh.innerHTML=`<button class="iconbtn" id="backcus" style="margin-right:2px">←</button><h1>${escapeH(p.full_name||p.email||'Customer')}</h1><span class="pill ${band}">Score ${m.relationship_score==null?'—':m.relationship_score}</span>${p.banned?'<span class="pill bad">Banned</span>':''}`;
  main.appendChild(wh); $('#backcus').onclick=()=>loadCustomers();
  { const ab=el('div'); ab.style.cssText='display:flex;gap:8px;flex-wrap:wrap;margin:8px 0 4px';
    const mk=(label,fn,danger)=>{ const b=el('button',null,label); b.style.cssText='padding:7px 13px;border-radius:8px;cursor:pointer;font:inherit;font-weight:600;border:1px solid var(--line);background:'+(danger?'#e02424':'var(--panel)')+';color:'+(danger?'#fff':'var(--ink)'); b.onclick=fn; return b; };
    ab.appendChild(p.banned?mk('↺ Unban',async()=>{ if(!confirm('Unban this customer?'))return; try{ await ops('customer_decide',{op:'unban',id:String(id)}); toast('Unbanned'); openCustomer360(id); }catch(e){ toast('Failed: '+(e&&e.message||e)); } }):mk('⛔ Ban',async()=>{ const note=prompt('Ban reason:')||''; if(!confirm('Ban this customer?'))return; try{ await ops('customer_decide',{op:'ban',id:String(id),note}); toast('Banned'); openCustomer360(id); }catch(e){ toast('Failed: '+(e&&e.message||e)); } },true));
    ab.appendChild(mk('📝 Add note',async()=>{ const body=prompt('Add an internal note:')||''; if(!body.trim())return; try{ await ops('note_add',{entity:'customers',id:String(id),body}); toast('Note added'); }catch(e){ toast('Failed: '+(e&&e.message||e)); } }));
    ab.appendChild(mk('◷ Create task',async()=>{ const title=prompt('Task title:')||''; if(!title.trim())return; try{ await ops('task_create',{title,entity:'customers',entity_id:String(id)}); toast('Task created'); }catch(e){ toast('Failed: '+(e&&e.message||e)); } }));
    main.appendChild(ab);
  }
  main.appendChild(el('p','wssub',`${escapeH(p.email||'')}${p.phone?' · '+escapeH(p.phone):''}${p.created_at?' · since '+fmtDate(p.created_at):''}`));
  if(d.ai_summary){ const c=el('div','card'); c.appendChild(el('h3',null,'✦ Customer summary')); c.appendChild(el('p','small',escapeH(d.ai_summary))); main.appendChild(c); }
  const k=el('div','grid kpis');
  k.append(
    kpi('Lifetime value', money(m.ltv), 'fees paid to us'),
    kpi('Total deal value', money(m.total_deal_value), (m.reveals||0)+' reveals'),
    kpi('RFQs', num(m.rfqs_total), `${m.rfqs_active||0} active`),
    kpi('Avg project budget', m.avg_project_budget?money(m.avg_project_budget):'—'),
    kpi('Relationship', num(m.relationship_score), 'score / 100'),
  );
  main.appendChild(k);
  const prefRow=el('div','grid cards2');
  prefRow.appendChild(statCard('Profile', [
    ['Email', p.email||'—'],['Email verified', p.email_verified?'yes':'no'],
    ['Phone', p.phone||'—'],['Phone verified', p.phone_verified?'yes':'no'],
    ['WhatsApp opt-in', p.wa_optin?'yes':'no'],['Terms accepted', p.tos_accepted_at?fmtDate(p.tos_accepted_at):'—'],
    ['Chat strikes', p.chat_strikes==null?0:p.chat_strikes],
  ]));
  prefRow.appendChild(statCard('Preferences & activity', [
    ['Preferred categories', arrList(pr.categories)],['Emirates', arrList(pr.emirates)],
    ['Completed RFQs', m.rfqs_completed==null?0:m.rfqs_completed],['Reveals', m.reveals==null?0:m.reveals],
  ]));
  main.appendChild(prefRow);
  const rc=el('div','card'); rc.appendChild(el('h3',null,`RFQs / Projects <span class="tag">${(d.rfqs||[]).length}</span>`));
  if((d.rfqs||[]).length)(d.rfqs||[]).forEach(r=>rc.appendChild(el('div','row',`<span class="k">${escapeH(r.category||'inquiry')} <span class="muted small">${escapeH([r.emirate,r.pipeline_stage||r.status].filter(Boolean).join(' · '))}</span></span><span class="v">${r.budget?money(r.budget):''} <span class="muted small">${fmtDate(r.created_at)}</span></span>`)));
  else rc.appendChild(el('div','muted small','No RFQs yet.'));
  main.appendChild(rc);
  const r3=el('div','grid cards2');
  const qc=el('div','card'); qc.appendChild(el('h3',null,`Quotes received <span class="tag">${(d.quotes||[]).length}</span>`));
  if((d.quotes||[]).length)(d.quotes||[]).forEach(q=>qc.appendChild(el('div','row',`<span class="k">${money(q.amount)} <span class="muted small">${cap(q.status||'')}</span></span><span class="v muted small">${fmtDate(q.created_at)}</span>`)));
  else qc.appendChild(el('div','muted small','No quotes yet.'));
  r3.appendChild(qc);
  const tc=el('div','card'); tc.appendChild(el('h3',null,`Financial history <span class="tag">${(d.transactions||[]).length}</span>`));
  if((d.transactions||[]).length)(d.transactions||[]).forEach(t=>tc.appendChild(el('div','row',`<span class="k">Deal ${money(t.quote_amount)} <span class="muted small">${cap(t.fee_status||'')}</span></span><span class="v">${money(t.reveal_fee)} fee</span>`)));
  else tc.appendChild(el('div','muted small','No transactions yet.'));
  r3.appendChild(tc);
  main.appendChild(r3);
  main.appendChild(await filesSection('customer', id));
  const a=$('#aside'); a.innerHTML='';
  a.appendChild(el('div','asideh','Relationship'));
  a.appendChild(el('div','small',`Score <b>${m.relationship_score==null?'—':m.relationship_score}</b>/100 · LTV ${money(m.ltv)} · ${m.reveals||0} reveal(s)`));
  a.appendChild(el('div','asideh','Alerts'));
  const al=[];
  if(p.banned) al.push('⛔ Banned'+(p.banned_reason?': '+p.banned_reason:''));
  if(!p.email_verified) al.push('✉ Email not verified');
  if((p.chat_strikes||0)>0) al.push('⚠ '+p.chat_strikes+' chat strike(s)');
  if(!al.length) al.push('No alerts.');
  al.forEach(x=>a.appendChild(el('div','small',escapeH(x))));
  a.appendChild(el('div','asideh','Timeline'));
  (d.timeline||[]).slice(0,10).forEach(t=>a.appendChild(el('div','small muted',`${fmtDate(t.at)} — ${escapeH(t.event||'')}`)));
  if(!(d.timeline||[]).length) a.appendChild(el('div','small muted','No history.'));
  a.appendChild(el('div','asideh','Actions'));
  const qa=el('div','qa'); qa.append(actBtn('←  Back to customers',()=>loadCustomers()), actBtn('🔍  Universal search',()=>openPalette())); a.appendChild(qa);
}

function healthDot(s){ const m={healthy:'var(--ok)',degraded:'var(--bad)',stale:'var(--warn)',idle:'#9aa7b5'}; return `<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${m[s]||'#9aa7b5'};margin-right:5px"></span>`; }
async function loadAgents(){
  CUR='ai'; renderNav();
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let d; try{ d=await api('ws.agents'); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  const k=d.kpis||{}, rows=d.rows||[];
  main.innerHTML=''; main.appendChild(el('div','wshead','<h1>Smart Engine Agents</h1>'));
  main.appendChild(el('p','wssub','Your Smart Engine workforce · click any agent for its operations center'));
  const kp=el('div','grid kpis');
  kp.append(kpi('Agents',num(k.agents)),kpi('Runs 24h',num(k.runs_24h)),kpi('Pending actions',num(k.actions_pending)),kpi('Knowledge items',num(k.knowledge_items)),kpi('Memory items',num(k.memory_items)),kpi('Actions total',num(k.actions_total)));
  main.appendChild(kp);
  const c=el('div','card'); c.appendChild(el('h3',null,`Agent roster <span class="tag">${rows.length}</span>`));
  rows.forEach(r=>{ const row=el('div','row'); row.style.cursor='pointer';
    const dot = r.last_status==='ok'?'healthy':(r.last_status && (r.last_status==='error'||r.last_status==='failed')?'degraded':(r.last_status?'healthy':'idle'));
    row.innerHTML=`<span class="k">${healthDot(dot)}${r.emoji?escapeH(r.emoji)+' ':''}${escapeH(r.name||r.key)} <span class="muted small">${escapeH(r.key)}</span></span><span class="v">${num(r.runs_24h)} runs/24h${r.actions_pending>0?(' · <span style="color:var(--warn)">'+r.actions_pending+' pending</span>'):''}${r.knowledge>0?(' · '+r.knowledge+' kb'):''}</span>`;
    row.onclick=()=>openAgentOps(r.key); c.appendChild(row); });
  if(!rows.length) c.appendChild(el('div','muted small','No agents.'));
  main.appendChild(c);
  try{
    const ai=await api('ws.ai'); const pr=(ai&&ai.prompt_reviews)||[];
    const pc=el('div','card'); pc.appendChild(el('h3',null,`Prompt reviews <span class="tag">${pr.length}</span>`));
    if(!pr.length) pc.appendChild(el('div','muted small','No prompt changes awaiting review. Improvements that beat the benchmark auto-apply; only regressions or sensitive prompts appear here.'));
    pr.forEach(p=>{
      const scored=p.scored===true||p.scored==='true'; const dl=Number(p.delta); const regress=scored&&dl<0;
      const scoreTxt = scored ? ('current '+p.active_score+' → candidate '+p.candidate_score+' ('+(dl>=0?'+':'')+p.delta+')') : 'not yet scored';
      const row=el('div','row'); row.style.flexWrap='wrap';
      row.innerHTML=`<span class="k">${escapeH(p.key)} v${p.version}${(p.sensitive==='true'||p.sensitive===true)?' <span class="muted small">· sensitive</span>':''}</span><span class="v" style="${regress?'color:var(--bad)':(scored?'color:var(--ok)':'')}">${escapeH(scoreTxt)}</span>`;
      const bar=el('div'); bar.style.cssText='display:flex;gap:12px;margin-top:6px;width:100%;flex-wrap:wrap';
      const lnk=(t,col,fn)=>{ const s=el('span'); s.style.cssText='cursor:pointer;text-decoration:underline;font-size:12px;color:'+col; s.textContent=t; s.onclick=fn; return s; };
      bar.appendChild(lnk('View diff','#4a90d9',()=>showPromptDiff(p.key,p.version)));
      bar.appendChild(lnk(scored?'Re-score':'Score now','#4a90d9',async()=>{ try{ await api('prompt_gate',{key:p.key,version:p.version}); toast('Scoring started — refresh in ~1 min'); }catch(e){ toast('Failed: '+e.message);} }));
      bar.appendChild(lnk('Approve','#0a8a3a',async()=>{ if(!confirm('Approve '+p.key+' v'+p.version+'? It becomes the live prompt.'))return; try{ await api('prompt_approve',{key:p.key,version:p.version}); toast('Approved — now live'); loadAgents(); }catch(e){ toast('Failed: '+e.message);} }));
      if(p.active_version&&p.active_version>1) bar.appendChild(lnk('Rollback','#a66200',async()=>{ const to=prompt('Roll '+p.key+' back to which version?',String(p.active_version-1)); if(!to)return; try{ await api('prompt_rollback',{key:p.key,to_version:Number(to)}); toast('Rolled back to v'+to); loadAgents(); }catch(e){ toast('Failed: '+e.message);} }));
      row.appendChild(bar); pc.appendChild(row);
    });
    main.appendChild(pc);
  }catch(_e){}
  $('#aside').innerHTML='<div class="asideh">Smart Engine workforce</div><div class="muted small">'+num(k.agents)+' agents running. Click one to see assignments, queue, conversations, knowledge coverage, memory, performance, prompt version and full audit trail.</div>';
}
async function showPromptDiff(key,version){
  const dr=$('#drawer'); dr.classList.add('on'); $('#drwtitle').textContent=key+' · v'+version; $('#drwbody').innerHTML=skeleton();
  let r; try{ r=await api('prompt_view',{key,version}); }catch(e){ $('#drwbody').innerHTML='<div class="card">Could not load: '+e.message+'</div>'; return; }
  const a=(r&&r.active)||{}, c=(r&&r.candidate)||{}; const b=$('#drwbody'); b.innerHTML='';
  const mk=(t,txt)=>{ const card=el('div','card'); card.appendChild(el('h3',null,t)); const pre=document.createElement('pre'); pre.style.cssText='white-space:pre-wrap;font-size:12px;line-height:1.5;margin:0'; pre.textContent=txt||'(empty)'; card.appendChild(pre); return card; };
  b.appendChild(mk('Current — v'+(a.version==null?'?':a.version), a.content));
  b.appendChild(mk('Candidate — v'+(c.version==null?version:c.version), c.content));
}
async function openAgentOps(key){
  CUR='ai'; renderNav();
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let d; try{ d=await api('ws.agent',{key}); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  if(!d||d.error){ main.innerHTML=`<div class="card">${d&&d.error?d.error:'Not found'}</div>`; return; }
  const id=d.identity||{}, h=d.health||{}, perf=d.performance||{}, kn=d.knowledge||{}, mem=d.memory||{};
  const band = h.status==='healthy'?'good':(h.status==='degraded'?'bad':'attention');
  main.innerHTML='';
  const wh=el('div','wshead'); wh.innerHTML=`<button class="iconbtn" id="backai" style="margin-right:2px">←</button><h1>${id.emoji?escapeH(id.emoji)+' ':''}${escapeH(id.name||key)}</h1><span class="pill ${band}">${cap(h.status||'idle')}</span>${id.active===false?'<span class="pill bad">Inactive</span>':''}`;
  main.appendChild(wh); $('#backai').onclick=()=>loadAgents();
  main.appendChild(el('p','wssub',`${escapeH(id.persona||id.prompt_desc||'Smart Engine agent')} · key ${escapeH(key)}`));
  const k=el('div','grid kpis');
  k.append(
    kpi('Runs total', num(perf.runs_total), num(perf.runs_24h)+' in 24h'),
    kpi('Reliability', perf.ok_rate!=null?perf.ok_rate+'%':'—', 'run success'),
    kpi('Avg duration', perf.avg_duration_ms!=null?Math.round(perf.avg_duration_ms)+' ms':'—'),
    kpi('Knowledge', num(kn.count), 'items'),
    kpi('Queue', num((d.queue||[]).length), 'pending actions'),
  );
  main.appendChild(k);
  const cfg=el('div','grid cards2');
  cfg.appendChild(statCard('Configuration', [
    ['Prompt version', id.prompt_version||'—'],['Prompt owner', id.prompt_owner||'—'],
    ['Prompt updated', id.prompt_updated?fmtDate(id.prompt_updated):'—'],
    ['Knowledge updated', id.knowledge_updated?fmtDate(id.knowledge_updated):'—'],
    ['Active', id.active===false?'no':'yes'],['Health', cap(h.status||'idle')],
    ['Last run', h.last_run?fmtDate(h.last_run):'—'],['Last status', h.last_status||'—'],
  ]));
  cfg.appendChild(statCard('Performance', [
    ['Runs total', num(perf.runs_total)],['Runs 24h', num(perf.runs_24h)],['Runs 7d', num(perf.runs_7d)],
    ['Success rate', perf.ok_rate!=null?perf.ok_rate+'%':'—'],['Avg duration', perf.avg_duration_ms!=null?Math.round(perf.avg_duration_ms)+' ms':'—'],
  ]));
  main.appendChild(cfg);
  // knowledge coverage
  const kc=el('div','card'); kc.appendChild(el('h3',null,`Knowledge coverage <span class="tag">${kn.count||0}</span>`));
  if((kn.topics||[]).length) kc.appendChild(el('div','chiprow',(kn.topics||[]).slice(0,24).map(t=>`<span class="chip">${escapeH(String(t))}</span>`).join('')));
  else kc.appendChild(el('div','muted small','No knowledge topics recorded.'));
  main.appendChild(kc);
  // queue / assignments
  const qc=el('div','card'); qc.appendChild(el('h3',null,`Queue & assignments <span class="tag">${(d.queue||[]).length}</span>`));
  if((d.queue||[]).length)(d.queue||[]).forEach(a=>{ const it=el('div','att'); it.innerHTML=`<div class="ico">⚑</div><div><div class="t">${escapeH(a.title||a.kind||'action')} ${a.risk?`<span class="muted small">· ${escapeH(a.risk)} risk</span>`:''}</div><div class="m">${escapeH(String(a.recommendation||'').slice(0,120))} · ${fmtDate(a.created_at)}</div></div>`; qc.appendChild(it); });
  else qc.appendChild(el('div','muted small','No pending assignments.'));
  main.appendChild(qc);
  // recommendations
  if((d.recommendations||[]).length){ const rc=el('div','card'); rc.appendChild(el('h3',null,'Recommendations'));
    (d.recommendations||[]).forEach(r=>rc.appendChild(el('div','row',`<span class="k">${escapeH(r.title||'')}</span><span class="v muted small">${escapeH(String(r.recommendation||'').slice(0,80))}</span>`))); main.appendChild(rc); }
  // memory + conversations
  const r3=el('div','grid cards2');
  const mc=el('div','card'); mc.appendChild(el('h3',null,`Memory <span class="tag">${mem.count||0}</span>`));
  if((mem.recent||[]).length)(mem.recent||[]).forEach(x=>mc.appendChild(el('div','row',`<span class="k">${escapeH(x.kind||'note')} <span class="muted small">${escapeH(String(x.content||'').slice(0,50))}</span></span><span class="v muted small">${fmtDate(x.at)}</span>`)));
  else mc.appendChild(el('div','muted small','No memory items.'));
  r3.appendChild(mc);
  const cc=el('div','card'); cc.appendChild(el('h3',null,`Recent conversations <span class="tag">${(d.conversations||[]).length}</span>`));
  if((d.conversations||[]).length)(d.conversations||[]).forEach(x=>cc.appendChild(el('div','row',`<span class="k">${escapeH(x.role||'')}: <span class="muted small">${escapeH(String(x.content||'').slice(0,60))}</span></span><span class="v muted small">${fmtDate(x.at)}</span>`)));
  else cc.appendChild(el('div','muted small','No conversations.'));
  r3.appendChild(cc);
  main.appendChild(r3);
  // audit trail
  const ac=el('div','card'); ac.appendChild(el('h3',null,`Audit trail <span class="tag">${(d.audit||[]).length}</span>`));
  if((d.audit||[]).length)(d.audit||[]).forEach(x=>ac.appendChild(el('div','row',`<span class="k">${escapeH(x.title||x.kind||'action')} <span class="muted small">${escapeH(x.status||'')}</span></span><span class="v muted small">${x.decided_by?escapeH(x.decided_by)+' · ':''}${fmtDate(x.at)}</span>`)));
  else ac.appendChild(el('div','muted small','No audit records.'));
  main.appendChild(ac);
  // right
  const a=$('#aside'); a.innerHTML='';
  a.appendChild(el('div','asideh','Health'));
  a.appendChild(el('div','small',`${healthDot(h.status)}${cap(h.status||'idle')} · ${perf.ok_rate!=null?perf.ok_rate+'% success':''}`));
  a.appendChild(el('div','asideh','Signals'));
  const sig=[];
  if((d.queue||[]).length) sig.push((d.queue||[]).length+' action(s) awaiting review');
  if(perf.ok_rate!=null && perf.ok_rate<90) sig.push('⚠ success rate below 90%');
  if(kn.count===0) sig.push('No knowledge base attached');
  if(id.active===false) sig.push('Agent is inactive');
  if(!sig.length) sig.push('Operating normally.');
  sig.forEach(x=>a.appendChild(el('div','small',escapeH(x))));
  a.appendChild(el('div','asideh','Recent runs'));
  (d.recent_runs||[]).slice(0,8).forEach(r=>a.appendChild(el('div','small muted',`${fmtDate(r.started_at)} — ${escapeH(r.status||'')}`)));
  a.appendChild(el('div','asideh','Actions'));
  const qa=el('div','qa'); qa.append(actBtn('←  Back to agents',()=>loadAgents()), actBtn('🔍  Universal search',()=>openPalette())); a.appendChild(qa);
}

async function loadRfqs(){
  CUR='marketplace'; renderNav();
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let d; try{ d=await api('ws.marketplace'); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  const k=d.kpis||{}, rows=d.rows||[];
  main.innerHTML=''; main.appendChild(el('div','wshead','<h1>RFQs & Procurement</h1>'));
  main.appendChild(el('p','wssub','Click any RFQ to open its procurement workspace'));
  const kp=el('div','grid kpis');
  kp.append(kpi('RFQs',num(k.rfqs)),kpi('Active',num(k.active)),kpi('Quotes',num(k.quotes)),kpi('Hired',num(k.hired)),kpi('Transactions',num(k.transactions)),kpi('Avg value',k.avg_value?money(k.avg_value):'—'));
  main.appendChild(kp);
  const c=el('div','card'); c.appendChild(el('h3',null,`Requests <span class="tag">${rows.length}</span>`));
  rows.forEach(r=>{ const row=el('div','row'); row.style.cursor='pointer';
    row.innerHTML=`<span class="k">${escapeH(String(r.summary||r.category||'RFQ').slice(0,60))} <span class="muted small">${escapeH([r.category,r.emirate].filter(Boolean).join(' · '))}</span></span><span class="v">${escapeH(cap(r.pipeline_stage||r.status||''))} ${r.budget?('<span class="muted small">· '+escapeH(String(r.budget))+'</span>'):''}</span>`;
    row.onclick=()=>openRfq360(r.id); c.appendChild(row); });
  if(!rows.length) c.appendChild(el('div','muted small','No RFQs.'));
  main.appendChild(c);
  $('#aside').innerHTML='<div class="asideh">Procurement</div><div class="muted small">Each RFQ opens a full workspace: requirements, drawings, Smart Engine qualification, supplier matching, quotation comparison, clarifications, selected supplier and timeline.</div>';
}
async function openRfq360(id){
  CUR='marketplace'; renderNav();
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let d; try{ d=await api('ws.rfq',{id}); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  if(!d||d.error){ main.innerHTML=`<div class="card">${d&&d.error?d.error:'Not found'}</div>`; return; }
  const req=d.requirements||{}, st=d.status||{}, ai=d.ai_qualification||{}, quotes=d.quotes||[], matches=d.matching||[];
  const best = quotes.reduce((a,q)=>(a==null||(q.amount!=null&&q.amount<a.amount))?q:a, null);
  main.innerHTML='';
  const band = st.outcome==='completed'?'good':(st.status==='cancelled'||st.lost_reason?'bad':'attention');
  const wh=el('div','wshead'); wh.innerHTML=`<button class="iconbtn" id="backrfq" style="margin-right:2px">←</button><h1>${escapeH(String(req.category||'RFQ'))}</h1><span class="pill ${band}">${cap(st.pipeline_stage||st.status||'open')}</span>${ai.rfq_ready?'<span class="pill good">RFQ ready</span>':''}`;
  main.appendChild(wh); $('#backrfq').onclick=()=>loadRfqs();
  main.appendChild(el('p','wssub',`${escapeH([req.emirate,req.role_needed,st.deal_owner?('owner '+st.deal_owner):''].filter(Boolean).join(' · '))}${st.created_at?' · '+fmtDate(st.created_at):''}`));
  const k=el('div','grid kpis');
  k.append(
    kpi('Quotes', num(quotes.length), 'received'),
    kpi('Best quote', best&&best.amount!=null?money(best.amount):'—', best?escapeH(String(best.company_name||'')):''),
    kpi('Matched suppliers', num(matches.length)),
    kpi('Expected value', st.expected_value?money(st.expected_value):'—'),
    kpi('Completeness', (ai.completeness&&typeof ai.completeness.score==='number')?ai.completeness.score+'%':'—'),
  );
  main.appendChild(k);
  // requirements
  const rq=el('div','card'); rq.appendChild(el('h3',null,'Requirements'));
  if(req.summary) rq.appendChild(el('p','small',escapeH(String(req.summary))));
  [['Budget',req.budget],['Scope',req.scope_type],['Trades',arrList(req.trades)],['Keywords',arrList(req.keywords)],['BOQ confidence',req.boq_confidence]].forEach(([kk,vv])=>{ if(vv!=null&&vv!=='') rq.appendChild(el('div','row',`<span class="k">${kk}</span><span class="v">${escapeH(String(vv))}</span>`)); });
  main.appendChild(rq);
  main.appendChild(await filesSection('rfq', id));
  // Smart Engine qualification
  main.appendChild(statCard('Smart Engine qualification', [
    ['Completeness score', (ai.completeness&&ai.completeness.score!=null)?ai.completeness.score+'%':'—'],['RFQ ready', (ai.rfq_ready||(ai.completeness&&ai.completeness.ready))?'yes':'no'],
    ['Routing', ai.routing?JSON.stringify(ai.routing).slice(0,60):'—'],['Brief source', ai.brief_source||'—'],
  ]));
  // supplier matching
  const mc=el('div','card'); mc.appendChild(el('h3',null,`Supplier matching <span class="tag">${matches.length}</span>`));
  if(matches.length)matches.forEach(m=>mc.appendChild(el('div','row',`<span class="k">${escapeH(m.company_name||('#'+m.supplier_id))} <span class="muted small">${escapeH(String(m.match_reason||'').slice(0,50))}</span></span><span class="v">${m.similarity!=null?(Math.round(m.similarity*100)+'% match'):''}</span>`)));
  else mc.appendChild(el('div','muted small','No matched suppliers.'));
  main.appendChild(mc);
  // quotation comparison
  const qc=el('div','card'); qc.appendChild(el('h3',null,`Quotation comparison <span class="tag">${quotes.length}</span>`));
  if(quotes.length)quotes.forEach(q=>{ const isBest=best&&q.id===best.id; const it=el('div','row');
    const qs=(q.quality&&typeof q.quality==='object')?q.quality.score:null;
    it.innerHTML=`<span class="k">${isBest?'★ ':''}${escapeH(q.company_name||('#'+q.supplier_id))} <span class="muted small">${escapeH(cap(q.status||''))}${q.lead_time?(' · '+escapeH(String(q.lead_time))):''}</span></span><span class="v">${money(q.amount)}${qs!=null?(' <span class="muted small">Q'+qs+'</span>'):''}</span>`;
    if(isBest) it.style.background='rgba(18,161,80,.06)';
    qc.appendChild(it); });
  else qc.appendChild(el('div','muted small','No quotes yet.'));
  main.appendChild(qc);
  // procurement analysis
  const pr=d.procurement||{};
  if(pr.ready){
    const prec=pr.recommendation||{}, prng=pr.price_range||{};
    const rb=el('div','card'); rb.style.borderLeft='4px solid var(--ok)';
    rb.appendChild(el('h3',null,'✓ Procurement recommendation'));
    rb.appendChild(el('div','small',`<b>${escapeH(prec.label||'')}</b>${prec.company_name?(' — '+escapeH(prec.company_name)):''} · ${money(prec.price)} · value ${prec.value_score}/100`));
    if(prec.why) rb.appendChild(el('div','small muted',escapeH(prec.why)));
    rb.appendChild(el('div','row',`<span class="k">Price range</span><span class="v">${money(prng.low)} – ${money(prng.high)} <span class="muted small">(median ${money(prng.median)}, spread ${prng.spread_pct}%)</span></span>`));
    main.appendChild(rb);
    const mtx=el('div','card'); mtx.appendChild(el('h3',null,`Comparison matrix <span class="tag">${(pr.matrix||[]).length}</span>`));
    (pr.matrix||[]).forEach(m=>{ const isRec=prec&&m.label===prec.label; const row=el('div','row'); row.style.display='block';
      row.innerHTML=`<div style="display:flex;justify-content:space-between"><span class="k">${isRec?'★ ':''}${escapeH(m.label)} <span class="muted small">${escapeH(m.company_name||'')}</span></span><span class="v">${money(m.price)} <span class="muted small">${m.price_vs_low_pct>0?('+'+m.price_vs_low_pct+'%'):'lowest'}</span></span></div><div class="muted small" style="margin:3px 0">quality ${m.quality_score}/100 · completeness ${m.completeness_pct}% · reputation ${m.reputation} · <b>value ${m.value_score}/100</b> · ${escapeH(m.lead_time||'lead n/a')}${m.warranty?(' · '+escapeH(m.warranty)):''}</div>${(m.risks||[]).length?('<div class="small" style="color:var(--warn)">⚠ '+m.risks.map(x=>escapeH(x)).join(' · ')+'</div>'):''}`;
      mtx.appendChild(row); });
    main.appendChild(mtx);
  } else if((pr.quote_count||0)===1){
    main.appendChild(el('div','card','<div class="muted small">Procurement analysis: only one quote so far — a comparison needs at least two.</div>'));
  }
  // clarifications
  if((d.clarifications||[]).length){ const cc=el('div','card'); cc.appendChild(el('h3',null,`Clarifications <span class="tag">${(d.clarifications||[]).length}</span>`));
    (d.clarifications||[]).forEach(c=>{ cc.appendChild(el('div','row',`<span class="k">Q: ${escapeH(String(c.question||'').slice(0,60))}</span><span class="v muted small">${c.answered_at?'answered':'pending'}</span>`)); if(c.answer) cc.appendChild(el('div','small muted','A: '+escapeH(String(c.answer).slice(0,90)))); });
    main.appendChild(cc); }
  // documents rendered above via filesSection('rfq', id)
  // right panel
  const a=$('#aside'); a.innerHTML='';
  a.appendChild(el('div','asideh','Selected supplier'));
  a.appendChild(el('div','small', d.selected_supplier?escapeH(d.selected_supplier.company_name||('#'+d.selected_supplier.id)):'Not yet awarded'));
  a.appendChild(el('div','asideh','Status'));
  a.appendChild(el('div','small',`${cap(st.pipeline_stage||st.status||'open')}${st.outcome?(' · '+escapeH(st.outcome)):''}${st.lost_reason?(' · lost: '+escapeH(st.lost_reason)):''}`));
  a.appendChild(el('div','asideh','Timeline'));
  (d.timeline||[]).slice(0,10).forEach(t=>a.appendChild(el('div','small muted',`${fmtDate(t.at)} — ${escapeH(t.event||'')}`)));
  if(!(d.timeline||[]).length) a.appendChild(el('div','small muted','No history.'));
  a.appendChild(el('div','asideh','Actions'));
  const qa=el('div','qa'); qa.append(actBtn('←  Back to RFQs',()=>loadRfqs()), actBtn('🔍  Universal search',()=>openPalette())); a.appendChild(qa);
}

async function loadInbox(){
  CUR='inbox'; renderNav();
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let d; try{ d=await api('inbox'); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  const k=d.kpis||{}, rows=d.rows||[];
  main.innerHTML=''; main.appendChild(el('div','wshead','<h1>Inbox</h1>'));
  main.appendChild(el('p','wssub','Smart Engine-triaged emails · review the suggested reply, edit if needed, and send. Nothing is sent without you.'));
  const kp=el('div','grid kpis');
  kp.append(kpi('Needs reply',num(k.needs_review)),kpi('Awaiting triage',num(k.untriaged)),kpi('Replied (7d)',num(k.replied_7d)));
  main.appendChild(kp);
  if(!rows.length){ main.appendChild(el('div','card','<div class="muted small">Inbox clear — nothing awaiting a reply.</div>')); return; }
  rows.forEach(m=>{
    const c=el('div','card');
    c.appendChild(el('h3',null,`${escapeH(String(m.subject||'(no subject)'))} <span class="tag">${escapeH(m.category||'')}</span>`));
    c.appendChild(el('div','muted small',`From ${escapeH(m.from_email||'')} · ${fmtDate(m.created_at)}${m.summary?(' · '+escapeH(m.summary)):''}`));
    if(m.body){ const ob=el('div','row'); ob.style.display='block'; ob.style.borderBottom='0';
      ob.innerHTML=`<div class="muted small" style="white-space:pre-wrap;max-height:110px;overflow:auto;background:var(--chip);border-radius:8px;padding:8px 10px;margin:8px 0">${escapeH(String(m.body).slice(0,800))}</div>`; c.appendChild(ob); }
    if(m.category==='spam' || !m.draft){
      c.appendChild(el('div','muted small', m.category==='spam'?'Classified as spam — no reply drafted. You can dismiss it.':'No reply drafted for this one.'));
    } else {
      const ta=document.createElement('textarea');
      ta.value=m.draft||''; ta.style.cssText='width:100%;min-height:130px;border:1px solid var(--line);border-radius:10px;padding:10px 12px;font:13px/1.5 inherit;background:var(--bg);color:var(--ink);margin-top:4px;resize:vertical';
      c.appendChild(el('div','muted small','Suggested reply (editable):'));
      c.appendChild(ta);
      const bar=el('div',null); bar.style.cssText='display:flex;gap:8px;margin-top:10px;align-items:center';
      const btn=document.createElement('button'); btn.textContent='Send reply'; btn.style.cssText='background:linear-gradient(135deg,var(--brand-2),var(--brand));color:#fff;border:0;border-radius:9px;padding:9px 18px;font-weight:700;cursor:pointer';
      btn.onclick=()=>sendInbox(m.id, ta, btn);
      bar.appendChild(btn); bar.appendChild(el('span','muted small','Sends to '+escapeH(m.from_email||'')));
      c.appendChild(bar);
    }
    main.appendChild(c);
  });
  $('#aside').innerHTML='<div class="asideh">How this works</div><div class="muted small">Incoming emails are read and classified by Smart Engine every hour, and a reply is drafted for you. You review and send with one click (or edit first). The Smart Engine never sends on its own.</div>';
}
async function sendInbox(id, ta, btn){
  const bodyv=(ta.value||'').trim();
  if(!bodyv){ toast('Reply is empty'); return; }
  btn.disabled=true; const old=btn.textContent; btn.textContent='Sending…';
  try{ const res=await api('inbox_send',{id, body:bodyv});
    if(res && res.error){ toast('Send failed: '+res.error); btn.disabled=false; btn.textContent=old; }
    else { toast('Reply sent to '+((res&&res.to)||'')); loadInbox(); }
  }catch(e){ toast('Send failed: '+e.message); btn.disabled=false; btn.textContent=old; }
}

// ================= UNIVERSAL SEARCH =================
let palSel=0, palItems=[];
function openPalette(){ $('#palette').classList.add('on'); const i=$('#palinput'); i.value=''; i.focus(); $('#palres').innerHTML='<div class="palg">Type to search suppliers, customers, RFQs, documents…</div>'; palItems=[]; }
function closePalette(){ $('#palette').classList.remove('on'); }
let palTimer;
$('#palinput')?.addEventListener('input',e=>{ clearTimeout(palTimer); const q=e.target.value.trim(); if(q.length<2){ $('#palres').innerHTML='<div class="palg">Keep typing…</div>'; return;} palTimer=setTimeout(()=>doSearch(q),220); });
async function doSearch(q){
  let d; try{ d=await api('search',{q}); }catch(e){ $('#palres').innerHTML=`<div class="palg">Search failed</div>`; return; }
  const res=$('#palres'); res.innerHTML=''; palItems=[]; palSel=0;
  const groups=Object.entries(d||{}).filter(([,v])=>Array.isArray(v)&&v.length);
  if(!groups.length){ res.innerHTML='<div class="palg">No matches</div>'; return; }
  groups.forEach(([g,items])=>{
    res.appendChild(el('div','palg',cap(g)));
    items.slice(0,6).forEach(it=>{
      const idx=palItems.length; palItems.push({entity:guessEntity(g),id:it.id});
      const row=el('div','palitem'+(idx===0?' sel':''));
      row.innerHTML=`<div><div class="n">${escapeH(String(it.name||it.id))}</div><div class="s">${escapeH(String(it.sub||''))}</div></div><div class="tp">${cap(g.replace(/s$/,''))}</div>`;
      row.onclick=()=>{ closePalette(); openRecord(guessEntity(g),it.id); };
      res.appendChild(row);
    });
  });
}
document.addEventListener('keydown',e=>{
  if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){ e.preventDefault(); openPalette(); }
  if(e.key==='Escape'){ closePalette(); $('#drawer').classList.remove('on'); }
  if($('#palette').classList.contains('on')&&palItems.length){
    const rows=[...document.querySelectorAll('.palitem')];
    if(e.key==='ArrowDown'){e.preventDefault();palSel=Math.min(palItems.length-1,palSel+1);}
    else if(e.key==='ArrowUp'){e.preventDefault();palSel=Math.max(0,palSel-1);}
    else if(e.key==='Enter'){e.preventDefault();const p=palItems[palSel];if(p){closePalette();openRecord(p.entity,p.id);}return;}
    rows.forEach((r,i)=>r.classList.toggle('sel',i===palSel));
    rows[palSel]?.scrollIntoView({block:'nearest'});
  }
});

// ================= RECORD DRAWER (fn_os_record) =================
async function openRecord(entity,id){
  if(entity==='supplier') return openSupplier360(id);
  if(entity==='customer') return openCustomer360(id);
  if(entity==='rfq') return openRfq360(id);
  const d=$('#drawer'); d.classList.add('on'); $('#drwtitle').textContent=cap(entity)+' record'; $('#drwbody').innerHTML=skeleton();
  let rec; try{ rec=await api('record',{entity,id}); }catch(e){ $('#drwbody').innerHTML=`<div class="card">Could not load record: ${e.message}</div>`; return; }
  const body=$('#drwbody'); body.innerHTML='';
  if(rec==null){ body.innerHTML='<div class="muted">No record found.</div>'; return; }
  const head=rec.name||rec.title||rec.company||rec.email||id;
  $('#drwtitle').textContent=String(head).slice(0,48);
  renderGeneric(body,rec);
}

// ---- helpers ----
function kpi(l,v,s){ const c=el('div','card kpi'); c.innerHTML=`<div class="lbl">${l}</div><div class="val">${v}</div>${s?`<div class="sub">${s}</div>`:''}`; return c; }
function statCard(title,rows){ const c=el('div','card'); c.appendChild(el('h3',null,title)); rows.forEach(([k,v,s])=>c.appendChild(el('div','row',`<span class="k">${k}</span><span class="v">${v}${s?` <span class="muted small">${s}</span>`:''}</span>`))); return c; }
function actBtn(label,fn){ const b=el('button',null,label); b.onclick=fn; return b; }
function openEditModal(title, fields, onSave){
  const ov=el('div'); ov.style.cssText='position:fixed;inset:0;background:rgba(6,18,27,.55);z-index:90;display:flex;align-items:center;justify-content:center;padding:20px';
  const card=el('div'); card.style.cssText='background:var(--panel);color:var(--ink);border:1px solid var(--line);border-radius:14px;max-width:660px;width:100%;max-height:88vh;overflow:auto;box-shadow:0 20px 60px rgba(0,0,0,.45)';
  const head=el('div'); head.style.cssText='padding:15px 18px;border-bottom:1px solid var(--line);font-weight:700'; head.textContent=title; card.appendChild(head);
  const body=el('div'); body.style.cssText='padding:16px 18px;display:flex;flex-direction:column;gap:12px'; card.appendChild(body);
  const inputs={};
  fields.forEach(f=>{ const w=el('div'); const lb=el('div'); lb.style.cssText='font-size:12px;font-weight:600;color:var(--muted);margin-bottom:4px'; lb.textContent=f.label||f.key; w.appendChild(lb);
    let inp; if(f.type==='textarea'){ inp=document.createElement('textarea'); inp.rows=f.rows||8; } else { inp=document.createElement('input'); inp.type='text'; }
    inp.value=(f.value==null?'':String(f.value)); inp.style.cssText='width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);font:inherit;box-sizing:border-box'; w.appendChild(inp); body.appendChild(w); inputs[f.key]=inp; });
  const foot=el('div'); foot.style.cssText='padding:13px 18px;border-top:1px solid var(--line);display:flex;gap:8px;justify-content:flex-end';
  const cancel=el('button',null,'Cancel'); cancel.style.cssText='padding:8px 16px;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--ink);cursor:pointer;font:inherit;font-weight:600'; cancel.onclick=()=>ov.remove();
  const save=el('button',null,'Save'); save.style.cssText='padding:8px 16px;border-radius:8px;border:0;background:var(--rail-active,#12b3a6);color:#fff;cursor:pointer;font:inherit;font-weight:700';
  save.onclick=async()=>{ const values={}; Object.keys(inputs).forEach(k=>values[k]=inputs[k].value); save.disabled=true; save.textContent='Saving…'; try{ await onSave(values); ov.remove(); }catch(e){ toast('Save failed: '+((e&&e.message)||e)); save.disabled=false; save.textContent='Save'; } };
  foot.append(cancel,save); card.appendChild(foot); ov.appendChild(card); ov.onclick=(e)=>{ if(e.target===ov) ov.remove(); }; document.body.appendChild(ov);
}
async function editContent(type,id,spec,after){
  let d; try{ d=await ops('content_get',{type,id}); }catch(e){ toast('Load failed: '+((e&&e.message)||e)); return; }
  const fields=spec.map(f=>Object.assign({},f,{value:d?d[f.key]:''}));
  openEditModal('Edit — '+String(type).replace(/_/g,' '), fields, async(values)=>{ await ops('content_save',{type,id,values}); toast('Saved'); if(after)after(); });
}
function skeleton(){ return '<div class="grid kpis">'+Array(5).fill('<div class="skel"></div>').join('')+'</div><div class="grid cards2" style="margin-top:14px"><div class="skel" style="height:220px"></div><div class="skel" style="height:220px"></div></div>'; }
function escapeH(s){ return s.replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
function navTo(id){ const m=MODULES.find(x=>x.id===id); if(m){ CUR=id; renderNav(); openModule(m);} }
async function openFile(bucket,path){ try{ const d=await api('file',{bucket,path}); if(d&&d.url) window.open(d.url,'_blank','noopener'); else toast('File unavailable'); }catch(e){ toast('Could not open: '+e.message); } }
function fileItem(f){ const r=el('div','row'); r.style.cursor='pointer'; r.innerHTML=`<span class="k">📎 ${escapeH(f.type||'File')}</span><span class="v muted small">${escapeH(f.name||'open')} ↗</span>`; r.onclick=()=>openFile(f.bucket,f.path); return r; }
async function filesSection(entity,id){ const c=el('div','card'); c.appendChild(el('h3',null,'Files & Documents')); const hold=el('div'); hold.innerHTML='<div class="muted small">Loading…</div>'; c.appendChild(hold); try{ const files=await api('files',{entity,id})||[]; if(!files.length){ hold.innerHTML='<div class="muted small">No files on record yet.</div>'; } else { hold.innerHTML=''; const g={}; files.forEach(f=>{(g[f.group||'Files']=g[f.group||'Files']||[]).push(f);}); Object.entries(g).forEach(([grp,arr])=>{ hold.appendChild(el('div','navlabel',`${grp} (${arr.length})`)); arr.forEach(f=>hold.appendChild(fileItem(f))); }); } }catch(e){ hold.innerHTML='<div class="muted small">Could not load files.</div>'; } return c; }
async function openReportPdf(id,src){ try{ toast('Rendering PDF…'); const d=await api('report_pdf',{id,src:src||'board'}); if(d&&d.url) window.open(d.url,'_blank','noopener'); else toast('Could not render PDF'); }catch(e){ toast('PDF failed: '+e.message); } }


// ===================== OPERATIONAL LAYER (os_ops) =====================
async function ops(action, body){
  const ctl=new AbortController(); const to=setTimeout(()=>ctl.abort(),20000);
  let r; try{ r=await fetch(FN+'/os_ops',{method:'POST',signal:ctl.signal,headers:{'Content-Type':'application/json',...(window.OS_AUTH||{})},body:JSON.stringify({action,...(body||{})})}); }
  finally{ clearTimeout(to); }
  const j=await r.json().catch(()=>({}));
  if(r.status===401){ toast('Session expired — refresh to sign in.'); throw new Error('unauthorized'); }
  if(r.status===403){ toast('Not authorized.'); throw new Error('forbidden'); }
  if(j.error) throw new Error(j.error);
  return j.data;
}
function opFmt(v){ if(v==null) return '<span class="muted">—</span>'; if(typeof v==='boolean') return v?'<b style="color:var(--ok)">yes</b>':'<span class="muted">no</span>'; if(typeof v==='object'){ const s=JSON.stringify(v); return '<span class="muted small">'+escapeH(s.length>50?s.slice(0,50)+'…':s)+'</span>'; } const s=String(v); if(/^\d{4}-\d\d-\d\dT/.test(s)) return fmtDate(s); if(/^\d+(\.\d+)?$/.test(s)&&s.length<=10) return escapeH(s); return escapeH(s.length>64?s.slice(0,64)+'…':s); }
function opBadge(v){ const s=String(v||'').toLowerCase(); let c='#5b6672'; if(/pending|submitted|review|requested|open|draft|awaiting/.test(s))c='#d9820b'; else if(/approv|paid|done|complete|active|ok|verified|resolved|sent|published/.test(s))c='#12a150'; else if(/reject|banned|cancel|fail|error|blocked|lost|overdue|dismiss/.test(s))c='#e02424'; return `<span class="tag" style="background:${c}22;color:${c};font-weight:700">${escapeH(String(v))}</span>`; }

// rich sortable table from a fn_os_list response
function opTable(resp, opts){
  opts=opts||{}; const cols=(resp.columns||[]).filter(c=>!/^(embedding|raw|spec|boq|extracted)$/.test(c));
  let rows=(resp.rows||[]).slice(); let sortK=null, sortDir=1;
  const wrap=el('div','card'); wrap.style.padding='0';
  const scroller=el('div'); scroller.style.cssText='overflow-x:auto';
  const tbl=document.createElement('table'); tbl.style.cssText='width:100%;border-collapse:collapse;font-size:12.5px';
  scroller.appendChild(tbl); wrap.appendChild(scroller);
  function cell(c,row){ const v=row[c]; if(/status|stage|fee_status|refund_status|approval_status|verification_status|severity|risk/.test(c)&&v!=null&&typeof v!=='object') return opBadge(v); return opFmt(v); }
  function draw(){
    let r2=rows.slice();
    if(sortK) r2.sort((a,b)=>{ let x=a[sortK],y=b[sortK]; if(x==null)return 1; if(y==null)return -1; if(typeof x==='number'&&typeof y==='number')return (x-y)*sortDir; return String(x).localeCompare(String(y))*sortDir; });
    let h='<thead><tr>'+cols.map(c=>`<th data-c="${c}" style="text-align:left;padding:9px 12px;border-bottom:1px solid var(--line);background:var(--chip);cursor:pointer;white-space:nowrap;font-weight:700;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.03em">${cap(c)}${sortK===c?(sortDir>0?' ▲':' ▼'):''}</th>`).join('')+(opts.actions?'<th style="background:var(--chip);border-bottom:1px solid var(--line)"></th>':'')+'</tr></thead><tbody>';
    r2.forEach((row,i)=>{ h+=`<tr data-i="${i}" style="border-bottom:1px solid var(--line);cursor:pointer">`+cols.map(c=>`<td style="padding:8px 12px;white-space:nowrap;max-width:280px;overflow:hidden;text-overflow:ellipsis">${cell(c,row)}</td>`).join('')+(opts.actions?('<td style="white-space:nowrap;padding:6px 10px;text-align:right">'+opts.actions(row)+'</td>'):'')+'</tr>'; });
    h+='</tbody>'; tbl.innerHTML=h;
    tbl.querySelectorAll('th[data-c]').forEach(th=>th.onclick=()=>{ const c=th.dataset.c; if(sortK===c)sortDir=-sortDir; else{sortK=c;sortDir=1;} draw(); });
    tbl.querySelectorAll('tbody tr').forEach(tr=>{ const row=r2[Number(tr.dataset.i)];
      tr.onclick=(e)=>{ if(e.target.closest('[data-act]'))return; if(opts.onRow) opts.onRow(row); };
      tr.onmouseover=()=>tr.style.background='var(--chip)'; tr.onmouseout=()=>tr.style.background=''; });
    if(opts.actions) tbl.querySelectorAll('[data-act]').forEach(btn=>{ btn.onclick=async(e)=>{ e.stopPropagation(); const row=r2[Number(btn.closest('tr').dataset.i)]; await opts.onAct(btn.dataset.act,row,btn); }; });
  }
  draw();
  try{ const _xb=el('button',null,'⇩ CSV'); _xb.style.cssText='margin:0 0 8px;padding:5px 10px;font-size:12px;font-weight:600;border:1px solid var(--line);border-radius:8px;background:var(--panel);color:var(--ink);cursor:pointer'; _xb.onclick=(e)=>{e.stopPropagation(); exportCSV(cols, rows.slice(), 'quotesdone-table');}; wrap.insertBefore(_xb, wrap.firstChild); }catch(_e){}
  return wrap;
}

// operational list module: tabs + search + pagination + inline actions
let OPS_REFRESH=null;
async function loadListModule(cfg){
  CUR=cfg.id; renderNav();
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let status=(cfg.tabs&&cfg.tabs.length)?cfg.tabs[0].v:null, q='', offset=0; const limit=cfg.limit||60;
  main.innerHTML=''; main.appendChild(el('div','wshead',`<h1>${cfg.title}</h1>`));
  main.appendChild(el('p','wssub',cfg.sub||'Operational workspace — click any row to open it; act inline.'));
  const bar=el('div'); bar.style.cssText='display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px';
  const tabWrap=el('div'); tabWrap.style.cssText='display:flex;gap:6px;flex-wrap:wrap';
  if(cfg.tabs) cfg.tabs.forEach(t=>{ const b=el('button','btn'); b.textContent=t.label; b.onclick=()=>{ status=t.v; offset=0; tabWrap.querySelectorAll('button').forEach(x=>{x.style.background='';x.style.color='';}); b.style.background='var(--rail)'; b.style.color='#fff'; refresh(); }; if(t.v===status){ b.style.background='var(--rail)'; b.style.color='#fff'; } tabWrap.appendChild(b); });
  bar.appendChild(tabWrap);
  const search=document.createElement('input'); search.placeholder='Search '+cfg.title.toLowerCase()+'…'; search.style.cssText='flex:1;min-width:200px;border:1px solid var(--line);border-radius:9px;padding:8px 12px;font:inherit;background:var(--panel);color:var(--ink)';
  let tmr; search.oninput=()=>{ clearTimeout(tmr); tmr=setTimeout(()=>{ q=search.value.trim(); offset=0; refresh(); },250); };
  bar.appendChild(search); main.appendChild(bar);
  const host=el('div'); main.appendChild(host);
  const pager=el('div'); pager.style.cssText='display:flex;gap:10px;align-items:center;margin-top:12px;color:var(--muted);font-size:13px'; main.appendChild(pager);
  async function refresh(){
    host.innerHTML='<div class="skel" style="height:280px"></div>';
    let resp; try{ resp=await ops('list',{entity:cfg.entity,params:{status,q,limit,offset}}); }catch(e){ host.innerHTML=`<div class="card">Could not load: ${escapeH(e.message)}</div>`; return; }
    host.innerHTML=''; host.appendChild(opTable(resp,{ onRow:cfg.onRow, actions:cfg.actions, onAct:cfg.onAct, bulk:cfg.bulk }));
    const total=resp.total||0, from=total?offset+1:0, toN=Math.min(offset+limit,total);
    pager.innerHTML=''; pager.appendChild(el('span',null,`${from}–${toN} of ${num(total)}`));
    const prev=el('button','btn'); prev.textContent='‹ Prev'; prev.disabled=offset<=0; prev.onclick=()=>{ offset=Math.max(0,offset-limit); refresh(); };
    const next=el('button','btn'); next.textContent='Next ›'; next.disabled=offset+limit>=total; next.onclick=()=>{ offset+=limit; refresh(); };
    pager.appendChild(prev); pager.appendChild(next);
  }
  OPS_REFRESH=refresh;
  if(cfg.aside) $('#aside').innerHTML=cfg.aside;
  refresh();
}

// generic full-record detail drawer for any operational entity
async function openOpsDetail(entity,id,title){
  const dr=$('#drawer'); dr.classList.add('on'); $('#drwtitle').textContent=title||(cap(entity)+' record'); const body=$('#drwbody'); body.innerHTML=skeleton();
  let d; try{ d=await ops('detail',{entity,id}); }catch(e){ body.innerHTML='<div class="card">Could not load: '+escapeH(e.message)+'</div>'; return; }
  const rec=(d&&d.record)||{}; body.innerHTML='';
  const head=rec.company_name||rec.full_name||rec.title||rec.subject||rec.file_name||rec.name||rec.invoice_no||rec.po_no||('#'+id);
  $('#drwtitle').textContent=String(head).slice(0,52);
  const fp=[]; const c=el('div','card'); c.appendChild(el('h3',null,'Record'));
  Object.entries(rec).forEach(([k,v])=>{ if(/^(embedding|embedding_gte|raw)$/.test(k))return; if(typeof v==='string'&&/_path$/.test(k)&&v){ fp.push([k,v]); return; } c.appendChild(el('div','row',`<span class="k">${cap(k)}</span><span class="v" style="max-width:62%;text-align:right;word-break:break-word">${/status|stage|severity|risk/.test(k)&&v!=null&&typeof v!=='object'?opBadge(v):opFmt(v)}</span>`)); });
  body.appendChild(c);
  if(fp.length){ const pc=el('div','card'); pc.appendChild(el('h3',null,'Attached files')); fp.forEach(([k,v])=>{ const r=el('div','row'); r.style.cursor='pointer'; r.innerHTML=`<span class="k">📎 ${cap(k.replace(/_path$/,''))}</span><span class="v muted small">open ↗</span>`; r.onclick=()=>openFile(guessBucket(k,entity),v); pc.appendChild(r); }); body.appendChild(pc); }
  const fc=el('div','card'); fc.appendChild(el('h3',null,'Files & Documents')); const hold=el('div','muted small','Loading files…'); fc.appendChild(hold); body.appendChild(fc);
  const fe = entity==='suppliers'?'supplier':(entity==='inquiries'?'rfq':(entity==='customers'?'customer':entity));
  try{ const files=await ops('files',{entity:fe,id})||[]; if(!files.length) hold.innerHTML='<div class="muted small">No files on record.</div>'; else { hold.innerHTML=''; files.forEach(f=>{ const r=el('div','row'); r.style.cursor='pointer'; r.innerHTML=`<span class="k">📎 ${escapeH(f.type||f.name||'File')}</span><span class="v muted small">${escapeH(f.name||'open')} ↗</span>`; r.onclick=()=>openFile(f.bucket,f.path); hold.appendChild(r); }); } }catch(_e){ hold.innerHTML='<div class="muted small">No files.</div>'; }
}
function guessBucket(k,entity){ if(/drawing/.test(k))return 'inquiry-drawings'; if(/quote|original/.test(k))return 'quotes'; if(entity==='invoices')return 'reveal-invoices'; if(/signed_terms/.test(k))return 'legal'; return 'supplier-docs'; }

// Dropbox archive browser (one-click open via temporary links)
async function loadFilesOps(){
  CUR='files'; renderNav();
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  main.innerHTML=''; main.appendChild(el('div','wshead','<h1>Files — Dropbox Archive</h1>'));
  main.appendChild(el('p','wssub','Live mirror of the Dropbox archive — every file synced and checksummed. Click folders to navigate, files to open.'));
  const crumbs=el('div'); crumbs.style.cssText='margin-bottom:10px;font-size:13px'; main.appendChild(crumbs);
  const host=el('div'); main.appendChild(host);
  async function go(p){ host.innerHTML='<div class="skel" style="height:220px"></div>'; let d; try{ d=await ops('dropbox',{prefix:p}); }catch(e){ host.innerHTML='<div class="card">Could not load: '+escapeH(e.message)+'</div>'; return; }
    const items=(d&&d.items)||[];
    crumbs.innerHTML=''; const root=el('span'); root.textContent='📦 Archive'; root.style.cssText='cursor:pointer;color:var(--brand-2);font-weight:700'; root.onclick=()=>go(''); crumbs.appendChild(root);
    let acc=''; p.split('/').filter(Boolean).forEach(seg=>{ acc+='/'+seg; const t=acc; const a=el('span'); a.textContent=' / '+seg; a.style.cssText='cursor:pointer;color:var(--brand-2)'; a.onclick=()=>go(t); crumbs.appendChild(a); });
    const card=el('div','card'); card.style.padding='0';
    if(!items.length) card.innerHTML='<div class="muted small" style="padding:16px">Empty folder.</div>';
    items.forEach(it=>{ const r=el('div','row'); r.style.cssText='cursor:pointer;padding:11px 16px'; r.innerHTML=`<span class="k">${it.is_folder?'📁':'📄'} ${escapeH(it.name)}</span><span class="v muted small">${it.is_folder?'folder':((it.size||0)>0?(Math.round(it.size/1024).toLocaleString()+' KB'):'')}${it.server_modified?(' · '+fmtDate(it.server_modified)):''}</span>`;
      r.onclick=()=>{ if(it.is_folder) go(it.path); else openDropboxFile(it.path); }; card.appendChild(r); });
    host.innerHTML=''; host.appendChild(card);
  }
  go('');
  $('#aside').innerHTML='<div class="asideh">Dropbox sync</div><div class="muted small">Files are archived to Dropbox with checksums and structured paths (customers, suppliers, RFQs, invoices, brand kit). Opening a file mints a temporary Dropbox link.</div>';
}
async function openDropboxFile(path){ toast('Opening…'); try{ const d=await ops('dropbox_link',{path}); if(d&&d.url){ window.open(d.url,'_blank','noopener'); return; } }catch(e){ toast('Could not open: '+e.message); return; } toast('File unavailable'); }

// ---- 360 action bars (wrap existing rich detail views) ----
async function supAct(id,op){ let note=''; if(op==='reject'||op==='ban') note=prompt(cap(op)+' reason (optional):')||''; if(!confirm(cap(op)+' this supplier?'))return; try{ await ops('supplier_decide',{id:Number(id),op,note}); toast('Supplier '+op+(op.endsWith('e')?'d':'ned')); openSupplier360(id);}catch(e){ toast('Failed: '+e.message); } }
const _openSupplier360 = openSupplier360;
openSupplier360 = async function(id){ await _openSupplier360(id); try{ const a=$('#aside'); a.appendChild(el('div','asideh','Decisions')); const bar=el('div','qa'); bar.append(actBtn('✅  Approve supplier',()=>supAct(id,'approve')), actBtn('⛔  Reject',()=>supAct(id,'reject')), actBtn('🚫  Ban from marketplace',()=>supAct(id,'ban')), actBtn('↩  Unban / unblock',()=>supAct(id,'unban'))); a.appendChild(bar); }catch(_e){} };

async function cusAct(id,op){ let note=''; if(op==='ban') note=prompt('Ban reason (optional):')||''; if(!confirm(cap(op)+' this customer?'))return; try{ await ops('customer_decide',{id:String(id),op,note}); toast('Customer '+op+'ned'); openCustomer360(id);}catch(e){ toast('Failed: '+e.message); } }
const _openCustomer360 = openCustomer360;
openCustomer360 = async function(id){ await _openCustomer360(id); try{ const a=$('#aside'); a.appendChild(el('div','asideh','Decisions')); const bar=el('div','qa'); bar.append(actBtn('🚫  Ban customer',()=>cusAct(id,'ban')), actBtn('↩  Unban',()=>cusAct(id,'unban'))); a.appendChild(bar); }catch(_e){} };

async function rfqCancel(id){ const reason=prompt('Cancellation reason (optional):')||''; if(!confirm('Cancel this RFQ?'))return; try{ const d=await ops('detail',{entity:'inquiries',id}); const cust=d&&d.record&&d.record.customer_id; await ops('cancel_inquiry',{inquiry:String(id),customer:String(cust||''),reason}); toast('RFQ cancelled'); openRfq360(id);}catch(e){ toast('Failed: '+e.message); } }
const _openRfq360 = openRfq360;
openRfq360 = async function(id){ await _openRfq360(id); try{ const a=$('#aside'); a.appendChild(el('div','asideh','Decisions')); const bar=el('div','qa'); bar.append(actBtn('✖  Cancel RFQ',()=>rfqCancel(id))); a.appendChild(bar); }catch(_e){} };

// ---- upgrade the generic renderer: arrays-of-objects -> real sortable tables ----
renderGeneric = function(main,d){
  if(d==null){ main.appendChild(el('div','card','No data.')); return; }
  const scalars=[], objs=[], arrs=[];
  Object.entries(d).forEach(([k,v])=>{ if(v==null)return; if(Array.isArray(v))arrs.push([k,v]); else if(typeof v==='object')objs.push([k,v]); else scalars.push([k,v]); });
  if(scalars.length){ const g=el('div','grid kpis'); scalars.forEach(([k,v])=>g.appendChild(kpi(cap(k),typeof v==='number'?num(v):String(v),''))); main.appendChild(g); }
  if(objs.length){ const g=el('div','grid cards2'); objs.forEach(([k,v])=>{ const rows=Object.entries(v).filter(([,x])=>x==null||typeof x!=='object').map(([kk,vv])=>[cap(kk),typeof vv==='number'?num(vv):String(vv==null?'—':vv)]); g.appendChild(statCard(cap(k),rows.length?rows:[['items',Object.keys(v).length]])); }); main.appendChild(g); }
  arrs.forEach(([k,v])=>{
    if(!v.length){ const c=el('div','card'); c.appendChild(el('h3',null,`${cap(k)} <span class="tag">0</span>`)); c.appendChild(el('div','muted small','None.')); main.appendChild(c); return; }
    if(typeof v[0]==='object' && v[0]!==null){
      const cols=Array.from(v.reduce((s,r)=>{Object.keys(r||{}).forEach(x=>{ if(!/^(embedding|raw|spec)$/.test(x)) s.add(x); });return s;},new Set())).slice(0,9);
      const hd=el('div'); hd.style.cssText='display:flex;align-items:center;margin:6px 0 8px'; hd.innerHTML=`<h3 style="margin:0">${cap(k)}</h3><span class="tag" style="margin-left:8px">${v.length}</span>`; main.appendChild(hd);
      main.appendChild(opTable({columns:cols,rows:v,id_col:'id'},{ onRow:(row)=>{ if(row.id!=null) openRecord(guessEntity(k),row.id); } }));
    } else {
      const c=el('div','card'); c.appendChild(el('h3',null,`${cap(k)} <span class="tag">${v.length}</span>`)); v.slice(0,40).forEach(x=>c.appendChild(el('div','row',`<span class="k">${escapeH(String(x))}</span>`))); main.appendChild(c);
    }
  });
};

// ---- operational module configs ----
const SUP_TABS=[{label:'All',v:null},{label:'Needs review',v:'pending_review'},{label:'Submitted',v:'submitted'},{label:'Approved',v:'approved'},{label:'Rejected',v:'rejected'}];
const OPS_CFG={
  suppliers:{ entity:'suppliers', title:'Suppliers', sub:'20k+ suppliers — filter, search, open a full 360, and approve / reject / ban inline.', tabs:SUP_TABS,
    onRow:(r)=>openSupplier360(r.id),
    bulk:[
      {label:'Approve', run:(r)=>ops('supplier_decide',{op:'approve',id:r.id})},
      {label:'Reject', run:(r)=>ops('supplier_decide',{op:'reject',id:r.id})},
      {label:'Ban', run:(r)=>ops('supplier_decide',{op:'ban',id:r.id})},
    ],
    actions:(r)=>`<button class="btn" data-act="approve">Approve</button> <button class="btn" data-act="reject">Reject</button> <button class="btn" data-act="ban">Ban</button>`,
    onAct:async(op,r,btn)=>{ let note=''; if(op==='reject'||op==='ban') note=prompt(cap(op)+' reason (optional):')||''; if(!confirm(cap(op)+' '+(r.company_name||('#'+r.id))+'?'))return; btn.disabled=true; try{ await ops('supplier_decide',{id:Number(r.id),op,note}); toast('Done'); OPS_REFRESH&&OPS_REFRESH(); }catch(e){ toast('Failed: '+e.message); btn.disabled=false; } } },
  customers:{ entity:'customers', title:'Customers', sub:'Every customer — open the full command center, ban / unban inline.',
    onRow:(r)=>openCustomer360(r.id),
    bulk:[
      {label:'Ban', run:(r)=>ops('customer_decide',{op:'ban',id:String(r.id)})},
      {label:'Unban', run:(r)=>ops('customer_decide',{op:'unban',id:String(r.id)})},
    ],
    actions:(r)=>r.banned?`<button class="btn" data-act="unban">Unban</button>`:`<button class="btn" data-act="ban">Ban</button>`,
    onAct:async(op,r,btn)=>{ let note=''; if(op==='ban') note=prompt('Ban reason:')||''; btn.disabled=true; try{ await ops('customer_decide',{id:String(r.id),op,note}); toast('Done'); OPS_REFRESH&&OPS_REFRESH(); }catch(e){ toast('Failed: '+e.message); btn.disabled=false; } } },
  marketplace:{ entity:'inquiries', title:'RFQs & Procurement', sub:'Every request — open the procurement workspace, open drawings & quotes, cancel inline.',
    onRow:(r)=>openRfq360(r.id),
    actions:(r)=>`<button class="btn" data-act="cancel">Cancel</button>`,
    onAct:async(op,r,btn)=>{ const reason=prompt('Cancel reason (optional):')||''; if(!confirm('Cancel this RFQ?'))return; btn.disabled=true; try{ await ops('cancel_inquiry',{inquiry:String(r.id),customer:String(r.customer_id||''),reason}); toast('Cancelled'); OPS_REFRESH&&OPS_REFRESH(); }catch(e){ toast('Failed: '+e.message); btn.disabled=false; } } },
  approvals:{ entity:'agent_actions', title:'Approvals', sub:'Agent-recommended actions awaiting your decision. Approve or reject — the decision is logged.', tabs:[{label:'Pending',v:'pending'},{label:'Approved',v:'approved'},{label:'Rejected',v:'rejected'},{label:'All',v:null}],
    onRow:(r)=>openOpsDetail('agent_actions',r.id,'Action — '+(r.title||r.kind)),
    actions:(r)=> (r.status==='pending'?`<button class="btn" data-act="approve">Approve</button> <button class="btn" data-act="reject">Reject</button> `:'')+`<button class="btn" data-act="edit">Edit</button>`,
    onAct:async(op,r,btn)=>{ if(op==='edit'){ editContent('agent_issue',r.id,[{key:'title',label:'Title',type:'text'},{key:'recommendation',label:'Recommendation',type:'textarea',rows:6},{key:'status',label:'Status (pending / approved / rejected)',type:'text'},{key:'escalation_reason',label:'Escalation reason',type:'textarea',rows:3}],()=>{ OPS_REFRESH&&OPS_REFRESH(); }); return; } if(!confirm(cap(op)+' this action?'))return; btn.disabled=true; try{ await ops('action_decide',{id:Number(r.id),op}); toast(cap(op)+'d'); OPS_REFRESH&&OPS_REFRESH(); }catch(e){ toast('Failed: '+e.message); btn.disabled=false; } } },
  docreviews:{ entity:'doc_reviews', title:'Document Reviews', sub:'Documents received by agent email — review the extraction, open the file, approve or reject.', tabs:[{label:'Pending',v:'pending'},{label:'Approved',v:'approved'},{label:'Rejected',v:'rejected'},{label:'All',v:null}],
    onRow:(r)=>openOpsDetail('doc_reviews',r.id,r.subject||'Document'),
    actions:(r)=>`<button class="btn" data-act="open">Open</button> ${r.status==='pending'?'<button class="btn" data-act="approve">Approve</button> <button class="btn" data-act="reject">Reject</button>':''}`,
    onAct:async(op,r,btn)=>{ if(op==='open'){ if(r.file_path) openFile('doc-reviews',r.file_path); else toast('No file'); return; } btn.disabled=true; try{ await ops('doc_review_decide',{id:Number(r.id),op}); toast(cap(op)+'d'); OPS_REFRESH&&OPS_REFRESH(); }catch(e){ toast('Failed: '+e.message); btn.disabled=false; } } },
  knowledge:{ entity:'kb_revisions', title:'Knowledge Base', sub:'Knowledge revisions — review the content, approve to publish or reject.', tabs:[{label:'Pending',v:'pending'},{label:'Approved',v:'approved'},{label:'Rejected',v:'rejected'},{label:'All',v:null}],
    onRow:(r)=>openOpsDetail('kb_revisions',r.id,r.entry_ref||'Knowledge'),
    actions:(r)=> r.status==='pending'?`<button class="btn" data-act="approve">Approve &amp; publish</button> <button class="btn" data-act="reject">Reject</button>`:'',
    onAct:async(op,r,btn)=>{ if(!confirm(cap(op)+' this revision?'))return; btn.disabled=true; try{ await ops(op==='approve'?'kb_approve':'kb_reject',{revision:Number(r.id)}); toast(cap(op)+'d'); OPS_REFRESH&&OPS_REFRESH(); }catch(e){ toast('Failed: '+e.message); btn.disabled=false; } } },
  documents:{ entity:'documents', title:'Documents', sub:'Every stored document across the platform — open any file.', tabs:[{label:'All',v:null},{label:'Indexed',v:'indexed'},{label:'Pending',v:'pending'},{label:'Error',v:'error'}],
    onRow:(r)=>openOpsDetail('documents',r.id,r.file_name||'Document'),
    actions:(r)=>`<button class="btn" data-act="open">Open</button>`,
    onAct:async(op,r)=>{ if(r.bucket&&r.path) openFile(r.bucket,r.path); else toast('No file'); } },
  quotes:{ entity:'quotes', title:'Quotes', sub:'Every quotation — open to compare, view the original file.', tabs:[{label:'All',v:null},{label:'Submitted',v:'submitted'},{label:'Committed',v:'committed'},{label:'Draft',v:'draft'}], onRow:(r)=>openOpsDetail('quotes',r.id,'Quote #'+r.id), actions:(r)=> r.original_file_path?`<button class="btn" data-act="open">Original</button>`:'', onAct:async(op,r)=>{ if(r.original_file_path) openFile('quotes',r.original_file_path); } },
  transactions:{ entity:'transactions', title:'Transactions', sub:'Reveals, fees and refunds.', onRow:(r)=>openOpsDetail('transactions',r.id,'Transaction') },
  invoices:{ entity:'invoices', title:'Reveal Invoices', sub:'Every reveal invoice PDF — click to open.', onRow:(r)=>openFile(r.bucket||'reveal-invoices',r.path), actions:(r)=>`<button class="btn" data-act="open">Open PDF</button>`, onAct:async(op,r)=>{ if(r.path) openFile(r.bucket||'reveal-invoices',r.path); } },
  notifications:{ entity:'notifications', title:'Notifications', sub:'Email/SMS notifications and their delivery status.', tabs:[{label:'All',v:null},{label:'Sent',v:'sent'},{label:'Failed',v:'failed'},{label:'Queued',v:'queued'}], onRow:(r)=>openOpsDetail('notifications',r.id,r.subject||'Notification') },
  tasks:{ entity:'tasks', title:'Tasks', sub:'Operational tasks across the platform.', tabs:[{label:'Open',v:null},{label:'Done',v:'done'}], onRow:(r)=>openOpsDetail('tasks',r.id,r.title||'Task') },
  po:{ entity:'po', title:'Purchase Orders', sub:'Approve purchase orders.', tabs:[{label:'All',v:null},{label:'Pending',v:'pending'},{label:'Approved',v:'approved'}], onRow:(r)=>openOpsDetail('po',r.id,r.po_no||'PO'), actions:(r)=> r.status!=='approved'?`<button class="btn" data-act="approve">Approve</button>`:'', onAct:async(op,r,btn)=>{ btn.disabled=true; try{ await ops('po_approve',{po:Number(r.id)}); toast('Approved'); OPS_REFRESH&&OPS_REFRESH(); }catch(e){ toast('Failed: '+e.message); btn.disabled=false; } } },
  expenses:{ entity:'expenses', title:'Expenses', sub:'All recorded expenses.', onRow:(r)=>openOpsDetail('expenses',r.id,r.vendor||'Expense') },
  agent_runs:{ entity:'agent_runs', title:'Agent Runs', sub:'Execution history of every agent.', tabs:[{label:'All',v:null},{label:'OK',v:'ok'},{label:'Error',v:'error'}], onRow:(r)=>openOpsDetail('agent_runs',r.id,r.agent||'Run') },
};

