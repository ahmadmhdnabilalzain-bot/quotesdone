const _openModule2 = openModule;
openModule = function(m){
  if(m.kind==='files') return loadFilesOps();
  if(m.kind==='ops' && OPS_CFG[m.id]) return loadListModule({id:m.id, ...OPS_CFG[m.id]});
  if(m.kind==='audit') return loadAudit();
  if(m.kind==='content') return loadContent();
  return _openModule2(m);
};
async function loadAudit(){
  CUR='audit'; renderNav();
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let d; try{ d=await ops('audit_log',{limit:400}); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  main.innerHTML='';
  main.appendChild(el('div','wshead','<h1>Audit log</h1>'));
  main.appendChild(el('p','wssub','Every action taken in the OS — who did what, when. Newest first · sortable · exportable.'));
  main.appendChild(opTable(d||{columns:[],rows:[]},{}));
}
async function pages(action, body){
  const ctl=new AbortController(); const to=setTimeout(()=>ctl.abort(),90000);
  let r; try{ r=await fetch(FN+'/os_pages',{method:'POST',signal:ctl.signal,headers:{'Content-Type':'application/json',...(window.OS_AUTH||{})},body:JSON.stringify({action,...(body||{})})}); } finally{ clearTimeout(to); }
  const j=await r.json().catch(()=>({}));
  if(!r.ok||j.error) throw new Error(j.error||('os_pages '+r.status));
  return j.data;
}
async function pageEdit(source,slug,locale){
  let d; try{ d=await pages('page_get',{source,slug,locale}); }catch(e){ toast('Load failed: '+((e&&e.message)||e)); return; }
  openEditModal('Edit — '+slug+' ('+String(locale).toUpperCase()+')', [{key:'title',label:'Title',type:'text',value:d.title},{key:'html',label:'Page HTML',type:'textarea',rows:20,value:d.html}], async(values)=>{ await pages('page_save',{source,slug,locale,title:values.title,html:values.html}); toast('Saved — click Publish to go live'); });
}
async function loadContent(){
  CUR='content'; renderNav();
  const main=$('#main'); main.innerHTML=skeleton(); $('#aside').innerHTML='';
  let d; try{ d=await pages('pages_list'); }catch(e){ main.innerHTML=`<div class="card">Could not load: ${e.message}</div>`; return; }
  main.innerHTML='';
  main.appendChild(el('div','wshead','<h1>Content & Pages</h1>'));
  main.appendChild(el('p','wssub','Edit legal & marketing page copy (English + Arabic), then publish. Every change is logged.'));
  const bar=el('div'); bar.style.cssText='display:flex;gap:10px;align-items:center;margin:0 0 12px';
  const pub=el('button',null,'🚀 Publish site'); pub.style.cssText='padding:8px 16px;border-radius:8px;border:0;background:var(--rail-active,#12b3a6);color:#fff;font:inherit;font-weight:700;cursor:pointer';
  pub.onclick=async()=>{ if(!confirm('Publish all saved changes to the live site now?'))return; pub.disabled=true; pub.textContent='Publishing…'; try{ await pages('publish'); toast('Publishing started — live in ~1-2 min'); }catch(e){ toast('Publish failed: '+((e&&e.message)||e)); } pub.disabled=false; pub.textContent='🚀 Publish site'; };
  const nsv=el('button',null,'＋ New service page'); nsv.style.cssText='padding:8px 16px;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--ink);font:inherit;font-weight:600;cursor:pointer';
  nsv.onclick=async()=>{ const name=(prompt('New service page name (e.g. Swimming Pool Maintenance) — it will auto-cover the UAE + all 7 emirates:')||'').trim(); if(!name)return; nsv.disabled=true; nsv.textContent='Generating…'; try{ await pages('service_generate',{name}); toast('Generating "'+name+'" (EN + AR) in the background — ~1 min, then click Publish to go live across all emirates.'); }catch(e){ toast('Failed: '+((e&&e.message)||e)); } nsv.disabled=false; nsv.textContent='＋ New service page'; };
  bar.append(pub, nsv, el('span','muted small','Edits save as drafts — Publish to push live.'));
  main.appendChild(bar);
  main.appendChild(opTable(d,{ onRow:(r)=>pageEdit(r.source,r.slug,'en'), actions:(r)=>`<button class="btn" data-act="en">Edit EN</button> <button class="btn" data-act="ar">Edit AR</button> <button class="btn" data-act="tr">🌐 → AR</button>`, onAct:async(op,r,btn)=>{ if(op==='tr'){ if(!confirm('Auto-translate the English version into Arabic? This overwrites the current Arabic page — review it, then Publish.'))return; if(btn){btn.disabled=true;btn.textContent='Translating…';} try{ await pages('translate',{source:r.source,slug:r.slug}); toast('Arabic generated — open Edit AR to review, then Publish'); }catch(e){ toast('Translate failed: '+((e&&e.message)||e)); } if(btn){btn.disabled=false;btn.textContent='🌐 → AR';} return; } pageEdit(r.source,r.slug, op==='ar'?'ar':'en'); } }));
}
renderNav();


// ===================== OPERATIONAL LAYER v2 (depth) =====================
async function addNotePrompt(entity,id,after){ const t=prompt('Add a note:'); if(!t)return; try{ await ops('note_add',{entity,id:String(id),body:t}); toast('Note added'); if(after)after(); }catch(e){ toast('Failed: '+e.message); } }
async function createTaskPrompt(entity,id){ const t=prompt('New task — title:'); if(!t)return; const due=prompt('Due date (YYYY-MM-DD, optional):')||null; try{ await ops('task_create',{title:t,entity:entity||null,entity_id:id?String(id):null,due_date:due}); toast('Task created'); }catch(e){ toast('Failed: '+e.message); } }
async function rfqStagePrompt(id){ let stages; try{ stages=await ops('stages_list'); }catch(_e){ stages=[]; } const opts=(stages||[]).map(s=>s.key+(s.label?(' ('+s.label+')'):'')).join(', '); const st=prompt('Move to pipeline stage.\nOptions: '+opts); if(!st)return; try{ await ops('rfq_stage',{inquiry:String(id),stage:st.trim()}); toast('Stage → '+st.trim()); }catch(e){ toast('Failed: '+e.message); } }
async function rfqOutcome(id,outcome){ let lr=null; if(outcome==='lost') lr=prompt('Lost reason (optional):')||null; if(!confirm('Mark this RFQ as '+outcome+'?'))return; try{ await ops('rfq_outcome',{inquiry:String(id),outcome,lost_reason:lr}); toast('Outcome: '+outcome); }catch(e){ toast('Failed: '+e.message); } }

// related-records + notes appended to every operational detail
async function appendRelated(body, entity, id){
  const rels=[];
  if(entity==='inquiries'){ rels.push(['quotes','Quotes on this RFQ',{inquiry_id:id}],['transactions','Transactions',{inquiry_id:id}]); }
  else if(entity==='suppliers'){ rels.push(['quotes','Recent quotes',{supplier_id:id}],['transactions','Deals / reveals',{supplier_id:id}]); }
  else if(entity==='customers'){ rels.push(['inquiries','RFQs',{customer_id:id}],['transactions','Transactions',{customer_id:id}]); }
  else if(entity==='quotes'){ rels.push(['transactions','Transaction',{quote_id:id}]); }
  for(const it of rels){ const ent=it[0], label=it[1], filt=it[2];
    let d; try{ d=await ops('list',{entity:ent,params:{filters:filt,limit:20}}); }catch(_e){ continue; }
    const rows=(d&&d.rows)||[]; const hd=el('div'); hd.style.cssText='display:flex;align-items:center;margin:12px 0 6px'; hd.innerHTML=`<h3 style="margin:0">${label}</h3><span class="tag" style="margin-left:8px">${d.total||rows.length}</span>`; body.appendChild(hd);
    if(!rows.length){ body.appendChild(el('div','muted small','None.')); continue; }
    body.appendChild(opTable(d,{ onRow:(row)=>openOpsDetail(ent, row[d.id_col]||row.id) }));
  }
}
async function appendNotes(body, entity, id, title){
  let d; try{ d=await ops('list',{entity:'notes',params:{filters:{entity,entity_id:String(id)},limit:50}}); }catch(_e){ return; }
  const rows=(d&&d.rows)||[]; const c=el('div','card'); c.appendChild(el('h3',null,`Notes <span class="tag">${rows.length}</span>`));
  const add=el('div'); add.style.cssText='display:flex;gap:6px;margin-bottom:10px';
  const inp=document.createElement('input'); inp.placeholder='Add a note…'; inp.style.cssText='flex:1;border:1px solid var(--line);border-radius:8px;padding:8px 10px;font:inherit;background:var(--panel);color:var(--ink)';
  const bt=el('button','btn'); bt.textContent='Add'; bt.onclick=async()=>{ if(!inp.value.trim())return; try{ await ops('note_add',{entity,id:String(id),body:inp.value.trim()}); inp.value=''; openOpsDetail(entity,id,title); }catch(e){ toast('Failed: '+e.message); } };
  inp.onkeydown=(e)=>{ if(e.key==='Enter') bt.onclick(); };
  add.append(inp,bt); c.appendChild(add);
  if(!rows.length) c.appendChild(el('div','muted small','No notes yet.'));
  rows.forEach(n=>c.appendChild(el('div','row',`<span class="k" style="max-width:66%;white-space:normal">${escapeH(n.body||'')}</span><span class="v muted small">${escapeH(n.author||'')} · ${fmtDate(n.created_at)}</span>`)));
  body.appendChild(c);
}

const _openOpsDetail = openOpsDetail;
openOpsDetail = async function(entity,id,title){
  await _openOpsDetail(entity,id,title);
  const body=$('#drwbody');
  try{ const qa=el('div','card'); qa.appendChild(el('h3',null,'Actions')); const row=el('div','qa'); row.append(actBtn('📝  Add note',()=>addNotePrompt(entity,id,()=>openOpsDetail(entity,id,title))), actBtn('☑  Create task',()=>createTaskPrompt(entity,id))); qa.appendChild(row); body.appendChild(qa); }catch(_e){}
  try{ await appendRelated(body, entity, id); }catch(_e){}
  try{ await appendNotes(body, entity, id, title); }catch(_e){}
};

// RFQ 360: add pipeline controls (stacks on top of the Decisions bar from v1)
const _openRfq360b = openRfq360;
openRfq360 = async function(id){ await _openRfq360b(id); try{ const a=$('#aside'); a.appendChild(el('div','asideh','Pipeline')); const bar=el('div','qa'); bar.append(actBtn('↗  Change stage',()=>rfqStagePrompt(id).then(()=>openRfq360(id))), actBtn('🏆  Mark won',()=>rfqOutcome(id,'completed').then(()=>openRfq360(id))), actBtn('✖  Mark lost',()=>rfqOutcome(id,'lost').then(()=>openRfq360(id))), actBtn('📝  Add note',()=>addNotePrompt('inquiries',id))); a.appendChild(bar); }catch(_e){} };
// supplier / customer 360: quick note
const _openSupplier360b = openSupplier360;
openSupplier360 = async function(id){ await _openSupplier360b(id); try{ const a=$('#aside'); const bar=el('div','qa'); bar.append(actBtn('📝  Add note',()=>addNotePrompt('suppliers',id))); a.appendChild(bar); }catch(_e){} };
const _openCustomer360b = openCustomer360;
openCustomer360 = async function(id){ await _openCustomer360b(id); try{ const a=$('#aside'); const bar=el('div','qa'); bar.append(actBtn('📝  Add note',()=>addNotePrompt('customers',id))); a.appendChild(bar); }catch(_e){} };

// upgrade RFQ table with pipeline + cancel actions
OPS_CFG.marketplace.actions=(r)=>`<button class="btn" data-act="stage">Stage</button> <button class="btn" data-act="won">Won</button> <button class="btn" data-act="lost">Lost</button> <button class="btn" data-act="cancel">Cancel</button>`;
OPS_CFG.marketplace.onAct=async(op,r,btn)=>{ try{ if(op==='cancel'){ const reason=prompt('Cancellation reason (optional):')||''; if(!confirm('Cancel this RFQ?'))return; await ops('cancel_inquiry',{inquiry:String(r.id),customer:String(r.customer_id||''),reason}); } else if(op==='stage'){ await rfqStagePrompt(r.id); } else if(op==='won'){ if(!confirm('Mark won?'))return; await ops('rfq_outcome',{inquiry:String(r.id),outcome:'completed'}); } else if(op==='lost'){ const lr=prompt('Lost reason (optional):')||null; await ops('rfq_outcome',{inquiry:String(r.id),outcome:'lost',lost_reason:lr}); } toast('Done'); OPS_REFRESH&&OPS_REFRESH(); }catch(e){ toast('Failed: '+e.message); } };

// transactions table: inline refund resolution (uses os_api refund_resolve)
OPS_CFG.transactions.actions=(r)=> (/request|pending/i.test(String(r.refund_status||'')))?`<button class="btn" data-act="rap">Approve refund</button> <button class="btn" data-act="rrj">Reject</button>`:'';
OPS_CFG.transactions.onAct=async(op,r,btn)=>{ const dec=op==='rap'?'approve':'reject'; let note=''; if(dec==='reject') note=prompt('Reject reason (optional):')||''; if(!confirm(cap(dec)+' refund for transaction '+r.id+'?'))return; btn.disabled=true; try{ await api('refund_resolve',{transaction_id:r.id,op:dec,note}); toast('Refund '+dec+(dec==='approve'?'d':'ed')); OPS_REFRESH&&OPS_REFRESH(); }catch(e){ toast('Failed: '+e.message); btn.disabled=false; } };

// top-bar: quick "＋ New task"
try{ const top=$('.top'); const themeb=$('#themebtn'); if(top&&themeb){ const nb=el('button','iconbtn'); nb.textContent='＋'; nb.title='New task'; nb.onclick=()=>createTaskPrompt(null,null); top.insertBefore(nb, themeb); } }catch(_e){}

// top-bar: auto-refresh toggle (opt-in; re-runs the current module every 30s, skips detail views + hidden tab)
let AUTO_ON=false, AUTO_TIMER=null;
function autoTick(){ try{ if(!AUTO_ON || document.hidden) return; if(document.querySelector('.iconbtn[id^="back"]')) return; navTo(CUR); }catch(_e){} }
function setAuto(on){ AUTO_ON=!!on; try{localStorage.setItem('os_auto',AUTO_ON?'1':'0')}catch(_e){} if(AUTO_TIMER){clearInterval(AUTO_TIMER);AUTO_TIMER=null;} if(AUTO_ON) AUTO_TIMER=setInterval(autoTick,30000); const btn=$('#autobtn'); if(btn){ btn.style.color=AUTO_ON?'var(--rail-active,#12b3a6)':''; btn.title=AUTO_ON?'Auto-refresh: ON (every 30s)':'Auto-refresh: OFF'; } }
try{ const top=$('.top'); const themeb=$('#themebtn'); if(top&&themeb){ const ab=el('button','iconbtn'); ab.id='autobtn'; ab.textContent='🔄'; ab.title='Auto-refresh: OFF'; ab.onclick=()=>setAuto(!AUTO_ON); top.insertBefore(ab, themeb); let init=false; try{init=localStorage.getItem('os_auto')==='1'}catch(_e){} setAuto(init); } }catch(_e){}
try{ document.addEventListener('visibilitychange',()=>{ if(AUTO_ON && !document.hidden) autoTick(); }); }catch(_e){}


// ===================== OPERATIONAL LAYER v3 (bulk + export) =====================
function exportCSV(cols, rows, name){
  const q=v=>{ if(v==null)return ''; const s=typeof v==='object'?JSON.stringify(v):String(v); return '"'+s.replace(/"/g,'""')+'"'; };
  const csv=[cols.join(',')].concat(rows.map(r=>cols.map(c=>q(r[c])).join(','))).join('\r\n');
  const blob=new Blob([csv],{type:'text/csv;charset=utf-8'});
  const a=document.createElement('a'); a.href=window.URL.createObjectURL(blob); a.download=(name||'export')+'-'+new Date().toISOString().slice(0,10)+'.csv'; document.body.appendChild(a); a.click(); a.remove();
}
// full rewrite of opTable: toolbar (CSV + bulk), optional multi-select, sortable, clickable rows, inline actions
opTable = function(resp, opts){
  opts=opts||{}; const cols=(resp.columns||[]).filter(c=>!/^(embedding|embedding_gte|raw|spec|boq|extracted)$/.test(c));
  let rows=(resp.rows||[]).slice(); let sortK=null, sortDir=1; const idc=resp.id_col||'id'; const sel=new Set(); const canBulk=Array.isArray(opts.bulk)&&opts.bulk.length;
  const wrap=el('div','card'); wrap.style.padding='0';
  const toolbar=el('div'); toolbar.style.cssText='display:flex;align-items:center;gap:8px;padding:8px 12px;border-bottom:1px solid var(--line);flex-wrap:wrap';
  const info=el('span','muted small'); toolbar.appendChild(info);
  const bulkBar=el('span'); bulkBar.style.cssText='display:flex;gap:6px;flex-wrap:wrap'; toolbar.appendChild(bulkBar);
  const spacer=el('div'); spacer.style.flex='1'; toolbar.appendChild(spacer);
  const csvBtn=el('button','btn'); csvBtn.textContent='⬇ Export CSV'; csvBtn.onclick=()=>exportCSV(cols,rows,resp.entity||'export'); toolbar.appendChild(csvBtn);
  wrap.appendChild(toolbar);
  const scroller=el('div'); scroller.style.cssText='overflow-x:auto';
  const tbl=document.createElement('table'); tbl.style.cssText='width:100%;border-collapse:collapse;font-size:12.5px'; scroller.appendChild(tbl); wrap.appendChild(scroller);
  function cell(c,row){ const v=row[c]; if(/status|stage|fee_status|refund_status|approval_status|verification_status|severity|risk/.test(c)&&v!=null&&typeof v!=='object') return opBadge(v); return opFmt(v); }
  function updateBulk(){
    info.textContent = canBulk&&sel.size ? (sel.size+' selected') : (num(resp.total||rows.length)+' rows');
    bulkBar.innerHTML='';
    if(canBulk&&sel.size){ opts.bulk.forEach(bk=>{ const b=el('button','btn'); b.style.cssText='background:var(--rail);color:#fff'; b.textContent=bk.label+' ('+sel.size+')';
      b.onclick=async()=>{ if(!confirm(bk.label+' '+sel.size+' selected item(s)?'))return; b.disabled=true; let ok=0; for(const rid of Array.from(sel)){ const row=rows.find(r=>String(r[idc])===String(rid)); if(row){ try{ await bk.run(row); ok++; }catch(_e){} } } toast(bk.label+': '+ok+' done'); OPS_REFRESH&&OPS_REFRESH(); }; bulkBar.appendChild(b); }); }
  }
  function draw(){
    let r2=rows.slice();
    if(sortK) r2.sort((a,b)=>{ let x=a[sortK],y=b[sortK]; if(x==null)return 1; if(y==null)return -1; if(typeof x==='number'&&typeof y==='number')return (x-y)*sortDir; return String(x).localeCompare(String(y))*sortDir; });
    let h='<thead><tr>';
    if(canBulk) h+='<th style="width:34px;padding:8px 10px;background:var(--chip);border-bottom:1px solid var(--line)"><input type="checkbox" data-all></th>';
    h+=cols.map(c=>`<th data-c="${c}" style="text-align:left;padding:9px 12px;border-bottom:1px solid var(--line);background:var(--chip);cursor:pointer;white-space:nowrap;font-weight:700;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.03em">${cap(c)}${sortK===c?(sortDir>0?' ▲':' ▼'):''}</th>`).join('')+(opts.actions?'<th style="background:var(--chip);border-bottom:1px solid var(--line)"></th>':'')+'</tr></thead><tbody>';
    r2.forEach((row,i)=>{ const rid=String(row[idc]); h+=`<tr data-i="${i}" data-rid="${escapeH(rid)}" style="border-bottom:1px solid var(--line);cursor:pointer">`;
      if(canBulk) h+=`<td style="padding:6px 10px" data-cb><input type="checkbox" data-rowcb ${sel.has(rid)?'checked':''}></td>`;
      h+=cols.map(c=>`<td style="padding:8px 12px;white-space:nowrap;max-width:280px;overflow:hidden;text-overflow:ellipsis">${cell(c,row)}</td>`).join('')+(opts.actions?('<td style="white-space:nowrap;padding:6px 10px;text-align:right">'+opts.actions(row)+'</td>'):'')+'</tr>'; });
    h+='</tbody>'; tbl.innerHTML=h;
    tbl.querySelectorAll('th[data-c]').forEach(th=>th.onclick=()=>{ const c=th.dataset.c; if(sortK===c)sortDir=-sortDir; else{sortK=c;sortDir=1;} draw(); });
    const allcb=tbl.querySelector('[data-all]'); if(allcb) allcb.onclick=(e)=>{ e.stopPropagation(); if(allcb.checked) r2.forEach(row=>sel.add(String(row[idc]))); else sel.clear(); draw(); updateBulk(); };
    tbl.querySelectorAll('[data-rowcb]').forEach(cb=>cb.onclick=(e)=>{ e.stopPropagation(); const rid=cb.closest('tr').dataset.rid; if(cb.checked)sel.add(rid); else sel.delete(rid); updateBulk(); });
    tbl.querySelectorAll('td[data-cb]').forEach(td=>td.onclick=(e)=>{ e.stopPropagation(); });
    tbl.querySelectorAll('tbody tr').forEach(tr=>{ const row=r2[Number(tr.dataset.i)];
      tr.onclick=(e)=>{ if(e.target.closest('[data-act]')||e.target.closest('[data-cb]'))return; if(opts.onRow) opts.onRow(row); };
      tr.onmouseover=()=>tr.style.background='var(--chip)'; tr.onmouseout=()=>tr.style.background=''; });
    if(opts.actions) tbl.querySelectorAll('[data-act]').forEach(btn=>{ btn.onclick=async(e)=>{ e.stopPropagation(); const row=r2[Number(btn.closest('tr').dataset.i)]; await opts.onAct(btn.dataset.act,row,btn); }; });
  }
  draw(); updateBulk();
  return wrap;
};

// bulk configs for the queues (no per-row prompts — direct calls)
OPS_CFG.approvals.bulk=[{label:'Approve',run:r=>ops('action_decide',{id:Number(r.id),op:'approve'})},{label:'Reject',run:r=>ops('action_decide',{id:Number(r.id),op:'reject'})}];
OPS_CFG.suppliers.bulk=[{label:'Approve',run:r=>ops('supplier_decide',{id:Number(r.id),op:'approve'})},{label:'Reject',run:r=>ops('supplier_decide',{id:Number(r.id),op:'reject'})}];
OPS_CFG.customers.bulk=[{label:'Ban',run:r=>ops('customer_decide',{id:String(r.id),op:'ban'})},{label:'Unban',run:r=>ops('customer_decide',{id:String(r.id),op:'unban'})}];
OPS_CFG.docreviews.bulk=[{label:'Approve',run:r=>ops('doc_review_decide',{id:Number(r.id),op:'approve'})},{label:'Reject',run:r=>ops('doc_review_decide',{id:Number(r.id),op:'reject'})}];
OPS_CFG.knowledge.bulk=[{label:'Approve',run:r=>ops('kb_approve',{revision:Number(r.id)})},{label:'Reject',run:r=>ops('kb_reject',{revision:Number(r.id)})}];
OPS_CFG.tasks.bulk=[{label:'Mark done',run:r=>ops('task_done',{id:Number(r.id),op:'done'})}];
OPS_CFG.po.bulk=[{label:'Approve',run:r=>ops('po_approve',{po:Number(r.id)})}];


// ===================== OPERATIONAL LAYER v4 (inline editing) =====================
const EDIT_FIELDS={
  inquiries:[['deal_owner','Deal owner','text'],['expected_value','Expected value','num'],['pipeline_stage','Pipeline stage','text'],['lost_reason','Lost reason','text']],
  suppliers:[['contact_name','Contact name','text'],['notes','Notes','text']],
  tasks:[['priority','Priority','text'],['due_date','Due date','date'],['title','Title','text'],['detail','Detail','text'],['status','Status','text']],
  expenses:[['category','Category','text'],['note','Note','text'],['vendor','Vendor','text'],['amount','Amount','num']],
};
const _openOpsDetail_edit = openOpsDetail;
openOpsDetail = async function(entity,id,title){
  await _openOpsDetail_edit(entity,id,title);
  const flds=EDIT_FIELDS[entity]; if(!flds) return;
  let rec={}; try{ const d=await ops('detail',{entity,id}); rec=(d&&d.record)||{}; }catch(_e){}
  const body=$('#drwbody'); const c=el('div','card'); c.appendChild(el('h3',null,'Edit fields'));
  flds.forEach(function(f){ const key=f[0],label=f[1],type=f[2];
    const row=el('div'); row.style.cssText='display:flex;gap:8px;align-items:center;margin:7px 0';
    const lab=el('span','muted small'); lab.textContent=label; lab.style.cssText='width:120px;flex:none';
    const inp=document.createElement('input'); inp.type=type==='date'?'date':(type==='num'?'number':'text'); inp.value=rec[key]==null?'':String(rec[key]); inp.style.cssText='flex:1;border:1px solid var(--line);border-radius:8px;padding:7px 10px;font:inherit;background:var(--panel);color:var(--ink)';
    const sv=el('button','btn'); sv.textContent='Save'; sv.onclick=async()=>{ sv.disabled=true; try{ await ops('field_set',{entity,id:String(id),field:key,value:inp.value}); toast('Saved: '+label); }catch(e){ toast('Failed: '+e.message);} sv.disabled=false; };
    inp.onkeydown=(e)=>{ if(e.key==='Enter') sv.onclick(); };
    row.append(lab,inp,sv); c.appendChild(row);
  });
  body.appendChild(c);
};
// add "Edit fields" to the rich 360s
const _sup_edit = openSupplier360;
openSupplier360 = async function(id){ await _sup_edit(id); try{ const a=$('#aside'); const bar=el('div','qa'); bar.append(actBtn('✎  Edit supplier fields',()=>openOpsDetail('suppliers',id,'Edit supplier'))); a.appendChild(bar); }catch(_e){} };
const _rfq_edit = openRfq360;
openRfq360 = async function(id){ await _rfq_edit(id); try{ const a=$('#aside'); const bar=el('div','qa'); bar.append(actBtn('✎  Edit RFQ fields',()=>openOpsDetail('inquiries',id,'Edit RFQ'))); a.appendChild(bar); }catch(_e){} };

// ---- wave5: performance & anonymous price-positioning cards ----
(function(){ if(document.getElementById('w5css'))return; const s=document.createElement('style'); s.id='w5css'; s.textContent=
'.pcard{margin-top:16px}'+
'.sgrid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:8px}'+
'.scell{background:var(--panel,#fff);border:1px solid var(--line,#e6e9ee);border-radius:10px;padding:8px 10px;text-align:center}'+
'.scell .sv{font-weight:800;font-size:15px}'+
'.scell .sl{font-size:11px;color:#8a94a0;margin-top:2px}'+
'.pband{margin-top:8px;padding:7px 12px;border-radius:999px;font-weight:700;font-size:13px;display:inline-block;text-transform:capitalize}'+
'.ptxt{margin-top:8px;font-size:12.5px;color:#5b6672;line-height:1.5}'+
'.spark{display:flex;gap:3px;align-items:flex-end;margin-top:8px}'+
'.scol{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end}'+
'.sbars{display:flex;gap:2px;align-items:flex-end;height:44px}'+
'.sb{width:5px;border-radius:2px 2px 0 0}'+
'.sbA{background:#12b3a6}.sbB{background:#0E7C7366}'+
'.sm{font-size:8px;color:#8a94a0;margin-top:3px}'+
'.ilist{margin-top:8px;display:flex;flex-direction:column;gap:6px}'+
'.irow{background:var(--panel,#fff);border:1px solid var(--line,#e6e9ee);border-radius:9px;padding:7px 10px;font-size:12.5px}'+
'.imeta{color:#8a94a0;font-size:11px;margin-top:2px}';
document.head.appendChild(s); })();
function fmtAED(n){ n=Number(n||0); return 'AED '+n.toLocaleString('en-AE',{maximumFractionDigits:0}); }
function statChip(label,val){ return '<div class="scell"><div class="sv">'+val+'</div><div class="sl">'+label+'</div></div>'; }
function sparkBars(hist,keyA,keyB){ if(!hist||!hist.length) return ''; const max=Math.max(1,...hist.map(h=>Math.max(Number(h[keyA]||0),keyB?Number(h[keyB]||0):0))); return '<div class="spark">'+hist.map(h=>{ const a=Math.round((Number(h[keyA]||0)/max)*40); const b=keyB?Math.round((Number(h[keyB]||0)/max)*40):0; const t=h.month+': '+(h[keyA]||0)+(keyB?(' / '+(h[keyB]||0)):''); return '<div class="scol" title="'+t+'"><div class="sbars"><div class="sb sbA" style="height:'+Math.max(a,1)+'px"></div>'+(keyB?'<div class="sb sbB" style="height:'+Math.max(b,1)+'px"></div>':'')+'</div><div class="sm">'+String(h.month).split(' ')[0]+'</div></div>'; }).join('')+'</div>'; }
function expiriesHtml(list){ if(!list||!list.length) return ''; const col={expired:'#e02424',expiring:'#b45309',soon:'#5b6672',ok:'#0E7C73'}; return '<div class="asideh" style="margin-top:14px">Documents &amp; expiry</div><div class="ilist">'+list.map(function(x){ var c=col[x.status]||'#5b6672'; var lbl=x.status==='expired'?('expired '+Math.abs(x.days_left)+'d ago'):(x.days_left+'d left'); return '<div class="irow" style="display:flex;justify-content:space-between;align-items:center"><div><b>'+x.doc+'</b><div class="imeta">'+(x.expiry||'')+'</div></div><span style="color:'+c+';font-weight:700;font-size:11.5px">'+lbl+'</span></div>'; }).join('')+'</div>'; }
async function supPerfCard(id){ let d; try{ const r=await ops('supplier_stats',{id:Number(id)}); d=r.data||r; }catch(e){ return; } if(!d||d.error) return;
  const pp=d.price_positioning||{}; const bandColor=/below/.test(pp.band||'')?'#0E7C73':(/above/.test(pp.band||'')?'#b45309':'#5b6672');
  const card=el('div','pcard');
  card.innerHTML='<div class="asideh">Performance</div>'
   +'<div class="sgrid">'+statChip('Quotes',d.quotes_total==null?0:d.quotes_total)+statChip('Reveals',d.reveals==null?0:d.reveals)+statChip('Hired',d.hired==null?0:d.hired)+statChip('Win ratio',(d.win_ratio!=null?d.win_ratio+'%':'—'))+statChip('Rating',(d.rating!=null?(d.rating+(d.rating_percentile!=null?(' · '+d.rating_percentile+'pct'):'')):'—'))+statChip('Deal value',fmtAED(d.deal_value_awarded))+'</div>'
   +'<div class="asideh" style="margin-top:14px">Price positioning <span style="font-weight:600;color:#8a94a0">(anonymous — no competitor prices)</span></div>'
   +'<div class="pband" style="background:'+bandColor+'22;color:'+bandColor+';border:1px solid '+bandColor+'55">'+(pp.band||'not enough data')+'</div>'
   +'<div class="ptxt">'+(pp.competitive_rfqs?('Lowest bid on '+(pp.times_lowest||0)+' of '+pp.competitive_rfqs+' competitive RFQs ('+(pp.lowest_rate||0)+'%). On average '+(pp.avg_pct_vs_average>=0?'+':'')+(pp.avg_pct_vs_average==null?0:pp.avg_pct_vs_average)+'% vs the market average and '+(pp.avg_pct_above_lowest==null?0:pp.avg_pct_above_lowest)+'% above the lowest quote.'):'Not enough competitive RFQs yet to position pricing.')+'</div>'
   +'<div class="asideh" style="margin-top:14px">Last 12 months <span style="font-weight:600;color:#8a94a0">(quotes / reveals)</span></div>'+sparkBars(d.history_12m,'quotes','reveals')+expiriesHtml(d.document_expiries);
  $('#aside').appendChild(card);
}
const _sup_perf=openSupplier360; openSupplier360=async function(id){ await _sup_perf(id); try{ await supPerfCard(id); }catch(_e){} };
async function cusPerfCard(id){ let d; try{ const r=await ops('customer_stats',{id:String(id)}); d=r.data||r; }catch(e){ return; } if(!d||d.error) return;
  const editable=(d.inquiries||[]).filter(x=>x.editable);
  const card=el('div','pcard');
  card.innerHTML='<div class="asideh">Activity</div>'
   +'<div class="sgrid">'+statChip('Inquiries',d.inquiries_total==null?0:d.inquiries_total)+statChip('Open',d.open_inquiries==null?0:d.open_inquiries)+statChip('Quotes recvd',d.quotes_received==null?0:d.quotes_received)+statChip('Avg quotes',d.avg_quotes_per_inquiry==null?0:d.avg_quotes_per_inquiry)+statChip('Deals',d.deals==null?0:d.deals)+statChip('Spend',fmtAED(d.total_spend))+'</div>'
   +(editable.length?('<div class="pband" style="margin-top:10px;background:#0E7C7322;color:#0E7C73;border:1px solid #0E7C7355;text-transform:none">'+editable.length+' inquiry(s) still in the 60-min edit window</div>'):'')
   +'<div class="asideh" style="margin-top:14px">Inquiries</div><div class="ilist">'+(d.inquiries||[]).slice(0,10).map(x=>'<div class="irow"><div><b>'+(x.category||'—')+'</b> · '+(x.emirate||'')+'</div><div class="imeta">'+(x.quotes_count||0)+' quotes · '+(x.status||'')+(x.has_drawing?' · drawing':'')+(x.editable?(' · editable '+x.edit_minutes_left+'m'):'')+'</div></div>').join('')+'</div>'
   +'<div class="asideh" style="margin-top:14px">Inquiries / month</div>'+sparkBars(d.history_12m,'inquiries',null);
  $('#aside').appendChild(card);
}
const _cus_perf=openCustomer360; openCustomer360=async function(id){ await _cus_perf(id); try{ await cusPerfCard(id); }catch(_e){} };
// ---- wave6: document expiries compliance module ----
MODULES.push({id:'expiring',ic:'⏰',label:'Doc Expiries', kind:'expiring'});
const _openModuleExp = openModule;
openModule = function(m){ if(m && m.kind==='expiring') return loadExpiring(); return _openModuleExp(m); };
async function loadExpiring(){
  CUR='expiring'; renderNav();
  const main=$('#main'); main.innerHTML='';
  main.appendChild(el('div','wshead','<h1>Document expiries</h1>'));
  main.appendChild(el('p','wssub','Approved suppliers with trade licence, ISO, insurance or manufacturer authorisation expiring within 90 days. Click a row to open the supplier and chase the renewal.'));
  const host=el('div'); main.appendChild(host); host.innerHTML='<div class="skel" style="height:280px"></div>';
  try{ const r=await ops('expiring_docs',{days:90}); const rows=(r.data||[]);
    host.innerHTML='';
    if(!rows.length){ host.appendChild(el('div','card','No supplier documents are expiring in the next 90 days.')); return; }
    host.appendChild(opTable({columns:['company_name','sector','doc','expiry','days_left','status'], rows}, { onRow:(row)=>openSupplier360(row.id) }));
  }catch(e){ host.innerHTML='<div class="card">Could not load: '+escapeH(e.message)+'</div>'; }
}
// ---- boot ----
async function boot(){
  $('#app').style.display='grid';
  const em=window.OS_EMAIL||''; $('#whoami').textContent=em||'admin'; $('#avatar').textContent=(em[0]||'?').toUpperCase();
  $('#searchbtn').onclick=openPalette;
  $('#refreshbtn').onclick=()=>navTo(CUR);
  $('#burger').onclick=()=>$('#rail').classList.toggle('open');
  $('#drwclose').onclick=()=>$('#drawer').classList.remove('on');
  $('#palette').onclick=e=>{ if(e.target.id==='palette') closePalette(); };
  const saved=localStorage.getItem('os3-theme'); if(saved)document.documentElement.setAttribute('data-theme',saved);
  $('#themebtn').onclick=()=>{ const cur=document.documentElement.getAttribute('data-theme')==='dark'?'':'dark'; if(cur)document.documentElement.setAttribute('data-theme',cur);else document.documentElement.removeAttribute('data-theme'); localStorage.setItem('os3-theme',cur); };
  renderNav();
  loadExec();
  try{ NAV=await api('nav')||{badges:{}}; renderNav(); }catch(e){}
}
if(window.OS_AUTH) boot(); else window.addEventListener('os-auth-ready',boot,{once:true});
    })();
  }, []);
  return <div dangerouslySetInnerHTML={{ __html: SHELL }} />;
}
