node_modules/
.next/
out/
build/
.vercel/
.env
.env*.local
*.tsbuildinfo
.DS_Store

# edge function rollback snapshots (local only)
.edge-backups/

# Supabase CLI local state
supabase/.temp/

# graphify: generated locally, cheap to rebuild, and as of 22 Sep 2026 NOT tracked at all.
# Measured: 7 tracked files, 30 MB, of which graph.json alone was 25 MB — a generated artefact
# rewritten in full by `graphify update .` on every code change, so every commit that touched code
# carried a multi-megabyte binary-shaped diff nobody read. The repository's CLAUDE.md still tells
# every session to query it; the answer to a missing graph is `graphify update .` (AST-only, no API
# cost), not a checkout.
graphify-out/

# transient commit-message scratch
COMMIT_MSG.tmp

# secrets / local artefacts - never commit
s.key
*.key
qd-src.zip
*.skill

# The kb_corpus_import bearer token. Minted per import, revoked after, never committed.
knowledge-import/.tok
# The 67 knowledge packages: 27 MB of source archives, re-downloadable, not repo content.
knowledge-import/all86/

knowledge-import/all86_full/
knowledge-import/__pycache__/

# vendored third-party reference clones - read-only, evaluated in docs/VENDOR_EVALUATION.md, never built
vendor/reference/

# claude-flow: machine-local daemon state, metrics and neural scratch. PR #276 swept these in
# because they were already dirty, and one commit on main has a regenerated
# .claude-flow/neural/stats.json as its entire content. Nothing reads them from git.
.claude-flow/

# repomix / source-export artefacts, generated on demand
repomix-src.xml

# shell-redirection debris at the repo root (bad quoting produced files named `3)`, `1279'`, …)
diag*.out
# A broken shell expansion mkdir-ed a directory literally named $WT and filled it with a copy of
# this repository. Measured 9 Sep 2026: 448 MB, 4,324 files, untracked — and GROWING (scripts/checks/
# run.mjs records it at 159 MB on 14 Aug). It is a stale snapshot: it still holds files deleted from
# main today. Ignored rather than deleted, because untracked bytes are not recoverable from git and
# removing 448 MB is the owner call. run.mjs already skips it via the carries-its-own-.git rule; this
# stops git and graphify from indexing it too.
$WT/

# Agent worktrees are scratch: 79 of them were committed as gitlinks with no .gitmodules,
# so every CI checkout printed "fatal: No url found for submodule path" and every job — including
# the green ones — ended with "git failed with exit code 128". Scratch, never source of truth.
.claude/worktrees/

# End-to-end harness reports (scripts/e2e/run.mjs): markdown + screenshots of one run against the
# live site. Evidence for a PR, never source — they are written outside the repository by default.
e2e-reports/

# ── THE REPOSITORY ROOT HOLDS ONLY THE PRODUCT (founder instruction 642, 22 Sep 2026) ──────────
# Measured 22 Sep 2026: the main checkout held 334 untracked root entries — files named `0`, `$TMP`,
# `1{print`, `NUL`, `%s`, `console.log(OPEN`, left by redirect and quoting accidents, plus ~40
# PHASE_C_*/PHASE_D_* reports and dozens of *.out/*.json/*.pdf scratch files. One `git add -A`
# would have committed all of them. repomix-src.xml was listed in this file AND committed anyway,
# because an ignore rule does not stop a forced add — which is why
# scripts/checks/the_repository_root_holds_only_the_product.test.mjs also fails CI when a tracked
# root name is not on this list.
# Every root entry is ignored unless named below. A new top-level file or folder is added HERE, on
# purpose, in the same commit that introduces it.
/*
!/.claude/
!/.devcontainer/
!/.dockerignore
!/.editorconfig
!/.env.example
!/.github/
!/.gitignore
!/.graphifyignore
!/.mcp.json
!/.squawk.toml
!/ARCHITECTURE.md
!/CLAUDE.md
!/Dockerfile
!/README.md
!/CONTRIBUTING.md
!/ai-organization/
!/components.json
!/docker-compose.yml
!/docs/
!/knowledge-import/
!/knowledge/
!/messages/
!/next-env.d.ts
!/next.config.mjs
!/.nvmrc
!/.oxlintrc.json
!/package-lock.json
!/package.json
!/postcss.config.mjs
!/public/
!/scripts/
!/src/
!/supabase/
# tests/fixtures/ holds generated benchmark fixtures (28 Sep 2026: the ZZ DEMO drawing take-off set,
# written by scripts/eval/drawing_takeoff_zz_demo_gen.ts, scored by scripts/eval/drawing_takeoff_benchmark.ts).
!/tests/
!/tsconfig.json
!/vercel.json

# graphify copies the previous graph into a dated folder on every rebuild (graphify/export.py,
# backup_if_protected): 23 folders, 434 MB, committed until 22 Sep 2026. Nothing reads them; the
# live graph is graphify-out/graph.json and every older one is in git history.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# V3 certification raw outputs: a 49 MB export of certrun_v3.raw_result (staging run, 14 Aug 2026).
# The digest stays in V3_CERTIFICATION_RAW_OUTPUTS.sha256; the file is `git show c8d91b1:<this path>`.
docs/knowledge/certification/V3_CERTIFICATION_RAW_OUTPUTS.jsonl
