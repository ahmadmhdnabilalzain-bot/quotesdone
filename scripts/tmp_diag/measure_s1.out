## rules
[{"rule_id":"BR-002","rule_name":"Creator/reviewer separation","rule_type":"hard","workflow_scope":"all","rule_text":"A creator cannot be the sole final independent reviewer of the same consequential output."},{"rule_id":"BR-018","rule_name":"Supplier quote remains supplier-authored","rule_type":"hard","workflow_scope":"W14;W15","rule_text":"The platform may normalize for comparison but cannot alter the supplier's original quotation revision."},{"rule_id":"BR-019","rule_name":"Published quote visibility only","rule_type":"hard","workflow_scope":"W14;W15","rule_text":"Customers may see only their own approved/published quotation comparison versions."},{"rule_id":"BR-020","rule_name":"Payment before reveal","rule_type":"hard","workflow_scope":"W15;W16","rule_text":"Supplier contact identity is revealed only after the founder-approved payment state is confirmed and reconciled."},{"rule_id":"BR-025","rule_name":"Exact terms acceptance","rule_type":"hard","workflow_scope":"W04;W09","rule_text":"Terms acceptance must reference the exact displayed version and hash and remain append-only."},{"rule_id":"BR-027","rule_name":"Evidence provenance","rule_type":"hard","workflow_scope":"W05;W07;W08;W10;W14;W25;W26","rule_text":"Every extracted document fact, normalization, score and review finding must retain source/version provenance."},{"rule_id":"BR-033","rule_name":"Unknown monetary state is visible","rule_type":"hard","workflow_scope":"W16;W17;W27","rule_text":"Unknown, conflicting or unreconciled monetary states are blocked/quarantined and cannot be treated as success."}]
