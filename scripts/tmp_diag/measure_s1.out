[{"state":"active","definition":"The accountable owner is executing the current required step.","terminal":false},{"state":"approved","definition":"The required decision/review passed but final closure actions remain.","terminal":false},{"state":"blocked","definition":"A named blocker prevents progression and has an accountable resolution owner.","terminal":false},{"state":"cancelled","definition":"The workflow was intentionally stopped with authority and reason.","terminal":true},{"state":"completed","definition":"The required end state and closure criteria are satisfied.","terminal":true},{"state":"draft","definition":"Record exists but work has not been accepted into active processing.","terminal":false},{"state":"expired","definition":"A configured time window ended without the required action.","terminal":false},{"state":"failed","definition":"Execution ended unsuccessfully and requires retry, escalation or closure.","terminal":false},{"state":"queued","definition":"Work is accepted and waiting for its accountable owner.","terminal":false},{"state":"rejected","definition":"The required decision/review failed; correction, appeal or closure must follow.","terminal":false},{"state":"superseded","definition":"A newer approved workflow/version replaces this one while preserving history.","terminal":true},{"state":"waiting_handoff","definition":"A complete handoff packet is awaiting receiving-owner acceptance.","terminal":false},{"state":"waiting_input","definition":"Required evidence or response is awaited from an identified party.","terminal":false},{"state":"waiting_review","definition":"An independent review or approval is pending.","terminal":false}]
