#### leads unique indexes
[{"indexname":"leads_pkey","indexdef":"CREATE UNIQUE INDEX leads_pkey ON public.leads USING btree (id)"},{"indexname":"leads_place_id_key","indexdef":"CREATE UNIQUE INDEX leads_place_id_key ON public.leads USING btree (place_id)"},{"indexname":"leads_place_id_uidx","indexdef":"CREATE UNIQUE INDEX leads_place_id_uidx ON public.leads USING btree (place_id) WHERE (place_id IS NOT NULL)"},{"indexname":"uq_leads_email_lower","indexdef":"CREATE UNIQUE INDEX uq_leads_email_lower ON public.leads USING btree (lower(email)) WHERE ((email IS NOT NULL) AND (email <> ''::text))"},{"indexname":"leads_claim_token_key","indexdef":"CREATE UNIQUE INDEX leads_claim_token_key ON public.leads USING btree (claim_token)"},{"indexname":"leads_founding_rank_uidx","indexdef":"CREATE UNIQUE INDEX leads_founding_rank_uidx ON public.leads USING btree (founding_rank) WHERE (founding_rank IS NOT NULL)"},{"indexname":"leads_claimed_by_lower_uidx","indexdef":"CREATE UNIQUE INDEX leads_claimed_by_lower_uidx ON public.leads USING btree (lower(btrim(claimed_by))) WHERE ((claimed_by IS NOT NULL) AND (btrim(claimed_by) <> ''::text))"}]
