## W17 steps
[{"step_id":"W17-S01","step_name":"Open refund/dispute/fraud case","ra":"Open a case from customer request, provider event, internal alert or fraud signal.","ro":"Open classified case.","founder_gate":"none","ac":"Case type, parties, transaction and source evidence are identified.","independent_reviewer_role_id":null},{"step_id":"W17-S02","step_name":"Triage jurisdiction and authority","ra":"Determine case type, applicable policy, legal/financial authority and required reviewers.","ro":"Case handling plan.","founder_gate":"none","ac":"Money, legal and enforcement decisions are routed to authorized roles.","independent_reviewer_role_id":null},{"step_id":"W17-S03","step_name":"Collect transaction and communication evidence","ra":"Collect provider records, platform states, messages, acknowledgements and complaint evidence.","ro":"Evidence packet.","founder_gate":"none","ac":"Evidence is complete enough for review or missing items are explicit.","independent_reviewer_role_id":null},{"step_id":"W17-S04","step_name":"Conduct fraud review when triggered","ra":"Assess manipulation, identity, abuse and transaction risk.","ro":"Fraud verdict and recommended controls.","founder_gate":"none","ac":"Verdict states evidence, uncertainty and block/allow recommendation.","independent_reviewer_role_id":null},{"step_id":"W17-S05","step_name":"Conduct legal/compliance review when triggered","ra":"Assess contractual, regulatory, privacy and consumer implications.","ro":"Legal/compliance position.","founder_gate":"none","ac":"Position distinguishes legal fact, interpretation, uncertainty and founder-reserved commitment.","independent_reviewer_role_id":null},{"step_id":"W17-S06","step_name":"Decide case outcome","ra":"Approve, reject, escalate, partially resolve or request further evidence within authority.","ro":"Case decision with required actions.","founder_gate":"none","ac":"Decision has one accountable owner and no reviewer executes the same monetary action.","independent_reviewer_role_id":"risk_and_governance_manager"},{"step_id":"W17-S07","step_name":"Execute approved financial action","ra":"Execute the approved action idempotently and preserve provider evidence.","ro":"Financial execution result.","founder_gate":"Money movement beyond approved policy requires founder approval.","ac":"No action occurs without an approved case and no duplicate refund is possible.","independent_reviewer_role_id":"billing_operations"},{"step_id":"W17-S08","step_name":"Apply trust/supplier/customer enforcement","ra":"Apply approved warning, restriction, suspension, block or restoration.","ro":"Enforcement state changes.","founder_gate":"none","ac":"Enforcement matches the case decision and supports appeal where required.","independent_reviewer_role_id":null},{"step_id":"W17-S09","step_name":"Reconcile and notify","ra":"Reconcile financial outcome and deliver approved case communications.","ro":"Reconciliation and notification records.","founder_gate":"none","ac":"Parties receive the correct outcome and no private internal evidence is leaked.","independent_reviewer_role_id":null},{"step_id":"W17-S10","step_name":"Handle appeal or escalation","ra":"Review the prior decision and escalate when authority is insufficient.","ro":"Appeal/escalation result.","founder_gate":"none","ac":"Reviewer is independent of the original execution and any founder gate is explicit.","independent_reviewer_role_id":null},{"step_id":"W17-S11","step_name":"Close case","ra":"Close with outcome, evidence, financial state, enforcement state and residual risk.","ro":"Closed refund/dispute/fraud case.","founder_gate":"none","ac":"All required actions are complete or explicitly handed to an accountable open workflow.","independent_reviewer_role_id":null}]
