## context_key_object
[{"context_key":"acceptance_ref","object_id":"customer_terms_acceptance","why":"BR-026 refuses a certificate before an acceptance and resolves this against the terms-acceptance record","recorded_at":"2026-08-22 20:41:48.519959+00"},{"context_key":"approved_revision_ref","object_id":"quotation_revision","why":"BR-035 compares the approved revision with the published one; both are IMMUTABLE_REVISION records","recorded_at":"2026-08-22 20:41:48.519959+00"},{"context_key":"artifact_ref","object_id":"ux_specification","why":"BR-036 requires the reviewer to have reviewed the artifact itself; the artifact is the revision record","recorded_at":"2026-08-22 20:41:48.519959+00"},{"context_key":"caller_customer_id","object_id":"customer_account","why":"BR-019 decides visibility from who is asking, which is a customer account","recorded_at":"2026-08-22 20:41:48.519959+00"},{"context_key":"comparison_id","object_id":"quotation_comparison","why":"BR-019 resolves the comparison whose visibility it is judging","recorded_at":"2026-08-22 20:41:48.519959+00"},{"context_key":"document_id","object_id":"inquiry_document","why":"GATE-012 and the extraction steps judge the document revision this key names; public.documents is its canonical relation","recorded_at":"2026-08-22 22:33:29.885808+00"},{"context_key":"inquiry_id","object_id":"inquiry","why":"BR-013 refuses a quote against an inquiry that is not quote-ready, reading public.inquiries","recorded_at":"2026-08-22 20:41:48.519959+00"},{"context_key":"provider_event_id","object_id":"provider_event","why":"BR-032 refuses a replayed provider event, reading the recorded event","recorded_at":"2026-08-22 20:41:48.519959+00"},{"context_key":"publishing_revision_ref","object_id":"quotation_revision","why":"BR-035, the other half of the same comparison","recorded_at":"2026-08-22 20:41:48.519959+00"},{"context_key":"quote_id","object_id":"quotation","why":"BR-015 and BR-018 judge the supplier quotation this key names; public.quotes is its canonical relation","recorded_at":"2026-08-22 22:33:29.885808+00"},{"context_key":"quote_revision_ref","object_id":"quotation_revision","why":"BR-018 asks whether the supplier quote is still supplier-authored, against the revision record","recorded_at":"2026-08-22 20:41:48.519959+00"},{"context_key":"refund_id","object_id":"refund_dispute_case","why":"GATE-020 and BR-032 judge the refund case this key names; public.refunds is its canonical relation","recorded_at":"2026-08-22 22:33:29.885808+00"},{"context_key":"safe_package_ref","object_id":"supplier_safe_package","why":"BR-012 requires an approved supplier-safe package record","recorded_at":"2026-08-22 20:41:48.519959+00"},{"context_key":"supplier_id","object_id":"supplier_account","why":"BR-015 requires an approved, verified supplier, reading public.leads","recorded_at":"2026-08-22 20:41:48.519959+00"},{"context_key":"transaction_id","object_id":"payment_transaction","why":"BR-020 refuses a reveal before payment, reading public.transactions","recorded_at":"2026-08-22 20:41:48.519959+00"}]
## payment ladder
[{"state_key":"checkout_created","rung":1,"meaning":"A checkout session exists. No money has moved and none may be assumed.","authorizes_reveal":false,"why":"The customer reached the payment screen. Treating this as paid is the first and cheapest mistake available."},{"state_key":"payment_initiated","rung":2,"meaning":"The customer submitted payment. The provider has not answered.","authorizes_reveal":false,"why":"An initiated payment can still fail, be declined, or be abandoned mid-flow."},{"state_key":"provider_success","rung":3,"meaning":"The provider reported success on its own API.","authorizes_reveal":false,"why":"A provider 200 is the provider's claim about itself. It is not our record and it is not reconciled."},{"state_key":"payment_confirmed","rung":4,"meaning":"We hold an authenticated provider event for this exact payment reference.","authorizes_reveal":false,"why":"Confirmed is a fact about the EVENT. It still says nothing about whether the amount and the transaction agree."},{"state_key":"payment_reconciled","rung":5,"meaning":"The confirmed amount, currency and payment reference match this transaction, and a reconciliation record exists.","authorizes_reveal":true,"why":"This is the founder-approved bar in BR-020. Reveal is permitted from here and from nowhere below it."},{"state_key":"reveal_authorized","rung":6,"meaning":"Reconciliation held and the reveal decision has been taken and recorded.","authorizes_reveal":true,"why":"The terminal rung. Recorded separately so a reveal that already happened is distinguishable from one that merely may."}]
## reveal_permitted def
[{"pg_get_functiondef":"CREATE OR REPLACE FUNCTION public.fn_phase_d_reveal_permitted(p_transaction_id text)\n RETURNS TABLE(permitted boolean, state_key text, rung integer, reason text)\n LANGUAGE plpgsql\n STABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare t public.transactions%rowtype; s public.phase_d_payment_state%rowtype; v_raw text;\nbegin\n  select * into t from public.transactions where id::text = p_transaction_id;\n  if not found then\n    permitted := false; state_key := 'no_transaction'; rung := 0;\n    reason := format('BR-020: no transaction %s. A reveal with no transaction is not an edge case, it is the whole defect.', coalesce(p_transaction_id,'(null)'));\n    return next; return;\n  end if;\n\n  v_raw := lower(btrim(coalesce(t.fee_status, '')));\n  if v_raw = '' then\n    permitted := false; state_key := 'unstated'; rung := 0;\n    reason := 'BR-020: transaction carries no fee_status. An absent payment state is not a paid one.';\n    return next; return;\n  end if;\n\n  -- The table is ALIASED and the column QUALIFIED. This function's OUT parameter is also named\n  -- state_key, and an unqualified reference resolves to the plpgsql variable rather than the\n  -- column. Postgres refuses that as ambiguous instead of silently choosing, which is the good\n  -- outcome — but only once it is written correctly.\n  select * into s from public.phase_d_payment_state ps where ps.state_key = v_raw;\n  if not found then\n    -- FAIL CLOSED. An unrecognised value is not mapped to the nearest rung and not assumed paid.\n    permitted := false; state_key := v_raw; rung := 0;\n    reason := format('BR-020: fee_status %s is not a declared payment state. Refusing rather than guessing which rung it means.', v_raw);\n    return next; return;\n  end if;\n\n  if not s.authorizes_reveal then\n    permitted := false; state_key := s.state_key; rung := s.rung;\n    reason := format('BR-020: transaction is at rung %s (%s) and reveal requires payment_reconciled at rung 5. %s',\n                     s.rung, s.state_key, s.why);\n    return next; return;\n  end if;\n\n  -- Reconciled is claimed. The claim must carry the two facts that make it one.\n  if coalesce(btrim(t.payment_ref),'') = '' then\n    permitted := false; state_key := s.state_key; rung := s.rung;\n    reason := 'BR-020: the transaction claims a reconciled state with no payment_ref. A reconciliation with nothing to reconcile against is a label.';\n    return next; return;\n  end if;\n  if t.reveal_fee is null then\n    permitted := false; state_key := s.state_key; rung := s.rung;\n    reason := 'BR-020: the transaction claims a reconciled state with a null reveal_fee. A null amount is an unmeasured amount, not a settled one.';\n    return next; return;\n  end if;\n\n  permitted := true; state_key := s.state_key; rung := s.rung;\n  reason := format('BR-020: transaction %s is at rung %s (%s) with payment_ref and a stated reveal_fee.',\n                   t.id, s.rung, s.state_key);\n  return next;\nend $function$\n"}]
