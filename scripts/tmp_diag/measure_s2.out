## refunds status check
[{"conname":"refunds_amount_fils_check","pg_get_constraintdef":"CHECK (((amount_fils IS NULL) OR (amount_fils > 0)))"},{"conname":"refunds_amount_source_check","pg_get_constraintdef":"CHECK (((amount_source IS NULL) OR (amount_source = ANY (ARRAY['in_platform_request'::text, 'webhook_event'::text, 'stripe_api'::text, 'manual'::text, 'unknown'::text]))))"},{"conname":"refunds_currency_check","pg_get_constraintdef":"CHECK ((currency = 'AED'::text))"},{"conname":"refunds_reason_code_check","pg_get_constraintdef":"CHECK ((reason_code = ANY (ARRAY['supplier_unresponsive'::text, 'supplier_withdrew'::text, 'duplicate_charge'::text, 'customer_cancelled_in_window'::text, 'service_not_delivered'::text, 'fraud_or_dispute'::text, 'goodwill'::text, 'other'::text])))"},{"conname":"refunds_settled_needs_amount","pg_get_constraintdef":"CHECK (((status <> 'succeeded'::text) OR (amount_fils IS NOT NULL) OR (reconciliation_note IS NOT NULL)))"},{"conname":"refunds_status_check","pg_get_constraintdef":"CHECK ((status = ANY (ARRAY['requested'::text, 'approved'::text, 'rejected'::text, 'processing'::text, 'succeeded'::text, 'failed'::text, 'cancelled'::text])))"}]
## dept objective check
[{"conname":"department_objective_status_check","pg_get_constraintdef":"CHECK ((status = ANY (ARRAY['active'::text, 'superseded'::text, 'achieved'::text, 'dropped'::text])))"}]
## org_tasks check
[{"conname":"org_tasks_status_check","pg_get_constraintdef":"CHECK ((status = ANY (ARRAY['proposed'::text, 'assigned'::text, 'in_progress'::text, 'blocked'::text, 'done'::text, 'failed'::text, 'escalated'::text, 'cancelled'::text])))"},{"conname":"org_tasks_tier_check","pg_get_constraintdef":"CHECK ((tier = ANY (ARRAY['advisory'::text, 'gated'::text, 'supervised'::text, 'autonomous'::text])))"}]
