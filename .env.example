# QuotesDone — every environment variable the code reads, in one place (it_engineer, 9 Nov 2026).
# Copy to .env.local (gitignored) and fill in only what you need. Never commit a real value.
# docker-compose.yml loads .env.local into every container when it exists.
#
# Measured 9 Nov 2026 by grepping process.env.* in src/ + next.config.mjs and Deno.env.get() in
# supabase/functions/. Provider keys (OpenRouter, Stripe, Resend, Twilio, Dropbox, ...) are NOT here:
# they live as Supabase edge-function secrets and no developer machine handles them
# (docs/runbooks/cloud-sessions.md, docs/runbooks/keys.md).

# ── The website (Next.js) ────────────────────────────────────────────────────────────────────────
# The Supabase project the browser talks to. Unset = the production project (src/lib/supaEnv.ts).
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (preferred) or the legacy anon key. Public by design; it ships to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by src/app/api/resilience-ping/route.ts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret the site sends with its own runtime errors (src/instrumentation.ts). Unset = no reports.
SITE_ERROR_INGEST_SECRET=
# Vercel's cron sends this as a Bearer token to /api/resilience-ping.
CRON_SECRET=
# Set by Vercel itself; leave empty locally.
VERCEL_ENV=
NEXT_PUBLIC_VERCEL_ENV=
VERCEL_DEPLOYMENT_ID=

# ── Tooling: scripts/, the local gate, sessions ─────────────────────────────────────────────────
# Management API token: every read or change of production (qsql, apply_sql, deploy, production checks).
# Without it `npm run gate -- --offline` still runs every offline step.
SUPABASE_ACCESS_TOKEN=
# gh CLI (reading runs, opening PRs).
GH_TOKEN=
# Only scripts/eval/reasoning_eval.mjs --live.
QD_AI_GATEWAY_SECRET=
# A throwaway Postgres for the OTP race check. docker compose sets it for you.
QD_OTP_RACE_PG=
# Where sandbox rehearsal reports are written (default: a temp folder).
QD_SANDBOX_OUT=
